/* FBI STUDIO UI POLISH v1 */
:root{--fbi-gold:#c9a227;--fbi-gold-soft:#e3c75d}
body{background:radial-gradient(circle at 86% -8%,rgba(201,162,39,.09),transparent 31%),#07080b;letter-spacing:.01em}
.side{width:252px;background:linear-gradient(180deg,#0d0f14,#090b0f);border-right:1px solid #252b35;box-shadow:12px 0 40px rgba(0,0,0,.14)}
.brand{height:76px;padding:16px 19px;border-bottom:1px solid #252b35}.brand .dot{width:10px;height:10px;background:var(--fbi-gold);box-shadow:0 0 18px rgba(201,162,39,.4)}.brand>div{font-size:14px}.brand small{color:#7d8695;font-size:9px}
.nav{padding:13px 10px}.nav button,.nav .nav-link{margin:3px 0;border:1px solid transparent;border-left:3px solid transparent;border-radius:8px;padding:11px 13px;color:#8992a1;font-size:11px;font-weight:700}.nav button:hover,.nav button.active,.nav .nav-link:hover,.nav .nav-link.active{background:linear-gradient(90deg,rgba(201,162,39,.12),rgba(201,162,39,.025));color:#fff;border-color:#2b303a;border-left-color:var(--fbi-gold)}
.sidefoot{padding:15px 17px;color:#646d7c;font-size:9px}.top{height:72px;padding:12px 28px;background:rgba(10,12,16,.9);backdrop-filter:blur(16px);border-bottom:1px solid #252b35}.top h1{font-size:18px}.top small{font-size:10px;color:#818a99}
.view{padding:28px;max-width:1540px;margin:0 auto;width:100%}.btn{border-radius:9px;border-color:#303744;background:#151922;min-height:36px;padding:8px 13px;font-size:10px;font-weight:800}.btn.primary{background:linear-gradient(135deg,#b48c16,#d4b33f);border-color:#d4b33f;color:#0b0c0f;box-shadow:0 7px 20px rgba(201,162,39,.12)}
.card,.stat{background:linear-gradient(145deg,rgba(21,25,34,.98),rgba(14,17,23,.98));border:1px solid #272d38;border-radius:14px;box-shadow:0 12px 35px rgba(0,0,0,.12)}.card{padding:19px}.card h3{color:#d7b641;font-size:10px;letter-spacing:1.05px}
input,textarea,select{background:#090c11;border-color:#2d3440;border-radius:8px;min-height:38px}input:focus,textarea:focus,select:focus{border-color:#a98922;box-shadow:0 0 0 3px rgba(201,162,39,.08)}label{font-size:10px;font-weight:700;color:#9da5b3}
.dashboard-stats{gap:12px}.dashboard-stats .stat{padding:18px;position:relative;overflow:hidden}.dashboard-stats .stat:after{content:"";position:absolute;right:-28px;top:-38px;width:90px;height:90px;border-radius:50%;background:rgba(201,162,39,.045)}.dashboard-stats .stat span{font-size:9px;letter-spacing:.9px}.dashboard-stats .stat b{font-size:22px}.dashboard-stats .stat .accent{color:#e2c34f}
.overview-item,.saved,.item{background:#0d1016;border-color:#282e39;border-radius:10px}.overview-item{padding:12px}.overview-item b{font-size:15px}.dashboard-main-grid{margin-top:18px}.recent{margin-top:18px}.dashboard-table th{font-size:8px;letter-spacing:.7px}.dashboard-table td{font-size:10px}
#view-dashboard:before{content:"BUSINESS OVERVIEW  •  FBI INVOICE STUDIO";display:block;color:#d7b641;font-size:9px;font-weight:900;letter-spacing:1.8px;margin:0 0 10px}
#view-dashboard>.report-toolbar{position:relative;display:flex;justify-content:space-between;align-items:center;margin-bottom:17px;padding:18px 20px;border:1px solid #2d333e;border-radius:16px;background:linear-gradient(120deg,rgba(201,162,39,.09),rgba(255,255,255,.015) 45%,transparent);box-shadow:0 15px 40px rgba(0,0,0,.12)}
#view-dashboard>.report-toolbar:before{content:"Your invoicing command center";font-size:20px;font-weight:800;letter-spacing:-.4px;color:#f5f6f8}#view-dashboard>.report-toolbar:after{content:"Monitor invoices, collections, balances and client activity.";position:absolute;left:20px;bottom:9px;color:#858e9f;font-size:9px}
@media(max-width:600px){.view{padding:12px}.top{height:64px;padding:12px 14px}#view-dashboard>.report-toolbar{align-items:flex-end;padding:15px;min-height:82px}#view-dashboard>.report-toolbar:before{font-size:16px}.dashboard-stats .stat b{font-size:20px}}

/* ===== FBI PROFESSIONAL UI SYSTEM — VISUAL ONLY ===== */
:root{--fbi-gold:#d7b15a;--fbi-gold-strong:#f0c75e;--fbi-glow:rgba(215,177,90,.22);--fbi-focus:rgba(215,177,90,.32);--fbi-radius:14px;--fbi-shadow:0 18px 55px rgba(0,0,0,.22);--fbi-speed:.22s}
html{scroll-behavior:smooth;color-scheme:dark}
body{overflow-x:hidden;background:radial-gradient(circle at 82% -10%,rgba(189,27,99,.10),transparent 32%),radial-gradient(circle at 15% 20%,rgba(215,177,90,.055),transparent 28%),var(--bg);transition:background .3s ease,color .3s ease}
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;background:linear-gradient(115deg,transparent 0 48%,rgba(255,255,255,.018) 50%,transparent 52%);opacity:.65}
.side{box-shadow:8px 0 35px rgba(0,0,0,.12);backdrop-filter:blur(16px);transition:background .3s,border-color .3s}
.brand{letter-spacing:.2px}.brand .dot{animation:fbiPulse 2.8s ease-in-out infinite}
.nav button,.nav .nav-link{transition:background var(--fbi-speed),color var(--fbi-speed),transform var(--fbi-speed),border-color var(--fbi-speed)}
.nav button:hover,.nav .nav-link:hover{transform:translateX(2px)}
.nav button.active,.nav .nav-link.active{box-shadow:inset 0 0 24px rgba(189,27,99,.08)}
.main{min-width:0}.top{backdrop-filter:blur(18px);box-shadow:0 8px 30px rgba(0,0,0,.12)}
.top>div:last-child{flex-wrap:wrap}
.btn{transition:transform var(--fbi-speed),box-shadow var(--fbi-speed),border-color var(--fbi-speed),background var(--fbi-speed);box-shadow:0 4px 12px rgba(0,0,0,.08)}
.btn:hover{transform:translateY(-1px);box-shadow:0 8px 22px rgba(0,0,0,.18);border-color:rgba(215,177,90,.55)}
.btn:active{transform:translateY(0) scale(.985)}
.btn.primary{box-shadow:0 7px 22px rgba(189,27,99,.18)}
.card,.stat,.saved,.overview-item{transition:transform .24s ease,box-shadow .24s ease,border-color .24s ease,background .3s ease}
.card:hover,.stat:hover{transform:translateY(-2px);box-shadow:var(--fbi-shadow);border-color:rgba(215,177,90,.24)}
.stat{position:relative;overflow:hidden}
.stat::after{content:"";position:absolute;width:90px;height:90px;right:-38px;top:-42px;border-radius:50%;background:var(--fbi-glow);filter:blur(3px);opacity:.5;pointer-events:none}
input,textarea,select{transition:border-color var(--fbi-speed),box-shadow var(--fbi-speed),background .25s,color .25s}
input:hover,textarea:hover,select:hover{border-color:rgba(215,177,90,.38)}
input:focus,textarea:focus,select:focus{border-color:var(--fbi-gold);box-shadow:0 0 0 3px var(--fbi-focus),0 10px 24px rgba(0,0,0,.12)}
.view.active{animation:fbiViewIn .28s ease both}
.saved:hover{transform:translateX(2px);border-color:rgba(215,177,90,.30)}
.toast{backdrop-filter:blur(16px);box-shadow:0 16px 40px rgba(0,0,0,.3)}
.theme-switcher{display:inline-flex;align-items:center;gap:2px;padding:3px;border:1px solid var(--border);background:rgba(127,127,127,.08);border-radius:10px}
.theme-choice{border:0!important;background:transparent!important;color:var(--muted)!important;border-radius:7px!important;padding:7px 8px!important;min-width:34px;line-height:1;font-size:13px;box-shadow:none!important;transition:background .2s,color .2s,transform .2s}
.theme-choice:hover{transform:none!important;color:var(--text)!important;background:rgba(127,127,127,.10)!important}
.theme-choice.active{background:linear-gradient(180deg,rgba(215,177,90,.22),rgba(215,177,90,.08))!important;color:var(--fbi-gold-strong)!important;box-shadow:inset 0 0 0 1px rgba(215,177,90,.25)!important}
.theme-choice span{font-size:10px;margin-left:3px}
.header-notify{position:relative}
.header-notify .notify-count{position:absolute;right:-3px;top:-4px;min-width:16px;height:16px;padding:0 4px;border-radius:99px;background:#bd1b63;color:#fff;font-size:8px;font-weight:900;display:grid;place-items:center;border:2px solid var(--panel)}
.dashboard-command{display:grid;grid-template-columns:1.35fr .85fr;gap:16px;margin:16px 0}
.command-card{position:relative;overflow:hidden}
.command-card::before{content:"";position:absolute;inset:0;background:linear-gradient(120deg,rgba(215,177,90,.07),transparent 45%,rgba(189,27,99,.05));pointer-events:none}
.quick-actions{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.quick-action{display:flex;align-items:center;gap:9px;padding:12px;border:1px solid var(--border);border-radius:10px;background:rgba(127,127,127,.045);color:var(--text);cursor:pointer;transition:.22s}
.quick-action:hover{transform:translateY(-2px);border-color:rgba(215,177,90,.38);box-shadow:0 10px 25px rgba(0,0,0,.15)}
.quick-action b{font-size:10px}.quick-action small{display:block;color:var(--muted);font-size:8px;margin-top:2px}
.pulse-bars{height:145px;display:flex;align-items:flex-end;gap:7px;padding:12px 4px 2px}
.pulse-bar{flex:1;min-width:8px;height:var(--h);border-radius:7px 7px 2px 2px;background:linear-gradient(180deg,var(--fbi-gold-strong),#8d6b28);box-shadow:0 0 18px rgba(215,177,90,.13);position:relative;transition:height .45s ease,filter .2s}
.pulse-bar:hover{filter:brightness(1.18)}
.pulse-bar span{position:absolute;bottom:-17px;left:50%;transform:translateX(-50%);font-size:7px;color:var(--muted);white-space:nowrap}
.activity-list{display:grid;gap:2px}
.activity-row{display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-bottom:1px solid var(--border)}
.activity-row:last-child{border-bottom:0}
.activity-dot{width:8px;height:8px;border-radius:50%;background:var(--fbi-gold);margin-top:4px;box-shadow:0 0 12px var(--fbi-glow);flex:0 0 auto}
.activity-row b{font-size:10px}.activity-row small{display:block;color:var(--muted);font-size:8px;margin-top:2px}
[data-theme="light"]{color-scheme:light}
[data-theme="light"] body{--bg:#f4f6f9;--panel:#ffffff;--panel2:#eef1f5;--border:#d8dee8;--muted:#667085;--text:#171a21;--accent:#a80e4d;--green:#16865a;background:radial-gradient(circle at 82% -10%,rgba(189,27,99,.08),transparent 32%),radial-gradient(circle at 15% 20%,rgba(184,145,43,.07),transparent 28%),var(--bg)}
[data-theme="light"] .side{background:rgba(255,255,255,.92);box-shadow:8px 0 35px rgba(30,41,59,.08)}
[data-theme="light"] .top{background:rgba(255,255,255,.88);box-shadow:0 8px 30px rgba(30,41,59,.08)}
[data-theme="light"] .nav button,[data-theme="light"] .nav .nav-link{color:#667085}
[data-theme="light"] .nav button:hover,[data-theme="light"] .nav .nav-link:hover,[data-theme="light"] .nav button.active,[data-theme="light"] .nav .nav-link.active{background:#f1f3f7;color:#171a21}
[data-theme="light"] .card,[data-theme="light"] .stat{background:linear-gradient(180deg,#fff,#f9fafb)}
[data-theme="light"] .btn{background:#fff;color:#171a21;border-color:#d4dae4}
[data-theme="light"] .btn.primary{background:#a80e4d;color:#fff;border-color:#a80e4d}
[data-theme="light"] .btn.danger{background:#fff2f4;color:#a61f36;border-color:#e8b7c0}
[data-theme="light"] input,[data-theme="light"] textarea,[data-theme="light"] select{background:#fff;color:#171a21;border-color:#d1d8e3}
[data-theme="light"] .item,[data-theme="light"] .saved,[data-theme="light"] .overview-item{background:#f8fafc;border-color:#dce2ea}
[data-theme="light"] .dashboard-table th{border-color:#d8dee8}.dashboard-table td{border-color:#e6e9ef}
[data-theme="light"] .report-modal{background:rgba(17,24,39,.48)}[data-theme="light"] .report-dialog{background:#fff;border-color:#d8dee8;box-shadow:0 30px 90px rgba(15,23,42,.22)}
[data-theme="light"] .report-head{background:rgba(255,255,255,.94);border-color:#d8dee8}.report-head h3{color:var(--text)}
[data-theme="light"] .report-filters{background:#f5f7fa;border-color:#d8dee8}
[data-theme="light"] .report-preview{box-shadow:0 8px 25px rgba(15,23,42,.08)}
[data-theme="light"] .report-table th{background:#1c2430}
[data-theme="light"] .theme-switcher{background:#f1f3f6}
[data-theme="light"] .header-notify .notify-count{border-color:#fff}
@media(max-width:950px){.dashboard-command{grid-template-columns:1fr}.quick-actions{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.theme-choice span{display:none}.theme-choice{padding:7px 9px!important}.quick-actions{grid-template-columns:1fr 1fr}.dashboard-command{gap:10px}.pulse-bars{height:125px}.top>div:last-child{gap:5px}}
@keyframes fbiPulse{0%,100%{box-shadow:0 0 12px rgba(199,25,84,.28)}50%{box-shadow:0 0 26px rgba(215,177,90,.42)}}
@keyframes fbiViewIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}


/* ===== FBI EXECUTIVE ACCOUNTING UI — VISUAL ONLY ===== */
:root{
  --exec-glow:rgba(215,177,90,.16);
  --exec-pink:rgba(189,27,99,.16);
  --exec-surface:rgba(17,20,27,.82);
}
body{
  background:
    radial-gradient(900px 500px at 78% -10%,var(--exec-glow),transparent 58%),
    radial-gradient(800px 520px at 12% 92%,var(--exec-pink),transparent 60%),
    var(--bg);
  background-attachment:fixed;
}
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;
  background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);
  background-size:42px 42px;
  mask-image:linear-gradient(to bottom,rgba(0,0,0,.7),transparent 85%);
}
.side{
  width:252px;
  background:linear-gradient(180deg,rgba(12,14,20,.96),rgba(16,18,25,.92));
  border-right:1px solid rgba(215,177,90,.12);
  box-shadow:18px 0 55px rgba(0,0,0,.16);
  backdrop-filter:blur(18px);
}
.brand{
  padding:22px 20px;
  border-bottom:1px solid rgba(255,255,255,.07);
  letter-spacing:.2px;
}
.brand .dot{width:10px;height:10px;background:#e5b83f;box-shadow:0 0 20px rgba(229,184,63,.7);animation:fbiDotPulse 2.8s ease-in-out infinite}
.nav{padding:13px 10px}
.nav .nav-link{
  margin:3px 0;width:100%;padding:12px 14px;border:1px solid transparent;border-left:1px solid transparent;
  border-radius:10px;color:#8f98a8;background:transparent;transition:all .22s ease;
}
.nav .nav-link:hover{
  color:#fff;background:linear-gradient(90deg,rgba(255,255,255,.055),transparent);
  border-color:rgba(255,255,255,.05);transform:translateX(3px);
}
.nav .nav-link.active{
  color:#fff;background:linear-gradient(100deg,rgba(189,27,99,.20),rgba(215,177,90,.07));
  border-color:rgba(215,177,90,.16);border-left-color:#e5b83f;
  box-shadow:inset 0 0 22px rgba(215,177,90,.035),0 7px 24px rgba(0,0,0,.12);
}
.sidefoot{padding:17px 18px;border-top:1px solid rgba(255,255,255,.07)}
.top{
  min-height:72px;padding:13px 24px;
  background:linear-gradient(180deg,rgba(15,18,25,.94),rgba(15,18,25,.78));
  border-bottom:1px solid rgba(215,177,90,.13);
  box-shadow:0 12px 36px rgba(0,0,0,.14);
  backdrop-filter:blur(20px);
}
.top h1{font-size:19px;letter-spacing:-.3px}
.top h1::after{content:"";display:block;width:24px;height:2px;margin-top:5px;border-radius:2px;background:linear-gradient(90deg,#e5b83f,#bd1b63);box-shadow:0 0 12px rgba(229,184,63,.35)}
.top>div:last-child{gap:8px!important}
.btn{
  position:relative;overflow:hidden;border-radius:9px;padding:9px 14px;
  border-color:rgba(255,255,255,.10);background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.025));
  box-shadow:0 5px 18px rgba(0,0,0,.10);
  transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease,filter .2s ease;
}
.btn::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 35%,rgba(255,255,255,.12) 50%,transparent 65%);transform:translateX(-120%);transition:transform .55s ease}
.btn:hover{transform:translateY(-1px);border-color:rgba(215,177,90,.32);box-shadow:0 9px 24px rgba(0,0,0,.18)}
.btn:hover::after{transform:translateX(120%)}
.primary{background:linear-gradient(135deg,#bd1b63,#8e0f49);border-color:rgba(229,184,63,.32);box-shadow:0 8px 26px rgba(189,27,99,.22)}
.danger{box-shadow:none}
.card,.stat{
  position:relative;overflow:hidden;
  background:linear-gradient(145deg,rgba(25,29,38,.92),rgba(15,18,25,.88));
  border:1px solid rgba(255,255,255,.075);
  border-radius:15px;
  box-shadow:0 14px 38px rgba(0,0,0,.12);
  backdrop-filter:blur(14px);
  transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease;
}
.card::before,.stat::before{
  content:"";position:absolute;left:0;right:0;top:0;height:1px;
  background:linear-gradient(90deg,transparent,rgba(215,177,90,.48),transparent);opacity:.55;
}
.card:hover{border-color:rgba(215,177,90,.16);box-shadow:0 18px 48px rgba(0,0,0,.18)}
.card h3{font-size:11px;letter-spacing:1.1px;color:#e5b83f;display:flex;align-items:center;gap:8px}
.card h3::before{content:"";width:5px;height:5px;border-radius:50%;background:#bd1b63;box-shadow:0 0 10px rgba(189,27,99,.65)}
.stat{
  min-height:126px;padding:18px;
  background:
    radial-gradient(180px 90px at 100% 0%,rgba(215,177,90,.09),transparent 70%),
    linear-gradient(145deg,rgba(25,29,38,.95),rgba(14,17,23,.92));
}
.stat:hover{transform:translateY(-3px);border-color:rgba(215,177,90,.25);box-shadow:0 20px 42px rgba(0,0,0,.22)}
.stat span{font-size:9px;letter-spacing:1.2px}
.stat b{font-size:25px;letter-spacing:-.7px}
.stat small{font-size:9px}
.dashboard-stats .stat:nth-child(1)::after{content:"01";position:absolute;right:15px;top:13px;font-size:9px;color:rgba(229,184,63,.5);font-weight:900}
.dashboard-stats .stat:nth-child(2)::after{content:"02";position:absolute;right:15px;top:13px;font-size:9px;color:rgba(229,184,63,.5);font-weight:900}
.dashboard-stats .stat:nth-child(3)::after{content:"03";position:absolute;right:15px;top:13px;font-size:9px;color:rgba(229,184,63,.5);font-weight:900}
.dashboard-stats .stat:nth-child(4)::after{content:"04";position:absolute;right:15px;top:13px;font-size:9px;color:rgba(229,184,63,.5);font-weight:900}
input,textarea,select{
  border-color:rgba(255,255,255,.10)!important;
  background:rgba(7,9,13,.66)!important;
  border-radius:9px!important;
  transition:border-color .2s,box-shadow .2s,background .2s;
}
input:hover,textarea:hover,select:hover{border-color:rgba(215,177,90,.20)!important}
input:focus,textarea:focus,select:focus{
  border-color:rgba(215,177,90,.62)!important;
  box-shadow:0 0 0 3px rgba(215,177,90,.08),0 7px 22px rgba(0,0,0,.12)!important;
}
.items-head{letter-spacing:1px}
.item{
  border-color:rgba(255,255,255,.075);
  background:linear-gradient(90deg,rgba(255,255,255,.035),rgba(255,255,255,.015));
  transition:transform .2s,border-color .2s,box-shadow .2s;
}
.item:hover{transform:translateX(2px);border-color:rgba(215,177,90,.18);box-shadow:0 7px 20px rgba(0,0,0,.12)}
.dashboard-table tbody tr{transition:background .18s,transform .18s}
.dashboard-table tbody tr:hover{background:rgba(215,177,90,.045);transform:translateX(2px)}
.theme-switcher{
  padding:3px;border-radius:11px;
  background:rgba(5,7,10,.48);
  border:1px solid rgba(215,177,90,.18);
  box-shadow:inset 0 0 18px rgba(215,177,90,.03),0 6px 18px rgba(0,0,0,.12);
}
.theme-choice{min-width:38px!important;padding:7px 9px!important}
.theme-choice.active{box-shadow:inset 0 0 0 1px rgba(229,184,63,.34),0 0 18px rgba(229,184,63,.08)!important}
.toast{border:1px solid rgba(215,177,90,.25)!important;box-shadow:0 15px 45px rgba(0,0,0,.3)!important;backdrop-filter:blur(14px)}
.view.active{animation:fbiExecutiveIn .32s ease both}
@keyframes fbiExecutiveIn{from{opacity:0;transform:translateY(7px) scale(.997)}to{opacity:1;transform:none}}
@keyframes fbiDotPulse{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.18);opacity:1}}
@media(max-width:900px){.side{width:228px}.top{padding:12px 16px}.view{padding:17px}}
@media(max-width:600px){.side{width:270px}.top{min-height:64px}.top h1{font-size:16px}.stat{min-height:108px}.card{border-radius:12px}}
@media(prefers-reduced-motion:reduce){.card,.stat,.btn,.item,.nav-link,.view.active{transition:none!important;animation:none!important}}



/* ===== FBI ACCOUNTING WORKSPACE — QUICKBOOKS-INSPIRED UI, FBI BRAND ===== */
:root{
  --bg:#f4f6f9;
  --panel:#ffffff;
  --panel2:#f8fafc;
  --border:#dde3eb;
  --muted:#667085;
  --text:#17202d;
  --accent:#a80e4d;
  --green:#16865a;
  --fbi-navy:#101722;
  --fbi-gold:#b89032;
  --fbi-magenta:#a80e4d;
}
html,body{background:var(--bg);color:var(--text)}
body{
  background:
    radial-gradient(900px 520px at 84% -12%,rgba(184,144,50,.08),transparent 56%),
    radial-gradient(760px 500px at 2% 96%,rgba(168,14,77,.045),transparent 60%),
    #f4f6f9;
}
body::before{display:none}
.side{
  width:246px;
  background:linear-gradient(180deg,#111823 0%,#0d141e 100%);
  border-right:1px solid #232d3a;
  box-shadow:10px 0 34px rgba(15,23,42,.10);
  backdrop-filter:none;
}
.brand{
  min-height:76px;
  padding:20px 19px;
  background:linear-gradient(180deg,rgba(255,255,255,.035),transparent);
  border-bottom:1px solid rgba(255,255,255,.08);
}
.brand .dot{width:9px;height:9px;background:#d2a846;box-shadow:0 0 14px rgba(210,168,70,.46)}
.brand small{color:#91a0b3}
.nav{padding:14px 10px}
.nav .nav-link{
  margin:4px 0;
  padding:11px 14px;
  border-left:3px solid transparent;
  border-radius:8px;
  color:#9aa7b8;
  background:transparent;
  font-size:12px;
  font-weight:650;
}
.nav .nav-link:hover{color:#fff;background:rgba(255,255,255,.055);transform:none;border-color:transparent}
.nav .nav-link.active{
  color:#fff;
  background:linear-gradient(90deg,rgba(168,14,77,.28),rgba(168,14,77,.08));
  border-left-color:#d2a846;
  box-shadow:inset 0 0 0 1px rgba(210,168,70,.08);
}
.sidefoot{color:#77869a;border-top:1px solid rgba(255,255,255,.08);background:rgba(0,0,0,.08)}
.main{background:transparent}
.top{
  min-height:72px;
  padding:12px 24px;
  background:rgba(255,255,255,.92);
  border-bottom:1px solid #dfe4eb;
  box-shadow:0 5px 24px rgba(15,23,42,.05);
  backdrop-filter:blur(12px);
}
.top h1{font-size:18px;color:#17202d;letter-spacing:-.25px}
.top h1::after{background:linear-gradient(90deg,#b89032,#a80e4d);box-shadow:none}
.top small{color:#7a8696}
.view{padding:25px 28px 34px;max-width:1500px;margin:0 auto;width:100%}
.report-toolbar{margin-bottom:12px}
.btn{
  min-height:36px;
  padding:9px 13px;
  border-radius:8px;
  border:1px solid #d2d9e2;
  background:#fff;
  color:#253041;
  box-shadow:0 1px 2px rgba(15,23,42,.04);
  font-size:11px;
  font-weight:750;
}
.btn::after{display:none}
.btn:hover{
  transform:translateY(-1px);
  border-color:#bcc6d4;
  box-shadow:0 6px 18px rgba(15,23,42,.08);
}
.primary{
  background:linear-gradient(135deg,#ae1555,#930d46);
  border-color:#a80e4d;
  color:#fff;
  box-shadow:0 6px 18px rgba(168,14,77,.18);
}
.primary:hover{box-shadow:0 9px 24px rgba(168,14,77,.22)}
.danger{background:#fff4f5;color:#a5273d;border-color:#ecc4ca;box-shadow:none}
.card,.stat{
  background:#fff;
  border:1px solid #dfe4eb;
  border-radius:12px;
  box-shadow:0 5px 18px rgba(15,23,42,.045);
  backdrop-filter:none;
}
.card::before,.stat::before{display:none}
.card:hover{border-color:#d4dbe5;box-shadow:0 9px 26px rgba(15,23,42,.065);transform:none}
.card h3{
  color:#273244;
  font-size:10px;
  letter-spacing:1px;
  font-weight:850;
}
.card h3::before{background:#b89032;box-shadow:none}
.dashboard-hero{
  display:flex;
  justify-content:space-between;
  gap:22px;
  align-items:stretch;
  padding:24px 26px;
  margin-bottom:14px;
  background:
    radial-gradient(480px 180px at 100% 0%,rgba(184,144,50,.12),transparent 70%),
    linear-gradient(135deg,#111823,#182231);
  border:1px solid #202b39;
  border-radius:14px;
  color:#fff;
  box-shadow:0 12px 32px rgba(15,23,42,.13);
  overflow:hidden;
}
.dashboard-hero .eyebrow{font-size:9px;letter-spacing:1.8px;color:#d7bc6e;font-weight:850}
.dashboard-hero h2{margin:6px 0 5px;font-size:22px;letter-spacing:-.5px}
.dashboard-hero p{margin:0;color:#aab6c6;font-size:11px;line-height:1.6}
.hero-metrics{display:flex;align-items:stretch;gap:9px;min-width:370px}
.hero-metric{
  min-width:165px;
  padding:12px 14px;
  border:1px solid rgba(255,255,255,.10);
  border-radius:10px;
  background:rgba(255,255,255,.045);
}
.hero-metric span{display:block;color:#95a2b4;font-size:8px;letter-spacing:1px;text-transform:uppercase}
.hero-metric b{display:block;margin-top:6px;color:#fff;font-size:17px}
.dashboard-quickstrip{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  margin-bottom:15px;
}
.quick-action{
  display:flex;
  align-items:center;
  gap:10px;
  min-height:54px;
  padding:10px 13px;
  border:1px solid #e0e5ec;
  border-radius:10px;
  background:#fff;
  text-align:left;
  transition:.18s ease;
}
.quick-action:hover{transform:translateY(-2px);border-color:#cdd5e0;box-shadow:0 7px 18px rgba(15,23,42,.06)}
.quick-action .qa-icon{
  width:30px;height:30px;border-radius:8px;display:grid;place-items:center;
  background:#f7edf2;color:#a80e4d;font-size:14px;flex:0 0 auto;
}
.quick-action b{display:block;color:#253041;font-size:10px}
.quick-action small{display:block;color:#7a8696;font-size:8px;margin-top:2px}
.dashboard-stats{
  grid-template-columns:repeat(4,1fr);
  gap:11px;
}
.dashboard-stats .stat{min-height:104px;padding:15px 16px}
.dashboard-stats .stat:nth-child(-n+4){
  min-height:126px;
  background:linear-gradient(180deg,#fff,#fbfcfd);
}
.dashboard-stats .stat:nth-child(-n+4)::after{
  content:"";
  position:absolute;right:14px;top:15px;
  width:24px;height:24px;border-radius:7px;
  background:linear-gradient(145deg,#fff8ea,#f8f2df);
  border:1px solid #eadfbe;
}
.dashboard-stats .stat:nth-child(1)::before{display:block;background:linear-gradient(90deg,#a80e4d,transparent)}
.dashboard-stats .stat:nth-child(2)::before{display:block;background:linear-gradient(90deg,#b89032,transparent)}
.dashboard-stats .stat:nth-child(3)::before{display:block;background:linear-gradient(90deg,#16865a,transparent)}
.dashboard-stats .stat:nth-child(4)::before{display:block;background:linear-gradient(90deg,#d28a18,transparent)}
.stat span{font-size:8px;letter-spacing:1.1px;color:#788394}
.stat b{font-size:22px;color:#182231;letter-spacing:-.45px}
.stat .accent{color:#a80e4d}
.stat small{font-size:8px;color:#8792a1}
.dashboard-main-grid{grid-template-columns:1.25fr .75fr;gap:12px;margin-top:14px}
.overview-grid{gap:8px}
.overview-item{background:#f8fafc;border:1px solid #e2e7ed;border-radius:8px;padding:11px}
.overview-item span{color:#788394;font-size:8px}
.overview-item b{color:#253041;font-size:14px}
.dashboard-analytics{
  display:grid;
  grid-template-columns:minmax(0,1.4fr) minmax(240px,.85fr) minmax(240px,.85fr);
  gap:12px;
  margin-top:14px;
}
.visual-card{min-height:224px;padding-bottom:14px}
.visual-card .visual-meta{color:#8994a3;font-size:8px;margin-top:3px}
.visual-card .card-headline{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.visual-card .card-headline h3{margin-bottom:2px}
.pulse-bars{
  height:148px;
  display:flex;
  align-items:flex-end;
  gap:9px;
  padding:16px 5px 20px;
  border-bottom:1px solid #edf0f4;
  margin-top:7px;
}
.pulse-bar{
  position:relative;
  flex:1;
  min-width:11px;
  max-width:54px;
  height:var(--h);
  background:linear-gradient(180deg,#c7a548,#a80e4d);
  border-radius:7px 7px 2px 2px;
  box-shadow:0 7px 15px rgba(168,14,77,.10);
  transition:height .4s ease,filter .18s ease;
}
.pulse-bar:hover{filter:brightness(1.08)}
.pulse-bar span{
  position:absolute;left:50%;bottom:-17px;transform:translateX(-50%);
  color:#8a94a2;font-size:7px;white-space:nowrap;
}
.activity-list,.alert-list{display:grid;gap:0;margin-top:7px}
.activity-row{
  display:flex;
  align-items:flex-start;
  gap:9px;
  padding:10px 0;
  border-bottom:1px solid #edf0f4;
}
.activity-row:last-child{border-bottom:0}
.activity-dot{width:7px;height:7px;margin-top:4px;background:#b89032;box-shadow:none}
.activity-row b{font-size:9px;color:#263243}
.activity-row small{font-size:8px;color:#8792a1;margin-top:2px}
.activity-row strong{font-size:8px;color:#4d5969}
.dashboard-section-head{margin-bottom:10px}
.dashboard-section-head h3{margin-bottom:3px}
.dashboard-section-head small{font-size:8px;color:#8792a1}
.recent{margin-top:14px}
.invoice-table-wrap{overflow:auto;border:1px solid #e5e9ef;border-radius:9px}
.dashboard-table{min-width:900px;background:#fff}
.dashboard-table th{
  background:#f8fafc;
  color:#7a8696;
  border-bottom:1px solid #dfe4eb;
  padding:10px 9px;
  font-size:7.5px;
  letter-spacing:.7px;
}
.dashboard-table td{border-bottom:1px solid #edf0f4;color:#3b4655;padding:10px 9px;font-size:9px}
.dashboard-table tbody tr:hover{background:#fbfaf6;transform:none}
.dashboard-table td:first-child b{color:#273244}
.status-pill{border:1px solid transparent}
.status-draft{background:#eef1f5;color:#667085}
.status-sent{background:#edf4ff;color:#2c67a9}
.status-paid{background:#e9f7ef;color:#16784b}
.status-partial{background:#fff5dc;color:#996d00}
.status-overdue{background:#fff0f2;color:#ae2537}
.due-item{padding:10px 0;border-bottom:1px solid #edf0f4}
.due-item b{font-size:9px;color:#2f3a4b}
.due-item small{font-size:8px}
.summary-lines>div{padding:9px 0;border-bottom:1px solid #edf0f4;font-size:9px}
.summary-lines span{color:#7a8696}
.summary-lines b{color:#2d3949}
.item,.saved{
  background:#fbfcfd;
  border-color:#e1e6ed;
}
.item:hover{border-color:#cfd7e2;box-shadow:0 5px 14px rgba(15,23,42,.05)}
input,textarea,select{
  background:#fff!important;
  color:#17202d!important;
  border:1px solid #d2d9e2!important;
  border-radius:8px!important;
}
input:hover,textarea:hover,select:hover{border-color:#bdc7d4!important}
input:focus,textarea:focus,select:focus{
  border-color:#b89032!important;
  box-shadow:0 0 0 3px rgba(184,144,50,.10)!important;
}
.theme-switcher{
  padding:3px;
  background:#f4f6f8;
  border:1px solid #d8dee7;
  box-shadow:none;
}
.theme-choice{
  color:#586577!important;
  min-width:38px!important;
  padding:7px 9px!important;
}
.theme-choice.active{
  background:#fff!important;
  color:#1c2431!important;
  box-shadow:0 2px 7px rgba(15,23,42,.08)!important;
  border-color:#d2d9e2!important;
}
@media(max-width:1150px){
  .hero-metrics{min-width:320px}
  .hero-metric{min-width:140px}
  .dashboard-analytics{grid-template-columns:1fr 1fr}
  .dashboard-analytics .visual-revenue{grid-column:1/-1}
}
@media(max-width:950px){
  .side{width:228px}
  .view{padding:18px}
  .dashboard-quickstrip{grid-template-columns:repeat(2,1fr)}
  .dashboard-main-grid{grid-template-columns:1fr}
  .hero-metrics{min-width:0;flex:0 0 auto}
}
@media(max-width:700px){
  .top{padding:11px 14px}
  .view{padding:14px 12px 24px}
  .dashboard-hero{flex-direction:column;padding:18px}
  .hero-metrics{width:100%;display:grid;grid-template-columns:1fr 1fr}
  .hero-metric{min-width:0}
  .dashboard-quickstrip{grid-template-columns:1fr 1fr}
  .dashboard-stats{grid-template-columns:1fr 1fr}
  .dashboard-analytics{grid-template-columns:1fr}
  .dashboard-analytics .visual-revenue{grid-column:auto}
  .dashboard-stats .stat:nth-child(-n+4){min-height:112px}
}
@media(max-width:480px){
  .dashboard-quickstrip,.dashboard-stats,.hero-metrics{grid-template-columns:1fr}
  .top .btn:not(.primary):not(.hamb){display:none}
  .dashboard-hero h2{font-size:18px}
}
@media(prefers-reduced-motion:reduce){
  .quick-action,.btn,.pulse-bar{transition:none!important}
}

/* Keep user-selected dark mode available while making Light mode the default presentation. */
[data-theme="dark"]{
  --bg:#0f141c;--panel:#151b24;--panel2:#1b222d;--border:#2a3442;--muted:#8b98a9;--text:#f5f7fa;
  --fbi-navy:#0c121a;
}
[data-theme="dark"] body{background:radial-gradient(760px 420px at 86% -10%,rgba(184,144,50,.10),transparent 58%),#0f141c;color:#f5f7fa}
[data-theme="dark"] .main{background:transparent}
[data-theme="dark"] .top{background:rgba(15,20,28,.94);border-color:#2a3442}
[data-theme="dark"] .top h1{color:#fff}
[data-theme="dark"] .top small{color:#8b98a9}
[data-theme="dark"] .btn,[data-theme="dark"] .quick-action,[data-theme="dark"] .card,[data-theme="dark"] .stat{background:#151b24;color:#f5f7fa;border-color:#2a3442}
[data-theme="dark"] .dashboard-hero{background:linear-gradient(135deg,#0c121a,#18212c);border-color:#263242}
[data-theme="dark"] .quick-action b,[data-theme="dark"] .stat b,[data-theme="dark"] .overview-item b,[data-theme="dark"] .dashboard-table td,[data-theme="dark"] .summary-lines b,[data-theme="dark"] .activity-row b{color:#eef2f7}
[data-theme="dark"] .quick-action small,[data-theme="dark"] .stat small,[data-theme="dark"] .overview-item span,[data-theme="dark"] .dashboard-section-head small,[data-theme="dark"] .activity-row small,[data-theme="dark"] .summary-lines span{color:#8b98a9}
[data-theme="dark"] input,[data-theme="dark"] textarea,[data-theme="dark"] select{background:#0d131b!important;color:#eef2f7!important;border-color:#2a3442!important}
[data-theme="dark"] .overview-item,[data-theme="dark"] .item,[data-theme="dark"] .saved,[data-theme="dark"] .dashboard-table th{background:#111821;border-color:#2a3442}
[data-theme="dark"] .dashboard-table td{border-color:#27303c}
[data-theme="dark"] .invoice-table-wrap{border-color:#2a3442}
[data-theme="dark"] .theme-switcher{background:#111821;border-color:#303a48}
[data-theme="dark"] .theme-choice.active{background:#1b222d!important;color:#fff!important;border-color:#3a4656!important}



/* ===== FBI ACCOUNTING DASHBOARD — CLEAN WORKSPACE PASS ===== */
/* This pass is presentation-only. Existing IDs, handlers, storage and data flows remain untouched. */
body{font-size:13px}
.side{width:228px}
.brand{min-height:72px;padding:18px 17px}
.nav .nav-link{padding:10px 13px;font-size:11.5px}
.top{min-height:68px;padding:10px 22px}
.view{padding:22px 24px 34px;max-width:1480px}
.dashboard-hero{
  margin-bottom:12px;padding:18px 20px;border-radius:12px;
  background:linear-gradient(135deg,#ffffff,#f7f9fc);
  border:1px solid #dfe4eb;color:#17202d;
  box-shadow:0 6px 20px rgba(15,23,42,.045);
}
.dashboard-hero .eyebrow{color:#9a7927;font-size:8px;letter-spacing:1.5px}
.dashboard-hero h2{font-size:19px;margin:5px 0 3px;color:#17202d}
.dashboard-hero p{color:#748093;font-size:10px}
.hero-metrics{min-width:320px;gap:8px}
.hero-metric{min-width:145px;padding:10px 12px;background:#fff;border:1px solid #e3e7ed}
.hero-metric span{color:#7b8797}
.hero-metric b{color:#17202d;font-size:15px}
.dashboard-quickstrip{grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-bottom:12px}
.quick-action{min-height:50px;padding:9px 11px}
.quick-action .qa-icon{width:28px;height:28px}
.dashboard-stats{grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}
.dashboard-stats .stat:nth-child(-n+4){min-height:112px;padding:14px}
.dashboard-stats .stat:nth-child(n+5){min-height:86px;padding:13px 14px}
.dashboard-stats .stat b{font-size:20px}
.dashboard-analytics{grid-template-columns:minmax(0,1.35fr) minmax(240px,.82fr) minmax(240px,.82fr);gap:10px;margin-top:12px}
.visual-card{min-height:214px;padding:14px 15px}
.visual-card h3{font-size:9.5px}
.pulse-bars{height:140px;gap:7px;padding:13px 4px 20px}
.pulse-bar{background:linear-gradient(180deg,#c8a94f 0%,#b89032 45%,#a80e4d 100%);border-radius:6px 6px 2px 2px;box-shadow:0 5px 12px rgba(168,14,77,.08)}
.activity-row{padding:9px 0}
.activity-dot{width:6px;height:6px}
.dashboard-main-grid{margin-top:12px;gap:10px}
.dashboard-main-grid .card,.recent,.grid2 .card{padding:14px}
.overview-grid{grid-template-columns:repeat(4,1fr);gap:7px}
.overview-item{padding:9px}
.overview-item b{font-size:13px}
.dashboard-table th{padding:9px 8px}
.dashboard-table td{padding:9px 8px}
.report-toolbar{margin:8px 0 10px}
.report-toolbar .primary{min-height:34px}
@media(max-width:1150px){
  .dashboard-stats{grid-template-columns:repeat(2,1fr)}
  .dashboard-analytics{grid-template-columns:1fr 1fr}
  .dashboard-analytics .visual-revenue{grid-column:1/-1}
}
@media(max-width:900px){
  .side{width:228px}
  .dashboard-quickstrip{grid-template-columns:repeat(2,1fr)}
  .dashboard-main-grid{grid-template-columns:1fr}
  .overview-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:700px){
  .view{padding:14px 12px 24px}
  .dashboard-hero{padding:16px;gap:12px}
  .hero-metrics{width:100%;display:grid;grid-template-columns:1fr 1fr;min-width:0}
  .dashboard-analytics{grid-template-columns:1fr}
  .dashboard-analytics .visual-revenue{grid-column:auto}
}
@media(max-width:480px){
  .dashboard-quickstrip,.dashboard-stats,.hero-metrics{grid-template-columns:1fr}
  .overview-grid{grid-template-columns:1fr 1fr}
}

