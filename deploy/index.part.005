const DEFAULT_FBI_LOGO="data:image/svg+xml,%3Csvg xmlns='http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg' viewBox='0 0 240 90'%3E%3Crect width='240' height='90' rx='14' fill='%2308090c'/%3E%3Ctext x='120' y='57' text-anchor='middle' font-family='Arial' font-size='48' font-weight='900' fill='white'%3EFBI%3C%2Ftext%3E%3C%2Fsvg%3E";

function init(skipNewInvoice=false,preloaded=null){
  const d=preloaded||readPersistentPayloadSync()||{};
  data=Array.isArray(d.data)?d.data:[];
  clients=Array.isArray(d.clients)?d.clients:[];
  settings={
    biz:"FILM BEYOND IMAGINATION (FBI)",owner:"Jerbel Mark Addeh",baddr:"Dome, Accra",bphone:"0257407350",bemail:"filmbfbi@gmail.com",bnum:"0257407350",
    logo:DEFAULT_FBI_LOGO,template:100,
    defaultPay:`Bank Name: Cal Bank
Account Name: FILM BEYOND IMAGINATION (FBI)
Account Number: 1400010238562
Branch: Dansoman

Momo service Name: MTN
Momo Number: 0257407350
Account Name: Jerbel Mark Addeh`,
    waEnabled:"yes",waRecipient:"233257407350",waApiUrl:"/api/whatsapp/invoice-created",waTemplate:"hello_world",waLanguage:"en_US",waEvent:"created",
    ...(d.settings||{})
  };
  if(!settings.logo)settings.logo=DEFAULT_FBI_LOGO;
  normalizePaymentSettings();
  ["biz","owner","baddr","bphone","bemail","bnum","defaultPay"].forEach(k=>{if($(k))$(k).value=settings[k]||""});
  if($("waEnabled"))$("waEnabled").value=settings.waEnabled||"yes";
  if($("waRecipient"))$("waRecipient").value=settings.waRecipient||"233257407350";
  if($("waApiUrl"))$("waApiUrl").value=settings.waApiUrl||"/api/whatsapp/invoice-created";
  if($("waTemplate"))$("waTemplate").value=settings.waTemplate||"hello_world";
  if($("waLanguage"))$("waLanguage").value=settings.waLanguage||"en_US";
  if($("waEvent"))$("waEvent").value=settings.waEvent||"created";
  document.querySelectorAll("[data-template-card]").forEach(c=>c.onclick=()=>{const map={classic:1,modern:2,minimal:3,bold:4,elegant:5};const v=map[c.dataset.templateCard]||1;setTemplate(v);$("template").value=String(v)});
  if(!skipNewInvoice) newInvoice();
  populateClientSelect();renderClients();dashboard();
}
function nextInvoiceSequence(){
  let maxSaved=0;
  data.forEach(x=>{
    const m=String(x.no||"").match(/(\d+)$/);
    if(m)maxSaved=Math.max(maxSaved,parseInt(m[1],10)||0);
  });
  const storedNext=Math.max(1,Number(settings.invoiceSequence)||1);
  const next=Math.max(storedNext,maxSaved+1);
  settings.invoiceSequence=next;
  return next;
}
function nextInvoiceNumber(){return "INV"+String(nextInvoiceSequence()).padStart(4,"0")}
function validateMediaEventDate(invoice,focus=true){
  if(!isMediaServiceCategory(invoice?.category))return true;
  const start=String(invoice?.eventDate||"").trim();
  const end=String(invoice?.eventEndDate||invoice?.eventDate||"").trim();
  if(!start){
    toggleEventDate();
    toast("Event Start Date is required for media invoices");
    if(focus)$("eventDate")?.focus();
    return false;
  }
  if(!end){
    toggleEventDate();
    toast("Event End Date is required for media invoices");
    if(focus)$("eventEndDate")?.focus();
    return false;
  }
  if(end<start){
    toggleEventDate();
    toast("Event End Date cannot be before the start date");
    if(focus)$("eventEndDate")?.focus();
    return false;
  }
  return true;
}
function setTemplate(v){settings.template=v;document.querySelectorAll("[data-template-card]").forEach(c=>c.classList.toggle("selected",c.dataset.templateCard===v));persist()}
const IT_SERVICE_CATEGORIES=["Networking","CCTV","Smart Home Automation"];
function isMediaServiceCategory(category){
  const c=String(category||"").trim();
  if(!c)return false;
  return !IT_SERVICE_CATEGORIES.includes(c);
}
function toggleEventDate(){
  const category=$("serviceCategory")?.value||"";
  const show=isMediaServiceCategory(category);
  const card=$("eventDateCard");
  if(card)card.style.display=show?"block":"none";
  const start=$("eventDate");
  const end=$("eventEndDate");
  if(start)start.required=show;
  if(end)end.required=show;
  if(end&&start&&start.value&&!end.value)end.value=start.value;
  const hint=$("eventDateHint");
  if(hint)hint.textContent=show?"Required for media invoices: enter the event start and end dates for "+category+".":"No event date is required for IT invoices.";
}
function clearEventDate(){
  if($("eventDate"))$("eventDate").value="";
  if($("eventEndDate"))$("eventEndDate").value="";
}
function syncEventEndDate(){
  const start=$("eventDate"),end=$("eventEndDate");
  if(start&&end&&start.value&&!end.value)end.value=start.value;
  toggleEventDate();
}
function toggleRentalDetails(){const isRental=$("serviceCategory")?.value==="Equipment Rentals";const el=$("rentalDetailsCard");if(el)el.style.display=isRental?"block":"none";}
function clearRentalDetails(){["rentalStart","rentalEnd","jobLocation","rentalRef"].forEach(id=>{if($(id))$(id).value=""});if($("rentalUnit"))$("rentalUnit").value="Per Day";if($("deposit"))$("deposit").value=0;}
function nextReceiptNumber(){let max=0;data.forEach(x=>{let m=String(x.receiptNo||"").match(/(\d+)$/);if(m)max=Math.max(max,parseInt(m[1],10)||0)});return "REC"+String(max+1).padStart(4,"0")}
$("eventDate")?.addEventListener("change",syncEventEndDate);
$("eventEndDate")?.addEventListener("change",toggleEventDate);
function paymentTotals(x){const total=Number(x.total||0),paid=Math.max(0,Number(x.amountPaid||0));return{total,paid,balance:Math.max(0,total-paid)}}
function updatePaymentBalancePreview(totalOverride){const el=$("paymentBalancePreview");if(!el)return;let total=Number(totalOverride);if(!Number.isFinite(total)){let sub=0;document.querySelectorAll(".item").forEach(r=>{let q=+r.querySelector(".qty").value||0,p=+r.querySelector(".rate").value||0;sub+=q*p});let dis=+$("discount").value||0,tax=Math.max(0,sub-dis)*(+$("tax").value||0)/100;total=Math.max(0,sub-dis)+tax}const paid=Math.max(0,Number($("amountPaid")?.value||0));el.textContent=fmtMoney(Math.max(0,total-paid),$("cur")?.value||"GHS")}
function renderReceipts(){const el=$("receiptList");if(!el)return;const list=data.filter(x=>Number(x.amountPaid||0)>0).sort((a,b)=>String(b.paymentDate||b.date||"").localeCompare(String(a.paymentDate||a.date||"")));if(!list.length){el.innerHTML='<div class="receipt-empty">No payment receipts have been recorded yet. Record a payment on an invoice to generate the first receipt.</div>';return}el.innerHTML=list.map(x=>{const p=paymentTotals(x),full=p.balance<=0.005;return `<div class="receipt-row"><div class="grow"><div class="main">${esc(x.receiptNo||"—")} · ${esc(x.no||"")}</div><div class="meta">${esc(x.client||"No client")} · ${esc(x.paymentDate||x.date||"—")} · ${esc(x.paymentMethod||"Payment")}</div></div><div class="amount">${fmtMoney(p.paid,x.cur)}</div><span class="status-pill ${full?"status-paid":"status-partial"}">${full?"Paid in Full":"Partial Payment"}</span><button class="btn" onclick="showReceipt('${x.id}')">View</button><button class="btn primary" onclick="showReceipt('${x.id}');setTimeout(printReceipt,30)">Print</button></div>`}).join("")}
async function recordPayment(){
  const total=Number(calc().total||0),paid=Math.max(0,Number($("amountPaid")?.value||0));
  if(paid<=0){alert("Enter the amount received before generating a receipt.");return}
  if(paid>total+0.005){alert("Amount paid cannot be greater than the invoice total.");return}
  if(!$("paymentDate").value)$("paymentDate").value=new Date().toISOString().slice(0,10);
  if(!$("receiptNo").value){
    try{$("receiptNo").value=await gsRun_("getNextReceiptNumber")}catch(e){$("receiptNo").value=nextReceiptNumber()}
  }
  $("status").value=paid>=total-0.005?"Paid":"Partially Paid";
  const savedInvoice=await save();
  if(!savedInvoice)return;
  await showReceipt(current?.id);
}
function showReceipt(id){const x=data.find(a=>a.id===id)||current;if(!x||Number(x.amountPaid||0)<=0){toast("Record a payment before generating a receipt");return}current=x;if(!x.receiptNo){x.receiptNo=nextReceiptNumber();persist()}renderReceipt(x);document.querySelectorAll(".view").forEach(v=>v.classList.remove("active","print-view"));$("view-receipt-preview").classList.add("active");$("side").classList.remove("open")}
function renderReceipt(x){const s=settings,p=paymentTotals(x),full=p.balance<=0.005,logo=s.logo?`<div class="receipt-logo" style="background-image:url('${s.logo}')"></div>`:`<div class="receipt-logo"></div>`;const rows=(x.items||[]).map(i=>`<tr><td>${esc(i.desc)}</td><td>${i.qty}</td><td>${esc(money(i.qty*i.rate))}</td></tr>`).join("");const statusLabel=full?"PAID IN FULL":"PARTIAL PAYMENT";$("receiptPaper").innerHTML=`<div class="receipt-header"><div class="receipt-brand">${logo}<div class="receipt-biz"><h2>${esc(s.biz||"FILM BEYOND IMAGINATION (FBI)")}</h2><div>${s.owner?esc(s.owner)+"<br>":""}${esc(s.baddr||"")}<br>${esc(s.bphone||"")} · ${esc(s.bemail||"")}</div></div></div><div class="receipt-meta"><div class="label">Receipt Number</div><div class="receipt-no">${esc(x.receiptNo||nextReceiptNumber())}</div><div class="label">Payment Date</div><div class="date">${esc(x.paymentDate||new Date().toISOString().slice(0,10))}</div></div></div><div class="receipt-title">OFFICIAL PAYMENT RECEIPT</div><span class="receipt-paid-badge ${full?"":"partial"}">${statusLabel}</span><div class="receipt-grid"><div class="receipt-info"><div class="k">Received From</div><div class="v">${esc(x.client||"Client")}<br>${esc(x.clientAddress||"")}<br>${esc(x.clientPhone||"")}${x.clientEmail?" · "+esc(x.clientEmail):""}</div></div><div class="receipt-info"><div class="k">Reference</div><div class="v">Invoice: ${esc(x.no||"—")}<br>Payment Method: ${esc(x.paymentMethod||"—")}<br>Transaction Ref: ${esc(x.transactionRef||"—")}</div></div></div><table class="receipt-items"><thead><tr><th>Description</th><th>Qty</th><th>Amount</th></tr></thead><tbody>${rows||`<tr><td>Invoice payment</td><td>1</td><td>${esc(fmtMoney(p.paid,x.cur))}</td></tr>`}</tbody></table><div class="receipt-total"><div class="receipt-total-box"><div class="receipt-total-line"><span>Invoice Total</span><b>${esc(fmtMoney(p.total,x.cur))}</b></div><div class="receipt-total-line"><span>Amount Received</span><b>${esc(fmtMoney(p.paid,x.cur))}</b></div><div class="receipt-total-line total"><span>RECEIVED</span><b>${esc(fmtMoney(p.paid,x.cur))}</b></div><div class="receipt-total-line balance"><span>Balance Remaining</span><b>${esc(fmtMoney(p.balance,x.cur))}</b></div></div></div><div class="receipt-note">Received with thanks. This receipt acknowledges payment made against the referenced invoice. ${x.notes?esc(x.notes):"Thank you for your business."}</div><div class="receipt-sign"><div class="line">Customer / Payer</div><div class="line">Received By${x.receivedBy?": "+esc(x.receivedBy):""}</div></div><div class="receipt-footer"><b>Receipt Record</b><br>Receipt ${esc(x.receiptNo||"")} · Invoice ${esc(x.no||"")} · ${esc(statusLabel)}<br>This document is a payment receipt. It is not a GRA E-VAT receipt unless issued through a GRA-certified invoicing system.</div>`}
function openDocumentPrint(element, title, pageCss){
  if(!element){throw new Error("Document preview is empty")};
  const popup=window.open("about:blank","_blank","width=1100,height=900");
  if(!popup){toast("Please allow pop-ups for this app so the invoice can be printed.");return false;}
  const styles=Array.from(document.querySelectorAll("style")).map(s=>s.textContent).join("\n");
  const links=Array.from(document.querySelectorAll('link[rel="stylesheet"]')).map(l=>l.outerHTML).join("\n");
  popup.document.open();
  popup.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>${String(title||"Document").replace(/[<>]/g,"")}</title>${links}<style>${styles}\n@page{${pageCss||"size:A4 portrait;margin:0"}}html,body{margin:0!important;padding:0!important;background:#fff!important;display:block!important;min-height:0!important}body{color:#111!important}.print-root{width:100%;margin:0!important;padding:0!important;background:#fff!important}.paper,.receipt-paper{box-shadow:none!important;margin:0 auto!important}.no-print{display:none!important}</style></head><body><div class="print-root">${element.outerHTML}</div></body></html>`);
  popup.document.close();
  popup.focus();
  setTimeout(()=>{try{popup.print()}catch(e){}},350);
  popup.onafterprint=()=>setTimeout(()=>{try{popup.close()}catch(e){}},250);
  return true;
}

async function printReceipt(){
  if(!current){toast("No receipt selected");return}
  try{
    renderReceipt(current);
    persist();
    openDocumentPrint($("receiptPaper"),"Official Receipt "+(current.receiptNo||""),"size:A5 portrait;margin:0");
  }catch(e){console.error(e);toast("Receipt print failed: "+e.message)}
}
let invoiceNumberReserved="";
function reserveInvoiceNumberClient(){
  invoiceNumberReserved=nextInvoiceNumber();
  if(!current&&$("no"))$("no").value=invoiceNumberReserved;
  return invoiceNumberReserved;
}
function newInvoice(){
  clearPersistentDraft();
  current=null;invoiceNumberReserved="";initTemplates();$("template").value="100";initServiceCatalog();
  const nextNo=nextInvoiceNumber();
  $("no").value=nextNo;
  $("date").value=new Date().toISOString().slice(0,10);$("due").value="On Receipt";$("status").value="Draft";$("cur").value="GHS";
  $("template").value=String(settings.template||100);$("client").value="";$("clientAddress").value="";$("clientPhone").value="";$("clientEmail").value="";
  if($("clientSelect"))$("clientSelect").value="";$("tax").value=20;$("discount").value=0;$("payment").value=settings.defaultPay;$("notes").value="";
  $("vatInclusive").checked=true;$("amountPaid").value=0;$("paymentDate").value="";$("paymentMethod").value="Mobile Money";$("transactionRef").value="";$("receivedBy").value="";$("receiptNo").value="";
  $("items").innerHTML="";addItem("",1,0);setTemplate($("template").value);clearRentalDetails();clearEventDate();toggleRentalDetails();toggleEventDate();show("create");updatePaymentBalancePreview();
}
function addItem(desc="",qty=1,rate=0,days=1){let d=document.createElement("div");d.className="item";d.innerHTML=`<div><input class="desc" list="itemOptions" placeholder="Description" value="${esc(desc)}"></div><div><input class="rate" type="number" min="0" step=".01" value="${rate}"></div><div><input class="days" type="number" min="1" step="1" value="${days||1}"></div><div><input class="qty" type="number" min="0" step=".01" value="${qty}"></div><div><input class="amt" readonly value="${money((Number(qty)||0)*(Number(rate)||0)*(Number(days)||1))}"></div><button class="rm" onclick="this.parentElement.remove();calc()">✕</button>`;$("items").appendChild(d);d.querySelectorAll("input").forEach(i=>i.oninput=calc);calc()}
function calc(){let sub=0;document.querySelectorAll(".item").forEach(r=>{let q=+r.querySelector(".qty").value||0,p=+r.querySelector(".rate").value||0,d=Math.max(1,+r.querySelector(".days")?.value||1),a=q*p*d;sub+=a;r.querySelector(".amt").value=money(a)});let dis=+$("discount").value||0,tax=Math.max(0,sub-dis)*(+$("tax").value||0)/100,total=Math.max(0,sub-dis)+tax;$("total").textContent=money(total);updatePaymentBalancePreview(total);return{sub,dis,tax,total}}
function get(){let c=calc();let paid=Math.max(0,Number($("amountPaid")?.value||0));if($("status")?.value==="Paid")paid=c.total;if(paid>0.005&&paid<c.total-0.005)$("status").value="Partially Paid";if(paid>=c.total-0.005&&c.total>0)$("status").value="Paid";let receiptNo=$("receiptNo")?.value||current?.receiptNo||"";if(paid>0.005&&!receiptNo)receiptNo=nextReceiptNumber();return{id:current?.id||("av-"+Date.now()+"-"+Math.random().toString(36).slice(2,10)),no:$("no").value,date:$("date").value,due:$("due").value,status:$("status").value,cur:$("cur").value,template:$("template").value||settings.template||"classic",client:$("client").value,clientAddress:$("clientAddress").value,clientPhone:$("clientPhone").value,clientEmail:$("clientEmail").value,items:[...document.querySelectorAll(".item")].map(r=>({desc:r.querySelector(".desc").value,qty:+r.querySelector(".qty").value||0,rate:+r.querySelector(".rate").value||0,days:Math.max(1,+r.querySelector(".days")?.value||1)})).filter(x=>x.desc),taxRate:+$("tax").value||0,discount:+$("discount").value||0,vatInclusive:$("vatInclusive").checked,...c,payment:$("payment").value,notes:$("notes").value,template:selectedTemplate(),category:$("serviceCategory")?.value||"Media Works",serviceBrand:$("brandModelFilter")?.value||"",serviceItem:$("catalogItemSelect")?.value||$("itemSearch")?.value||"",eventDate:$("eventDate")?.value||"",eventEndDate:$("eventEndDate")?.value||$("eventDate")?.value||"",rentalStart:$("rentalStart")?.value||"",rentalEnd:$("rentalEnd")?.value||"",jobLocation:$("jobLocation")?.value||"",rentalRef:$("rentalRef")?.value||"",rentalUnit:$("rentalUnit")?.value||"Per Day",deposit:+($("deposit")?.value||0),amountPaid:paid,paymentDate:$("paymentDate")?.value||"",paymentMethod:$("paymentMethod")?.value||"",transactionRef:$("transactionRef")?.value||"",receivedBy:$("receivedBy")?.value||"",receiptNo}}
async function save(){
  try{
    let x=get();
    if(!validateMediaEventDate(x))return null;
    let i=data.findIndex(a=>a.id===x.id),isNew=i<0;
    if(isNew){
      let seq=nextInvoiceSequence();
      let candidate="INV"+String(seq).padStart(4,"0");
      while(data.some(a=>String(a.no)===candidate)){
        seq++;
        settings.invoiceSequence=seq;
        candidate="INV"+String(seq).padStart(4,"0");
      }
      x.no=candidate;
      settings.invoiceSequence=seq+1;
    }
    $("no").value=x.no;invoiceNumberReserved=x.no;
    if(i>=0)data[i]=x;else data.unshift(x);
    current=x;
    const localOk=await persist();
    if(localOk)clearPersistentDraft();
    dashboard();renderSaved();renderReceipts();
    toast(localOk?"Invoice saved":"Invoice could not be saved");
    if(isNew && settings.waEnabled==="yes"){try{await sendWhatsAppNotification(x)}catch(e){console.warn("WhatsApp notification failed",e)}}
    return x;
  }catch(err){console.error(err);toast("Invoice could not be saved: "+err.message);throw err}
}
function restoreServiceSelection(x){
  try{
    initServiceCatalog();
    const cat=$("serviceCategory"),brand=$("brandModelFilter"),search=$("itemSearch"),item=$("catalogItemSelect");
    if(cat&&x.category){cat.value=x.category;cat.dispatchEvent(new Event("change"));}
    if(brand&&x.serviceBrand){brand.value=x.serviceBrand;brand.dispatchEvent(new Event("change"));}
    if(search&&x.serviceItem){search.value=x.serviceItem;search.dispatchEvent(new Event("input"));}
    if(item&&x.serviceItem){const opts=[...item.options];const match=opts.find(o=>o.value.toLowerCase()===String(x.serviceItem).toLowerCase());if(match)item.value=match.value;}
    toggleEventDate();toggleRentalDetails();
  }catch(e){console.warn("Service selection restore failed",e)}
}
function loadInvoice(id){
  clearPersistentDraft();
  let x=data.find(a=>a.id===id);if(!x)return;current=x;invoiceNumberReserved=x.no||"";
  ["no","date","due","status","cur","client","clientAddress","clientPhone","clientEmail","tax","discount","payment","notes"].forEach(k=>$(k).value=x[{no:"no",date:"date",due:"due",status:"status",cur:"cur",client:"client",clientAddress:"clientAddress",clientPhone:"clientPhone",clientEmail:"clientEmail",tax:"taxRate",discount:"discount",payment:"payment",notes:"notes"}[k]]??"");
  $("template").value=String(Number(x.template)||100);$("vatInclusive").checked=x.vatInclusive!==false;$("amountPaid").value=Number(x.amountPaid||0);$("paymentDate").value=x.paymentDate||"";$("paymentMethod").value=x.paymentMethod||"Mobile Money";$("transactionRef").value=x.transactionRef||"";$("receivedBy").value=x.receivedBy||"";$("receiptNo").value=x.receiptNo||"";
  $("eventDate").value=x.eventDate||"";$("eventEndDate").value=x.eventEndDate||x.eventDate||"";$("rentalStart").value=x.rentalStart||"";$("rentalEnd").value=x.rentalEnd||"";$("jobLocation").value=x.jobLocation||"";$("rentalRef").value=x.rentalRef||"";$("rentalUnit").value=x.rentalUnit||"Per Day";$("deposit").value=x.deposit||0;
  if($("payment") && !String(x.payment||"").trim())$("payment").value=settings.defaultPay||"";
  setTemplate($("template").value);$("items").innerHTML="";(x.items||[]).forEach(a=>addItem(a.desc,a.qty,a.rate));initTemplates();$("template").value=String(Number(x.template)||100);
  restoreServiceSelection(x);show("create");populateClientSelect();if($("clientSelect"))$("clientSelect").value=(clients.find(c=>c.name===x.client)||{}).id||"";updatePaymentBalancePreview();
}
function populateClientSelect(){const sel=$("clientSelect");if(!sel)return;const current=sel.value;sel.innerHTML='<option value="">— New / Manual Client —</option>'+clients.slice().sort((a,b)=>a.name.localeCompare(b.name)).map(c=>`<option value="${esc(c.id)}">${esc(c.name)}${c.phone?" · "+esc(c.phone):""}</option>`).join("");if(current)sel.value=current}
function applySelectedClient(){const id=$("clientSelect")?.value;if(!id)return;const c=clients.find(x=>x.id===id);if(!c)return;$("client").value=c.name||"";$("clientAddress").value=c.address||"";$("clientPhone").value=c.phone||"";$("clientEmail").value=c.email||""}
function saveCurrentClient(){const name=$("client").value.trim();if(!name){toast("Enter a client name first");return}let c=clients.find(x=>x.name.toLowerCase()===name.toLowerCase());if(c){c.phone=$("clientPhone").value.trim();c.email=$("clientEmail").value.trim();c.address=$("clientAddress").value.trim()}else{c={id:("av-"+Date.now()+"-"+Math.random().toString(36).slice(2,10)),name,phone:$("clientPhone").value.trim(),email:$("clientEmail").value.trim(),address:$("clientAddress").value.trim(),notes:"",createdAt:new Date().toISOString()};clients.unshift(c)}persist();populateClientSelect();$("clientSelect").value=c.id;toast("Client saved to database")}
function clearClientForm(){$("clientId").value="";$("dbClientName").value="";$("dbClientPhone").value="";$("dbClientEmail").value="";$("dbClientAddress").value="";$("dbClientNotes").value="";$("clientFormTitle").textContent="Add Client"}
function saveClient(){const name=$("dbClientName").value.trim();if(!name){toast("Client name is required");return}const id=$("clientId").value;let c=id?clients.find(x=>x.id===id):null;if(!c){c={id:("av-"+Date.now()+"-"+Math.random().toString(36).slice(2,10)),createdAt:new Date().toISOString()};clients.unshift(c)}c.name=name;c.phone=$("dbClientPhone").value.trim();c.email=$("dbClientEmail").value.trim();c.address=$("dbClientAddress").value.trim();c.notes=$("dbClientNotes").value.trim();persist();clearClientForm();populateClientSelect();renderClients();toast("Client saved")}
function editClient(id){const c=clients.find(x=>x.id===id);if(!c)return;$("clientId").value=c.id;$("dbClientName").value=c.name||"";$("dbClientPhone").value=c.phone||"";$("dbClientEmail").value=c.email||"";$("dbClientAddress").value=c.address||"";$("dbClientNotes").value=c.notes||"";$("clientFormTitle").textContent="Edit Client";show("clients")}
function deleteClient(id){
  if(!confirm("Delete this client from the database? Existing invoices will remain unchanged."))return;
  const target=clients.find(x=>x.id===id);
  const deleteId=target?.id||id;
  clients=clients.filter(x=>x.id!==id);
  if(deleteId)pendingClientDeletes.push(String(deleteId));
  persist();
  populateClientSelect();
  renderClients();
  toast("Client deleted")
}
function useClient(id){const c=clients.find(x=>x.id===id);if(!c)return;newInvoice();$("client").value=c.name||"";$("clientAddress").value=c.address||"";$("clientPhone").value=c.phone||"";$("clientEmail").value=c.email||"";$("clientSelect").value=c.id;show("create")}
function parseCsvLine(line){
  const out=[];let cur="",quoted=false;
  for(let i=0;i<line.length;i++){const ch=line[i];if(ch==='"'){if(quoted&&line[i+1]==='"'){cur+='"';i++;}else quoted=!quoted;}else if(ch===','&&!quoted){out.push(cur.trim());cur="";}else cur+=ch;}
  out.push(cur.trim());return out;
}
function importClientsFile(evt){
  const f=evt.target.files&&evt.target.files[0];if(!f)return;
  const status=$("clientImportStatus");if(status)status.textContent="Reading "+f.name+"…";
  const reader=new FileReader();reader.onload=async e=>{
    try{
      const text=String(e.target.result||"");let rows=[];
      if(f.name.toLowerCase().endsWith(".json")){
        const raw=JSON.parse(text);rows=Array.isArray(raw)?raw:(Array.isArray(raw.clients)?raw.clients:[]);
      }else{
        const lines=text.replace(/^\uFEFF/,"").split(/\r?\n/).filter(x=>x.trim());if(!lines.length)throw new Error("The file is empty.");
        const headers=parseCsvLine(lines.shift()).map(h=>h.toLowerCase().replace(/[^a-z0-9]/g,""));
        const idx=k=>{const aliases={name:["name","clientname","company","companyname"],phone:["phone","phonenumber","mobile","contact"],email:["email","emailaddress"],address:["address","clientaddress"],notes:["notes","note"]}[k]||[k];return headers.findIndex(h=>aliases.includes(h))};
        const ix={name:idx("name"),phone:idx("phone"),email:idx("email"),address:idx("address"),notes:idx("notes")};
        rows=lines.map(line=>{const a=parseCsvLine(line);return{name:ix.name>=0?a[ix.name]:"",phone:ix.phone>=0?a[ix.phone]:"",email:ix.email>=0?a[ix.email]:"",address:ix.address>=0?a[ix.address]:"",notes:ix.notes>=0?a[ix.notes]:""}});
      }
      let added=0,updated=0;
      rows.forEach(r=>{const name=String(r.name||r.client||r.company||"").trim();if(!name)return;let c=clients.find(x=>String(x.name||"").toLowerCase()===name.toLowerCase());if(!c){c={id:"av-"+Date.now()+"-"+Math.random().toString(36).slice(2,10),createdAt:new Date().toISOString()};clients.unshift(c);added++;}else updated++;c.name=name;c.phone=String(r.phone||"").trim();c.email=String(r.email||"").trim();c.address=String(r.address||"").trim();c.notes=String(r.notes||"").trim();});
      await persist();populateClientSelect();renderClients();if(status)status.textContent=`Imported ${added} new clients and updated ${updated} existing clients.`;toast("Client data imported");
    }catch(err){console.error(err);if(status)status.textContent="Import failed: "+err.message;toast("Client import failed: "+err.message)}finally{evt.target.value=""}
  };reader.readAsText(f);
}

function renderClients(){
  const el=$("clientList");if(!el)return;
  const q=$("clientSearch")?.value||"";
  const qq=String(q).trim().toLowerCase();
  const list=clients.filter(c=>[c.name,c.phone,c.email,c.address].join(" ").toLowerCase().includes(qq)).sort((a,b)=>a.name.localeCompare(b.name));
  el.innerHTML=list.length?list.map(c=>`<div class="saved" style="align-items:flex-start"><div class="grow"><div style="font-weight:900">${esc(c.name)}</div><div class="meta">${esc(c.phone||"")}${c.email?" · "+esc(c.email):""}</div><div class="meta">${esc(c.address||"")}</div></div><button type="button" class="btn" data-client-action="use" data-client-id="${esc(c.id)}">Use</button><button type="button" class="btn" data-client-action="edit" data-client-id="${esc(c.id)}">Edit</button><button type="button" class="btn danger" data-client-action="delete" data-client-id="${esc(c.id)}">Delete</button></div>`).join(""):'<div style="color:#777;text-align:center;padding:20px">No clients found.</div>';
  el.onclick=function(e){
    const btn=e.target.closest("button[data-client-action][data-client-id]");
    if(!btn)return;
    e.preventDefault();e.stopPropagation();
    const id=btn.getAttribute("data-client-id");
    const action=btn.getAttribute("data-client-action");
    if(action==="use")useClient(id);
    else if(action==="edit")editClient(id);
    else if(action==="delete")deleteClient(id);
  };
}

function del(id){if(confirm("Delete this invoice?")){const target=data.find(x=>x.id===id);const deleteId=target?.id||target?.no||id;data=data.filter(x=>x.id!==id);if(deleteId)pendingInvoiceDeletes.push(String(deleteId));persist();renderSaved();dashboard();toast("Invoice deleted")}}
function renderSaved(){
  const el=$("saved");if(!el)return;
  el.innerHTML=data.length?data.map(x=>{
    const js=String(x.jobStatus||"Not Started")==="Done"?"Completed":String(x.jobStatus||"Not Started");
    const opts=["Not Started","Scheduled","In Progress","Completed","Cancelled"].map(s=>`<option value="${esc(s)}" ${js===s?"selected":""}>${esc(s)}</option>`).join("");
    return `<div class="saved" data-invoice-row="${esc(x.id)}" style="align-items:center;flex-wrap:wrap">
      <span class="grow">${esc(x.no)} <span class="meta">${esc(x.client||"No client")} · ${esc(x.status)}</span></span>
      <b>${x.cur}₵${Number(x.total||0).toLocaleString(undefined,{minimumFractionDigits:2})}</b>
      <label style="display:flex;align-items:center;gap:6px;margin:0;color:#7f8897;font-size:9px;font-weight:800;white-space:nowrap">Job Status
        <select class="job-status-select" data-job-status-id="${esc(x.id)}" aria-label="Job status for ${esc(x.no)}">${opts}</select>
      </label>
      <button type="button" class="btn" data-invoice-action="edit" data-invoice-id="${esc(x.id)}">Edit</button>
      <button type="button" class="btn" data-invoice-action="view" data-invoice-id="${esc(x.id)}">View</button>
      ${Number(x.amountPaid||0)>0?`<button type="button" class="btn primary" data-invoice-action="receipt" data-invoice-id="${esc(x.id)}">Receipt</button>`:""}
      <button type="button" class="btn danger" data-invoice-action="delete" data-invoice-id="${esc(x.id)}">Delete</button>
    </div>`;
  }).join(""):'<div style="color:#777;text-align:center;padding:20px">No saved invoices.</div>';
  el.onclick=function(e){
    const btn=e.target.closest("button[data-invoice-action][data-invoice-id]");
    if(!btn)return;
    e.preventDefault();e.stopPropagation();
    const id=btn.getAttribute("data-invoice-id");
    const action=btn.getAttribute("data-invoice-action");
    if(action==="edit")loadInvoice(id);
    else if(action==="view")previewSaved(id);
    else if(action==="receipt")showReceipt(id);
    else if(action==="delete")del(id);
  };
  el.onchange=function(e){
    const sel=e.target.closest("select[data-job-status-id]");
    if(!sel)return;
    e.preventDefault();e.stopPropagation();
    if(typeof window.setJobStatusFromSelect==="function")window.setJobStatusFromSelect(sel.getAttribute("data-job-status-id"),sel.value);
  };
}

let calendarCursor=new Date();calendarCursor.setDate(1);
function calendarDateKey(year,month,day){return String(year).padStart(4,"0")+"-"+String(month+1).padStart(2,"0")+"-"+String(day).padStart(2,"0")}
function calendarLocalDate(value){if(!value)return null;const parts=String(value).split("-").map(Number);if(parts.length!==3||parts.some(n=>!Number.isFinite(n)))return null;return new Date(parts[0],parts[1]-1,parts[2])}
function calendarEventStart(x){return calendarLocalDate(x?.eventDate)}
function calendarEventEnd(x){return calendarLocalDate(x?.eventEndDate||x?.eventDate)}
function calendarHumanDate(value){const d=calendarLocalDate(value);return d?d.toLocaleDateString(undefined,{weekday:"long",day:"numeric",month:"long",year:"numeric"}):"—"}
function calendarHumanRange(x){
  const s=calendarEventStart(x),e=calendarEventEnd(x)||s;
  if(!s)return "—";
  if(!e||s.getTime()===e.getTime())return calendarHumanDate(x.eventDate);
  return s.toLocaleDateString(undefined,{day:"numeric",month:"long",year:"numeric"})+" – "+e.toLocaleDateString(undefined,{day:"numeric",month:"long",year:"numeric"});
}
function calendarEvents(){
  return data.filter(x=>isMediaServiceCategory(x.category)&&calendarEventStart(x)).sort((a,b)=>String(a.eventDate).localeCompare(String(b.eventDate))||String(a.no||"").localeCompare(String(b.no||"")));
}
function calendarPrevMonth(){calendarCursor.setMonth(calendarCursor.getMonth()-1);renderCalendar()}
function calendarNextMonth(){calendarCursor.setMonth(calendarCursor.getMonth()+1);renderCalendar()}
function calendarToday(){const now=new Date();calendarCursor=new Date(now.getFullYear(),now.getMonth(),1);renderCalendar()}
function calendarStatusPill(x){const info=invoiceStatusInfo(x);return '<span class="status-pill '+info.cls+'">'+esc(info.status)+'</span>'}
function calendarJobStatus(x){const v=String(x&&x.jobStatus||"Not Started");return v==="Done"?"Completed":v}
function calendarJobStatusPill(x){
  const s=calendarJobStatus(x);
  const styles={
    "Completed":"background:#163a2c;color:#78e0ae;border-color:#2c6b51",
    "In Progress":"background:#102e46;color:#72c6ff;border-color:#285b80",
    "Scheduled":"background:#3b3218;color:#f0cf79;border-color:#75632f",
    "Cancelled":"background:#421d22;color:#ff8993;border-color:#813740",
    "Not Started":"background:#20252d;color:#aeb7c4;border-color:#3a424e"
  };
  return '<span class="calendar-job-status-pill" style="display:inline-flex;align-items:center;gap:4px;padding:2px 6px;border:1px solid;border-radius:999px;font-size:8px;font-weight:900;line-height:1.1;'+(styles[s]||styles["Not Started"])+'">Job: '+esc(s)+'</span>';
}
function renderCalendar(){
  const grid=$("calendarGrid"),title=$("calendarMonthTitle"),list=$("calendarEventList");
  if(!grid||!title||!list)return;
  const year=calendarCursor.getFullYear(),month=calendarCursor.getMonth();
  title.textContent=calendarCursor.toLocaleDateString(undefined,{month:"long",year:"numeric"});
  const events=calendarEvents(),byDate={};
  events.forEach(x=>{
    const s=calendarEventStart(x),e=calendarEventEnd(x)||s;
    if(!s)return;
    const cursor=new Date(s.getTime()),finish=new Date(e.getTime());
    if(finish<s)finish=new Date(s.getTime());
    let guard=0;
    while(cursor<=finish&&guard<370){
      const k=calendarDateKey(cursor.getFullYear(),cursor.getMonth(),cursor.getDate());
      (byDate[k]||(byDate[k]=[])).push(x);
      cursor.setDate(cursor.getDate()+1);guard++;
    }
  });
  const first=new Date(year,month,1),startOffset=first.getDay(),days=new Date(year,month+1,0).getDate(),prevDays=new Date(year,month,0).getDate();
  const today=new Date(),cells=[];
  ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"].forEach(d=>cells.push('<div class="calendar-weekday">'+d+'</div>'));
  for(let i=0;i<42;i++){
    const dayNum=i-startOffset+1;
    let cellYear=year,cellMonth=month,day=dayNum,other=false;
    if(dayNum<1){cellMonth=month-1;if(cellMonth<0){cellMonth=11;cellYear=year-1}day=prevDays+dayNum;other=true}
    else if(dayNum>days){cellMonth=month+1;if(cellMonth>11){cellMonth=0;cellYear=year+1}day=dayNum-days;other=true}
    const key=calendarDateKey(cellYear,cellMonth,day),dayEvents=byDate[key]||[];
    const isToday=key===calendarDateKey(today.getFullYear(),today.getMonth(),today.getDate());
    let html='<div class="calendar-day '+(other?'other-month ':'')+(isToday?'today':'')+'"><div class="calendar-day-number">'+day+'</div>';
    dayEvents.slice(0,3).forEach(x=>{
      html+='<button type="button" class="calendar-event" onclick="openCalendarInvoice(\''+esc(x.id)+'\')"><span class="event-no">'+esc(x.no||"Invoice")+' · '+esc(fmtMoney(x.total,x.cur))+'</span><span class="event-client">'+esc(x.client||"No client")+'</span><span class="event-cat">'+esc(x.category||"Media")+'</span><span class="event-status">'+calendarStatusPill(x)+' '+calendarJobStatusPill(x)+'</span></button>';
    });
    if(dayEvents.length>3)html+='<div class="calendar-more">+'+(dayEvents.length-3)+' more</div>';
    cells.push(html+'</div>');
  }
  grid.innerHTML=cells.join("");
  const monthStart=new Date(year,month,1),monthEnd=new Date(year,month+1,1);
  const monthEvents=events.filter(x=>{
    const s=calendarEventStart(x),e=calendarEventEnd(x)||s;
    return s&&e&&e>=monthStart&&s<monthEnd;
  });
  list.innerHTML=monthEvents.length?monthEvents.map(x=>{
    const d=calendarEventStart(x),p=paymentTotals(x);
    return '<button type="button" class="calendar-list-row" style="width:100%;background:none;border:0;color:inherit;text-align:left;cursor:pointer" onclick="openCalendarInvoice(\''+esc(x.id)+'\')"><span class="calendar-list-date"><b>'+d.getDate()+'</b><small>'+d.toLocaleDateString(undefined,{month:"short"})+'</small></span><span class="calendar-list-main"><b>'+esc(x.no||"Invoice")+' · '+esc(x.client||"No client")+'</b><small>'+esc(x.category||"Media")+' · '+calendarStatusPill(x)+' · '+calendarJobStatusPill(x)+' · '+esc(calendarHumanRange(x))+'</small></span><span class="calendar-list-right"><b>'+esc(fmtMoney(x.total,x.cur))+'</b><small>Balance '+esc(fmtMoney(p.balance,x.cur))+'</small></span></button>';
  }).join(""):'<div style="color:#777;text-align:center;padding:20px">No media events scheduled for this month.</div>';
}
function closeCalendarModal(){const m=$("calendarModal");if(m){m.classList.remove("show");m.setAttribute("aria-hidden","true")}}
function openCalendarInvoice(id){
  const x=data.find(a=>a.id===id);if(!x)return;
  const modal=$("calendarModal"),body=$("calendarModalBody");if(!modal||!body)return;
  const p=paymentTotals(x),items=x.items||[];
  const rental=x.category==="Equipment Rentals"?'<div class="calendar-detail-card full"><span>Equipment Rental</span><b>'+esc(x.rentalStart||"—")+' → '+esc(x.rentalEnd||"—")+' · '+esc(x.rentalUnit||"Per Day")+' · '+esc(x.jobLocation||"—")+' · Ref '+esc(x.rentalRef||"—")+(x.deposit?' · Deposit '+esc(fmtMoney(x.deposit,x.cur)):"")+'</b></div>':"";
  const payments=Number(x.amountPaid||0)>0?'<div class="calendar-detail-card"><span>Payment Received</span><b>'+esc(fmtMoney(x.amountPaid,x.cur))+' · '+esc(x.paymentMethod||"Payment")+' · '+esc(x.paymentDate||"—")+' · Receipt '+esc(x.receiptNo||"—")+'</b></div><div class="calendar-detail-card"><span>Payment Reference</span><b>'+esc(x.transactionRef||"—")+' · Received by '+esc(x.receivedBy||"—")+'</b></div>':'<div class="calendar-detail-card full"><span>Payment Received</span><b>No payment recorded.</b></div>';
  const rows=items.map(i=>'<tr><td>'+esc(i.desc||"")+'</td><td>'+esc(money(i.rate))+'</td><td>'+esc(i.qty)+'</td><td>'+esc(money(i.qty*i.rate))+'</td></tr>').join("");
  $("calendarModalTitle").textContent=(x.no||"Invoice")+" · "+(x.client||"No client");
  $("calendarModalSubtitle").textContent=calendarHumanRange(x);
  body.innerHTML='<div class="calendar-detail-grid">'+
    '<div class="calendar-detail-card"><span>Invoice Number</span><b>'+esc(x.no||"—")+'</b></div>'+
    '<div class="calendar-detail-card"><span>Invoice Status</span><b>'+calendarStatusPill(x)+'</b></div>'+
    '<div class="calendar-detail-card"><span>Job Status</span><b>'+calendarJobStatusPill(x)+'</b></div>'+
    '<div class="calendar-detail-card"><span>Event Date</span><b>'+esc(calendarHumanRange(x))+'</b></div>'+
    '<div class="calendar-detail-card"><span>Service Category</span><b>'+esc(x.category||"Media")+'</b></div>'+
    '<div class="calendar-detail-card"><span>Brand / Model Group</span><b>'+esc(x.serviceBrand||"—")+'</b></div>'+
    '<div class="calendar-detail-card"><span>Service / Equipment Item</span><b>'+esc(x.serviceItem||"—")+'</b></div>'+
    '<div class="calendar-detail-card"><span>Client</span><b>'+esc(x.client||"—")+'</b></div>'+
    '<div class="calendar-detail-card"><span>Client Contact</span><b>'+esc([x.clientPhone,x.clientEmail].filter(Boolean).join(" · ")||"—")+'</b></div>'+
    '<div class="calendar-detail-card full"><span>Client Address</span><b>'+esc(x.clientAddress||"—")+'</b></div>'+
    '<div class="calendar-detail-card"><span>Invoice Date / Due</span><b>'+esc(x.date||"—")+' · Due '+esc(x.due||"On Receipt")+'</b></div>'+
    '<div class="calendar-detail-card"><span>Invoice Template</span><b>'+esc(String(x.template||"—"))+'</b></div>'+
    rental+payments+'</div>'+
  '<div class="calendar-detail-section-title">Invoice Items</div>'+
  '<table class="calendar-detail-table"><thead><tr><th>Description</th><th>Rate</th><th>Qty</th><th>Amount</th></tr></thead><tbody>'+(rows||'<tr><td colspan="4">No invoice items.</td></tr>')+'</tbody></table>'+
  '<div class="calendar-detail-section-title">Invoice Summary</div>'+
  '<div class="calendar-detail-grid"><div class="calendar-detail-card"><span>Subtotal</span><b>'+esc(fmtMoney(x.sub,x.cur))+'</b></div><div class="calendar-detail-card"><span>Discount</span><b>'+esc(fmtMoney(x.dis||x.discount||0,x.cur))+'</b></div><div class="calendar-detail-card"><span>Tax</span><b>'+esc(fmtMoney(x.tax,x.cur))+' · '+esc(x.taxRate)+'%</b></div><div class="calendar-detail-card"><span>Total / Balance</span><b>'+esc(fmtMoney(x.total,x.cur))+' · '+esc(fmtMoney(p.balance,x.cur))+'</b></div></div>'+
  '<div class="calendar-detail-section-title">Payment Information</div>'+
  '<div class="calendar-detail-card full"><b style="white-space:pre-wrap;font-weight:500">'+esc(x.payment||settings.defaultPay||"—")+'</b></div>'+
  '<div class="calendar-detail-section-title">Notes</div>'+
  '<div class="calendar-detail-card full"><b style="white-space:pre-wrap;font-weight:500">'+esc(x.notes||"—")+'</b></div>';
  const edit=$("calendarEditBtn"),print=$("calendarPrintBtn"),receipt=$("calendarReceiptBtn");
  if(edit)edit.onclick=function(){closeCalendarModal();loadInvoice(x.id)};
  if(print)print.onclick=function(){closeCalendarModal();loadInvoice(x.id);setTimeout(printInvoice,30)};
  if(receipt){const hasReceipt=Number(x.amountPaid||0)>0;receipt.style.display=hasReceipt?"inline-flex":"none";receipt.onclick=function(){closeCalendarModal();showReceipt(x.id)}}
  modal.classList.add("show");modal.setAttribute("aria-hidden","false");
}
window.renderCalendar=renderCalendar;
document.addEventListener("keydown",function(e){if(e.key==="Escape"&&$("calendarModal")?.classList.contains("show"))closeCalendarModal()});
function previewSaved(id){loadInvoice(id);setTimeout(preview,30)}
function invoiceStatusInfo(x){const st=String(x.status||"Draft");const due=String(x.due||"");let dueDate=/^\d{4}-\d{2}-\d{2}$/.test(due)?new Date(due+"T23:59:59"):null;const today=new Date();today.setHours(23,59,59,999);let effective=st;if(st!=="Paid"&&dueDate&&dueDate<today)effective="Overdue";let cls=effective==="Paid"?"status-paid":effective==="Overdue"?"status-overdue":effective==="Partially Paid"?"status-partial":effective==="Sent"?"status-sent":"status-draft";return{status:effective,cls,dueDate}}
function amountCollected(x){const total=Math.max(0,Number(x.total||0));const received=Math.max(0,Number(x.amountPaid||0));if(received>0)return Math.min(received,total);return x.status==="Paid"?total:0}
function invoiceBalance(x){const total=Math.max(0,Number(x.total||0));if(x.status==="Paid")return 0;const received=Math.max(0,Number(x.amountPaid||0));if(received>0)return Math.max(0,total-Math.min(received,total));return Number(x.balanceDue!=null?x.balanceDue:total||0)}
function fmtMoney(v,c="GHS"){return String(c||"GHS")+"₵"+Number(v||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}
function daysFromToday(d){if(!d)return null;const a=new Date();a.setHours(0,0,0,0);const b=new Date(d);b.setHours(0,0,0,0);return Math.round((b-a)/86400000)}
function dashboard(){
  const infos=data.map(x=>({x,...invoiceStatusInfo(x)}));
  const total=data.reduce((s,x)=>s+Number(x.total||0),0);
  const collected=data.reduce((s,x)=>s+amountCollected(x),0);
  const outstanding=infos.filter(o=>o.status!=="Paid"&&o.status!=="Draft").reduce((s,o)=>s+invoiceBalance(o.x),0);
  const overdue=infos.filter(o=>o.status==="Overdue").reduce((s,o)=>s+invoiceBalance(o.x),0);
  const drafts=infos.filter(o=>o.status==="Draft").length;
  const sent=infos.filter(o=>o.status==="Sent").length;
  const partial=infos.filter(o=>o.status==="Partially Paid").length;