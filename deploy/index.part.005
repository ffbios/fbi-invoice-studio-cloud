const TEMPLATE_NAMES=['Classic Executive', 'Modern Corporate', 'Minimal White', 'Midnight Luxe', 'Royal Gold', 'Slate Professional', 'Emerald Business', 'Ocean Finance', 'Crimson Legal', 'Violet Creative', 'Cobalt Studio', 'Graphite Pro', 'Ivory Classic', 'Copper Executive', 'Teal Modern', 'Navy Ledger', 'Burgundy Premium', 'Forest Professional', 'Aqua Minimal', 'Charcoal Elite', 'Sandstone Business', 'Platinum Clean', 'Ruby Agency', 'Sapphire Corporate', 'Olive Consulting', 'Indigo Finance', 'Bronze Studio', 'Pearl Minimal', 'Steel Executive', 'Onyx Premium', 'Azure Modern', 'Wine Professional', 'Moss Business', 'Skyline Corporate', 'Amber Creative', 'Deep Blue Ledger', 'Terracotta Agency', 'Arctic Clean', 'Royal Indigo', 'Cedar Executive', 'Carbon Studio', 'Champagne Luxe', 'Mint Professional', 'Oceanic Minimal', 'Mahogany Business', 'Electric Cobalt', 'Desert Corporate', 'Pine Consulting', 'Rose Agency', 'Titanium Pro', 'Monochrome Classic', 'Goldline Executive', 'Blueprint Modern', 'Clean Ledger', 'Black Label', 'White Label', 'Copperline Studio', 'Emerald Luxe', 'Sapphire Elite', 'Ruby Corporate', 'Indigo Minimal', 'Teal Executive', 'Crimson Studio', 'Forest Luxe', 'Platinum Corporate', 'Obsidian Modern', 'Ivory Agency', 'Cobalt Executive', 'Burgundy Ledger', 'Aqua Professional', 'Graphite Minimal', 'Royal Business', 'Amber Executive', 'Slate Agency', 'Pearl Corporate', 'Bronze Luxe', 'Navy Professional', 'Olive Minimal', 'Violet Executive', 'Steel Corporate', 'Ocean Studio', 'Sand Modern', 'Wine Luxe', 'Moss Executive', 'Azure Agency', 'Charcoal Ledger', 'Arctic Professional', 'Cedar Minimal', 'Ruby Executive', 'Sapphire Studio', 'Gold Corporate', 'Indigo Luxe', 'Teal Agency', 'Emerald Ledger', 'Crimson Professional', 'Platinum Minimal', 'Onyx Executive', 'Cobalt Corporate', 'Ivory Luxe', 'FBI Signature'];
function initTemplates(){
  const sel=$("template"); if(!sel) return;
  sel.innerHTML=TEMPLATE_NAMES.map((n,i)=>`<option value="${i+1}">${String(i+1).padStart(2,"0")} — ${n}</option>`).join("");
  sel.onchange=()=>{ if(current) current.template=+sel.value; };
}
function selectedTemplate(){return Math.max(1,Math.min(100,Number($("template")?.value||1)))}

function money(n){return ($("cur")?.value||"GHS")+"₵"+Number(n||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}
function esc(v){return String(v??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
function reportStatusFor(x){return invoiceStatusInfo(x).status}
function reportCategories(){
  const set=new Set(data.map(x=>String(x.category||"").trim()).filter(Boolean));
  return Array.from(set).sort((a,b)=>a.localeCompare(b));
}
function reportFilteredData(){
  const from=$("reportFrom")?.value||"",to=$("reportTo")?.value||"",status=$("reportStatus")?.value||"",client=$("reportClient")?.value||"",category=$("reportCategory")?.value||"";
  return data.filter(x=>{
    const d=String(x.date||"");
    if(from&&d<from)return false; if(to&&d>to)return false;
    if(status&&reportStatusFor(x)!==status)return false;
    if(client&&String(x.client||"")!==client)return false;
    if(category&&String(x.category||"")!==category)return false;
    return true;
  }).sort((a,b)=>String(b.date||"").localeCompare(String(a.date||""))||String(b.no||"").localeCompare(String(a.no||"")));
}
function populateReportFilters(){
  const clientEl=$("reportClient"),catEl=$("reportCategory");
  if(clientEl){const old=clientEl.value;clientEl.innerHTML='<option value="">All Clients</option>'+Array.from(new Set(data.map(x=>String(x.client||"").trim()).filter(Boolean))).sort((a,b)=>a.localeCompare(b)).map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join("");if(Array.from(clientEl.options).some(o=>o.value===old))clientEl.value=old}
  if(catEl){const old=catEl.value;catEl.innerHTML='<option value="">All Categories</option>'+reportCategories().map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join("");if(Array.from(catEl.options).some(o=>o.value===old))catEl.value=old}
}
function resetReportFilters(){
  ["reportFrom","reportTo"].forEach(id=>{if($(id))$(id).value=""});if($("reportStatus"))$("reportStatus").value="";if($("reportClient"))$("reportClient").value="";if($("reportCategory"))$("reportCategory").value="";updateReportPreview();
}
function openReportModal(){
  populateReportFilters();
  $("reportModal").classList.add("show");
  $("reportModal").setAttribute("aria-hidden","false");
  updateReportPreview();
}
function closeReportModal(){
  $("reportModal").classList.remove("show");
  $("reportModal").setAttribute("aria-hidden","true");
}
function reportDateRangeLabel(){const f=$("reportFrom")?.value||"",t=$("reportTo")?.value||"";if(f&&t)return f+" to "+t;if(f)return "From "+f;if(t)return "Up to "+t;return "All saved invoice records"}
function updateReportPreview(){
  const rows=reportFilteredData();const total=rows.reduce((s,x)=>s+Number(x.total||0),0);const paid=rows.reduce((s,x)=>s+Math.min(Number(x.amountPaid||0),Number(x.total||0)),0);const balance=rows.reduce((s,x)=>s+invoiceBalance(x),0);const overdue=rows.filter(x=>reportStatusFor(x)==="Overdue").length;
  const body=rows.map(x=>{const st=reportStatusFor(x),p=Math.min(Number(x.amountPaid||0),Number(x.total||0));return `<tr><td><b>${esc(x.no||"—")}</b></td><td>${esc(x.client||"No client")}</td><td>${esc(x.date||"—")}</td><td>${esc(x.due||"On Receipt")}</td><td>${esc(st)}</td><td>${esc(x.category||"—")}</td><td class="num">${esc(fmtMoney(x.total,x.cur))}</td><td class="num">${esc(fmtMoney(p,x.cur))}</td><td class="num">${esc(fmtMoney(invoiceBalance(x),x.cur))}</td></tr>`}).join("");
  $("reportPreview").innerHTML=`<div class="report-preview-head"><h2>${esc(settings.biz||"FBI Invoice Studio")} — Invoice Report</h2><p>${esc(reportDateRangeLabel())} · Generated ${esc(new Date().toLocaleString())}</p></div><div class="report-summary-cards"><div class="report-summary-card"><span>Invoices</span><b>${rows.length}</b></div><div class="report-summary-card"><span>Total Invoiced</span><b>${esc(fmtMoney(total,"GHS"))}</b></div><div class="report-summary-card"><span>Collected</span><b>${esc(fmtMoney(paid,"GHS"))}</b></div><div class="report-summary-card"><span>Outstanding</span><b>${esc(fmtMoney(balance,"GHS"))}</b></div></div>${rows.length?`<div class="report-table-wrap"><table class="report-table"><thead><tr><th>Invoice</th><th>Client</th><th>Date</th><th>Due</th><th>Status</th><th>Category</th><th class="num">Amount</th><th class="num">Paid</th><th class="num">Balance</th></tr></thead><tbody>${body}</tbody></table></div>`:`<div class="report-empty">No invoices match the selected report filters.</div>`}`;
}
function csvCell(v){const x=String(v??"");return '"'+x.replace(/"/g,'""')+'"'}
function exportReportCsv(){
  const rows=reportFilteredData();if(!rows.length){toast("No records match the report filters.");return}
  const lines=[["Invoice","Client","Date","Due","Status","Category","Currency","Amount","Paid","Balance"],...rows.map(x=>[x.no,x.client||"No client",x.date||"",x.due||"On Receipt",reportStatusFor(x),x.category||"",x.cur||"GHS",Number(x.total||0).toFixed(2),Number(Math.min(Number(x.amountPaid||0),Number(x.total||0))).toFixed(2),Number(invoiceBalance(x)).toFixed(2)])].map(r=>r.map(csvCell).join(",")).join("\r\n");
  const blob=new Blob([lines],{type:"text/csv;charset=utf-8"});const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="FBI-Invoice-Studio-Report-"+new Date().toISOString().slice(0,10)+".csv";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);toast("Report CSV exported");
}
function printOverviewReport(){
  const content=$("reportPreview");if(!content||!content.innerHTML.trim()){toast("Generate the report first.");return}
  openDocumentPrint(content,"Invoice Studio Report","size:A4 landscape;margin:10mm");
}
document.addEventListener("keydown",e=>{if(e.key==="Escape"&&$("reportModal")?.classList.contains("show"))closeReportModal()});

function show(v){document.body.classList.remove("receipt-print-mode");document.querySelectorAll(".view").forEach(x=>x.classList.remove("active","print-view"));$("view-"+v).classList.add("active");document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.v===v));let t={dashboard:["Overview","Your invoicing control center"],create:["Create Invoice","Build and print invoices"],clients:["Client Database","Manage your clients and billing contacts"],saved:["Saved Invoices","View and manage saved invoices"],calendar:["Calendar","View media event dates and invoice details"],receipts:["Official Receipts","Print professional payment receipts"],settings:["Business Settings","Business identity and payment details"],whatsapp:["WhatsApp Alerts","Automatic invoice notifications"],preview:["Invoice Preview","Preview and print your invoice"],"receipt-preview":["Official Receipt","Preview and print your receipt"]}[v]||["Invoice Studio",""];$("title").textContent=t[0];$("subtitle").textContent=t[1];if(v==="saved")renderSaved();if(v==="calendar")renderCalendar();if(v==="receipts")renderReceipts();if(v==="clients")renderClients();if(v==="dashboard")dashboard();if(v==="create"){populateClientSelect();initServiceCatalog();}$("side").classList.remove("open")}
document.querySelectorAll(".nav button").forEach(b=>{b.addEventListener("click",function(e){e.preventDefault();if(window.__FBI_NAV__)window.__FBI_NAV__(b.dataset.v);else show(b.dataset.v);});});$("template").onchange=()=>setTemplate($("template").value);["amountPaid","paymentDate","paymentMethod","transactionRef","receivedBy"].forEach(id=>$(id)?.addEventListener("input",()=>{if(id==="amountPaid")updatePaymentBalancePreview()}));
function toast(x){let t=$("toast");t.textContent=x;t.classList.add("show");clearTimeout(t._x);t._x=setTimeout(()=>t.classList.remove("show"),2000)}
const DRAFT_KEY=KEY+":draft-v3";
let lastPersistAt=0;

function safeStorageGet(store,key){
  try{return store&&store.getItem?store.getItem(key):null}catch(e){return null}
}
function safeStorageSet(store,key,value){
  try{if(!store||!store.setItem)return false;store.setItem(key,value);return true}catch(e){return false}
}
function safeStorageRemove(store,key){
  try{if(store&&store.removeItem)store.removeItem(key)}catch(e){}
}
function parseStoredEnvelope(raw){
  if(!raw)return null;
  try{
    const obj=JSON.parse(raw);
    if(obj&&obj.data&&Array.isArray(obj.data.data)){
      return {data:obj.data.data,clients:Array.isArray(obj.data.clients)?obj.data.clients:[],settings:obj.data.settings||{},savedAt:Number(obj.savedAt)||0};
    }
    if(obj&&Array.isArray(obj.data)){
      return {data:obj.data,clients:Array.isArray(obj.clients)?obj.clients:[],settings:obj.settings||{},savedAt:0};
    }
  }catch(e){}
  return null;
}
function readWindowNameState(){
  try{
    if(!window.name)return null;
    if(window.name.indexOf("FBI-INVOICE-STUDIO-STATE:")===0)return JSON.parse(window.name.slice("FBI-INVOICE-STUDIO-STATE:".length));
    if(window.name.indexOf("FBI-INVOICE-STUDIO:")===0)return {app:JSON.parse(window.name.slice("FBI-INVOICE-STUDIO:".length)),draft:null};
    if(window.name.indexOf("FBI-INVOICE-DRAFT:")===0)return {app:null,draft:JSON.parse(window.name.slice("FBI-INVOICE-DRAFT:".length))};
  }catch(e){}
  return null;
}
function getWindowNameEnvelope(){
  try{
    const state=readWindowNameState();
    return state&&state.app?parseStoredEnvelope(JSON.stringify(state.app)):null;
  }catch(e){return null}
}
function setWindowNameState(appJson,draftValue){
  try{
    const existing=readWindowNameState()||{};
    const state={app:appJson?JSON.parse(appJson):(existing.app||null),draft:draftValue!==undefined?draftValue:(existing.draft||null)};
    const json=JSON.stringify(state);
    // window.name survives page refresh in the same tab and is a final fallback
    // for browsers that restrict Web Storage on local HTML files.
    if(json.length<=1900000)window.name="FBI-INVOICE-STUDIO-STATE:"+json;
  }catch(e){}
}
function setWindowNameEnvelope(json){setWindowNameState(json,undefined)}
function readPersistentPayloadSync(){
  const candidates=[
    parseStoredEnvelope(safeStorageGet(window.localStorage,KEY)),
    parseStoredEnvelope(safeStorageGet(window.sessionStorage,KEY)),
    getWindowNameEnvelope()
  ].filter(Boolean);
  if(!candidates.length)return null;
  candidates.sort((a,b)=>(b.savedAt||0)-(a.savedAt||0));
  return candidates[0];
}
let serverPersistQueue=Promise.resolve();
let serverDbOnline=false;
let lastServerPersistAt=0;
let pendingInvoiceDeletes=[];
let pendingClientDeletes=[];

function persist(){
  const deleteIds=pendingInvoiceDeletes.slice();
  const clientDeleteIds=pendingClientDeletes.slice();
  const payload={data,clients,settings};
  const envelope={version:4,savedAt:Date.now(),data:payload,deletedInvoiceIds:deleteIds,deletedClientIds:clientDeleteIds};
  const json=JSON.stringify(envelope);
  // Keep the existing browser fallback, but make the local SQLite server the primary store.
  safeStorageSet(window.localStorage,KEY,json);
  safeStorageSet(window.sessionStorage,KEY,json);
  setWindowNameEnvelope(json);
  lastPersistAt=envelope.savedAt;

  serverPersistQueue=serverPersistQueue.then(async()=>{
    try{
      const res=await fetch('/api/state',{method:'PUT',headers:{'Content-Type':'application/json'},body:json,cache:'no-store'});
      if(!res.ok)throw new Error('HTTP '+res.status);
      const body=await res.json().catch(()=>({}));
      if(body.ok===false)throw new Error(body.error||'Database save failed');
      serverDbOnline=true;
      lastServerPersistAt=envelope.savedAt;
      if(deleteIds.length) pendingInvoiceDeletes=pendingInvoiceDeletes.filter(id=>!deleteIds.includes(id));
      if(clientDeleteIds.length) pendingClientDeletes=pendingClientDeletes.filter(id=>!clientDeleteIds.includes(id));
      const st=$('storageStatus');
      if(st)st.textContent='Cloud PostgreSQL database is connected. Your invoices, clients and settings are stored securely in the cloud.';
      return true;
    }catch(e){
      serverDbOnline=false;
      console.warn('SQLite database save failed:',e);
      const st=$('storageStatus');
      if(st)st.textContent='Cloud database connection unavailable. Your browser copy is being kept as a temporary fallback.';
      return false;
    }
  });
  return serverPersistQueue;
}
function readPersistentPayload(){
  return fetch('/api/state',{cache:'no-store'})
    .then(async res=>{
      if(!res.ok)throw new Error('HTTP '+res.status);
      const body=await res.json();
      if(body&&body.ok===false)throw new Error(body.error||'Database read failed');
      serverDbOnline=true;
      const st=$('storageStatus');
      if(st)st.textContent='Cloud PostgreSQL database is connected. Your invoices, clients and settings are restored from the cloud database.';
      return body&&body.state?parseStoredEnvelope(JSON.stringify(body.state)):null;
    })
    .catch(e=>{
      serverDbOnline=false;
      console.warn('SQLite database read failed; using browser fallback:',e);
      return readPersistentPayloadSync();
    });
}
let serverDraftQueue=Promise.resolve();
let cloudDraftDirty=false;

function clearPersistentDraft(){
  cloudDraftDirty=false;
  safeStorageRemove(window.localStorage,DRAFT_KEY);safeStorageRemove(window.sessionStorage,DRAFT_KEY);
  try{
    const state=readWindowNameState();
    if(state){state.draft=null;window.name="FBI-INVOICE-STUDIO-STATE:"+JSON.stringify(state)}
  }catch(e){}
  if(location.protocol!=="file:"){
    serverDraftQueue=serverDraftQueue.then(async()=>{
      try{
        await fetch('/api/draft',{method:'DELETE',cache:'no-store',credentials:'same-origin'});
      }catch(e){}
    });
  }
}
function readDraft(){
  const raws=[safeStorageGet(window.localStorage,DRAFT_KEY),safeStorageGet(window.sessionStorage,DRAFT_KEY)];
  for(const raw of raws){if(raw){try{return JSON.parse(raw)}catch(e){}}}
  try{const state=readWindowNameState();if(state?.draft)return state.draft}catch(e){}
  return null;
}
function writeDraft(draft){
  try{
    cloudDraftDirty=true;
    const entry={savedAt:Date.now(),draft};
    const json=JSON.stringify(entry);
    safeStorageSet(window.localStorage,DRAFT_KEY,json);
    safeStorageSet(window.sessionStorage,DRAFT_KEY,json);
    try{const state=readWindowNameState()||{};setWindowNameState(state.app?JSON.stringify(state.app):null,entry)}catch(e){}
    if(location.protocol!=="file:"){
      serverDraftQueue=serverDraftQueue.then(async()=>{
        try{
          const res=await fetch('/api/draft',{method:'PUT',headers:{'Content-Type':'application/json'},body:json,cache:'no-store',credentials:'same-origin'});
          if(!res.ok)throw new Error('HTTP '+res.status);
          const body=await res.json().catch(()=>({}));
          if(body.ok===false)throw new Error(body.error||'Cloud draft save failed');
          const st=$('storageStatus');if(st)st.textContent='Cloud database connected. Your current work is also saved as a draft.';
        }catch(e){
          console.warn('Cloud draft save failed:',e);
        }
      });
    }
  }catch(e){}
}
let draftSaveTimer=null;
function collectDraft(){
  if(!$('no')||!$('date')||!$('items'))return null;
  return {
    id:current?.id||null,no:$('no').value,date:$('date').value,due:$('due').value,status:$('status').value,cur:$('cur').value,client:$('client').value,clientAddress:$('clientAddress').value,clientPhone:$('clientPhone').value,clientEmail:$('clientEmail').value,tax:$('tax').value,discount:$('discount').value,payment:$('payment').value,notes:$('notes').value,template:$('template').value,vatInclusive:$('vatInclusive').checked,amountPaid:$('amountPaid').value,paymentDate:$('paymentDate').value,paymentMethod:$('paymentMethod').value,transactionRef:$('transactionRef').value,receivedBy:$('receivedBy').value,receiptNo:$('receiptNo').value,eventDate:$('eventDate')?.value||'',eventEndDate:$('eventEndDate')?.value||'',rentalStart:$('rentalStart')?.value||'',rentalEnd:$('rentalEnd')?.value||'',jobLocation:$('jobLocation')?.value||'',rentalRef:$('rentalRef')?.value||'',rentalUnit:$('rentalUnit')?.value||'Per Day',deposit:$('deposit')?.value||0,category:$('serviceCategory')?.value||'',serviceBrand:$('brandModelFilter')?.value||'',serviceItem:$('catalogItemSelect')?.value||$('itemSearch')?.value||'',items:[...document.querySelectorAll('.item')].map(r=>({desc:r.querySelector('.desc')?.value||'',qty:r.querySelector('.qty')?.value||0,rate:r.querySelector('.rate')?.value||0,days:Math.max(1,+(r.querySelector('.days')?.value||1))}))
  };
}
function scheduleDraftSave(){
  clearTimeout(draftSaveTimer);
  draftSaveTimer=setTimeout(()=>{try{const d=collectDraft();if(d)writeDraft(d)}catch(e){}},180);
}
function applyDraftEntry(entry,showMessage){
  if(!entry?.draft)return false;
  const x=entry.draft;
  try{
    current=x.id?(data.find(a=>a.id===x.id)||null):null;
    invoiceNumberReserved=x.no||'';
    ['no','date','due','status','cur','client','clientAddress','clientPhone','clientEmail','tax','discount','payment','notes','template','amountPaid','paymentDate','paymentMethod','transactionRef','receivedBy','receiptNo'].forEach(id=>{if($(id)&&x[id]!==undefined)$(id).value=x[id]});
    if($('vatInclusive'))$('vatInclusive').checked=x.vatInclusive!==false;
    if($('eventDate'))$('eventDate').value=x.eventDate||'';
    if($('eventEndDate'))$('eventEndDate').value=x.eventEndDate||x.eventDate||'';
    if($('rentalStart'))$('rentalStart').value=x.rentalStart||'';
    if($('rentalEnd'))$('rentalEnd').value=x.rentalEnd||'';
    if($('jobLocation'))$('jobLocation').value=x.jobLocation||'';
    if($('rentalRef'))$('rentalRef').value=x.rentalRef||'';
    if($('rentalUnit'))$('rentalUnit').value=x.rentalUnit||'Per Day';
    if($('deposit'))$('deposit').value=x.deposit||0;
    if($('items')){ $('items').innerHTML=''; (x.items||[]).forEach(a=>addItem(a.desc,a.qty,a.rate,a.days||1)); if(!x.items?.length)addItem('',1,0); }
    initTemplates();if($('template'))$('template').value=String(x.template||settings.template||100);
    if($('serviceCategory')&&x.category){$('serviceCategory').value=x.category;$('serviceCategory').dispatchEvent(new Event('change'))}
    if($('brandModelFilter')&&x.serviceBrand){$('brandModelFilter').value=x.serviceBrand;$('brandModelFilter').dispatchEvent(new Event('change'))}
    if($('catalogItemSelect')&&x.serviceItem)$('catalogItemSelect').value=x.serviceItem;
    toggleEventDate();toggleRentalDetails();calc();updatePaymentBalancePreview();show('create');
    if(showMessage)toast(showMessage);
    return true;
  }catch(e){console.warn('Draft restore failed',e);return false}
}
function restoreDraft(){
  return applyDraftEntry(readDraft(),'Your saved work was restored.');
}
async function restoreCloudDraft(){
  if(location.protocol==="file:")return false;
  try{
    const res=await fetch('/api/draft',{cache:'no-store',credentials:'same-origin'});
    if(!res.ok)return false;
    const body=await res.json();
    const cloudEntry=body?.draft;
    if(!cloudEntry?.draft)return false;
    const localEntry=readDraft();
    if(localEntry?.savedAt && Number(localEntry.savedAt)>=Number(cloudEntry.savedAt||0))return false;
    return applyDraftEntry(cloudEntry,'Your cloud-saved work was restored.');
  }catch(e){
    console.warn('Cloud draft restore failed:',e);
    return false;
  }
}
window.addEventListener('pagehide',function(){
  if(!cloudDraftDirty || location.protocol==='file:')return;
  try{
    const d=collectDraft();
    if(!d)return;
    const payload=JSON.stringify({savedAt:Date.now(),draft:d});
    if(navigator.sendBeacon)navigator.sendBeacon('/api/draft',new Blob([payload],{type:'application/json'}));
  }catch(e){}
});
