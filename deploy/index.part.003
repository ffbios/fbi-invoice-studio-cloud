.rental-meta{margin:10px 0 14px;padding:10px 12px;border:1px solid #ddd;background:#fafafa;font-size:8.5px;line-height:1.55}.rental-meta b{font-weight:700}

/* FBI SIGNATURE MODERN INVOICE — default premium design */
.paper.template-100{background:#fff;color:#16181d;border:0;border-radius:0;box-shadow:none;font-family:Inter,Arial,sans-serif;padding:12mm 13mm;position:relative;overflow:hidden}
.paper.template-100:before{content:"";position:absolute;top:0;left:0;right:0;height:7px;background:linear-gradient(90deg,#11131a 0%,#11131a 72%,#c9a227 72%,#c9a227 100%)}
.paper.template-100 .paper-top{display:grid;grid-template-columns:1fr 220px;gap:28px;border:0;padding:12px 0 24px;margin-top:4px;align-items:start}