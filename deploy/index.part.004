.paper.template-100 .business{display:grid;grid-template-columns:112px 1fr;gap:18px;align-items:start}
.paper.template-100 .logo{width:112px;height:72px;background:#08090c center/contain no-repeat;border:0;border-radius:6px}
.paper.template-100 .biz h2{font-size:19px;letter-spacing:.3px;color:#11131a;margin:2px 0 7px;font-weight:800}
.paper.template-100 .biz div{font-size:9px;line-height:1.65;color:#5d6470}
.paper.template-100 .invoice-meta{text-align:right;line-height:1.5}
.paper.template-100 .invoice-meta>b{font-size:8px;letter-spacing:1.6px;color:#8a919c}
.paper.template-100 .invoice-meta .big{font-size:24px;line-height:1.1;color:#11131a;font-weight:850;margin:3px 0 13px}
.paper.template-100 .balance{font-size:15px;color:#11131a;font-weight:850;margin-top:3px}
.paper.template-100 .status-pill{display:inline-block;margin-top:8px;padding:5px 10px;border-radius:999px;background:#f3f4f6;color:#303640;font-size:8px;font-weight:800;letter-spacing:.7px;text-transform:uppercase}
.paper.template-100 .status-paid{background:#e8f7ef;color:#147a48}.paper.template-100 .status-overdue{background:#fff0f1;color:#b42332}.paper.template-100 .status-draft{background:#f0f1f3;color:#5d6470}.paper.template-100 .status-partial{background:#fff6df;color:#986b00}.paper.template-100 .status-sent{background:#edf4ff;color:#235fa9}
.paper.template-100 .bill{padding:16px 0;border:0}
.paper.template-100 .bill-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.paper.template-100 .info-card{background:#f7f8fa;border:1px solid #e6e8ec;border-radius:10px;padding:12px 14px;min-height:78px}
.paper.template-100 .info-label{font-size:7px;letter-spacing:1.3px;text-transform:uppercase;font-weight:800;color:#9299a5;margin-bottom:6px}
.paper.template-100 .bill-title{font-size:7px;letter-spacing:1.3px;color:#9299a5;margin:0 0 6px}
.paper.template-100 .bill-name{font-size:12px;color:#15181e;font-weight:800}.paper.template-100 .bill-info{font-size:8.5px;color:#68707c;line-height:1.5;margin-top:4px}
.paper.template-100 .invtable{margin-top:18px;border-collapse:separate;border-spacing:0;overflow:hidden;border:1px solid #e4e6ea;border-radius:10px}
.paper.template-100 .invtable th{background:#11131a;color:#fff;border:0;padding:9px 10px;font-size:7.5px;letter-spacing:.7px}
.paper.template-100 .invtable th:first-child{border-radius:9px 0 0 0}.paper.template-100 .invtable th:last-child{border-radius:0 9px 0 0}
.paper.template-100 .invtable td{padding:10px;border-bottom:1px solid #eceef1;font-size:9px;color:#3e4550}.paper.template-100 .invtable tr:last-child td{border-bottom:0}.paper.template-100 .invtable td:first-child{font-weight:650;color:#171a20}.paper.template-100 .invtable tbody tr:nth-child(even){background:#fafbfc}
.paper.template-100 .lower{display:grid;grid-template-columns:1fr 270px;gap:26px;margin-top:20px;align-items:start}
.paper.template-100 .pay{border:1px solid #e5e7eb;border-radius:10px;padding:14px;background:#fff}.paper.template-100 .pay h3{font-size:11px;color:#11131a;margin:0 0 11px}.paper.template-100 .pay h4{font-size:7px;letter-spacing:1.1px;color:#9299a5;margin:0 0 5px}.paper.template-100 .pay p{font-size:8.5px;color:#5d6470;line-height:1.55;margin:0 0 10px}
.paper.template-100 .totals{border:1px solid #e4e6ea;border-radius:10px;padding:8px 14px;background:#fafbfc}.paper.template-100 .tl{padding:7px 0;font-size:8.5px;color:#707783}.paper.template-100 .tl b{color:#252a32}.paper.template-100 .tl.total{margin:5px -14px 0;padding:12px 14px;border:0;border-top:1px solid #e2e4e8;background:#11131a;color:#fff;font-size:11px}.paper.template-100 .tl.total b{color:#fff;font-size:13px}.paper.template-100 .tl.balance{margin:0 -14px;padding:11px 14px;border:0;border-top:1px dashed #d5d8dd;font-size:9px;color:#11131a}.paper.template-100 .tl.balance b{font-size:12px}
.paper.template-100 .vat-note{margin-top:9px;padding:7px 10px;background:#fff8df;border-left:3px solid #c9a227;border-radius:5px;color:#745900;font-size:8px;font-weight:700}
.paper.template-100 .rental-box{margin-top:15px;border:1px solid #e5e7eb;border-radius:10px;padding:12px;background:#fbfbfc}.paper.template-100 .rental-box .rental-title{font-size:8px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:#8a919c;margin-bottom:8px}.paper.template-100 .rental-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.paper.template-100 .rental-grid div{font-size:8px;color:#5d6470}.paper.template-100 .rental-grid b{display:block;color:#222730;font-size:8.5px;margin-top:3px}
.paper.template-100 .paper-footer{margin-top:25px;padding-top:13px;border-top:1px solid #e5e7eb;line-height:1.5}.paper.template-100 .paper-footer b{font-size:7px;letter-spacing:1px;color:#8a919c}.paper.template-100 .paper-footer .two{font-size:8px;color:#68707c;margin-top:8px}.paper.template-100 .watermark{margin-top:20px;font-size:7px;color:#a4a9b1;letter-spacing:.5px}
@media(max-width:700px){.paper.template-100 .paper-top,.paper.template-100 .bill-grid,.paper.template-100 .lower{grid-template-columns:1fr}.paper.template-100 .invoice-meta{text-align:left}.paper.template-100 .rental-grid{grid-template-columns:1fr 1fr}}

/* ===== PAYMENT RECEIPTS ===== */
.receipt-paper{width:148mm;min-height:210mm;background:#fff;color:#1a1d22;margin:auto;padding:13mm 12mm;box-shadow:0 10px 40px #0008;font-family:Arial,sans-serif;font-size:10px;position:relative}.receipt-header{display:grid;grid-template-columns:1fr 170px;gap:20px;align-items:start;border-bottom:2px solid #11131a;padding-bottom:14px}.receipt-brand{display:flex;gap:14px;align-items:flex-start}.receipt-logo{width:86px;height:56px;background:#08090c center/contain no-repeat;border-radius:4px;overflow:hidden}.receipt-biz h2{font-size:16px;line-height:1.15;margin:0 0 7px;font-weight:850}.receipt-biz div{font-size:8.5px;line-height:1.55;color:#5f6671}.receipt-meta{text-align:right}.receipt-meta .label{font-size:7px;letter-spacing:1.2px;text-transform:uppercase;color:#8a919c;font-weight:800;margin:0}.receipt-meta .receipt-no{font-size:19px;font-weight:900;color:#b18a2c;margin:4px 0 9px}.receipt-meta .date{font-size:9px;color:#3f4650}.receipt-title{margin:18px 0 10px;font-size:22px;font-weight:900;letter-spacing:1px;color:#11131a}.receipt-paid-badge{display:inline-flex;padding:6px 10px;border-radius:999px;background:#e9f8f0;color:#167546;font-size:8px;font-weight:900;letter-spacing:.8px;text-transform:uppercase}.receipt-paid-badge.partial{background:#fff4d9;color:#8a6400}.receipt-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}.receipt-info{border:1px solid #e4e6ea;border-radius:9px;padding:12px;background:#fafbfc;min-height:72px}.receipt-info .k{font-size:7px;color:#9299a5;letter-spacing:1.2px;text-transform:uppercase;font-weight:800;margin-bottom:6px}.receipt-info .v{font-size:10px;font-weight:750;line-height:1.45;color:#232830}.receipt-items{width:100%;border-collapse:collapse;margin-top:16px}.receipt-items th{font-size:7px;letter-spacing:.8px;text-transform:uppercase;text-align:left;color:#747c87;padding:8px 0;border-bottom:1px solid #cfd3d9}.receipt-items td{padding:8px 0;border-bottom:1px solid #eceef1;font-size:8.8px}.receipt-items th:not(:first-child),.receipt-items td:not(:first-child){text-align:right}.receipt-total{margin-top:18px;display:flex;justify-content:flex-end}.receipt-total-box{width:260px;border:1px solid #dfe2e6;border-radius:10px;overflow:hidden}.receipt-total-line{display:flex;justify-content:space-between;padding:8px 12px;font-size:9px}.receipt-total-line span{color:#707782}.receipt-total-line.total{background:#11131a;color:#fff;font-size:12px;font-weight:900;padding:12px}.receipt-total-line.total span{color:#fff}.receipt-total-line.balance{border-top:1px dashed #d3d6da;font-size:10px;font-weight:850}.receipt-total-line.balance b{color:#b18a2c}.receipt-note{margin-top:18px;padding:10px 12px;border-left:3px solid #b18a2c;background:#fff9e7;border-radius:5px;color:#5f4b13;font-size:8.5px;line-height:1.5}.receipt-sign{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:32px}.receipt-sign .line{border-top:1px solid #aab0b8;padding-top:6px;font-size:7.5px;color:#737b87}.receipt-footer{margin-top:28px;border-top:1px solid #e3e5e8;padding-top:10px;font-size:7.5px;color:#858d98;line-height:1.5}.receipt-footer b{color:#4c535e}.receipt-list{display:grid;gap:8px}.receipt-row{display:flex;align-items:center;gap:10px;border:1px solid #2b303b;background:#10131a;border-radius:8px;padding:10px}.receipt-row .grow{flex:1;min-width:0}.receipt-row .main{font-size:11px;font-weight:850}.receipt-row .meta{color:#727b89;font-size:9px;margin-top:3px}.receipt-row .amount{font-weight:900;font-size:11px}.receipt-empty{text-align:center;color:#737c8b;padding:24px;border:1px dashed #3a404c;border-radius:10px}@media(max-width:700px){.receipt-paper{width:100%;min-height:0;padding:8mm}.receipt-header,.receipt-grid{grid-template-columns:1fr}.receipt-meta{text-align:left}.receipt-sign{grid-template-columns:1fr}}@media print{@page{size:A5 portrait;margin:10mm}body.receipt-print-mode{background:#fff;display:block}body.receipt-print-mode .side,body.receipt-print-mode .top,body.receipt-print-mode .no-print{display:none!important}body.receipt-print-mode .view{display:none!important}body.receipt-print-mode #view-receipt-preview{display:block!important;padding:0}body.receipt-print-mode .preview-wrap{padding:0;background:#fff}body.receipt-print-mode .receipt-paper{box-shadow:none;margin:0;width:100%;min-height:0}}

/* Final invoice readability override: line items are intentionally larger and bolder. */
.paper .invtable th{font-size:12px !important}
.paper .invtable td{font-size:14px !important;font-weight:600 !important}
.paper .pay p{font-size:14px !important}.paper .bill-info,.paper .invoice-meta,.paper .paper-footer{font-size:12px}

/* ===== FBI PROFESSIONAL AUTHENTICATION REFRESH ===== */
#authView{
  padding:20px!important;
  background:
    radial-gradient(900px 520px at 8% 12%,rgba(209,31,104,.18),transparent 60%),
    radial-gradient(760px 520px at 92% 88%,rgba(230,181,72,.10),transparent 62%),
    #07090d!important;
}
.fbi-auth-shell{
  width:min(1160px,100%);
  min-height:min(720px,92vh);
  height:auto;
  grid-template-columns:1.02fr .98fr;
  border:1px solid rgba(255,255,255,.14);
  border-radius:24px;
  background:#0b0e14;
  box-shadow:0 30px 110px rgba(0,0,0,.68),0 0 90px rgba(208,25,99,.08);
}
.fbi-auth-visual{
  background:#090b10;
  border-right:1px solid rgba(255,255,255,.07);
}
.fbi-auth-visual-bg{
  background:
    radial-gradient(circle at 20% 25%,rgba(205,28,101,.22),transparent 30%),
    linear-gradient(145deg,#05070a 0%,#120b11 50%,#090d13 100%)!important;
}
.fbi-auth-visual-overlay{
  background:
    linear-gradient(180deg,rgba(0,0,0,.02),rgba(0,0,0,.32)),
    linear-gradient(90deg,rgba(0,0,0,.12),rgba(0,0,0,.05) 58%,rgba(6,8,12,.36))!important;
}
.fbi-auth-visual-content{
  padding:42px 44px 34px;
}
.fbi-auth-kicker{
  font-size:9px;
  letter-spacing:2.6px;
  color:#cfd3dc;
  opacity:.9;
  max-width:390px;
}
.fbi-auth-logo-wrap{
  width:min(560px,100%);
  margin-top:24px;
  padding:0;
  border:0;
  background:none;
}
.fbi-auth-logo-wrap img{
  width:100%;
  max-height:245px;
  object-fit:contain;
  object-position:left center;
  filter:drop-shadow(0 18px 28px rgba(0,0,0,.5));
}
.fbi-auth-tagline{
  font-family:Georgia,"Times New Roman",serif;
  font-size:36px;
  line-height:1.02;
  font-weight:700;
  font-style:italic;
  letter-spacing:-.5px;
  color:#efc24a;
  text-shadow:0 5px 22px rgba(0,0,0,.52);
  max-width:380px;
  margin-top:8px;
}
.fbi-auth-benefits{
  grid-template-columns:1fr 1fr;
  gap:12px;
  max-width:520px;
  padding-top:18px;
}
.fbi-auth-benefits>div{
  min-height:58px;
  padding:11px 13px!important;
  border:1px solid rgba(255,255,255,.09)!important;
  border-radius:11px;
  background:rgba(255,255,255,.025);
}
.fbi-auth-benefits span{font-size:15px!important}
.fbi-auth-benefits b{font-size:10px!important;letter-spacing:1.2px}
.fbi-auth-benefits small{font-size:9px!important;color:#8f97a6!important}
.fbi-auth-panel{
  padding:40px 54px 28px;
  justify-content:flex-start;
}
.fbi-auth-panel-top{
  margin-bottom:28px;
  padding-bottom:18px;
  border-bottom:1px solid rgba(255,255,255,.07);
}
.fbi-auth-panel-top strong{font-size:13px;letter-spacing:1.7px}
.fbi-auth-panel-top small{font-size:10px}
.fbi-auth-card{
  max-width:430px;
  margin:auto;
}
.fbi-auth-card h3{
  font-size:36px;
  margin-bottom:7px;
  letter-spacing:-1px;
}
.fbi-auth-card .auth-sub{
  font-size:13px;
  max-width:380px;
  margin-bottom:26px;
}
.fbi-auth-card .auth-field input{
  height:52px;
  border-radius:10px;
  background:#080c12;
  border-color:#303846;
  transition:border-color .2s,box-shadow .2s,transform .2s;
}
.fbi-auth-card .auth-field input:hover{border-color:#4b5565}
.fbi-auth-card .auth-field input:focus{
  border-color:#d01963;
  box-shadow:0 0 0 3px rgba(208,25,99,.10);
}
.auth-primary{
  height:54px;
  border-radius:10px;
  background:linear-gradient(100deg,#b90852,#e51a72);
}
.auth-primary:hover{box-shadow:0 14px 30px rgba(208,25,99,.26)}
.fbi-create{
  height:50px;
  border-color:#3a414d;
  background:#0a0d13;
  color:#dce0e7;
}
.fbi-create:hover{
  border-color:#d6ad47;
  background:rgba(214,173,71,.05);
}
.auth-message{min-height:18px}
.fbi-quote{margin-top:22px;color:#70798a}
.fbi-auth-panel-foot{
  position:static;
  margin-top:auto;
  padding-top:20px;
  color:#606978;
  font-size:9px;
  line-height:1.5;
}
@media(max-width:900px){
  #authView{padding:12px!important;overflow:auto!important;align-items:flex-start!important}
  .fbi-auth-shell{
    width:100%;
    min-height:calc(100vh - 24px);
    grid-template-columns:1fr;
    border-radius:18px;
  }
  .fbi-auth-visual{
    min-height:245px;
    border-right:0;
    border-bottom:1px solid rgba(255,255,255,.08);
  }
  .fbi-auth-visual-content{
    padding:24px 22px 20px;
    justify-content:flex-start;
  }
  .fbi-auth-kicker{max-width:100%;font-size:8px;letter-spacing:2px;line-height:1.7}
  .fbi-auth-logo-wrap{width:min(520px,100%);margin-top:12px}
  .fbi-auth-logo-wrap img{max-height:135px}
  .fbi-auth-tagline{font-size:25px;max-width:320px}
  .fbi-auth-benefits{display:none}
  .fbi-auth-panel{padding:28px 22px 20px}
  .fbi-auth-panel-top{margin-bottom:22px}
  .fbi-auth-card h3{font-size:30px}
  .fbi-auth-panel-foot{margin-top:22px;text-align:center;justify-content:center;flex-direction:column}
}
@media(max-width:520px){
  .fbi-auth-logo-wrap img{max-height:110px}
  .fbi-auth-tagline{font-size:22px}
  .fbi-auth-card .auth-sub{font-size:12px}
  .fbi-auth-panel{padding-left:18px;padding-right:18px}
}
.completed-jobs-head{display:flex;justify-content:space-between;gap:18px;align-items:center}
.completed-job-stats{margin-top:14px}
.completed-status-done{display:inline-flex;align-items:center;gap:5px;padding:4px 8px;border-radius:999px;background:#e8f7ef;color:#147a48;font-size:11px;font-weight:800}
.completed-status-open{display:inline-flex;align-items:center;gap:5px;padding:4px 8px;border-radius:999px;background:#fff6df;color:#8a6400;font-size:11px;font-weight:800}
@media(max-width:760px){.completed-jobs-head{align-items:flex-start;flex-direction:column}}
 .job-status-inline{display:inline-flex;align-items:center;gap:5px;padding:0 6px;border:1px solid #343a48;border-radius:7px;background:#0d1016;color:#9ca5b4;font-size:9px}.job-status-inline span{font-weight:700}.job-status-select{border:0;background:transparent;color:#e8ebf0;font:inherit;outline:none;cursor:pointer;padding:4px 2px}.job-status-select option{background:#11141b;color:#fff}.job-status-badge{display:inline-flex;padding:4px 7px;border-radius:999px;font-size:8px;font-weight:800;white-space:nowrap;background:#eef1f5;color:#4d5663}.job-status-badge.completed{background:#e7f7ee;color:#147a48}.job-status-badge.in-progress{background:#fff4dc;color:#936600}.job-status-badge.scheduled{background:#edf4ff;color:#235fa9}.job-status-badge.cancelled{background:#fff0f1;color:#b42332}.job-status-badge.not-started{background:#eef1f5;color:#59616d}</style>
<style>.calendar-main-card{overflow:hidden}.calendar-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}.calendar-actions{display:flex;gap:7px;flex-wrap:wrap}.calendar-title-row{display:grid;grid-template-columns:42px 1fr 42px;align-items:center;gap:8px;margin:14px 0}.calendar-title-btn{width:42px;padding:8px}.calendar-month-title{text-align:center;font-size:18px;font-weight:900}.calendar-grid-wrap{overflow:auto}.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;min-width:720px}.calendar-weekday{padding:8px 6px;text-align:center;color:#7d8695;font-size:9px;text-transform:uppercase;letter-spacing:.7px}.calendar-day{min-height:112px;padding:7px;border:1px solid #2b303b;background:#0f1218;border-radius:9px;overflow:hidden}.calendar-day.other-month{opacity:.4}.calendar-day.today{border-color:#bd1b63;box-shadow:inset 0 0 0 1px #bd1b63}.calendar-day-number{font-size:10px;font-weight:900;color:#cbd1db;margin-bottom:6px}.calendar-event{display:block;width:100%;border:1px solid #3a3045;background:#1b1420;color:#fff;border-radius:6px;padding:6px;text-align:left;margin-top:5px;cursor:pointer}.calendar-event:hover{border-color:#bd1b63;background:#24162a}.calendar-event .event-no{display:block;font-size:9px;font-weight:900}.calendar-event .event-client{display:block;font-size:8px;color:#aeb6c4;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.calendar-event .event-cat{display:block;font-size:7px;color:#e6a1c1;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.calendar-event .event-status{display:block;margin-top:4px}.calendar-event .event-status .status-pill{font-size:7px;padding:3px 5px}.calendar-more{font-size:8px;color:#858e9f;margin-top:5px;text-align:center}.calendar-event-list{margin-top:16px;border-top:1px solid #2b303c;padding-top:12px}.calendar-list-row{display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid #282e38}.calendar-list-date{width:72px;flex:0 0 72px;text-align:center}.calendar-list-date b{display:block;font-size:13px}.calendar-list-date small{display:block;color:#858e9f;font-size:8px;text-transform:uppercase}.calendar-list-main{flex:1;min-width:0}.calendar-list-main b{display:block;font-size:10px}.calendar-list-main small{display:block;color:#7d8695;font-size:8px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.calendar-list-right{text-align:right}.calendar-list-right b{display:block;font-size:10px}.calendar-list-right small{color:#7d8695;font-size:8px}.calendar-modal{position:fixed;inset:0;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(0,0,0,.72);backdrop-filter:blur(5px);z-index:200}.calendar-modal.show{display:flex}.calendar-dialog{width:min(980px,96vw);max-height:92vh;overflow:auto;background:#11141b;border:1px solid #343a48;border-radius:14px;box-shadow:0 30px 90px #000b}.calendar-dialog-head{position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;gap:12px;align-items:flex-start;padding:16px 18px;background:#11141bf5;border-bottom:1px solid #2b303c}.calendar-dialog-head h3{margin:0;color:#fff;font-size:14px}.calendar-dialog-head small{display:block;color:#858e9f;font-size:9px;margin-top:4px}.calendar-dialog-body{padding:18px}.calendar-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.calendar-detail-card{border:1px solid #2b303b;background:#0d1016;border-radius:9px;padding:11px}.calendar-detail-card.full{grid-column:1/-1}.calendar-detail-card span{display:block;color:#7d8695;font-size:8px;text-transform:uppercase;letter-spacing:.7px}.calendar-detail-card b{display:block;color:#fff;font-size:11px;margin-top:5px;line-height:1.45;word-break:break-word}.calendar-detail-table{width:100%;border-collapse:collapse;margin-top:12px;font-size:9px}.calendar-detail-table th{padding:7px;text-align:left;color:#858e9f;background:#0d1016;border-bottom:1px solid #343a48;text-transform:uppercase}.calendar-detail-table td{padding:8px 7px;border-bottom:1px solid #282e38}.calendar-detail-table td:not(:first-child),.calendar-detail-table th:not(:first-child){text-align:right}.calendar-detail-section-title{margin:16px 0 8px;color:#e63d7e;font-size:10px;text-transform:uppercase;letter-spacing:.7px}.calendar-dialog-actions{display:flex;justify-content:flex-end;gap:7px;flex-wrap:wrap;padding:12px 18px;border-top:1px solid #2b303c}@media(max-width:600px){.calendar-actions{width:100%}.calendar-actions .btn{flex:1}.calendar-detail-grid{grid-template-columns:1fr}.calendar-detail-card.full{grid-column:auto}.calendar-dialog{width:98vw}.calendar-dialog-body{padding:12px}}</style>

<script>
(function(){
  window.__FBI_NAV__=function(v){
    try{
      document.querySelectorAll('.view').forEach(function(el){el.classList.remove('active','print-view');});
      var target=document.getElementById('view-'+v);
      if(target) target.classList.add('active');
      document.querySelectorAll('.nav button').forEach(function(btn){btn.classList.toggle('active',btn.getAttribute('data-v')===v);});
      var titles={dashboard:['Overview','Your invoicing control center'],create:['Create Invoice','Build and print invoices'],clients:['Client Database','Manage your clients and billing contacts'],saved:['Saved Invoices','View and manage saved invoices'],completed:['Jobs','Manage job status linked to every invoice'],calendar:['Calendar','View media event dates and invoice details'],receipts:['Official Receipts','Print professional payment receipts'],settings:['Business Settings','Business identity and payment details'],whatsapp:['WhatsApp Alerts','Automatic invoice notifications']};
      var t=titles[v]||['Invoice Studio',''];
      var title=document.getElementById('title'); if(title) title.textContent=t[0];
      var sub=document.getElementById('subtitle'); if(sub) sub.textContent=t[1];
      var side=document.getElementById('side'); if(side) side.classList.remove('open');
      // Call application-specific renderers if they exist.
      try{ if(v==='dashboard' && typeof window.dashboard==='function') window.dashboard(); }catch(e){}
      try{ if(v==='clients' && typeof window.renderClients==='function') window.renderClients(); }catch(e){}
      try{ if(v==='saved' && typeof window.renderSaved==='function') window.renderSaved(); }catch(e){}
      try{ if(v==='calendar' && typeof window.renderCalendar==='function') window.renderCalendar(); }catch(e){}
      try{ if(v==='receipts' && typeof window.renderReceipts==='function') window.renderReceipts(); }catch(e){}
      try{ if(v==='create' && typeof window.populateClientSelect==='function') window.populateClientSelect(); }catch(e){}
      return false;
    }catch(e){console.error('Navigation error',e);return false;}
  };
})();
</script>
<script>
(function(){
 function sync(){
  var id=location.hash.replace(/^#/,'');
  var valid={dashboard:1,create:1,clients:1,saved:1,calendar:1,receipts:1,settings:1,whatsapp:1,completed:1};
  var v=id.replace(/^view-/,''); if(!valid[v]) v='dashboard';
  document.querySelectorAll('.nav-link').forEach(function(a){a.classList.toggle('active',a.dataset.v===v);});
  var title={dashboard:['Overview','Your invoicing control center'],create:['Create Invoice','Build and print invoices'],clients:['Client Database','Manage your clients and billing contacts'],saved:['Saved Invoices','View and manage saved invoices'],completed:['Jobs','Manage job status linked to every invoice'],calendar:['Calendar','View media event dates and invoice details'],receipts:['Official Receipts','Print professional payment receipts'],settings:['Business Settings','Business identity and payment details'],whatsapp:['WhatsApp Alerts','Automatic invoice notifications']}[v];
  if(document.getElementById('title')) document.getElementById('title').textContent=title[0];
  if(document.getElementById('subtitle')) document.getElementById('subtitle').textContent=title[1];
  try{if(v==='create' && typeof initServiceCatalog==='function')initServiceCatalog();}catch(e){}
 }
 window.addEventListener('hashchange',sync);
 document.addEventListener('DOMContentLoaded',sync);
})();
</script>
<style id="fbi-ui-v2">
/* ===== FBI INVOICE STUDIO — UI v2 DESIGN LAYER (visual only) =====
   Pure CSS. Does not touch data, scripts, API calls or the printable invoice
   (.paper / templates) styles. Every selector is prefixed with P so it wins over
   the older stacked style passes above. Remove this whole <style> block to revert. */
html[data-theme]{--u-gold:#b3893a;--u-brand:#a80e4d;--u-brand-2:#7c0a38;--u-ring:rgba(168,14,77,.18);--u-r:14px;--u-r-sm:10px;--u-shadow:0 1px 2px rgba(20,22,28,.05),0 6px 20px -8px rgba(20,22,28,.08);--u-side:#101218;--u-side-text:#aeb5c4;--u-ok:#127a52;--u-ok-bg:#e4f5ec;--u-warn:#9a6700;--u-warn-bg:#fff3d6;--u-bad:#b4233a;--u-bad-bg:#fde8eb;--u-info:#1f5fae;--u-info-bg:#e6f0fd;--u-neutral:#505868;--u-neutral-bg:#eceae5;--u-row:#faf9f7;--u-input:#fff}
html[data-theme="dark"]{--u-gold:#e2bb62;--u-brand:#d3235f;--u-brand-2:#a80e4d;--u-ring:rgba(211,35,95,.28);--u-shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px -12px rgba(0,0,0,.6);--u-side:#0a0b0f;--u-ok:#4fd49b;--u-ok-bg:rgba(79,212,155,.13);--u-warn:#f1bf55;--u-warn-bg:rgba(241,191,85,.13);--u-bad:#ff8497;--u-bad-bg:rgba(255,132,151,.13);--u-info:#7db4ff;--u-info-bg:rgba(125,180,255,.13);--u-neutral:#b2b9c7;--u-neutral-bg:rgba(255,255,255,.07);--u-row:#1a1d25;--u-input:#0f1116}
html[data-theme="light"] body{--bg:#f5f4f1;--panel:#ffffff;--panel2:#f1efeb;--border:#e6e2db;--muted:#5d6574;--text:#15171c;--accent:#a80e4d;--green:#127a52;background:var(--bg)!important;color:var(--text)}
html[data-theme="dark"] body{--bg:#0c0d11;--panel:#15171d;--panel2:#1b1e26;--border:#272b35;--muted:#9aa2b1;--text:#f3f4f7;--accent:#d3235f;--green:#4fd49b;background:var(--bg)!important;color:var(--text)}
html[data-theme] body :is(.side,.top,#view-dashboard,#view-create,#view-clients,#view-saved,#view-completed,#view-receipts,#view-settings,#view-whatsapp,#view-calendar,.report-modal,.calendar-modal,.toast){font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}

/* ---------- Sidebar ---------- */
html[data-theme] body .side{width:252px;background:var(--u-side)!important;border-right:0;box-shadow:none;color:var(--u-side-text)}
html[data-theme] body .brand{padding:22px 20px 18px;border-bottom:1px solid rgba(255,255,255,.07);gap:12px;color:#fff;font-size:15px;font-weight:700;letter-spacing:.2px}
html[data-theme] body .brand small{color:#7e8696;font-weight:500;font-size:12px;margin-top:2px;letter-spacing:0}
html[data-theme] body .brand .dot{width:38px;height:38px;border-radius:11px;background:linear-gradient(140deg,var(--u-brand),var(--u-brand-2));box-shadow:0 6px 16px -4px rgba(168,14,77,.6),inset 0 0 0 1px rgba(255,255,255,.14);display:grid;place-items:center;flex:none}
html[data-theme] body .brand .dot:after{content:"FBI";color:#fff;font-size:11px;font-weight:800;letter-spacing:.6px}
html[data-theme] body .nav{padding:14px 12px;display:flex;flex-direction:column;gap:2px}
html[data-theme] body .nav button,html[data-theme] body .nav .nav-link{position:relative;display:flex;align-items:center;gap:12px;width:100%;padding:10px 12px;border:0;border-radius:10px;background:transparent;color:var(--u-side-text);font-size:14px;font-weight:500;text-align:left;transition:background .15s,color .15s}
html[data-theme] body .nav button svg{width:18px;height:18px;flex:none;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;opacity:.85}
html[data-theme] body .nav button:hover,html[data-theme] body .nav .nav-link:hover{background:rgba(255,255,255,.06);color:#fff}
html[data-theme] body .nav button.active,html[data-theme] body .nav .nav-link.active{background:rgba(255,255,255,.09);color:#fff;border-left:0}
html[data-theme] body .nav button.active:before{content:"";position:absolute;left:-12px;top:9px;bottom:9px;width:3px;border-radius:0 3px 3px 0;background:var(--u-gold)}
html[data-theme] body .nav button.active svg{opacity:1;color:var(--u-gold)}
html[data-theme] body .nav button:focus-visible{outline:2px solid var(--u-gold);outline-offset:1px}
html[data-theme] body .sidefoot{border-top:1px solid rgba(255,255,255,.07);padding:16px 20px;color:#7a8292;font-size:12px;line-height:1.55;background:transparent}

/* ---------- Top bar ---------- */
html[data-theme] body .top{padding:14px 28px;background:color-mix(in srgb,var(--panel) 88%,transparent)!important;backdrop-filter:saturate(1.4) blur(14px);border-bottom:1px solid var(--border);box-shadow:none}
html[data-theme] body .top h1{font-size:21px;font-weight:700;letter-spacing:-.2px;color:var(--text)}
html[data-theme] body .top h1:after,html[data-theme] body .top h1:before{display:none!important}
html[data-theme] body .top small{display:block;color:var(--muted);font-size:13px;margin-top:2px}
html[data-theme] body .view{padding:28px}
html[data-theme] body .main{background:var(--bg)}

/* ---------- Buttons ---------- */
html[data-theme] body .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;padding:8px 14px;border-radius:var(--u-r-sm);border:1px solid var(--border);background:var(--panel)!important;color:var(--text)!important;font-size:13px;font-weight:600;line-height:1.2;box-shadow:0 1px 1px rgba(20,22,28,.04);transition:background .15s,border-color .15s,box-shadow .15s,transform .05s}
html[data-theme] body .btn:hover{border-color:color-mix(in srgb,var(--text) 22%,var(--border));background:var(--panel2)!important}
html[data-theme] body .btn:active{transform:translateY(1px)}
html[data-theme] body .btn:focus-visible,html[data-theme] body input:focus-visible,html[data-theme] body select:focus-visible,html[data-theme] body textarea:focus-visible{outline:none;box-shadow:0 0 0 3px var(--u-ring)}
html[data-theme] body .btn.primary,html[data-theme] body .btn.accent{background:linear-gradient(180deg,var(--u-brand),var(--u-brand-2))!important;border-color:var(--u-brand-2);color:#fff!important;box-shadow:0 1px 2px rgba(124,10,56,.35),inset 0 1px 0 rgba(255,255,255,.14)}
html[data-theme] body .btn.primary:hover{filter:brightness(1.07)}
html[data-theme] body .btn.danger,html[data-theme] body .btn.del{color:var(--u-bad)!important;background:var(--u-bad-bg)!important;border-color:color-mix(in srgb,var(--u-bad) 25%,transparent)}
html[data-theme] body .install-app-btn{background:var(--panel)!important;color:var(--u-gold)!important;border-color:color-mix(in srgb,var(--u-gold) 55%,var(--border))!important}
html[data-theme] body .theme-switcher{padding:3px;border-radius:11px;background:var(--panel2);border:1px solid var(--border)}
html[data-theme] body .theme-switcher button{border-radius:8px;font-size:12px;font-weight:600;color:var(--muted);background:transparent;border:0;padding:6px 10px}
html[data-theme] body .theme-switcher button.active,html[data-theme] body .theme-switcher button[aria-pressed="true"]{background:var(--panel);color:var(--text);box-shadow:0 1px 3px rgba(20,22,28,.14)}

/* ---------- Cards ---------- */
html[data-theme] body .card{background:var(--panel)!important;border:1px solid var(--border);border-radius:var(--u-r);padding:22px;margin-bottom:20px;box-shadow:var(--u-shadow)}
html[data-theme] body .card>h3,html[data-theme] body .card h3{margin:0 0 16px;font-size:15px;font-weight:700;letter-spacing:-.1px;text-transform:none;color:var(--text);display:flex;align-items:center;gap:8px}
html[data-theme] body .card h3:before{display:none!important}
html[data-theme] body .card small,html[data-theme] body .visual-meta{color:var(--muted);font-size:13px}
html[data-theme] body .card-headline{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px}
html[data-theme] body .card-headline h3{margin-bottom:3px}
html[data-theme] body .grid2{gap:20px}

/* ---------- Dashboard ---------- */
html[data-theme] body #view-dashboard>.report-toolbar{margin:0 0 16px;padding:0;background:none;border:0;box-shadow:none;min-height:0;display:flex;justify-content:flex-end}
html[data-theme] body #view-dashboard>.report-toolbar:before,html[data-theme] body #view-dashboard>.report-toolbar:after{content:none!important;display:none!important}
html[data-theme] body .dashboard-hero{position:relative;overflow:hidden;display:flex;justify-content:space-between;align-items:center;gap:24px;padding:28px 32px;margin-bottom:18px;border-radius:18px;border:0;color:#fff;background:radial-gradient(120% 160% at 100% 0%,rgba(168,14,77,.55),transparent 55%),linear-gradient(135deg,#171a22,#0e1015);box-shadow:var(--u-shadow)}
html[data-theme] body .dashboard-hero:after{content:"";position:absolute;right:-60px;bottom:-90px;width:260px;height:260px;border-radius:50%;border:1px solid rgba(226,187,98,.28);pointer-events:none}
html[data-theme] body .dashboard-hero .eyebrow{color:var(--u-gold);font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;margin-bottom:8px}
html[data-theme] body .dashboard-hero h2{margin:0 0 6px;font-size:26px;font-weight:700;letter-spacing:-.4px;color:#fff}
html[data-theme] body .dashboard-hero p{margin:0;color:#b6bdcb;font-size:14px;max-width:520px}
html[data-theme] body .hero-metrics{display:flex;gap:12px;position:relative;z-index:1}
html[data-theme] body .hero-metric{min-width:150px;padding:14px 18px;border-radius:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(6px)}
html[data-theme] body .hero-metric span{display:block;color:#aab2c2;font-size:12px;font-weight:600;letter-spacing:.4px;text-transform:uppercase}
html[data-theme] body .hero-metric b{display:block;margin-top:4px;font-size:22px;font-weight:700;color:#fff}
html[data-theme] body .dashboard-quickstrip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px}
html[data-theme] body .quick-action{display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:var(--u-r);border:1px solid var(--border);background:var(--panel);color:var(--text);text-align:left;box-shadow:var(--u-shadow);transition:border-color .15s,transform .15s}
html[data-theme] body .quick-action:hover{border-color:var(--u-brand);transform:translateY(-1px)}
html[data-theme] body .quick-action .qa-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:color-mix(in srgb,var(--u-brand) 10%,var(--panel));color:var(--u-brand);font-size:17px;flex:none}
html[data-theme] body .quick-action b{display:block;font-size:14px;font-weight:700}
html[data-theme] body .quick-action small{display:block;color:var(--muted);font-size:12.5px;margin-top:1px}
html[data-theme] body .stats{gap:16px;margin-bottom:20px}
html[data-theme] body .stat{position:relative;padding:18px 20px;border-radius:var(--u-r);border:1px solid var(--border);background:var(--panel)!important;box-shadow:var(--u-shadow);overflow:hidden}
html[data-theme] body .stat:before,html[data-theme] body .stat:after{display:none!important}
html[data-theme] body .stat>span{display:block;color:var(--muted);font-size:12px;font-weight:600;letter-spacing:.6px;text-transform:uppercase}
html[data-theme] body .stat>b{display:block;margin:6px 0 4px;font-size:26px;font-weight:700;letter-spacing:-.4px;color:var(--text);line-height:1.15}
html[data-theme] body .stat>b.accent{color:var(--u-brand)}
html[data-theme] body .stat>small{display:block;color:var(--muted);font-size:12.5px}
html[data-theme] body .dashboard-analytics{gap:20px;margin-bottom:20px}
html[data-theme] body .overview-grid{gap:12px}
html[data-theme] body .overview-item{padding:14px 16px;border-radius:12px;border:1px solid var(--border);background:var(--u-row)}
html[data-theme] body .overview-item span{display:block;color:var(--muted);font-size:12px;font-weight:600;letter-spacing:.3px;text-transform:uppercase}
html[data-theme] body .overview-item b{display:block;margin-top:4px;font-size:20px;font-weight:700}
html[data-theme] body .summary-lines>div{display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid var(--border);font-size:14px}
html[data-theme] body .summary-lines>div:last-child{border-bottom:0}
html[data-theme] body .summary-lines span{color:var(--muted)}
html[data-theme] body .summary-lines b{font-weight:600}
html[data-theme] body .dashboard-section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px}
html[data-theme] body .dashboard-section-head small{display:block;color:var(--muted);font-size:13px}

/* ---------- Tables & status pills ---------- */
html[data-theme] body .invoice-table-wrap{border:1px solid var(--border);border-radius:12px;overflow:auto;background:var(--panel)}
html[data-theme] body .dashboard-table{width:100%;border-collapse:collapse;font-size:14px}
html[data-theme] body .dashboard-table th{position:sticky;top:0;padding:12px 16px;text-align:left;color:var(--muted);background:var(--u-row);border-bottom:1px solid var(--border);font-size:12px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;white-space:nowrap}
html[data-theme] body .dashboard-table td{padding:14px 16px;border-bottom:1px solid var(--border);vertical-align:middle}
html[data-theme] body .dashboard-table tr:last-child td{border-bottom:0}
html[data-theme] body .dashboard-table tbody tr:hover td{background:var(--u-row)}
html[data-theme] body .dashboard-table td:nth-last-child(-n+3):not(:last-child),html[data-theme] body .dashboard-table th:nth-last-child(-n+3):not(:last-child){text-align:right}
html[data-theme] body .dashboard-table td:first-child{font-weight:700;white-space:nowrap}
html[data-theme] body .status-pill:not(.paper *){display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700;line-height:1.3;background:var(--u-neutral-bg);color:var(--u-neutral)}
html[data-theme] body .status-pill:not(.paper *):before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
html[data-theme] body .status-pill.status-paid:not(.paper *){background:var(--u-ok-bg);color:var(--u-ok)}
html[data-theme] body .status-pill.status-overdue:not(.paper *){background:var(--u-bad-bg);color:var(--u-bad)}
html[data-theme] body .status-pill.status-partial:not(.paper *){background:var(--u-warn-bg);color:var(--u-warn)}
html[data-theme] body .status-pill.status-sent:not(.paper *){background:var(--u-info-bg);color:var(--u-info)}
html[data-theme] body .status-pill.status-draft:not(.paper *){background:var(--u-neutral-bg);color:var(--u-neutral)}
html[data-theme] body .job-status-badge{font-size:12px;padding:4px 10px;font-weight:700}

/* ---------- Lists (activity, alerts, saved, clients, due) ---------- */
html[data-theme] body .saved{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:14px 16px;margin-bottom:10px;border:1px solid var(--border);border-radius:12px;background:var(--panel);font-size:14px;transition:border-color .15s,box-shadow .15s}
html[data-theme] body .saved:hover{border-color:color-mix(in srgb,var(--text) 18%,var(--border));box-shadow:var(--u-shadow)}
html[data-theme] body .saved .grow{flex:1 1 220px;min-width:0;font-weight:700}
html[data-theme] body .saved .meta{color:var(--muted);font-weight:500;font-size:13px}
html[data-theme] body .saved .btn{min-height:34px;padding:6px 12px}
html[data-theme] body .activity-list>*,html[data-theme] body .alert-list>*,html[data-theme] body .due-list>*,html[data-theme] body .attention-list>*{font-size:14px}
html[data-theme] body .activity-list small,html[data-theme] body .alert-list small,html[data-theme] body .due-list small,html[data-theme] body .attention-list small{font-size:12.5px;color:var(--muted)}

/* ---------- Forms ---------- */
html[data-theme] body :is(.main,.report-modal,.calendar-modal) label{display:block;margin:14px 0 6px;color:var(--muted);font-size:13px;font-weight:600}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) input,html[data-theme] body :is(.main,.report-modal,.calendar-modal) select,html[data-theme] body :is(.main,.report-modal,.calendar-modal) textarea{width:100%;min-height:42px;padding:10px 12px;border:1px solid var(--border);border-radius:var(--u-r-sm);background:var(--u-input)!important;color:var(--text)!important;font-size:14px;outline:none;transition:border-color .15s,box-shadow .15s}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) textarea{min-height:84px;line-height:1.5}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) input::placeholder,html[data-theme] body :is(.main,.report-modal,.calendar-modal) textarea::placeholder{color:color-mix(in srgb,var(--muted) 70%,transparent)}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) input:hover,html[data-theme] body :is(.main,.report-modal,.calendar-modal) select:hover,html[data-theme] body :is(.main,.report-modal,.calendar-modal) textarea:hover{border-color:color-mix(in srgb,var(--text) 24%,var(--border))}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) input:focus,html[data-theme] body :is(.main,.report-modal,.calendar-modal) select:focus,html[data-theme] body :is(.main,.report-modal,.calendar-modal) textarea:focus{border-color:var(--u-brand);box-shadow:0 0 0 3px var(--u-ring)}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) input[type=checkbox],html[data-theme] body :is(.main,.report-modal,.calendar-modal) input[type=radio]{width:auto;min-height:0;accent-color:var(--u-brand)}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) input[type=file]{padding:8px;min-height:0;font-size:13px}
html[data-theme] body .item{padding:12px;border:1px solid var(--border);border-radius:12px;background:var(--u-row)}
html[data-theme] body .items-head{color:var(--muted);font-size:12px;font-weight:700;letter-spacing:.5px}
html[data-theme] body .template-picker{gap:12px}
html[data-theme] body .template-card{padding:14px;border:1px solid var(--border);border-radius:12px;background:var(--panel)!important;color:var(--text)!important;transition:border-color .15s,box-shadow .15s}
html[data-theme] body .template-card b,html[data-theme] body .template-card strong{color:var(--text)!important;font-size:14px}
html[data-theme] body .template-card small,html[data-theme] body .template-card span{color:var(--muted)!important;font-size:12.5px}
html[data-theme] body .template-card:hover{border-color:color-mix(in srgb,var(--text) 25%,var(--border))}
html[data-theme] body .template-card.selected{border-color:var(--u-brand);box-shadow:0 0 0 3px var(--u-ring)}

/* ---------- Modals, toast ---------- */
html[data-theme] body .report-modal,html[data-theme] body .calendar-modal{background:rgba(12,13,17,.55);backdrop-filter:blur(6px)}
html[data-theme] body .report-dialog,html[data-theme] body .calendar-dialog{background:var(--panel);color:var(--text);border:1px solid var(--border);border-radius:18px;box-shadow:0 30px 80px -20px rgba(0,0,0,.45)}
html[data-theme] body .report-head,html[data-theme] body .calendar-dialog-head{background:var(--panel);border-bottom:1px solid var(--border)}
html[data-theme] body .report-head h3,html[data-theme] body .calendar-dialog-head h3{font-size:17px;color:var(--text)}
html[data-theme] body .report-head small,html[data-theme] body .calendar-dialog-head small{color:var(--muted);font-size:13px}
html[data-theme] body .report-filters{background:var(--u-row);border:1px solid var(--border);border-radius:12px}
html[data-theme] body .toast{background:#15171d;color:#fff;border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:12px 16px;font-size:14px;box-shadow:0 14px 40px -12px rgba(0,0,0,.5)}

/* ---------- Calendar ---------- */
html[data-theme] body .calendar-month-title{font-size:20px;font-weight:700;color:var(--text)}
html[data-theme] body .calendar-grid{gap:8px}
html[data-theme] body .calendar-weekday{color:var(--muted);font-size:12px;font-weight:700;letter-spacing:.6px}
html[data-theme] body .calendar-day{min-height:116px;padding:9px;border:1px solid var(--border);border-radius:12px;background:var(--panel)}
html[data-theme] body .calendar-day.today{border-color:var(--u-brand);box-shadow:inset 0 0 0 1px var(--u-brand)}
html[data-theme] body .calendar-day-number{color:var(--text);font-size:13px;font-weight:700}
html[data-theme] body .calendar-event{border:1px solid color-mix(in srgb,var(--u-brand) 25%,var(--border));background:color-mix(in srgb,var(--u-brand) 8%,var(--panel));color:var(--text);border-radius:8px;padding:6px 8px}
html[data-theme] body .calendar-event .event-no{font-size:12px}
html[data-theme] body .calendar-event .event-client,html[data-theme] body .calendar-event .event-cat{font-size:11.5px;color:var(--muted)}
html[data-theme] body .calendar-list-row{border-bottom:1px solid var(--border)}
html[data-theme] body .calendar-list-main b{font-size:14px}
html[data-theme] body .calendar-list-main small,html[data-theme] body .calendar-list-date small,html[data-theme] body .calendar-list-right small{font-size:12px;color:var(--muted)}

/* ---------- Sign-in gate (server-injected markup, styling only) ---------- */
html body #fbiAuthGate{background:radial-gradient(90% 70% at 15% 0%,rgba(168,14,77,.35),transparent 60%),radial-gradient(70% 60% at 100% 100%,rgba(179,137,58,.18),transparent 60%),#0c0d11;font-family:Inter,ui-sans-serif,-apple-system,"Segoe UI",Roboto,Arial,sans-serif}
html body .fbi-auth-card{width:min(440px,100%);padding:34px 32px;border-radius:22px;border:1px solid rgba(255,255,255,.1);background:linear-gradient(180deg,rgba(26,29,37,.92),rgba(16,18,24,.96));box-shadow:0 40px 90px -30px rgba(0,0,0,.8),inset 0 1px 0 rgba(255,255,255,.06);backdrop-filter:blur(10px)}
html body .fbi-auth-brand{margin-bottom:26px;gap:14px}
html body .fbi-auth-brand img{width:52px;height:52px;border-radius:13px;background:#0c0d11;padding:3px;box-shadow:0 0 0 1px rgba(226,187,98,.35)}
html body .fbi-auth-brand strong{font-size:14px;letter-spacing:2px;color:#fff}
html body .fbi-auth-brand span{color:#e2bb62;font-size:11px;letter-spacing:1.8px;font-weight:600}
html body .fbi-auth-card h1{font-size:26px;font-weight:700;letter-spacing:-.4px;color:#fff}
html body .fbi-auth-card p{color:#a7aebd;font-size:14px}
html body .fbi-auth-label{color:#c9cfdb;font-size:13px;font-weight:600}
html body .fbi-auth-label input,html body .fbi-auth-label select{min-height:46px;border:1px solid #333a49;background:#0e1015!important;color:#fff!important;border-radius:12px;font-size:15px}
html body .fbi-auth-label input:focus,html body .fbi-auth-label select:focus{border-color:#d3235f;box-shadow:0 0 0 3px rgba(211,35,95,.25)}
html body .fbi-auth-primary{min-height:48px;margin-top:6px;border-radius:12px;background:linear-gradient(180deg,#c01c5c,#8d0c40);font-size:15px;font-weight:700;letter-spacing:.2px;box-shadow:0 10px 24px -10px rgba(211,35,95,.7),inset 0 1px 0 rgba(255,255,255,.18)}
html body .fbi-auth-primary:hover{filter:brightness(1.08)}
html body .fbi-auth-link{color:#c9cfdb;font-size:13px}
html body .fbi-auth-error{font-size:13px}

/* ---------- Scrollbars & small polish ---------- */
html[data-theme] body *{scrollbar-width:thin;scrollbar-color:color-mix(in srgb,var(--muted) 45%,transparent) transparent}
html[data-theme] body ::selection{background:var(--u-ring)}

/* ---------- Responsive ---------- */
@media(max-width:1180px){html[data-theme] body .dashboard-quickstrip{grid-template-columns:repeat(2,minmax(0,1fr))}html[data-theme] body .dashboard-hero{flex-wrap:wrap}}
@media(max-width:950px){html[data-theme] body .view{padding:18px}html[data-theme] body .top{padding:12px 16px}html[data-theme] body .card{padding:18px}}
@media(max-width:600px){html[data-theme] body .dashboard-quickstrip{grid-template-columns:1fr}html[data-theme] body .dashboard-hero{padding:22px 20px}html[data-theme] body .hero-metrics{width:100%}html[data-theme] body .hero-metric{flex:1;min-width:0}html[data-theme] body .stat>b{font-size:22px}html[data-theme] body .top h1{font-size:18px}}
@media print{html[data-theme] body .side,html[data-theme] body .top{display:none!important}}

/* ---------- Overrides for old !important rules ---------- */
html[data-theme] body section#view-dashboard .dashboard-hero{background:radial-gradient(120% 160% at 100% 0%,rgba(168,14,77,.55),transparent 55%),linear-gradient(135deg,#171a22,#0e1015)!important;border:0!important;color:#fff!important;padding:28px 32px!important;border-radius:18px!important;box-shadow:var(--u-shadow)!important}
html[data-theme] body section#view-dashboard .dashboard-hero h2{color:#fff!important;font-size:26px!important;margin:0 0 6px!important;letter-spacing:-.4px}
html[data-theme] body section#view-dashboard .dashboard-hero p{color:#b6bdcb!important;font-size:14px!important;line-height:1.5}
html[data-theme] body section#view-dashboard .dashboard-hero .eyebrow{color:var(--u-gold)!important;font-size:12px!important;letter-spacing:1.4px!important}
html[data-theme] body section#view-dashboard .dashboard-hero>div:first-child{background:none!important;color:#fff!important}
html[data-theme] body section#view-dashboard .hero-metric{background:rgba(255,255,255,.07)!important;border:1px solid rgba(255,255,255,.14)!important;border-radius:14px!important}
html[data-theme] body section#view-dashboard .hero-metric span{color:#aab2c2!important;font-size:12px!important}
html[data-theme] body section#view-dashboard .hero-metric b{color:#fff!important;font-size:22px!important}
/* readable type sizes (old passes used 7-10px) */
html[data-theme] body .dashboard-table td{font-size:14px!important;color:var(--text)!important;padding:14px 16px!important}
html[data-theme] body .dashboard-table th{font-size:12px!important;padding:12px 16px!important;color:var(--muted)!important;background:var(--u-row)!important}
html[data-theme] body .dashboard-table td:nth-child(2){color:var(--text)!important}
html[data-theme] body .dashboard-table td b{font-size:14px!important;color:var(--text)!important}
html[data-theme] body .dashboard-table td:nth-last-child(-n+3):not(:last-child),html[data-theme] body .dashboard-table th:nth-last-child(-n+3):not(:last-child){text-align:right}
html[data-theme] body .activity-row{gap:12px!important;padding:12px 0!important;border-bottom:1px solid var(--border)!important}
html[data-theme] body .activity-row b{font-size:14px!important;color:var(--text)!important}
html[data-theme] body .activity-row small{font-size:12.5px!important;color:var(--muted)!important}
html[data-theme] body .activity-row strong{font-size:13px!important;color:var(--text)!important}
html[data-theme] body .alert-row,html[data-theme] body .attention-row,html[data-theme] body .due-row{font-size:14px!important}
html[data-theme] body .overview-item,html[data-theme] body .saved,html[data-theme] body .item{background:var(--u-row)!important;border-color:var(--border)!important}
html[data-theme] body .saved{background:var(--panel)!important}
html[data-theme] body .stat span,html[data-theme] body .stat small{font-size:12.5px!important}
html[data-theme] body .stat span{font-size:12px!important}
html[data-theme] body .stat b{font-size:26px!important;color:var(--text)!important}
html[data-theme] body .stat b.accent{color:var(--u-brand)!important}
html[data-theme] body .card-headline>span{font-size:12px!important;color:var(--muted)!important}
html[data-theme] body .pulse-bars span,html[data-theme] body .pulse-bars small{font-size:12px!important;color:var(--muted)!important}
html[data-theme] body section#view-dashboard .dashboard-hero>div:first-child h2{color:#fff!important;-webkit-text-fill-color:#fff!important;text-shadow:none!important}
html[data-theme] body #view-dashboard:before{content:none!important;display:none!important}
html[data-theme] body .dashboard-analytics{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr) minmax(0,1fr)}
html[data-theme] body .due-item,html[data-theme] body .attention-item{display:flex;align-items:center;gap:12px;padding:12px 0!important;border-bottom:1px solid var(--border)!important}
html[data-theme] body .due-item:last-child,html[data-theme] body .attention-item:last-child{border-bottom:0!important}
html[data-theme] body .due-item .grow,html[data-theme] body .attention-item .grow{flex:1;min-width:0}
html[data-theme] body .due-item b,html[data-theme] body .attention-item b{display:block;font-size:14px!important;font-weight:700;color:var(--text)!important}
html[data-theme] body .due-item small,html[data-theme] body .attention-item small{display:block;font-size:12.5px!important;color:var(--muted)!important;margin-top:2px}
html[data-theme] body .attention-icon{display:grid;place-items:center;width:36px;height:36px;flex:none;border-radius:10px;background:var(--u-warn-bg)!important;color:var(--u-warn)!important;font-size:16px}
html[data-theme] body .activity-dot{flex:none;width:8px!important;height:8px!important;margin-top:7px!important;background:var(--u-gold)!important}
html[data-theme] body .overview-item span{font-size:11.5px!important;letter-spacing:.3px}
html[data-theme] body .alert-list>*,html[data-theme] body .alert-row{display:flex;gap:10px;align-items:flex-start;padding:12px 0;border-bottom:1px solid var(--border)}
html[data-theme] body .alert-list b{font-size:14px!important;color:var(--text)!important}
html[data-theme] body .alert-list small{font-size:12.5px!important;color:var(--muted)!important}
@media(max-width:1180px){html[data-theme] body .dashboard-analytics{grid-template-columns:1fr 1fr}}
@media(max-width:700px){html[data-theme] body .dashboard-analytics{grid-template-columns:1fr}}
/* ---------- Inline-styled dark boxes & tiny hints (app screens only; never the printable invoice) ---------- */
html[data-theme] body :is(#view-create,#view-clients,#view-saved,#view-completed,#view-receipts,#view-settings,#view-whatsapp,#view-calendar,#view-dashboard) :is([style*="background:#0b"],[style*="background:#0d"],[style*="background:#0e"],[style*="background:#10"],[style*="background:#11"],[style*="background:#12"]){background:var(--u-row)!important;border-color:var(--border)!important;border-radius:12px!important;color:var(--text)!important}
html[data-theme] body :is(#view-create,#view-clients,#view-saved,#view-completed,#view-receipts,#view-settings,#view-whatsapp,#view-calendar) [style*="color:#fff"]{color:var(--text)!important}
html[data-theme] body :is(#view-create,#view-clients,#view-saved,#view-completed,#view-receipts,#view-settings,#view-whatsapp,#view-calendar) :is([style*="font-size:8px"],[style*="font-size:9px"],[style*="font-size:10px"],[style*="font-size:11px"]){font-size:13px!important;color:var(--muted)}
html[data-theme] body #eventDateHint{padding:12px 14px!important;font-size:13px!important;color:var(--muted)!important}
html[data-theme] body #paymentHistoryPanel{padding:14px 16px!important;border-radius:12px!important}
html[data-theme] body #paymentHistoryPanel *{font-size:13px!important;color:var(--text);border-color:var(--border)!important}
html[data-theme] body #paymentHistoryPanel div[style*="color:#7"]{color:var(--muted)!important}
html[data-theme] body #paymentBalancePreview{font-size:20px!important;color:var(--text)!important}
html[data-theme] body .item .rm{min-height:36px;width:36px;padding:0;border-radius:10px;border:1px solid color-mix(in srgb,var(--u-bad) 30%,transparent);background:var(--u-bad-bg)!important;color:var(--u-bad)!important;font-size:14px}
html[data-theme] body #view-calendar .card [style*="line-height:1.6"]{font-size:13px!important;line-height:1.6!important}
html[data-theme] body .card h3 small{font-size:12px;font-weight:500;color:var(--muted)}
html[data-theme] body .card-headline>span{white-space:nowrap}
@media(max-width:700px){
html[data-theme] body .top{flex-wrap:wrap;align-items:center;padding:10px 14px;row-gap:8px}
html[data-theme] body .top>div:first-child{flex:1 1 100%;min-width:0}
html[data-theme] body .top>div:last-child{flex:1 1 100%;justify-content:flex-start;gap:6px}
html[data-theme] body .top small{font-size:12.5px}
html[data-theme] body section#view-dashboard .hero-metrics{flex-direction:column;width:100%}
html[data-theme] body section#view-dashboard .hero-metric{min-width:0;width:100%}
html[data-theme] body section#view-dashboard .hero-metric b{font-size:20px!important}
html[data-theme] body .report-toolbar{justify-content:stretch}
html[data-theme] body .report-toolbar .btn{width:100%}
}
html[data-theme] body .top{height:auto!important;min-height:68px}

/* The printable invoice / receipt must render exactly as before: undo any inherited UI typography on it. */
html[data-theme] body :is(.paper,.receipt-paper,.preview-wrap){line-height:normal;font-variant-numeric:normal;-webkit-font-smoothing:auto}
</style>
</head>
<body>
<aside class="side" id="side">
  <div class="brand"><img class="brand-logo" src="/assets/fbi-logo.png" alt="Film Beyond Imagination logo"><div>Invoice Studio<small>Professional invoicing system</small></div></div>
  <div class="nav">
    <button type="button" class="nav-link active" data-v="dashboard" onclick="show('dashboard')"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg><span>Overview</span></button>
    <button type="button" class="nav-link" data-v="calendar" onclick="show('calendar')"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16.5" rx="2.5"/><path d="M8 2.5v4M16 2.5v4M3 10h18"/></svg><span>Calendar</span></button>
    <button type="button" class="nav-link" data-v="create" onclick="show('create')"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M12 11.5v6M9 14.5h6"/></svg><span>Create Invoice</span></button>
    <button type="button" class="nav-link" data-v="clients" onclick="show('clients')"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.7a3.5 3.5 0 0 1 0 6.6M18.5 14.4c1.7.8 3 2.6 3 5.6"/></svg><span>Client Database</span></button>
    <button type="button" class="nav-link" data-v="saved" onclick="show('saved')"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5H10l2 2.5h6.5A2.5 2.5 0 0 1 21 10v7.5a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z"/></svg><span>Saved Invoices</span></button>
    <button type="button" class="nav-link" data-v="completed" onclick="show('completed')"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12.3 2.6 2.6L16 9.5"/></svg><span>Completed Jobs</span></button>
    <button type="button" class="nav-link" data-v="receipts" onclick="show('receipts')"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h14v18l-2.3-1.6L14.3 21 12 19.4 9.7 21l-2.4-1.6L5 21z"/><path d="M8.5 8h7M8.5 12h7M8.5 16h4"/></svg><span>Official Receipts</span></button>
    <button type="button" class="nav-link" data-v="payroll" onclick="window.__FBI_NAV__ ? window.__FBI_NAV__('payroll') : (window.__FBI_PAYROLL_OPEN__ && window.__FBI_PAYROLL_OPEN__())"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18"/><circle cx="16.5" cy="14.5" r="1.2"/></svg><span>Payroll</span></button>
    <button type="button" class="nav-link" data-v="settings" onclick="show('settings')"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg><span>Business Settings</span></button>
    <button type="button" class="nav-link" data-v="whatsapp" onclick="show('whatsapp')"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9a6 6 0 1 1 12 0c0 6 2.5 7.5 2.5 7.5h-17S6 15 6 9z"/><path d="M10 20a2 2 0 0 0 4 0"/></svg><span>WhatsApp Alerts</span></button>
  </div>
  <div class="sidefoot">Invoices are stored securely in the cloud database.<br>Install this app on your phone or PC for quick access.</div>
</aside>
<main class="main">
<header class="top no-print">
  <div style="display:flex;align-items:center;gap:10px"><button class="btn hamb" style="display:none" onclick="side.classList.toggle('open')">☰</button><div><h1 id="title">Overview</h1><small id="subtitle">Your invoicing control center</small></div></div>
  <div style="display:flex;align-items:center;gap:7px;flex-wrap:wrap"><button id="installAppBtn" class="btn install-app-btn" type="button" onclick="installFBIApp()">⬇ Install App</button><button class="btn" onclick="newInvoice()">New Invoice</button><button class="btn primary" onclick="newInvoice()">＋ Create Invoice</button><div class="theme-switcher no-print" role="group" aria-label="Appearance"><button type="button" class="theme-choice" data-theme-choice="light" onclick="setThemePreference('light')" aria-label="Light mode" title="Light mode">☀️<span>Light</span></button><button type="button" class="theme-choice" data-theme-choice="dark" onclick="setThemePreference('dark')" aria-label="Dark mode" title="Dark mode">🌙<span>Dark</span></button><button type="button" class="theme-choice" data-theme-choice="system" onclick="setThemePreference('system')" aria-label="System mode" title="Follow device theme">⚙️<span>System</span></button></div><button id="fbiSignOutBtn" class="btn no-print" type="button" onclick="fbiSignOut()" aria-label="Sign out" title="Sign out" style="width:38px;height:38px;padding:0;display:inline-flex;align-items:center;justify-content:center;border-radius:9px;font-size:0"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4"/><path d="M15 17l5-5-5-5"/><path d="M20 12H9"/></svg></button></div>
</header>
<script>window.fbiSignOut=async function(){var b=document.getElementById("fbiSignOutBtn");if(b)b.disabled=true;try{var r=await fetch("/api/auth/logout",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},cache:"no-store"});if(!r.ok)throw new Error("Sign out failed");window.location.reload();}catch(e){if(b)b.disabled=false;try{toast(e.message||"Sign out failed");}catch(_){} }};</script>

<section class="view active" id="view-dashboard">
  <div class="dashboard-hero">
  <div>
    <div class="eyebrow">FBI INVOICE STUDIO · BUSINESS OVERVIEW</div>
    <h2>Your financial command center</h2>
    <p>See invoicing, collections, outstanding balances and client activity in one workspace.</p>
  </div>
  <div class="hero-metrics">
    <div class="hero-metric"><span>Collected</span><b id="heroCollected">GHS₵0.00</b></div>
    <div class="hero-metric"><span>Open invoices</span><b id="heroOpen">0</b></div>
  </div>
</div>
<div class="dashboard-quickstrip">
  <button class="quick-action" type="button" onclick="newInvoice()"><span class="qa-icon">＋</span><span><b>Create invoice</b><small>Start a new bill</small></span></button>
  <button class="quick-action" type="button" onclick="show('clients')"><span class="qa-icon">👥</span><span><b>Add client</b><small>Manage customer records</small></span></button>
  <button class="quick-action" type="button" onclick="show('receipts')"><span class="qa-icon">🧾</span><span><b>Receipts</b><small>Review recorded payments</small></span></button>
  <button class="quick-action" type="button" onclick="openReportModal()"><span class="qa-icon">↗</span><span><b>Business report</b><small>Generate financial reports</small></span></button>
</div>
<div class="report-toolbar"><button class="btn primary" type="button" onclick="openReportModal()">📊 Generate Report</button></div>
  <div class="stats dashboard-stats">
    <div class="stat"><span>Total Invoices</span><b id="sCount">0</b><small id="sCountMeta">All records</small></div>
    <div class="stat"><span>Total Invoiced</span><b id="sInvoiced">GHS₵0.00</b><small id="sInvoicedMeta">All saved invoices</small></div>
    <div class="stat"><span>Total Collected</span><b id="sPaid">GHS₵0.00</b><small id="sPaidMeta">0 received</small></div>
    <div class="stat"><span>Outstanding</span><b class="accent" id="sDue">GHS₵0.00</b><small id="sDueMeta">0 invoices</small></div>
    <div class="stat"><span>Overdue</span><b id="sOverdue">GHS₵0.00</b><small id="sOverdueMeta">0 invoices</small></div>
    <div class="stat"><span>Due Soon</span><b id="sDueSoon">GHS₵0.00</b><small id="sDueSoonMeta">Next 7 days</small></div>
    <div class="stat"><span>Drafts</span><b id="sDraft">0</b><small id="sDraftMeta">Not yet sent</small></div>
    <div class="stat"><span>Clients</span><b id="sClients">0</b><small id="sClientsMeta">Client database</small></div>
  </div>

  <div class="dashboard-analytics">
    <div class="card visual-card visual-revenue">
      <div class="card-headline"><div><h3>Revenue Pulse</h3><div class="visual-meta" id="pulseMeta">Six-month invoiced volume</div></div><span style="font-size:9px;color:#8994a3">Last 6 months</span></div>
      <div id="revenuePulse" class="pulse-bars" aria-label="Six month revenue pulse"></div>
    </div>
    <div class="card visual-card">
      <div class="card-headline"><div><h3>Recent Activity</h3><div class="visual-meta">Latest invoice movement</div></div></div>
      <div id="dashboardActivity" class="activity-list"></div>
    </div>
    <div class="card visual-card">
      <div class="card-headline"><div><h3>Attention Center</h3><div class="visual-meta">Items requiring follow-up</div></div></div>
      <div id="dashboardAlerts" class="alert-list"></div>
    </div>
  </div>

  <div class="grid2 dashboard-main-grid">
    <div class="card">
      <h3>System Overview</h3>
      <div class="overview-grid">
        <div class="overview-item"><span>Sent / Awaiting Payment</span><b id="ovSent">0</b></div>
        <div class="overview-item"><span>Partially Paid</span><b id="ovPartial">0</b></div>
        <div class="overview-item"><span>Paid Invoices</span><b id="ovPaid">0</b></div>
        <div class="overview-item"><span>Overdue Invoices</span><b id="ovOverdue">0</b></div>
        <div class="overview-item"><span>Draft Invoices</span><b id="ovDraft">0</b></div>
        <div class="overview-item"><span>Collection Rate</span><b id="ovCollection">0%</b></div>
        <div class="overview-item"><span>Average Invoice</span><b id="ovAverage">GHS₵0.00</b></div>
        <div class="overview-item"><span>Equipment Rental Invoices</span><b id="ovRentals">0</b></div>
      </div>
    </div>
    <div class="card">
      <h3>Needs Attention</h3>
      <div id="attentionList" class="attention-list"></div>
    </div>
  </div>

  <div class="card recent">
    <div class="dashboard-section-head"><div><h3 style="margin-bottom:3px">Recent Invoices</h3><small>Every invoice shows its current status, client, dates, amount and outstanding position.</small></div><button class="btn" onclick="show('saved')">View All Invoices →</button></div>
    <div class="invoice-table-wrap">
      <table class="dashboard-table">
        <thead><tr><th>Invoice</th><th>Client</th><th>Date</th><th>Due</th><th>Status</th><th>Amount</th><th>Balance</th><th></th></tr></thead>
        <tbody id="recent"></tbody>
      </table>
    </div>
  </div>

  <div class="grid2">
    <div class="card">
      <h3>Upcoming & Overdue</h3>
      <div id="dueList" class="due-list"></div>
    </div>
    <div class="card">
      <h3>Client & Activity Summary</h3>
      <div class="summary-lines">
        <div><span>Clients in Database</span><b id="sumClients">0</b></div>
        <div><span>Invoices With Clients</span><b id="sumClientInvoices">0</b></div>
        <div><span>Invoices Without Client</span><b id="sumNoClient">0</b></div>
        <div><span>Latest Invoice</span><b id="sumLatest">—</b></div>
        <div><span>Latest Client</span><b id="sumLatestClient">—</b></div>
        <div><span>Data Stored</span><b>Browser Local Storage</b></div>
      </div>
    </div>
  </div>
</section>


<!-- Overview Reports Modal -->
<div class="report-modal no-print" id="reportModal" aria-hidden="true">
  <div class="report-dialog">
    <div class="report-head">
      <div><h3>Overview Report Generator</h3><small>Generate a report from your saved Invoice Studio records.</small></div>
      <button class="btn" type="button" onclick="closeReportModal()">✕ Close</button>
    </div>
    <div class="report-body">
      <div class="report-filters">
        <div><label>From Date</label><input id="reportFrom" type="date"></div>
        <div><label>To Date</label><input id="reportTo" type="date"></div>
        <div><label>Status</label><select id="reportStatus"><option value="">All Statuses</option><option value="Draft">Draft</option><option value="Sent">Sent</option><option value="Partially Paid">Partially Paid</option><option value="Paid">Paid</option><option value="Overdue">Overdue</option></select></div>
        <div><label>Client</label><select id="reportClient"><option value="">All Clients</option></select></div>
        <div><label>Category</label><select id="reportCategory"><option value="">All Categories</option></select></div>
      </div>
      <div class="report-actions">
        <button class="btn" type="button" onclick="resetReportFilters()">Reset</button>
        <button class="btn" type="button" onclick="updateReportPreview()">Refresh Report</button>
        <button class="btn" type="button" onclick="exportReportCsv()">⬇ Export CSV</button><button class="btn" type="button" onclick="exportReportExcel()">⬇ Excel</button>
        <button class="btn primary" type="button" onclick="printOverviewReport()">🖨 Print / Save PDF</button>
      </div>
      <div class="report-preview" id="reportPreview"></div>
    </div>
  </div>
</div>

<section class="view" id="view-create">
<div class="card service-selector-card" id="catalogPanel">
  <h3>Invoice Category & Quick Equipment / Service Selection</h3>
  <div class="grid2">
    <div>
      <label>Service Category</label>
      <select id="serviceCategory"><option value="">Select a service category...</option></select>
    </div>
    <div>
      <label>Brand / Model Group</label>
      <select id="brandModelFilter"><option value="">All Brands / Models</option></select>
      <label>Search Item</label>
      <input id="itemSearch" type="search" placeholder="Type to filter items..." autocomplete="off">
      <label>Select Item</label>
      <select id="catalogItemSelect" size="6" style="width:100%;min-height:150px"><option value="">Select a category first...</option></select>
    </div>
  </div>
  <div style="display:flex;gap:7px;flex-wrap:wrap;margin-top:10px">
    <button type="button" class="btn primary" id="addSelectedCatalogBtn">＋ Add Selected Item</button>
    <button type="button" class="btn" id="addCategoryItemsBtn">＋ Add 25 From Group</button>
  </div>
  <small id="catalogCount" style="display:block;color:#777;margin-top:7px"></small>
</div>

  <div class="card" id="eventDateCard" style="display:none">
    <h3>Event Details <span style="font-size:9px;color:#858e9f;font-weight:600;text-transform:none">(Media invoices only — required)</span></h3>
    <div class="grid2">
      <div>
        <label>Event Start Date</label>
        <input id="eventDate" type="date">
      </div>
      <div>
        <label>Event End Date</label>
        <input id="eventEndDate" type="date">
      </div>
      <div style="grid-column:1/-1">
        <label>Event Date Status</label>
        <div id="eventDateHint" style="padding:9px 10px;border:1px solid #303642;border-radius:7px;background:#0b0d12;color:#858e9f;font-size:12px">
          Select the start and end dates for this event.
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <h3>Invoice Header</h3>
    <div class="grid2">
      <div><label>Invoice Number</label><input id="no" readonly aria-readonly="true" title="Invoice numbers are assigned automatically"><div class="row"><div><label>Date</label><input id="date" type="date"></div><div><label>Due</label><input id="due" type="text" value="On Receipt"></div></div></div>
      <div><label>Status</label><select id="status"><option>Draft</option><option>Sent</option><option>Paid</option><option>Partially Paid</option><option>Overdue</option></select><label>Currency</label><select id="cur"><option>GHS</option><option>USD</option><option>EUR</option><option>GBP</option></select><label>Invoice Template</label><select id="template"><option value="classic">Classic Professional</option><option value="modern">Modern Studio</option><option value="minimal">Minimal Executive</option><option value="bold">Bold Premium</option><option value="elegant">Elegant Creative</option></select><div class="template-picker no-print">
<div class="template-card" data-template-card="classic"><b>Classic</b><span>Clean business layout</span></div>
<div class="template-card" data-template-card="modern"><b>Modern</b><span>Contemporary studio look</span></div>
<div class="template-card" data-template-card="minimal"><b>Minimal</b><span>Quiet executive style</span></div>
<div class="template-card" data-template-card="bold"><b>Bold</b><span>Strong premium header</span></div>
<div class="template-card" data-template-card="elegant"><b>Elegant</b><span>Refined creative style</span></div>
</div></div>
    </div>
  </div>
  <div class="card"><h3>Bill To</h3>
    <div style="display:flex;gap:8px;align-items:end;margin-bottom:4px"><div style="flex:1"><label>Select Existing Client</label><select id="clientSelect" onchange="applySelectedClient()"><option value="">— New / Manual Client —</option></select></div><button class="btn" onclick="show('clients')">＋ Client Database</button><button class="btn" onclick="saveCurrentClient()">Save Client</button></div>
    <div class="grid2"><div><label>Client Name</label><input id="client" placeholder="Chris"><label>Client Address</label><textarea id="clientAddress" rows="2"></textarea></div><div><label>Phone</label><input id="clientPhone"><label>Email</label><input id="clientEmail"></div></div>
  </div>
  <div class="card" id="rentalDetailsCard" style="display:none">
    <h3>Equipment Rental Details</h3>
    <div class="grid2">
      <div><label>Rental Start</label><input id="rentalStart" type="date"><label>Rental End / Return</label><input id="rentalEnd" type="date"><label>Job / Delivery Location</label><input id="jobLocation" placeholder="Event venue / production location"></div>
      <div><label>Rental Agreement / Reference</label><input id="rentalRef" placeholder="Agreement or booking reference"><label>Pricing Unit</label><select id="rentalUnit"><option>Per Hour</option><option selected>Per Day</option><option>Per Week</option><option>Per Month</option><option>Per Event</option></select><label>Security Deposit</label><input id="deposit" type="number" min="0" step=".01" value="0"></div>
    </div>
  </div>
  <div class="card" id="invoiceItemsCard">
    <h3>Invoice Items</h3>
    <div class="items-head"><div>Description</div><div id="rateHeader">Rate / Day</div><div class="days-col">Days</div><div>Qty</div><div>Amount</div><div></div></div>
    <div id="items"></div><button class="btn" onclick="addItem()">＋ Add Item</button>
    <div style="max-width:330px;margin:16px 0 0 auto">
      <div class="row"><label style="flex:1">Tax (%)<input id="tax" type="number" min="0" step=".01" value="20" oninput="calc()"></label><label style="flex:1">Discount<input id="discount" type="number" min="0" step=".01" value="0" oninput="calc()"></label></div>
      <div style="display:flex;justify-content:space-between;border-top:1px solid #343a46;padding-top:10px;font-size:16px;font-weight:900"><span>Total</span><span id="total">GHS 0.00</span></div>
    </div>
  </div>
  <div class="card"><h3>Payment Info</h3><textarea id="payment" rows="6" placeholder="Bank Name: Cal Bank&#10;Account Name: FILM BEYOND IMAGINATION (FBI)&#10;Account Number: 1400010238562&#10;Branch: Dansoman&#10;&#10;Momo service Name: MTN&#10;Momo Number: 0257407350&#10;Account Name: Jerbel Mark Addeh"></textarea><label>Additional Notes</label><textarea id="notes" rows="3"></textarea><label style="display:flex;align-items:center;gap:8px;margin-top:12px"><input id="vatInclusive" type="checkbox" style="width:auto" checked> Show note: <b>This invoice is VAT inclusive.</b></label>
    <div class="no-print" style="display:flex;gap:7px;margin-top:12px"><button class="btn" onclick="save()">💾 Save Invoice</button><button class="btn primary" onclick="preview()">👁 Preview</button><button class="btn" onclick="printInvoice()">🖨 Print / PDF</button><button class="btn primary no-print" type="button" onclick="savePdfToDrive()">Print / Save Invoice PDF</button></div>
  </div>
  <div class="card" id="paymentReceivedCard"><h3>Payment Received & Official Receipt</h3><div class="grid2"><div><label>Amount Paid</label><input id="amountPaid" type="number" min="0" step="0.01" value="0" placeholder="0.00"><label>Payment Date</label><input id="paymentDate" type="date"><label>Payment Method</label><select id="paymentMethod"><option>Cash</option><option selected>Mobile Money</option><option>Bank Transfer</option><option>Card</option><option>Cheque</option><option>Other</option></select></div><div><label>Transaction / Payment Reference</label><input id="transactionRef" placeholder="Bank / MoMo / card / payment reference"><label>Received By</label><input id="receivedBy" placeholder="Accounts / Cashier"><label>Receipt Number</label><input id="receiptNo" readonly placeholder="Generated when payment is recorded"></div></div><div style="display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:12px;padding:11px 12px;border:1px solid #303642;background:#0e1117;border-radius:8px"><div><div style="font-size:9px;color:#858e9f;text-transform:uppercase;letter-spacing:.7px">Remaining Balance</div><b id="paymentBalancePreview" style="font-size:15px">GHS₵0.00</b></div><button class="btn primary" onclick="recordPayment()">🧾 Record Payment & Generate Receipt</button></div><small style="display:block;color:#727b89;font-size:9px;line-height:1.5;margin-top:8px">Each time you receive another part-payment, enter only the new amount here and click <b>Record Payment & Generate Receipt</b>. The system creates a new receipt number and keeps the previous receipts.</small><div id="paymentHistoryPanel" style="margin-top:12px;padding:10px 11px;border:1px solid #303642;background:#0b0e13;border-radius:8px"></div></div>
</section>

<section class="view" id="view-receipts"><div class="card"><div class="dashboard-section-head"><div><h3 style="margin-bottom:3px">Official Payment Receipts</h3><small>Print a professional receipt for every payment recorded against an invoice.</small></div><button class="btn" onclick="show('saved')">View Invoices →</button></div><div id="receiptList" class="receipt-list"></div></div></section>

<section class="view" id="view-clients">
  <div class="grid2">
    <div class="card">
      <h3>Client Database</h3>
      <label>Search Clients</label><input id="clientSearch" placeholder="Search name, phone or email" oninput="renderClients()">
      <div style="margin-top:10px;padding:10px;border:1px dashed #343a46;border-radius:8px;background:#0b0e13">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
          <div><b style="color:#fff">Import Client Data</b><div style="font-size:9px;color:#7f8794;margin-top:3px">Upload CSV or JSON. CSV columns: Name, Phone, Email, Address, Notes.</div></div>
          <input id="clientImportFile" type="file" accept=".csv,.txt,.json" onchange="importClientsFile(event)" style="max-width:230px">
        </div>
        <div id="clientImportStatus" style="font-size:9px;color:#8e97a6;margin-top:7px"></div>
      </div>
      <div id="clientList" style="margin-top:12px"></div>
    </div>
    <div class="card">
      <h3 id="clientFormTitle">Add Client</h3>
      <input id="clientId" type="hidden">
      <label>Client / Company Name *</label><input id="dbClientName" placeholder="Client or company name">
      <label>Phone</label><input id="dbClientPhone" placeholder="0250000000">
      <label>Email</label><input id="dbClientEmail" type="email" placeholder="client@example.com">
      <label>Address</label><textarea id="dbClientAddress" rows="3" placeholder="Client address"></textarea>
      <label>Notes</label><textarea id="dbClientNotes" rows="3" placeholder="Additional client notes"></textarea>
      <div style="display:flex;gap:8px;margin-top:12px"><button class="btn primary" onclick="saveClient()">Save Client</button><button class="btn" onclick="clearClientForm()">Clear</button></div>
    </div>
  </div>
</section>

<section class="view" id="view-saved"><div class="card"><h3>Saved Invoices</h3><div id="saved"></div></div></section>
<section class="view" id="view-completed">
  <div class="card completed-jobs-head">
    <div>
      <h3>Jobs</h3>
      <p style="margin:4px 0 0;color:#7d8593">Every job is linked to its invoice. Payment status and job status are tracked separately.</p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn" type="button" onclick="exportCompletedJobsCsv()">⬇ Export CSV</button>
      <button class="btn primary" type="button" onclick="printCompletedJobsReport()">🖨 Print / Save PDF</button>
    </div>
  </div>
  <div class="stats dashboard-stats completed-job-stats">
    <div class="stat"><span>Total Jobs</span><b id="completedCount">0</b><small id="completedCountMeta">Linked to invoices</small></div>
    <div class="stat"><span>Completed</span><b id="completedValue">0</b><small id="completedValueMeta">Jobs finished</small></div>
    <div class="stat"><span>In Progress</span><b id="completedCollected">0</b><small id="completedCollectedMeta">Scheduled + active</small></div>
    <div class="stat"><span>Outstanding</span><b id="completedBalance">GHS₵0.00</b><small id="completedBalanceMeta">Balance on jobs</small></div>
  </div>
  <div class="card">
    <div class="report-filters" style="margin-bottom:14px">
      <div><label>From Event Date</label><input id="completedFrom" type="date" onchange="renderCompletedJobs()"></div>
      <div><label>To Event Date</label><input id="completedTo" type="date" onchange="renderCompletedJobs()"></div>
      <div><label>Job Status</label><select id="completedJobStatus" onchange="renderCompletedJobs()"><option value="">All Job Statuses</option><option value="Not Started">Not Started</option><option value="Scheduled">Scheduled</option><option value="In Progress">In Progress</option><option value="Completed">Completed</option><option value="Cancelled">Cancelled</option></select></div>
      <div><label>Payment</label><select id="completedPayment" onchange="renderCompletedJobs()"><option value="">All Payments</option><option value="Paid">Fully Paid</option><option value="Partial">Partially Paid</option><option value="Outstanding">Outstanding</option></select></div>
      <div><label>Client</label><select id="completedClient" onchange="renderCompletedJobs()"><option value="">All Clients</option></select></div>
    </div>
    <div id="completedJobsTable"></div>
  </div>
</section>

<section class="view" id="view-calendar">
  <div class="card calendar-main-card">
    <div class="calendar-head">
      <div><h3 style="margin-bottom:3px">Event Calendar</h3><small>Media invoices with an event date. IT invoices are excluded from this calendar.</small></div>
      <div class="calendar-actions">
        <button type="button" class="btn" onclick="calendarPrevMonth()">← Previous</button>
        <button type="button" class="btn" onclick="calendarToday()">Today</button>
        <button type="button" class="btn" onclick="calendarNextMonth()">Next →</button>
      </div>
    </div>
    <div class="calendar-title-row">
