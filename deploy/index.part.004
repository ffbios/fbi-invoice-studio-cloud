.paper.template-100 .business{display:grid;grid-template-columns:112px 1fr;gap:18px;align-items:start}
.paper.template-100 .logo{width:112px;height:72px;background:#08090c center/contain no-repeat;border:0;border-radius:6px}
.paper.template-100 .biz h2{font-size:19px;letter-spacing:.3px;color:#11131a;margin:2px 0 7px;font-weight:800}
.paper.template-100 .biz div{font-size:9px;line-height:1.65;color:#5d6470}
.paper.template-100 .invoice-meta{text-align:right;line-height:1.5}
.paper.template-100 .invoice-meta>b{font-size:8px;letter-spacing:1.6px;color:#8a919c}
.paper.template-100 .invoice-meta .big{font-size:24px;line-height:1.1;color:#11131a;font-weight:850;margin:3px 0 13px}
.paper.template-100 .balance{font-size:15px;color:#11131a;font-weight:850;margin-top:3px}
.paper.template-100 .status-pill{display:inline-block;margin-top:8px;padding:5px 10px;border-radius:999px;background:#f3f4f6;color:#303640;font-size:8px;font-weight:800;letter-spacing:.7px;text-transform:uppercase}
.paper.template-100 .status-paid{background:#e8f7ef;color:#147a48}.paper.template-100 .status-overdue{background:#fff0f1;color:#b42332}.paper.template-100 .status-draft{background:#f0f1f3;color:#5d6470}.paper.template-100 .status-partial{background:#fff6df;color:#986b00}.paper.template-100 .status-sent{background:#edf4ff;color:#235fa9}
.paper.template-100 .bill{padding:16px 0;border:0}
.paper.template-100 .bill-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.paper.template-100 .info-card{background:#f7f8fa;border:1px solid #e6e8ec;border-radius:10px;padding:12px 14px;min-height:78px}
.paper.template-100 .info-label{font-size:7px;letter-spacing:1.3px;text-transform:uppercase;font-weight:800;color:#9299a5;margin-bottom:6px}
.paper.template-100 .bill-title{font-size:7px;letter-spacing:1.3px;color:#9299a5;margin:0 0 6px}
.paper.template-100 .bill-name{font-size:12px;color:#15181e;font-weight:800}.paper.template-100 .bill-info{font-size:8.5px;color:#68707c;line-height:1.5;margin-top:4px}
.paper.template-100 .invtable{margin-top:18px;border-collapse:separate;border-spacing:0;overflow:hidden;border:1px solid #e4e6ea;border-radius:10px}
.paper.template-100 .invtable th{background:#11131a;color:#fff;border:0;padding:9px 10px;font-size:7.5px;letter-spacing:.7px}
.paper.template-100 .invtable th:first-child{border-radius:9px 0 0 0}.paper.template-100 .invtable th:last-child{border-radius:0 9px 0 0}
.paper.template-100 .invtable td{padding:10px;border-bottom:1px solid #eceef1;font-size:9px;color:#3e4550}.paper.template-100 .invtable tr:last-child td{border-bottom:0}.paper.template-100 .invtable td:first-child{font-weight:650;color:#171a20}.paper.template-100 .invtable tbody tr:nth-child(even){background:#fafbfc}
.paper.template-100 .lower{display:grid;grid-template-columns:1fr 270px;gap:26px;margin-top:20px;align-items:start}
.paper.template-100 .pay{border:1px solid #e5e7eb;border-radius:10px;padding:14px;background:#fff}.paper.template-100 .pay h3{font-size:11px;color:#11131a;margin:0 0 11px}.paper.template-100 .pay h4{font-size:7px;letter-spacing:1.1px;color:#9299a5;margin:0 0 5px}.paper.template-100 .pay p{font-size:8.5px;color:#5d6470;line-height:1.55;margin:0 0 10px}
.paper.template-100 .totals{border:1px solid #e4e6ea;border-radius:10px;padding:8px 14px;background:#fafbfc}.paper.template-100 .tl{padding:7px 0;font-size:8.5px;color:#707783}.paper.template-100 .tl b{color:#252a32}.paper.template-100 .tl.total{margin:5px -14px 0;padding:12px 14px;border:0;border-top:1px solid #e2e4e8;background:#11131a;color:#fff;font-size:11px}.paper.template-100 .tl.total b{color:#fff;font-size:13px}.paper.template-100 .tl.balance{margin:0 -14px;padding:11px 14px;border:0;border-top:1px dashed #d5d8dd;font-size:9px;color:#11131a}.paper.template-100 .tl.balance b{font-size:12px}
.paper.template-100 .vat-note{margin-top:9px;padding:7px 10px;background:#fff8df;border-left:3px solid #c9a227;border-radius:5px;color:#745900;font-size:8px;font-weight:700}
.paper.template-100 .rental-box{margin-top:15px;border:1px solid #e5e7eb;border-radius:10px;padding:12px;background:#fbfbfc}.paper.template-100 .rental-box .rental-title{font-size:8px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:#8a919c;margin-bottom:8px}.paper.template-100 .rental-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.paper.template-100 .rental-grid div{font-size:8px;color:#5d6470}.paper.template-100 .rental-grid b{display:block;color:#222730;font-size:8.5px;margin-top:3px}
.paper.template-100 .paper-footer{margin-top:25px;padding-top:13px;border-top:1px solid #e5e7eb;line-height:1.5}.paper.template-100 .paper-footer b{font-size:7px;letter-spacing:1px;color:#8a919c}.paper.template-100 .paper-footer .two{font-size:8px;color:#68707c;margin-top:8px}.paper.template-100 .watermark{margin-top:20px;font-size:7px;color:#a4a9b1;letter-spacing:.5px}
@media(max-width:700px){.paper.template-100 .paper-top,.paper.template-100 .bill-grid,.paper.template-100 .lower{grid-template-columns:1fr}.paper.template-100 .invoice-meta{text-align:left}.paper.template-100 .rental-grid{grid-template-columns:1fr 1fr}}

/* ===== PAYMENT RECEIPTS ===== */
.receipt-paper{width:148mm;min-height:210mm;background:#fff;color:#1a1d22;margin:auto;padding:13mm 12mm;box-shadow:0 10px 40px #0008;font-family:Arial,sans-serif;font-size:10px;position:relative}.receipt-header{display:grid;grid-template-columns:1fr 170px;gap:20px;align-items:start;border-bottom:2px solid #11131a;padding-bottom:14px}.receipt-brand{display:flex;gap:14px;align-items:flex-start}.receipt-logo{width:86px;height:56px;background:#08090c center/contain no-repeat;border-radius:4px;overflow:hidden}.receipt-biz h2{font-size:16px;line-height:1.15;margin:0 0 7px;font-weight:850}.receipt-biz div{font-size:8.5px;line-height:1.55;color:#5f6671}.receipt-meta{text-align:right}.receipt-meta .label{font-size:7px;letter-spacing:1.2px;text-transform:uppercase;color:#8a919c;font-weight:800;margin:0}.receipt-meta .receipt-no{font-size:19px;font-weight:900;color:#b18a2c;margin:4px 0 9px}.receipt-meta .date{font-size:9px;color:#3f4650}.receipt-title{margin:18px 0 10px;font-size:22px;font-weight:900;letter-spacing:1px;color:#11131a}.receipt-paid-badge{display:inline-flex;padding:6px 10px;border-radius:999px;background:#e9f8f0;color:#167546;font-size:8px;font-weight:900;letter-spacing:.8px;text-transform:uppercase}.receipt-paid-badge.partial{background:#fff4d9;color:#8a6400}.receipt-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}.receipt-info{border:1px solid #e4e6ea;border-radius:9px;padding:12px;background:#fafbfc;min-height:72px}.receipt-info .k{font-size:7px;color:#9299a5;letter-spacing:1.2px;text-transform:uppercase;font-weight:800;margin-bottom:6px}.receipt-info .v{font-size:10px;font-weight:750;line-height:1.45;color:#232830}.receipt-items{width:100%;border-collapse:collapse;margin-top:16px}.receipt-items th{font-size:7px;letter-spacing:.8px;text-transform:uppercase;text-align:left;color:#747c87;padding:8px 0;border-bottom:1px solid #cfd3d9}.receipt-items td{padding:8px 0;border-bottom:1px solid #eceef1;font-size:8.8px}.receipt-items th:not(:first-child),.receipt-items td:not(:first-child){text-align:right}.receipt-total{margin-top:18px;display:flex;justify-content:flex-end}.receipt-total-box{width:260px;border:1px solid #dfe2e6;border-radius:10px;overflow:hidden}.receipt-total-line{display:flex;justify-content:space-between;padding:8px 12px;font-size:9px}.receipt-total-line span{color:#707782}.receipt-total-line.total{background:#11131a;color:#fff;font-size:12px;font-weight:900;padding:12px}.receipt-total-line.total span{color:#fff}.receipt-total-line.balance{border-top:1px dashed #d3d6da;font-size:10px;font-weight:850}.receipt-total-line.balance b{color:#b18a2c}.receipt-note{margin-top:18px;padding:10px 12px;border-left:3px solid #b18a2c;background:#fff9e7;border-radius:5px;color:#5f4b13;font-size:8.5px;line-height:1.5}.receipt-sign{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:32px}.receipt-sign .line{border-top:1px solid #aab0b8;padding-top:6px;font-size:7.5px;color:#737b87}.receipt-footer{margin-top:28px;border-top:1px solid #e3e5e8;padding-top:10px;font-size:7.5px;color:#858d98;line-height:1.5}.receipt-footer b{color:#4c535e}.receipt-list{display:grid;gap:8px}.receipt-row{display:flex;align-items:center;gap:10px;border:1px solid #2b303b;background:#10131a;border-radius:8px;padding:10px}.receipt-row .grow{flex:1;min-width:0}.receipt-row .main{font-size:11px;font-weight:850}.receipt-row .meta{color:#727b89;font-size:9px;margin-top:3px}.receipt-row .amount{font-weight:900;font-size:11px}.receipt-empty{text-align:center;color:#737c8b;padding:24px;border:1px dashed #3a404c;border-radius:10px}@media(max-width:700px){.receipt-paper{width:100%;min-height:0;padding:8mm}.receipt-header,.receipt-grid{grid-template-columns:1fr}.receipt-meta{text-align:left}.receipt-sign{grid-template-columns:1fr}}@media print{@page{size:A5 portrait;margin:10mm}body.receipt-print-mode{background:#fff;display:block}body.receipt-print-mode .side,body.receipt-print-mode .top,body.receipt-print-mode .no-print{display:none!important}body.receipt-print-mode .view{display:none!important}body.receipt-print-mode #view-receipt-preview{display:block!important;padding:0}body.receipt-print-mode .preview-wrap{padding:0;background:#fff}body.receipt-print-mode .receipt-paper{box-shadow:none;margin:0;width:100%;min-height:0}}

/* Final invoice readability override: line items are intentionally larger and bolder. */
.paper .invtable th{font-size:12px !important}
.paper .invtable td{font-size:14px !important;font-weight:600 !important}
.paper .pay p{font-size:14px !important}.paper .bill-info,.paper .invoice-meta,.paper .paper-footer{font-size:12px}

/* ===== FBI PROFESSIONAL AUTHENTICATION REFRESH ===== */
#authView{
  padding:20px!important;
  background:
    radial-gradient(900px 520px at 8% 12%,rgba(209,31,104,.18),transparent 60%),
    radial-gradient(760px 520px at 92% 88%,rgba(230,181,72,.10),transparent 62%),
    #07090d!important;
}
.fbi-auth-shell{
  width:min(1160px,100%);
  min-height:min(720px,92vh);
  height:auto;
  grid-template-columns:1.02fr .98fr;
  border:1px solid rgba(255,255,255,.14);
  border-radius:24px;
  background:#0b0e14;
  box-shadow:0 30px 110px rgba(0,0,0,.68),0 0 90px rgba(208,25,99,.08);
}
.fbi-auth-visual{
  background:#090b10;
  border-right:1px solid rgba(255,255,255,.07);
}
.fbi-auth-visual-bg{
  background:
    radial-gradient(circle at 20% 25%,rgba(205,28,101,.22),transparent 30%),
    linear-gradient(145deg,#05070a 0%,#120b11 50%,#090d13 100%)!important;
}
.fbi-auth-visual-overlay{
  background:
    linear-gradient(180deg,rgba(0,0,0,.02),rgba(0,0,0,.32)),
    linear-gradient(90deg,rgba(0,0,0,.12),rgba(0,0,0,.05) 58%,rgba(6,8,12,.36))!important;
}
.fbi-auth-visual-content{
  padding:42px 44px 34px;
}
.fbi-auth-kicker{
  font-size:9px;
  letter-spacing:2.6px;
  color:#cfd3dc;
  opacity:.9;
  max-width:390px;
}
.fbi-auth-logo-wrap{
  width:min(560px,100%);
  margin-top:24px;
  padding:0;
  border:0;
  background:none;
}
.fbi-auth-logo-wrap img{
  width:100%;
  max-height:245px;
  object-fit:contain;
  object-position:left center;
  filter:drop-shadow(0 18px 28px rgba(0,0,0,.5));
}
.fbi-auth-tagline{
  font-family:Georgia,"Times New Roman",serif;
  font-size:36px;
  line-height:1.02;
  font-weight:700;
  font-style:italic;
  letter-spacing:-.5px;
  color:#efc24a;
  text-shadow:0 5px 22px rgba(0,0,0,.52);
  max-width:380px;
  margin-top:8px;
}
.fbi-auth-benefits{
  grid-template-columns:1fr 1fr;
  gap:12px;
  max-width:520px;
  padding-top:18px;
}
.fbi-auth-benefits>div{
  min-height:58px;
  padding:11px 13px!important;
  border:1px solid rgba(255,255,255,.09)!important;
  border-radius:11px;
  background:rgba(255,255,255,.025);
}
.fbi-auth-benefits span{font-size:15px!important}
.fbi-auth-benefits b{font-size:10px!important;letter-spacing:1.2px}
.fbi-auth-benefits small{font-size:9px!important;color:#8f97a6!important}
.fbi-auth-panel{
  padding:40px 54px 28px;
  justify-content:flex-start;
}
.fbi-auth-panel-top{
  margin-bottom:28px;
  padding-bottom:18px;
  border-bottom:1px solid rgba(255,255,255,.07);
}
.fbi-auth-panel-top strong{font-size:13px;letter-spacing:1.7px}
.fbi-auth-panel-top small{font-size:10px}
.fbi-auth-card{
  max-width:430px;
  margin:auto;
}
.fbi-auth-card h3{
  font-size:36px;
  margin-bottom:7px;
  letter-spacing:-1px;
}
.fbi-auth-card .auth-sub{
  font-size:13px;
  max-width:380px;
  margin-bottom:26px;
}
.fbi-auth-card .auth-field input{
  height:52px;
  border-radius:10px;
  background:#080c12;
  border-color:#303846;
  transition:border-color .2s,box-shadow .2s,transform .2s;
}
.fbi-auth-card .auth-field input:hover{border-color:#4b5565}
.fbi-auth-card .auth-field input:focus{
  border-color:#d01963;
  box-shadow:0 0 0 3px rgba(208,25,99,.10);
}
.auth-primary{
  height:54px;
  border-radius:10px;
  background:linear-gradient(100deg,#b90852,#e51a72);
}
.auth-primary:hover{box-shadow:0 14px 30px rgba(208,25,99,.26)}
.fbi-create{
  height:50px;
  border-color:#3a414d;
  background:#0a0d13;
  color:#dce0e7;
}
.fbi-create:hover{
  border-color:#d6ad47;
  background:rgba(214,173,71,.05);
}
.auth-message{min-height:18px}
.fbi-quote{margin-top:22px;color:#70798a}
.fbi-auth-panel-foot{
  position:static;
  margin-top:auto;
  padding-top:20px;
  color:#606978;
  font-size:9px;
  line-height:1.5;
}
@media(max-width:900px){
  #authView{padding:12px!important;overflow:auto!important;align-items:flex-start!important}
  .fbi-auth-shell{
    width:100%;
    min-height:calc(100vh - 24px);
    grid-template-columns:1fr;
    border-radius:18px;
  }
  .fbi-auth-visual{
    min-height:245px;
    border-right:0;
    border-bottom:1px solid rgba(255,255,255,.08);
  }
  .fbi-auth-visual-content{
    padding:24px 22px 20px;
    justify-content:flex-start;
  }
  .fbi-auth-kicker{max-width:100%;font-size:8px;letter-spacing:2px;line-height:1.7}
  .fbi-auth-logo-wrap{width:min(520px,100%);margin-top:12px}
  .fbi-auth-logo-wrap img{max-height:135px}
  .fbi-auth-tagline{font-size:25px;max-width:320px}
  .fbi-auth-benefits{display:none}
  .fbi-auth-panel{padding:28px 22px 20px}
  .fbi-auth-panel-top{margin-bottom:22px}
  .fbi-auth-card h3{font-size:30px}
  .fbi-auth-panel-foot{margin-top:22px;text-align:center;justify-content:center;flex-direction:column}
}
@media(max-width:520px){
  .fbi-auth-logo-wrap img{max-height:110px}
  .fbi-auth-tagline{font-size:22px}
  .fbi-auth-card .auth-sub{font-size:12px}
  .fbi-auth-panel{padding-left:18px;padding-right:18px}
}
.completed-jobs-head{display:flex;justify-content:space-between;gap:18px;align-items:center}
.completed-job-stats{margin-top:14px}
.completed-status-done{display:inline-flex;align-items:center;gap:5px;padding:4px 8px;border-radius:999px;background:#e8f7ef;color:#147a48;font-size:11px;font-weight:800}
.completed-status-open{display:inline-flex;align-items:center;gap:5px;padding:4px 8px;border-radius:999px;background:#fff6df;color:#8a6400;font-size:11px;font-weight:800}
@media(max-width:760px){.completed-jobs-head{align-items:flex-start;flex-direction:column}}
 .job-status-inline{display:inline-flex;align-items:center;gap:5px;padding:0 6px;border:1px solid #343a48;border-radius:7px;background:#0d1016;color:#9ca5b4;font-size:9px}.job-status-inline span{font-weight:700}.job-status-select{border:0;background:transparent;color:#e8ebf0;font:inherit;outline:none;cursor:pointer;padding:4px 2px}.job-status-select option{background:#11141b;color:#fff}.job-status-badge{display:inline-flex;padding:4px 7px;border-radius:999px;font-size:8px;font-weight:800;white-space:nowrap;background:#eef1f5;color:#4d5663}.job-status-badge.completed{background:#e7f7ee;color:#147a48}.job-status-badge.in-progress{background:#fff4dc;color:#936600}.job-status-badge.scheduled{background:#edf4ff;color:#235fa9}.job-status-badge.cancelled{background:#fff0f1;color:#b42332}.job-status-badge.not-started{background:#eef1f5;color:#59616d}</style>
<style>.calendar-main-card{overflow:hidden}.calendar-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}.calendar-actions{display:flex;gap:7px;flex-wrap:wrap}.calendar-title-row{display:grid;grid-template-columns:42px 1fr 42px;align-items:center;gap:8px;margin:14px 0}.calendar-title-btn{width:42px;padding:8px}.calendar-month-title{text-align:center;font-size:18px;font-weight:900}.calendar-grid-wrap{overflow:auto}.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;min-width:720px}.calendar-weekday{padding:8px 6px;text-align:center;color:#7d8695;font-size:9px;text-transform:uppercase;letter-spacing:.7px}.calendar-day{min-height:112px;padding:7px;border:1px solid #2b303b;background:#0f1218;border-radius:9px;overflow:hidden}.calendar-day.other-month{opacity:.4}.calendar-day.today{border-color:#bd1b63;box-shadow:inset 0 0 0 1px #bd1b63}.calendar-day-number{font-size:10px;font-weight:900;color:#cbd1db;margin-bottom:6px}.calendar-event{display:block;width:100%;border:1px solid #3a3045;background:#1b1420;color:#fff;border-radius:6px;padding:6px;text-align:left;margin-top:5px;cursor:pointer}.calendar-event:hover{border-color:#bd1b63;background:#24162a}.calendar-event .event-no{display:block;font-size:9px;font-weight:900}.calendar-event .event-client{display:block;font-size:8px;color:#aeb6c4;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.calendar-event .event-cat{display:block;font-size:7px;color:#e6a1c1;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.calendar-event .event-status{display:block;margin-top:4px}.calendar-event .event-status .status-pill{font-size:7px;padding:3px 5px}.calendar-more{font-size:8px;color:#858e9f;margin-top:5px;text-align:center}.calendar-event-list{margin-top:16px;border-top:1px solid #2b303c;padding-top:12px}.calendar-list-row{display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid #282e38}.calendar-list-date{width:72px;flex:0 0 72px;text-align:center}.calendar-list-date b{display:block;font-size:13px}.calendar-list-date small{display:block;color:#858e9f;font-size:8px;text-transform:uppercase}.calendar-list-main{flex:1;min-width:0}.calendar-list-main b{display:block;font-size:10px}.calendar-list-main small{display:block;color:#7d8695;font-size:8px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.calendar-list-right{text-align:right}.calendar-list-right b{display:block;font-size:10px}.calendar-list-right small{color:#7d8695;font-size:8px}.calendar-modal{position:fixed;inset:0;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(0,0,0,.72);backdrop-filter:blur(5px);z-index:200}.calendar-modal.show{display:flex}.calendar-dialog{width:min(980px,96vw);max-height:92vh;overflow:auto;background:#11141b;border:1px solid #343a48;border-radius:14px;box-shadow:0 30px 90px #000b}.calendar-dialog-head{position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;gap:12px;align-items:flex-start;padding:16px 18px;background:#11141bf5;border-bottom:1px solid #2b303c}.calendar-dialog-head h3{margin:0;color:#fff;font-size:14px}.calendar-dialog-head small{display:block;color:#858e9f;font-size:9px;margin-top:4px}.calendar-dialog-body{padding:18px}.calendar-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.calendar-detail-card{border:1px solid #2b303b;background:#0d1016;border-radius:9px;padding:11px}.calendar-detail-card.full{grid-column:1/-1}.calendar-detail-card span{display:block;color:#7d8695;font-size:8px;text-transform:uppercase;letter-spacing:.7px}.calendar-detail-card b{display:block;color:#fff;font-size:11px;margin-top:5px;line-height:1.45;word-break:break-word}.calendar-detail-table{width:100%;border-collapse:collapse;margin-top:12px;font-size:9px}.calendar-detail-table th{padding:7px;text-align:left;color:#858e9f;background:#0d1016;border-bottom:1px solid #343a48;text-transform:uppercase}.calendar-detail-table td{padding:8px 7px;border-bottom:1px solid #282e38}.calendar-detail-table td:not(:first-child),.calendar-detail-table th:not(:first-child){text-align:right}.calendar-detail-section-title{margin:16px 0 8px;color:#e63d7e;font-size:10px;text-transform:uppercase;letter-spacing:.7px}.calendar-dialog-actions{display:flex;justify-content:flex-end;gap:7px;flex-wrap:wrap;padding:12px 18px;border-top:1px solid #2b303c}@media(max-width:600px){.calendar-actions{width:100%}.calendar-actions .btn{flex:1}.calendar-detail-grid{grid-template-columns:1fr}.calendar-detail-card.full{grid-column:auto}.calendar-dialog{width:98vw}.calendar-dialog-body{padding:12px}}</style>

<script>
(function(){
  window.__FBI_NAV__=function(v){
    try{
      // Use the app's own page switcher (one set of page titles); fall back to the old logic below
      if(typeof window.show==='function'&&document.getElementById('view-'+v)){window.show(v);var sd=document.getElementById('side');if(sd)sd.classList.remove('open');try{if(v==='dashboard'&&typeof window.dashboard==='function')window.dashboard();if(v==='create'&&typeof window.populateClientSelect==='function')window.populateClientSelect();}catch(e){}return false;}
      document.querySelectorAll('.view').forEach(function(el){el.classList.remove('active','print-view');});
      var target=document.getElementById('view-'+v);
      if(target) target.classList.add('active');
      document.querySelectorAll('.nav button').forEach(function(btn){btn.classList.toggle('active',btn.getAttribute('data-v')===v);});
      var titles={dashboard:['Overview','Your invoicing control center'],create:['Create Invoice','Build and print invoices'],clients:['Client Database','Manage your clients and billing contacts'],saved:['Saved Invoices','View and manage saved invoices'],completed:['Jobs','Manage job status linked to every invoice'],calendar:['Calendar','View media event dates and invoice details'],receipts:['Official Receipts','Print professional payment receipts'],settings:['Business Settings','Business identity and payment details'],whatsapp:['WhatsApp Alerts','Automatic invoice notifications']};
      var t=titles[v]||['Invoice Studio',''];
      var title=document.getElementById('title'); if(title) title.textContent=t[0];
      var sub=document.getElementById('subtitle'); if(sub) sub.textContent=t[1];
      var side=document.getElementById('side'); if(side) side.classList.remove('open');
      // Call application-specific renderers if they exist.
      try{ if(v==='dashboard' && typeof window.dashboard==='function') window.dashboard(); }catch(e){}
      try{ if(v==='clients' && typeof window.renderClients==='function') window.renderClients(); }catch(e){}
      try{ if(v==='saved' && typeof window.renderSaved==='function') window.renderSaved(); }catch(e){}
      try{ if(v==='calendar' && typeof window.renderCalendar==='function') window.renderCalendar(); }catch(e){}
      try{ if(v==='receipts' && typeof window.renderReceipts==='function') window.renderReceipts(); }catch(e){}
      try{ if(v==='create' && typeof window.populateClientSelect==='function') window.populateClientSelect(); }catch(e){}
      return false;
    }catch(e){console.error('Navigation error',e);return false;}
  };
})();
</script>
<script>
(function(){
 function sync(){
  var id=location.hash.replace(/^#/,'');
  var valid={dashboard:1,create:1,clients:1,saved:1,calendar:1,receipts:1,settings:1,whatsapp:1,completed:1};
  var v=id.replace(/^view-/,''); if(!valid[v]) v='dashboard';
  document.querySelectorAll('.nav-link').forEach(function(a){a.classList.toggle('active',a.dataset.v===v);});
  var title={dashboard:['Overview','Your invoicing control center'],create:['Create Invoice','Build and print invoices'],clients:['Client Database','Manage your clients and billing contacts'],saved:['Saved Invoices','View and manage saved invoices'],completed:['Jobs','Manage job status linked to every invoice'],calendar:['Calendar','View media event dates and invoice details'],receipts:['Official Receipts','Print professional payment receipts'],settings:['Business Settings','Business identity and payment details'],whatsapp:['WhatsApp Alerts','Automatic invoice notifications']}[v];
  if(document.getElementById('title')) document.getElementById('title').textContent=title[0];
  if(document.getElementById('subtitle')) document.getElementById('subtitle').textContent=title[1];
  try{if(v==='create' && typeof initServiceCatalog==='function')initServiceCatalog();}catch(e){}
 }
 window.addEventListener('hashchange',sync);
 document.addEventListener('DOMContentLoaded',sync);
})();
</script>
<style id="fbi-ui-v2">
/* ===== FBI INVOICE STUDIO — UI v2 DESIGN LAYER (visual only) =====
   Pure CSS. Does not touch data, scripts, API calls or the printable invoice
   (.paper / templates) styles. Every selector is prefixed with P so it wins over
   the older stacked style passes above. Remove this whole <style> block to revert. */
html[data-theme]{--u-gold:#b3893a;--u-brand:#a80e4d;--u-brand-2:#7c0a38;--u-ring:rgba(168,14,77,.18);--u-r:14px;--u-r-sm:10px;--u-shadow:0 1px 2px rgba(20,22,28,.05),0 6px 20px -8px rgba(20,22,28,.08);--u-side:#101218;--u-side-text:#aeb5c4;--u-ok:#127a52;--u-ok-bg:#e4f5ec;--u-warn:#9a6700;--u-warn-bg:#fff3d6;--u-bad:#b4233a;--u-bad-bg:#fde8eb;--u-info:#1f5fae;--u-info-bg:#e6f0fd;--u-neutral:#505868;--u-neutral-bg:#eceae5;--u-row:#faf9f7;--u-input:#fff}
html[data-theme="dark"]{--u-gold:#e2bb62;--u-brand:#d3235f;--u-brand-2:#a80e4d;--u-ring:rgba(211,35,95,.28);--u-shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px -12px rgba(0,0,0,.6);--u-side:#0a0b0f;--u-ok:#4fd49b;--u-ok-bg:rgba(79,212,155,.13);--u-warn:#f1bf55;--u-warn-bg:rgba(241,191,85,.13);--u-bad:#ff8497;--u-bad-bg:rgba(255,132,151,.13);--u-info:#7db4ff;--u-info-bg:rgba(125,180,255,.13);--u-neutral:#b2b9c7;--u-neutral-bg:rgba(255,255,255,.07);--u-row:#1a1d25;--u-input:#0f1116}
html[data-theme="light"] body{--bg:#f5f4f1;--panel:#ffffff;--panel2:#f1efeb;--border:#e6e2db;--muted:#5d6574;--text:#15171c;--accent:#a80e4d;--green:#127a52;background:var(--bg)!important;color:var(--text)}
html[data-theme="dark"] body{--bg:#0c0d11;--panel:#15171d;--panel2:#1b1e26;--border:#272b35;--muted:#9aa2b1;--text:#f3f4f7;--accent:#d3235f;--green:#4fd49b;background:var(--bg)!important;color:var(--text)}
html[data-theme] body :is(.side,.top,#view-dashboard,#view-create,#view-clients,#view-saved,#view-completed,#view-receipts,#view-settings,#view-whatsapp,#view-calendar,.report-modal,.calendar-modal,.toast){font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums}

/* ---------- Sidebar ---------- */
html[data-theme] body .side{width:252px;background:var(--u-side)!important;border-right:0;box-shadow:none;color:var(--u-side-text)}
html[data-theme] body .brand{padding:22px 20px 18px;border-bottom:1px solid rgba(255,255,255,.07);gap:12px;color:#fff;font-size:15px;font-weight:700;letter-spacing:.2px}
html[data-theme] body .brand small{color:#7e8696;font-weight:500;font-size:12px;margin-top:2px;letter-spacing:0}
html[data-theme] body .brand .dot{width:38px;height:38px;border-radius:11px;background:linear-gradient(140deg,var(--u-brand),var(--u-brand-2));box-shadow:0 6px 16px -4px rgba(168,14,77,.6),inset 0 0 0 1px rgba(255,255,255,.14);display:grid;place-items:center;flex:none}
html[data-theme] body .brand .dot:after{content:"FBI";color:#fff;font-size:11px;font-weight:800;letter-spacing:.6px}
html[data-theme] body .nav{padding:14px 12px;display:flex;flex-direction:column;gap:2px}
html[data-theme] body .nav button,html[data-theme] body .nav .nav-link{position:relative;display:flex;align-items:center;gap:12px;width:100%;padding:10px 12px;border:0;border-radius:10px;background:transparent;color:var(--u-side-text);font-size:14px;font-weight:500;text-align:left;transition:background .15s,color .15s}
html[data-theme] body .nav button svg{width:18px;height:18px;flex:none;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;opacity:.85}
html[data-theme] body .nav button:hover,html[data-theme] body .nav .nav-link:hover{background:rgba(255,255,255,.06);color:#fff}
html[data-theme] body .nav button.active,html[data-theme] body .nav .nav-link.active{background:rgba(255,255,255,.09);color:#fff;border-left:0}
html[data-theme] body .nav button.active:before{content:"";position:absolute;left:-12px;top:9px;bottom:9px;width:3px;border-radius:0 3px 3px 0;background:var(--u-gold)}
html[data-theme] body .nav button.active svg{opacity:1;color:var(--u-gold)}
html[data-theme] body .nav button:focus-visible{outline:2px solid var(--u-gold);outline-offset:1px}
html[data-theme] body .sidefoot{border-top:1px solid rgba(255,255,255,.07);padding:16px 20px;color:#7a8292;font-size:12px;line-height:1.55;background:transparent}

/* ---------- Top bar ---------- */
html[data-theme] body .top{padding:14px 28px;background:color-mix(in srgb,var(--panel) 88%,transparent)!important;backdrop-filter:saturate(1.4) blur(14px);border-bottom:1px solid var(--border);box-shadow:none}
html[data-theme] body .top h1{font-size:21px;font-weight:700;letter-spacing:-.2px;color:var(--text)}
html[data-theme] body .top h1:after,html[data-theme] body .top h1:before{display:none!important}
html[data-theme] body .top small{display:block;color:var(--muted);font-size:13px;margin-top:2px}
html[data-theme] body .view{padding:28px}
html[data-theme] body .main{background:var(--bg)}

/* ---------- Buttons ---------- */
html[data-theme] body .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;padding:8px 14px;border-radius:var(--u-r-sm);border:1px solid var(--border);background:var(--panel)!important;color:var(--text)!important;font-size:13px;font-weight:600;line-height:1.2;box-shadow:0 1px 1px rgba(20,22,28,.04);transition:background .15s,border-color .15s,box-shadow .15s,transform .05s}
html[data-theme] body .btn:hover{border-color:color-mix(in srgb,var(--text) 22%,var(--border));background:var(--panel2)!important}
html[data-theme] body .btn:active{transform:translateY(1px)}
html[data-theme] body .btn:focus-visible,html[data-theme] body input:focus-visible,html[data-theme] body select:focus-visible,html[data-theme] body textarea:focus-visible{outline:none;box-shadow:0 0 0 3px var(--u-ring)}
html[data-theme] body .btn.primary,html[data-theme] body .btn.accent{background:linear-gradient(180deg,var(--u-brand),var(--u-brand-2))!important;border-color:var(--u-brand-2);color:#fff!important;box-shadow:0 1px 2px rgba(124,10,56,.35),inset 0 1px 0 rgba(255,255,255,.14)}
html[data-theme] body .btn.primary:hover{filter:brightness(1.07)}
html[data-theme] body .btn.danger,html[data-theme] body .btn.del{color:var(--u-bad)!important;background:var(--u-bad-bg)!important;border-color:color-mix(in srgb,var(--u-bad) 25%,transparent)}
html[data-theme] body .install-app-btn{background:var(--panel)!important;color:var(--u-gold)!important;border-color:color-mix(in srgb,var(--u-gold) 55%,var(--border))!important}
html[data-theme] body .theme-switcher{padding:3px;border-radius:11px;background:var(--panel2);border:1px solid var(--border)}
html[data-theme] body .theme-switcher button{border-radius:8px;font-size:12px;font-weight:600;color:var(--muted);background:transparent;border:0;padding:6px 10px}
html[data-theme] body .theme-switcher button.active,html[data-theme] body .theme-switcher button[aria-pressed="true"]{background:var(--panel);color:var(--text);box-shadow:0 1px 3px rgba(20,22,28,.14)}

/* ---------- Cards ---------- */
html[data-theme] body .card{background:var(--panel)!important;border:1px solid var(--border);border-radius:var(--u-r);padding:22px;margin-bottom:20px;box-shadow:var(--u-shadow)}
html[data-theme] body .card>h3,html[data-theme] body .card h3{margin:0 0 16px;font-size:15px;font-weight:700;letter-spacing:-.1px;text-transform:none;color:var(--text);display:flex;align-items:center;gap:8px}
html[data-theme] body .card h3:before{display:none!important}
html[data-theme] body .card small,html[data-theme] body .visual-meta{color:var(--muted);font-size:13px}
html[data-theme] body .card-headline{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px}
html[data-theme] body .card-headline h3{margin-bottom:3px}
html[data-theme] body .grid2{gap:20px}

/* ---------- Dashboard ---------- */
html[data-theme] body #view-dashboard>.report-toolbar{margin:0 0 16px;padding:0;background:none;border:0;box-shadow:none;min-height:0;display:flex;justify-content:flex-end}
html[data-theme] body #view-dashboard>.report-toolbar:before,html[data-theme] body #view-dashboard>.report-toolbar:after{content:none!important;display:none!important}
html[data-theme] body .dashboard-hero{position:relative;overflow:hidden;display:flex;justify-content:space-between;align-items:center;gap:24px;padding:28px 32px;margin-bottom:18px;border-radius:18px;border:0;color:#fff;background:radial-gradient(120% 160% at 100% 0%,rgba(168,14,77,.55),transparent 55%),linear-gradient(135deg,#171a22,#0e1015);box-shadow:var(--u-shadow)}
html[data-theme] body .dashboard-hero:after{content:"";position:absolute;right:-60px;bottom:-90px;width:260px;height:260px;border-radius:50%;border:1px solid rgba(226,187,98,.28);pointer-events:none}
html[data-theme] body .dashboard-hero .eyebrow{color:var(--u-gold);font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;margin-bottom:8px}
html[data-theme] body .dashboard-hero h2{margin:0 0 6px;font-size:26px;font-weight:700;letter-spacing:-.4px;color:#fff}
html[data-theme] body .dashboard-hero p{margin:0;color:#b6bdcb;font-size:14px;max-width:520px}
html[data-theme] body .hero-metrics{display:flex;gap:12px;position:relative;z-index:1}
html[data-theme] body .hero-metric{min-width:150px;padding:14px 18px;border-radius:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(6px)}
html[data-theme] body .hero-metric span{display:block;color:#aab2c2;font-size:12px;font-weight:600;letter-spacing:.4px;text-transform:uppercase}
html[data-theme] body .hero-metric b{display:block;margin-top:4px;font-size:22px;font-weight:700;color:#fff}
html[data-theme] body .dashboard-quickstrip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px}
html[data-theme] body .quick-action{display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:var(--u-r);border:1px solid var(--border);background:var(--panel);color:var(--text);text-align:left;box-shadow:var(--u-shadow);transition:border-color .15s,transform .15s}
html[data-theme] body .quick-action:hover{border-color:var(--u-brand);transform:translateY(-1px)}
html[data-theme] body .quick-action .qa-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:color-mix(in srgb,var(--u-brand) 10%,var(--panel));color:var(--u-brand);font-size:17px;flex:none}
html[data-theme] body .quick-action b{display:block;font-size:14px;font-weight:700}
html[data-theme] body .quick-action small{display:block;color:var(--muted);font-size:12.5px;margin-top:1px}
html[data-theme] body .stats{gap:16px;margin-bottom:20px}
html[data-theme] body .stat{position:relative;padding:18px 20px;border-radius:var(--u-r);border:1px solid var(--border);background:var(--panel)!important;box-shadow:var(--u-shadow);overflow:hidden}
html[data-theme] body .stat:before,html[data-theme] body .stat:after{display:none!important}
html[data-theme] body .stat>span{display:block;color:var(--muted);font-size:12px;font-weight:600;letter-spacing:.6px;text-transform:uppercase}
html[data-theme] body .stat>b{display:block;margin:6px 0 4px;font-size:26px;font-weight:700;letter-spacing:-.4px;color:var(--text);line-height:1.15}
html[data-theme] body .stat>b.accent{color:var(--u-brand)}
html[data-theme] body .stat>small{display:block;color:var(--muted);font-size:12.5px}
html[data-theme] body .dashboard-analytics{gap:20px;margin-bottom:20px}
html[data-theme] body .overview-grid{gap:12px}
html[data-theme] body .overview-item{padding:14px 16px;border-radius:12px;border:1px solid var(--border);background:var(--u-row)}
html[data-theme] body .overview-item span{display:block;color:var(--muted);font-size:12px;font-weight:600;letter-spacing:.3px;text-transform:uppercase}
html[data-theme] body .overview-item b{display:block;margin-top:4px;font-size:20px;font-weight:700}
html[data-theme] body .summary-lines>div{display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid var(--border);font-size:14px}
html[data-theme] body .summary-lines>div:last-child{border-bottom:0}
html[data-theme] body .summary-lines span{color:var(--muted)}
html[data-theme] body .summary-lines b{font-weight:600}
html[data-theme] body .dashboard-section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px}
html[data-theme] body .dashboard-section-head small{display:block;color:var(--muted);font-size:13px}

/* ---------- Tables & status pills ---------- */
html[data-theme] body .invoice-table-wrap{border:1px solid var(--border);border-radius:12px;overflow:auto;background:var(--panel)}
html[data-theme] body .dashboard-table{width:100%;border-collapse:collapse;font-size:14px}
html[data-theme] body .dashboard-table th{position:sticky;top:0;padding:12px 16px;text-align:left;color:var(--muted);background:var(--u-row);border-bottom:1px solid var(--border);font-size:12px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;white-space:nowrap}
html[data-theme] body .dashboard-table td{padding:14px 16px;border-bottom:1px solid var(--border);vertical-align:middle}
html[data-theme] body .dashboard-table tr:last-child td{border-bottom:0}
html[data-theme] body .dashboard-table tbody tr:hover td{background:var(--u-row)}
html[data-theme] body .dashboard-table td:nth-last-child(-n+3):not(:last-child),html[data-theme] body .dashboard-table th:nth-last-child(-n+3):not(:last-child){text-align:right}
html[data-theme] body .dashboard-table td:first-child{font-weight:700;white-space:nowrap}
html[data-theme] body .status-pill:not(.paper *){display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700;line-height:1.3;background:var(--u-neutral-bg);color:var(--u-neutral)}
html[data-theme] body .status-pill:not(.paper *):before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
html[data-theme] body .status-pill.status-paid:not(.paper *){background:var(--u-ok-bg);color:var(--u-ok)}
html[data-theme] body .status-pill.status-overdue:not(.paper *){background:var(--u-bad-bg);color:var(--u-bad)}
html[data-theme] body .status-pill.status-partial:not(.paper *){background:var(--u-warn-bg);color:var(--u-warn)}
html[data-theme] body .status-pill.status-sent:not(.paper *){background:var(--u-info-bg);color:var(--u-info)}
html[data-theme] body .status-pill.status-draft:not(.paper *){background:var(--u-neutral-bg);color:var(--u-neutral)}
html[data-theme] body .job-status-badge{font-size:12px;padding:4px 10px;font-weight:700}

/* ---------- Lists (activity, alerts, saved, clients, due) ---------- */
html[data-theme] body .saved{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:14px 16px;margin-bottom:10px;border:1px solid var(--border);border-radius:12px;background:var(--panel);font-size:14px;transition:border-color .15s,box-shadow .15s}
html[data-theme] body .saved:hover{border-color:color-mix(in srgb,var(--text) 18%,var(--border));box-shadow:var(--u-shadow)}
html[data-theme] body .saved .grow{flex:1 1 220px;min-width:0;font-weight:700}
html[data-theme] body .saved .meta{color:var(--muted);font-weight:500;font-size:13px}
html[data-theme] body .saved .btn{min-height:34px;padding:6px 12px}
html[data-theme] body .activity-list>*,html[data-theme] body .alert-list>*,html[data-theme] body .due-list>*,html[data-theme] body .attention-list>*{font-size:14px}
html[data-theme] body .activity-list small,html[data-theme] body .alert-list small,html[data-theme] body .due-list small,html[data-theme] body .attention-list small{font-size:12.5px;color:var(--muted)}

/* ---------- Forms ---------- */
html[data-theme] body :is(.main,.report-modal,.calendar-modal) label{display:block;margin:14px 0 6px;color:var(--muted);font-size:13px;font-weight:600}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) input,html[data-theme] body :is(.main,.report-modal,.calendar-modal) select,html[data-theme] body :is(.main,.report-modal,.calendar-modal) textarea{width:100%;min-height:42px;padding:10px 12px;border:1px solid var(--border);border-radius:var(--u-r-sm);background:var(--u-input)!important;color:var(--text)!important;font-size:14px;outline:none;transition:border-color .15s,box-shadow .15s}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) textarea{min-height:84px;line-height:1.5}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) input::placeholder,html[data-theme] body :is(.main,.report-modal,.calendar-modal) textarea::placeholder{color:color-mix(in srgb,var(--muted) 70%,transparent)}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) input:hover,html[data-theme] body :is(.main,.report-modal,.calendar-modal) select:hover,html[data-theme] body :is(.main,.report-modal,.calendar-modal) textarea:hover{border-color:color-mix(in srgb,var(--text) 24%,var(--border))}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) input:focus,html[data-theme] body :is(.main,.report-modal,.calendar-modal) select:focus,html[data-theme] body :is(.main,.report-modal,.calendar-modal) textarea:focus{border-color:var(--u-brand);box-shadow:0 0 0 3px var(--u-ring)}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) input[type=checkbox],html[data-theme] body :is(.main,.report-modal,.calendar-modal) input[type=radio]{width:auto;min-height:0;accent-color:var(--u-brand)}
html[data-theme] body :is(.main,.report-modal,.calendar-modal) input[type=file]{padding:8px;min-height:0;font-size:13px}
html[data-theme] body .item{padding:12px;border:1px solid var(--border);border-radius:12px;background:var(--u-row)}
html[data-theme] body .items-head{color:var(--muted);font-size:12px;font-weight:700;letter-spacing:.5px}
html[data-theme] body .template-picker{gap:12px}
html[data-theme] body .template-card{padding:14px;border:1px solid var(--border);border-radius:12px;background:var(--panel)!important;color:var(--text)!important;transition:border-color .15s,box-shadow .15s}
html[data-theme] body .template-card b,html[data-theme] body .template-card strong{color:var(--text)!important;font-size:14px}
html[data-theme] body .template-card small,html[data-theme] body .template-card span{color:var(--muted)!important;font-size:12.5px}
html[data-theme] body .template-card:hover{border-color:color-mix(in srgb,var(--text) 25%,var(--border))}
html[data-theme] body .template-card.selected{border-color:var(--u-brand);box-shadow:0 0 0 3px var(--u-ring)}

/* ---------- Modals, toast ---------- */
html[data-theme] body .report-modal,html[data-theme] body .calendar-modal{background:rgba(12,13,17,.55);backdrop-filter:blur(6px)}
html[data-theme] body .report-dialog,html[data-theme] body .calendar-dialog{background:var(--panel);color:var(--text);border:1px solid var(--border);border-radius:18px;box-shadow:0 30px 80px -20px rgba(0,0,0,.45)}
html[data-theme] body .report-head,html[data-theme] body .calendar-dialog-head{background:var(--panel);border-bottom:1px solid var(--border)}
html[data-theme] body .report-head h3,html[data-theme] body .calendar-dialog-head h3{font-size:17px;color:var(--text)}
html[data-theme] body .report-head small,html[data-theme] body .calendar-dialog-head small{color:var(--muted);font-size:13px}
html[data-theme] body .report-filters{background:var(--u-row);border:1px solid var(--border);border-radius:12px}
html[data-theme] body .toast{background:#15171d;color:#fff;border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:12px 16px;font-size:14px;box-shadow:0 14px 40px -12px rgba(0,0,0,.5)}

/* ---------- Calendar ---------- */
html[data-theme] body .calendar-month-title{font-size:20px;font-weight:700;color:var(--text)}
html[data-theme] body .calendar-grid{gap:8px}
html[data-theme] body .calendar-weekday{color:var(--muted);font-size:12px;font-weight:700;letter-spacing:.6px}
html[data-theme] body .calendar-day{min-height:116px;padding:9px;border:1px solid var(--border);border-radius:12px;background:var(--panel)}
html[data-theme] body .calendar-day.today{border-color:var(--u-brand);box-shadow:inset 0 0 0 1px var(--u-brand)}
html[data-theme] body .calendar-day-number{color:var(--text);font-size:13px;font-weight:700}
html[data-theme] body .calendar-event{border:1px solid color-mix(in srgb,var(--u-brand) 25%,var(--border));background:color-mix(in srgb,var(--u-brand) 8%,var(--panel));color:var(--text);border-radius:8px;padding:6px 8px}
html[data-theme] body .calendar-event .event-no{font-size:12px}
html[data-theme] body .calendar-event .event-client,html[data-theme] body .calendar-event .event-cat{font-size:11.5px;color:var(--muted)}
html[data-theme] body .calendar-list-row{border-bottom:1px solid var(--border)}
html[data-theme] body .calendar-list-main b{font-size:14px}
html[data-theme] body .calendar-list-main small,html[data-theme] body .calendar-list-date small,html[data-theme] body .calendar-list-right small{font-size:12px;color:var(--muted)}

/* ---------- Sign-in gate (server-injected markup, styling only) ---------- */
html body #fbiAuthGate{background:radial-gradient(90% 70% at 15% 0%,rgba(168,14,77,.35),transparent 60%),radial-gradient(70% 60% at 100% 100%,rgba(179,137,58,.18),transparent 60%),#0c0d11;font-family:Inter,ui-sans-serif,-apple-system,"Segoe UI",Roboto,Arial,sans-serif}
html body .fbi-auth-card{width:min(440px,100%);padding:34px 32px;border-radius:22px;border:1px solid rgba(255,255,255,.1);background:linear-gradient(180deg,rgba(26,29,37,.92),rgba(16,18,24,.96));box-shadow:0 40px 90px -30px rgba(0,0,0,.8),inset 0 1px 0 rgba(255,255,255,.06);backdrop-filter:blur(10px)}
html body .fbi-auth-brand{margin-bottom:26px;gap:14px}
html body .fbi-auth-brand img{width:52px;height:52px;border-radius:13px;background:#0c0d11;padding:3px;box-shadow:0 0 0 1px rgba(226,187,98,.35)}
html body .fbi-auth-brand strong{font-size:14px;letter-spacing:2px;color:#fff}
html body .fbi-auth-brand span{color:#e2bb62;font-size:11px;letter-spacing:1.8px;font-weight:600}
html body .fbi-auth-card h1{font-size:26px;font-weight:700;letter-spacing:-.4px;color:#fff}
html body .fbi-auth-card p{color:#a7aebd;font-size:14px}
html body .fbi-auth-label{color:#c9cfdb;font-size:13px;font-weight:600}
html body .fbi-auth-label input,html body .fbi-auth-label select{min-height:46px;border:1px solid #333a49;background:#0e1015!important;color:#fff!important;border-radius:12px;font-size:15px}
html body .fbi-auth-label input:focus,html body .fbi-auth-label select:focus{border-color:#d3235f;box-shadow:0 0 0 3px rgba(211,35,95,.25)}
html body .fbi-auth-primary{min-height:48px;margin-top:6px;border-radius:12px;background:linear-gradient(180deg,#c01c5c,#8d0c40);font-size:15px;font-weight:700;letter-spacing:.2px;box-shadow:0 10px 24px -10px rgba(211,35,95,.7),inset 0 1px 0 rgba(255,255,255,.18)}
html body .fbi-auth-primary:hover{filter:brightness(1.08)}
html body .fbi-auth-link{color:#c9cfdb;font-size:13px}
html body .fbi-auth-error{font-size:13px}

/* ---------- Scrollbars & small polish ---------- */
html[data-theme] body *{scrollbar-width:thin;scrollbar-color:color-mix(in srgb,var(--muted) 45%,transparent) transparent}
html[data-theme] body ::selection{background:var(--u-ring)}

/* ---------- Responsive ---------- */
@media(max-width:1180px){html[data-theme] body .dashboard-quickstrip{grid-template-columns:repeat(2,minmax(0,1fr))}html[data-theme] body .dashboard-hero{flex-wrap:wrap}}
@media(max-width:950px){html[data-theme] body .view{padding:18px}html[data-theme] body .top{padding:12px 16px}html[data-theme] body .card{padding:18px}}
@media(max-width:600px){html[data-theme] body .dashboard-quickstrip{grid-template-columns:1fr}html[data-theme] body .dashboard-hero{padding:22px 20px}html[data-theme] body .hero-metrics{width:100%}html[data-theme] body .hero-metric{flex:1;min-width:0}html[data-theme] body .stat>b{font-size:22px}html[data-theme] body .top h1{font-size:18px}}
@media print{html[data-theme] body .side,html[data-theme] body .top{display:none!important}}

/* ---------- Overrides for old !important rules ---------- */
html[data-theme] body section#view-dashboard .dashboard-hero{background:radial-gradient(120% 160% at 100% 0%,rgba(168,14,77,.55),transparent 55%),linear-gradient(135deg,#171a22,#0e1015)!important;border:0!important;color:#fff!important;padding:28px 32px!important;border-radius:18px!important;box-shadow:var(--u-shadow)!important}
html[data-theme] body section#view-dashboard .dashboard-hero h2{color:#fff!important;font-size:26px!important;margin:0 0 6px!important;letter-spacing:-.4px}
html[data-theme] body section#view-dashboard .dashboard-hero p{color:#b6bdcb!important;font-size:14px!important;line-height:1.5}
html[data-theme] body section#view-dashboard .dashboard-hero .eyebrow{color:var(--u-gold)!important;font-size:12px!important;letter-spacing:1.4px!important}
html[data-theme] body section#view-dashboard .dashboard-hero>div:first-child{background:none!important;color:#fff!important}
html[data-theme] body section#view-dashboard .hero-metric{background:rgba(255,255,255,.07)!important;border:1px solid rgba(255,255,255,.14)!important;border-radius:14px!important}
html[data-theme] body section#view-dashboard .hero-metric span{color:#aab2c2!important;font-size:12px!important}
html[data-theme] body section#view-dashboard .hero-metric b{color:#fff!important;font-size:22px!important}
/* readable type sizes (old passes used 7-10px) */
html[data-theme] body .dashboard-table td{font-size:14px!important;color:var(--text)!important;padding:14px 16px!important}
html[data-theme] body .dashboard-table th{font-size:12px!important;padding:12px 16px!important;color:var(--muted)!important;background:var(--u-row)!important}
html[data-theme] body .dashboard-table td:nth-child(2){color:var(--text)!important}
html[data-theme] body .dashboard-table td b{font-size:14px!important;color:var(--text)!important}
html[data-theme] body .dashboard-table td:nth-last-child(-n+3):not(:last-child),html[data-theme] body .dashboard-table th:nth-last-child(-n+3):not(:last-child){text-align:right}
html[data-theme] body .activity-row{gap:12px!important;padding:12px 0!important;border-bottom:1px solid var(--border)!important}
html[data-theme] body .activity-row b{font-size:14px!important;color:var(--text)!important}
html[data-theme] body .activity-row small{font-size:12.5px!important;color:var(--muted)!important}
html[data-theme] body .activity-row strong{font-size:13px!important;color:var(--text)!important}
html[data-theme] body .alert-row,html[data-theme] body .attention-row,html[data-theme] body .due-row{font-size:14px!important}
html[data-theme] body .overview-item,html[data-theme] body .saved,html[data-theme] body .item{background:var(--u-row)!important;border-color:var(--border)!important}
html[data-theme] body .saved{background:var(--panel)!important}
html[data-theme] body .stat span,html[data-theme] body .stat small{font-size:12.5px!important}
html[data-theme] body .stat span{font-size:12px!important}
html[data-theme] body .stat b{font-size:26px!important;color:var(--text)!important}
html[data-theme] body .stat b.accent{color:var(--u-brand)!important}
html[data-theme] body .card-headline>span{font-size:12px!important;color:var(--muted)!important}
html[data-theme] body .pulse-bars span,html[data-theme] body .pulse-bars small{font-size:12px!important;color:var(--muted)!important}
html[data-theme] body section#view-dashboard .dashboard-hero>div:first-child h2{color:#fff!important;-webkit-text-fill-color:#fff!important;text-shadow:none!important}
html[data-theme] body #view-dashboard:before{content:none!important;display:none!important}
html[data-theme] body .dashboard-analytics{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr) minmax(0,1fr)}
html[data-theme] body .due-item,html[data-theme] body .attention-item{display:flex;align-items:center;gap:12px;padding:12px 0!important;border-bottom:1px solid var(--border)!important}
html[data-theme] body .due-item:last-child,html[data-theme] body .attention-item:last-child{border-bottom:0!important}
html[data-theme] body .due-item .grow,html[data-theme] body .attention-item .grow{flex:1;min-width:0}
html[data-theme] body .due-item b,html[data-theme] body .attention-item b{display:block;font-size:14px!important;font-weight:700;color:var(--text)!important}
html[data-theme] body .due-item small,html[data-theme] body .attention-item small{display:block;font-size:12.5px!important;color:var(--muted)!important;margin-top:2px}
html[data-theme] body .attention-icon{display:grid;place-items:center;width:36px;height:36px;flex:none;border-radius:10px;background:var(--u-warn-bg)!important;color:var(--u-warn)!important;font-size:16px}
html[data-theme] body .activity-dot{flex:none;width:8px!important;height:8px!important;margin-top:7px!important;background:var(--u-gold)!important}
html[data-theme] body .overview-item span{font-size:11.5px!important;letter-spacing:.3px}
html[data-theme] body .alert-list>*,html[data-theme] body .alert-row{display:flex;gap:10px;align-items:flex-start;padding:12px 0;border-bottom:1px solid var(--border)}
html[data-theme] body .alert-list b{font-size:14px!important;color:var(--text)!important}
html[data-theme] body .alert-list small{font-size:12.5px!important;color:var(--muted)!important}
@media(max-width:1180px){html[data-theme] body .dashboard-analytics{grid-template-columns:1fr 1fr}}
@media(max-width:700px){html[data-theme] body .dashboard-analytics{grid-template-columns:1fr}}
/* ---------- Inline-styled dark boxes & tiny hints (app screens only; never the printable invoice) ---------- */
html[data-theme] body :is(#view-create,#view-clients,#view-saved,#view-completed,#view-receipts,#view-settings,#view-whatsapp,#view-calendar,#view-dashboard) :is([style*="background:#0b"],[style*="background:#0d"],[style*="background:#0e"],[style*="background:#10"],[style*="background:#11"],[style*="background:#12"]){background:var(--u-row)!important;border-color:var(--border)!important;border-radius:12px!important;color:var(--text)!important}
html[data-theme] body :is(#view-create,#view-clients,#view-saved,#view-completed,#view-receipts,#view-settings,#view-whatsapp,#view-calendar) [style*="color:#fff"]{color:var(--text)!important}
html[data-theme] body :is(#view-create,#view-clients,#view-saved,#view-completed,#view-receipts,#view-settings,#view-whatsapp,#view-calendar) :is([style*="font-size:8px"],[style*="font-size:9px"],[style*="font-size:10px"],[style*="font-size:11px"]){font-size:13px!important;color:var(--muted)}
html[data-theme] body #eventDateHint{padding:12px 14px!important;font-size:13px!important;color:var(--muted)!important}
html[data-theme] body #paymentHistoryPanel{padding:14px 16px!important;border-radius:12px!important}
html[data-theme] body #paymentHistoryPanel *{font-size:13px!important;color:var(--text);border-color:var(--border)!important}
html[data-theme] body #paymentHistoryPanel div[style*="color:#7"]{color:var(--muted)!important}
html[data-theme] body #paymentBalancePreview{font-size:20px!important;color:var(--text)!important}
html[data-theme] body .item .rm{min-height:36px;width:36px;padding:0;border-radius:10px;border:1px solid color-mix(in srgb,var(--u-bad) 30%,transparent);background:var(--u-bad-bg)!important;color:var(--u-bad)!important;font-size:14px}
html[data-theme] body #view-calendar .card [style*="line-height:1.6"]{font-size:13px!important;line-height:1.6!important}
html[data-theme] body .card h3 small{font-size:12px;font-weight:500;color:var(--muted)}
html[data-theme] body .card-headline>span{white-space:nowrap}
@media(max-width:700px){
html[data-theme] body .top{flex-wrap:wrap;align-items:center;padding:10px 14px;row-gap:8px}
html[data-theme] body .top>div:first-child{flex:1 1 100%;min-width:0}
html[data-theme] body .top>div:last-child{flex:1 1 100%;justify-content:flex-start;gap:6px}
html[data-theme] body .top small{font-size:12.5px}
html[data-theme] body section#view-dashboard .hero-metrics{flex-direction:column;width:100%}
html[data-theme] body section#view-dashboard .hero-metric{min-width:0;width:100%}
html[data-theme] body section#view-dashboard .hero-metric b{font-size:20px!important}
html[data-theme] body .report-toolbar{justify-content:stretch}
html[data-theme] body .report-toolbar .btn{width:100%}
}
html[data-theme] body .top{height:auto!important;min-height:68px}

/* The printable invoice / receipt must render exactly as before: undo any inherited UI typography on it. */
html[data-theme] body :is(.paper,.receipt-paper,.preview-wrap){line-height:normal;font-variant-numeric:normal;-webkit-font-smoothing:auto}
</style>
</head>
<body>
<aside class="side" id="side">
  <div class="brand"><img class="brand-logo" src="/assets/fbi-logo.png" alt="Film Beyond Imagination logo"><div>Invoice Studio<small>Professional invoicing system</small></div></div>
  <div class="nav">
    <div class="nav-group" role="group" aria-label="Invoicing"><div class="nav-heading">Invoicing</div>
    <button type="button" class="nav-link active" data-v="dashboard" onclick="show('dashboard')"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg><span>Overview</span></button>
    <button type="button" class="nav-link" data-v="create" onclick="show('create')"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M12 11.5v6M9 14.5h6"/></svg><span>Create invoice</span></button>
    <button type="button" class="nav-link" data-v="saved" onclick="show('saved')"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5H10l2 2.5h6.5A2.5 2.5 0 0 1 21 10v7.5a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z"/></svg><span>Invoices</span></button>
    <button type="button" class="nav-link" data-v="quotes" onclick="show('quotes')"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M14 3v5h5M8.5 13h7M8.5 17h4"/></svg><span>Quotations</span></button>
    <button type="button" class="nav-link" data-v="receipts" onclick="show('receipts')"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h14v18l-2.3-1.6L14.3 21 12 19.4 9.7 21l-2.4-1.6L5 21z"/><path d="M8.5 8h7M8.5 12h7M8.5 16h4"/></svg><span>Receipts</span></button>
    <button type="button" class="nav-link" data-v="completed" onclick="show('completed')"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12.3 2.6 2.6L16 9.5"/></svg><span>Jobs</span></button>
    <button type="button" class="nav-link" data-v="calendar" onclick="show('calendar')"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16.5" rx="2.5"/><path d="M8 2.5v4M16 2.5v4M3 10h18"/></svg><span>Calendar</span></button>
    </div>
    <div class="nav-group" role="group" aria-label="People"><div class="nav-heading">People</div>
    <button type="button" class="nav-link" data-v="clients" onclick="show('clients')"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.7a3.5 3.5 0 0 1 0 6.6M18.5 14.4c1.7.8 3 2.6 3 5.6"/></svg><span>Clients</span></button>
    <button type="button" class="nav-link" data-v="payroll" onclick="window.__FBI_NAV__ ? window.__FBI_NAV__('payroll') : (window.__FBI_PAYROLL_OPEN__ && window.__FBI_PAYROLL_OPEN__())"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18"/><circle cx="16.5" cy="14.5" r="1.2"/></svg><span>Payroll</span></button>
    </div>
    <div class="nav-group" role="group" aria-label="Setup"><div class="nav-heading">Setup</div>
    <button type="button" class="nav-link" data-v="settings" onclick="show('settings')"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg><span>Business settings</span></button>
    </div>
  </div>
  <div class="sidefoot"><span class="sf-dot" aria-hidden="true"></span><span>Saved to the cloud · backed up daily</span></div>
</aside>
<main class="main">
<header class="top no-print">
  <div style="display:flex;align-items:center;gap:10px"><button class="btn hamb" style="display:none" onclick="side.classList.toggle('open')">☰</button><div><h1 id="title">Overview</h1><small id="subtitle">Your invoicing control center</small></div></div>
  <div style="display:flex;align-items:center;gap:7px;flex-wrap:wrap"><button id="installAppBtn" class="btn install-app-btn" type="button" onclick="installFBIApp()">⬇ Install App</button><button class="btn ui-search-btn" type="button" onclick="openCommandPalette()" aria-label="Search invoices and clients"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg><span>Search invoices, clients…</span><kbd>Ctrl K</kbd></button><button class="btn primary ui-new-btn" type="button" onclick="newInvoice()">＋ New invoice</button><div class="theme-switcher no-print" role="group" aria-label="Appearance"><button type="button" class="theme-choice" data-theme-choice="light" onclick="setThemePreference('light')" aria-label="Light mode" title="Light mode">☀️<span>Light</span></button><button type="button" class="theme-choice" data-theme-choice="dark" onclick="setThemePreference('dark')" aria-label="Dark mode" title="Dark mode">🌙<span>Dark</span></button><button type="button" class="theme-choice" data-theme-choice="system" onclick="setThemePreference('system')" aria-label="System mode" title="Follow device theme">⚙️<span>System</span></button></div><button id="fbiSignOutBtn" class="btn no-print" type="button" onclick="fbiSignOut()" aria-label="Sign out" title="Sign out" style="width:38px;height:38px;padding:0;display:inline-flex;align-items:center;justify-content:center;border-radius:9px;font-size:0"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4"/><path d="M15 17l5-5-5-5"/><path d="M20 12H9"/></svg></button></div>
</header>
<script>window.fbiSignOut=async function(){var b=document.getElementById("fbiSignOutBtn");if(b)b.disabled=true;try{var r=await fetch("/api/auth/logout",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},cache:"no-store"});if(!r.ok)throw new Error("Sign out failed");window.location.reload();}catch(e){if(b)b.disabled=false;try{toast(e.message||"Sign out failed");}catch(_){} }};</script>

<section class="view active" id="view-dashboard">
  <div class="ov-head">
    <div><h2 class="ov-greet" id="ovGreeting">Welcome back</h2><p class="ov-date" id="ovToday"></p></div>
    <div class="ov-actions no-print">
      <button class="btn" type="button" onclick="openReportModal()">Business report</button>
      <button class="btn" type="button" onclick="show('clients')">Add client</button>
      <button class="btn primary" type="button" onclick="newInvoice()">＋ New invoice</button>
    </div>
  </div>

  <div class="ov-money">
    <div class="card ov-owed">
      <div class="ov-owed-top"><span>Money owed to FBI</span><button class="ov-link" type="button" onclick="openInvoicesFiltered('open')">See open invoices</button></div>
      <b class="ov-owed-amt" id="sDue">GH₵0.00</b>
      <small class="ov-owed-meta" id="sDueMeta">0 invoices</small>
      <div class="ov-reel" id="ovReel" role="img" aria-label="Who owes the most"></div>
      <ul class="ov-reel-legend" id="ovReelLegend"></ul>
    </div>
    <div class="ov-tiles">
      <button class="ov-tile" type="button" onclick="openInvoicesFiltered('Paid')"><span>Collected</span><b id="sPaid">GH₵0.00</b><small id="sPaidMeta">0 received</small></button>
      <button class="ov-tile" type="button" onclick="openInvoicesFiltered('')"><span>Invoiced</span><b id="sInvoiced">GH₵0.00</b><small id="sInvoicedMeta">All saved invoices</small></button>
      <button class="ov-tile ov-tile-bad" type="button" onclick="openInvoicesFiltered('Overdue')"><span>Overdue</span><b id="sOverdue">GH₵0.00</b><small id="sOverdueMeta">0 invoices</small></button>
      <button class="ov-tile" type="button" onclick="openInvoicesFiltered('open')"><span>Due in the next 7 days</span><b id="sDueSoon">GH₵0.00</b><small id="sDueSoonMeta">Next 7 days</small></button>
    </div>
  </div>

  <div class="ov-grid">
    <div class="card ov-panel">
      <div class="ov-panel-head"><h3>Needs attention</h3></div>
      <div id="attentionList" class="attention-list"></div>
    </div>
    <div class="card ov-panel">
      <div class="ov-panel-head"><h3>Payments due</h3><button class="ov-link" type="button" onclick="openInvoicesFiltered('open')">All open</button></div>
      <div id="dueList" class="due-list"></div>
    </div>
    <div class="card ov-panel">
      <div class="ov-panel-head"><h3>Invoiced by month</h3><small id="pulseMeta">Six-month invoiced volume</small></div>
      <div id="revenuePulse" class="pulse-bars" aria-label="Invoiced amount over the last six months"></div>
    </div>
  </div>

  <div class="card recent ov-recent">
    <div class="ov-panel-head"><h3>Recent invoices</h3><button class="ov-link" type="button" onclick="show('saved')">View all invoices</button></div>
    <div class="invoice-table-wrap">
      <table class="dashboard-table">
        <thead><tr><th>Invoice</th><th>Client</th><th>Date</th><th>Due</th><th>Status</th><th class="num">Amount</th><th class="num">Balance</th><th></th></tr></thead>
        <tbody id="recent"></tbody>
      </table>
    </div>
  </div>

  <!-- Figures still calculated by the app but not shown in this layout -->
  <div hidden aria-hidden="true">
    <b id="heroCollected"></b><b id="heroOpen"></b>
    <b id="sCount"></b><small id="sCountMeta"></small><b id="sDraft"></b><small id="sDraftMeta"></small><b id="sClients"></b><small id="sClientsMeta"></small>
    <div id="dashboardActivity"></div><div id="dashboardAlerts"></div>
    <b id="ovSent"></b><b id="ovPartial"></b><b id="ovPaid"></b><b id="ovOverdue"></b><b id="ovDraft"></b><b id="ovCollection"></b><b id="ovAverage"></b><b id="ovRentals"></b>
    <b id="sumClients"></b><b id="sumClientInvoices"></b><b id="sumNoClient"></b><b id="sumLatest"></b><b id="sumLatestClient"></b>
  </div>
</section>


<!-- Overview Reports Modal -->
<div class="report-modal no-print" id="reportModal" aria-hidden="true">
  <div class="report-dialog">
    <div class="report-head">
      <div><h3>Overview Report Generator</h3><small>Generate a report from your saved Invoice Studio records.</small></div>
      <button class="btn" type="button" onclick="closeReportModal()">✕ Close</button>
    </div>
    <div class="report-body">
      <div class="report-filters">
        <div><label>From Date</label><input id="reportFrom" type="date"></div>
        <div><label>To Date</label><input id="reportTo" type="date"></div>
        <div><label>Status</label><select id="reportStatus"><option value="">All Statuses</option><option value="Draft">Draft</option><option value="Sent">Sent</option><option value="Partially Paid">Partially Paid</option><option value="Paid">Paid</option><option value="Overdue">Overdue</option></select></div>
        <div><label>Client</label><select id="reportClient"><option value="">All Clients</option></select></div>
        <div><label>Category</label><select id="reportCategory"><option value="">All Categories</option></select></div>
      </div>
      <div class="report-actions">
        <button class="btn" type="button" onclick="resetReportFilters()">Reset</button>
        <button class="btn" type="button" onclick="updateReportPreview()">Refresh Report</button>
        <button class="btn" type="button" onclick="exportReportCsv()">⬇ Export CSV</button><button class="btn" type="button" onclick="exportReportExcel()">⬇ Excel</button>
        <button class="btn primary" type="button" onclick="printOverviewReport()">🖨 Print / Save PDF</button>
      </div>
      <div class="report-preview" id="reportPreview"></div>
    </div>
  </div>
</div>

<section class="view cx" id="view-create">
<!-- Create Invoice — v3 workspace layout (UI only). Every input keeps its original id,
     so saving, loading, printing and the database are untouched. -->
<div class="qt-banner no-print" id="quoteBanner" hidden>
  <div class="qt-banner-main"><b id="qtBannerTitle">New quotation</b><small id="qtBannerMeta">Not saved yet — it gets a quotation number when you save.</small></div>
  <div class="qt-banner-fields">
    <label>Print as<select id="qtDocType"><option value="QUOTATION">Quotation</option><option value="PRO-FORMA INVOICE">Pro-forma invoice</option></select></label>
    <label>Valid until<input id="qtValidUntil" type="date"></label>
    <label>Status<select id="qtStatus"><option>Draft</option><option>Sent</option><option>Accepted</option><option>Declined</option><option>Expired</option></select></label>
  </div>
  <div class="qt-banner-actions"><button class="btn primary" type="button" onclick="convertCurrentQuote()">Convert to invoice</button><button class="btn" type="button" onclick="exitQuoteMode(true)">Close</button></div>
</div>
<nav class="cx-steps no-print" id="cxSteps" aria-label="Invoice sections">
  <a href="#cxClient" data-cx-step="cxClient"><i>1</i>Client &amp; details</a>
  <a href="#invoiceItemsCard" data-cx-step="invoiceItemsCard"><i>2</i>Items</a>
  <a href="#cxJob" data-cx-step="cxJob" id="cxJobStep"><i>3</i>Event / rental</a>
  <a href="#cxPayment" data-cx-step="cxPayment"><i>4</i>Payment terms</a>
  <a href="#paymentReceivedCard" data-cx-step="paymentReceivedCard"><i>5</i>Receipt</a>
</nav>

<div class="cx-layout">
<div class="cx-main">

  <!-- 1 · CLIENT + INVOICE DETAILS -->
  <div class="card cx-card" id="cxClient">
    <div class="cx-head"><h3><span class="cx-num">1</span>Client &amp; invoice details</h3></div>
    <div class="cx-split">
      <div class="cx-col">
        <div class="cx-sub">Bill to</div>
        <div class="cx-inline">
          <div class="cx-f cx-grow"><label for="clientSelect">Existing client</label><select id="clientSelect" onchange="applySelectedClient()"><option value="">— New / Manual Client —</option></select></div>
          <button class="btn" type="button" onclick="saveCurrentClient()" title="Save these client details to the database">Save client</button>
          <button class="btn cx-icon" type="button" onclick="show('clients')" title="Open the client database">＋</button>
        </div>
        <div class="cx-grid2">
          <div class="cx-f"><label for="client">Client name</label><input id="client" placeholder="Client or company name"></div>
          <div class="cx-f"><label for="clientPhone">Phone</label><input id="clientPhone"></div>
          <div class="cx-f"><label for="clientEmail">Email</label><input id="clientEmail"></div>
          <div class="cx-f"><label for="clientAddress">Address</label><textarea id="clientAddress" rows="1"></textarea></div>
        </div>
      </div>
      <div class="cx-col">
        <div class="cx-sub">Invoice</div>
        <div class="cx-grid2">
          <div class="cx-f"><label for="no">Invoice number</label><input id="no" readonly aria-readonly="true" title="Invoice numbers are assigned automatically"></div>
          <div class="cx-f"><label for="status">Status</label><select id="status"><option>Draft</option><option>Sent</option><option>Paid</option><option>Partially Paid</option><option>Overdue</option></select></div>
          <div class="cx-f"><label for="date">Invoice date</label><input id="date" type="date"></div>
          <div class="cx-f"><label for="due">Due</label><input id="due" type="text" value="On Receipt"></div>
          <div class="cx-f"><label for="cur">Currency</label><select id="cur"><option>GHS</option><option>USD</option><option>EUR</option><option>GBP</option></select></div>
          <div class="cx-f"><label for="template">Invoice design</label><select id="template"><option value="classic">Classic Professional</option><option value="modern">Modern Studio</option><option value="minimal">Minimal Executive</option><option value="bold">Bold Premium</option><option value="elegant">Elegant Creative</option></select></div>
        </div>
        <details class="cx-more">
          <summary>Quick design styles</summary>
          <div class="template-picker no-print">
<div class="template-card" data-template-card="classic"><b>Classic</b><span>Clean business layout</span></div>
<div class="template-card" data-template-card="modern"><b>Modern</b><span>Contemporary studio look</span></div>
<div class="template-card" data-template-card="minimal"><b>Minimal</b><span>Quiet executive style</span></div>
<div class="template-card" data-template-card="bold"><b>Bold</b><span>Strong premium header</span></div>
<div class="template-card" data-template-card="elegant"><b>Elegant</b><span>Refined creative style</span></div>
          </div>
        </details>
      </div>
    </div>
  </div>

  <!-- 2 · ITEMS (catalog picker + line items together) -->
  <div class="card cx-card" id="invoiceItemsCard">
    <div class="cx-head"><h3><span class="cx-num">2</span>Services &amp; items</h3><small id="catalogCount" class="cx-count"></small></div>

    <div class="cx-catalog service-selector-card" id="catalogPanel">
      <div class="cx-catalog-filters">
        <div class="cx-f"><label for="serviceCategory">Service category</label><select id="serviceCategory"><option value="">Select a service category...</option></select></div>
        <div class="cx-f"><label for="brandModelFilter">Section</label><select id="brandModelFilter"><option value="">All sections</option></select></div>
        <div class="cx-f"><label for="itemSearch">Search the catalogue</label><input id="itemSearch" type="search" placeholder="e.g. FX6, softbox, PoE switch, smart lock" autocomplete="off"></div>
      </div>
      <div class="cx-catalog-pick">
        <div class="cx-f cx-grow"><label for="catalogItemSelect">Catalogue <span class="cx-hint">— double-click an item, or press Enter in search, to add it</span></label><select id="catalogItemSelect" size="10"><option value="">Select a category first...</option></select></div>
        <div class="cx-catalog-actions">
          <button type="button" class="btn primary" id="addSelectedCatalogBtn">＋ Add Selected Item</button>
          <button type="button" class="btn" id="addCategoryItemsBtn">＋ Add whole section</button>
        </div>
      </div>
    </div>

    <div class="cx-lines">
      <div class="items-head"><div>Description</div><div id="rateHeader">Rate / Day</div><div class="days-col">Days</div><div>Qty</div><div>Amount</div><div></div></div>
      <div id="items"></div>
      <button class="btn cx-add" type="button" onclick="addItem()">＋ Add custom line</button>
    </div>

    <div class="cx-totals">
      <div class="cx-f"><label for="tax">Tax (%)</label><input id="tax" type="number" min="0" step=".01" value="20" oninput="calc()"></div>
      <div class="cx-f"><label for="discount">Discount</label><input id="discount" type="number" min="0" step=".01" value="0" oninput="calc()"></div>
      <div class="cx-grand"><span>Total</span><b id="total">GHS 0.00</b></div>
    </div>
  </div>

  <!-- 3 · EVENT / RENTAL (shown automatically for the categories that need them) -->
  <div id="cxJob" class="cx-job">
    <div class="card cx-card" id="eventDateCard" style="display:none">
      <div class="cx-head"><h3><span class="cx-num">3</span>Event details <small>Required for media invoices</small></h3></div>
      <div class="cx-grid3">
        <div class="cx-f"><label for="eventDate">Event start date</label><input id="eventDate" type="date"></div>
        <div class="cx-f"><label for="eventEndDate">Event end date</label><input id="eventEndDate" type="date"></div>
        <div class="cx-note" id="eventDateHint">Select the start and end dates for this event.</div>
      </div>
    </div>
    <div class="card cx-card" id="rentalDetailsCard" style="display:none">
      <div class="cx-head"><h3><span class="cx-num">3</span>Equipment rental details</h3></div>
      <div class="cx-grid3">
        <div class="cx-f"><label for="rentalStart">Rental start</label><input id="rentalStart" type="date"></div>
        <div class="cx-f"><label for="rentalEnd">Rental end / return</label><input id="rentalEnd" type="date"></div>
        <div class="cx-f"><label for="rentalUnit">Pricing unit</label><select id="rentalUnit"><option>Per Hour</option><option selected>Per Day</option><option>Per Week</option><option>Per Month</option><option>Per Event</option></select></div>
        <div class="cx-f"><label for="jobLocation">Job / delivery location</label><input id="jobLocation" placeholder="Event venue / production location"></div>
        <div class="cx-f"><label for="rentalRef">Agreement / reference</label><input id="rentalRef" placeholder="Agreement or booking reference"></div>
        <div class="cx-f"><label for="deposit">Security deposit</label><input id="deposit" type="number" min="0" step=".01" value="0"></div>
      </div>
    </div>
  </div>

  <!-- 4 · PAYMENT TERMS & NOTES -->
  <div class="card cx-card" id="cxPayment">
    <div class="cx-head"><h3><span class="cx-num">4</span>Payment terms &amp; notes</h3></div>
    <div class="cx-split">
      <div class="cx-f"><label for="payment">Payment info (bank / MoMo)</label><textarea id="payment" rows="6" placeholder="Bank Name: Cal Bank&#10;Account Name: FILM BEYOND IMAGINATION (FBI)&#10;Account Number: 1400010238562&#10;Branch: Dansoman&#10;&#10;Momo service Name: MTN&#10;Momo Number: 0257407350&#10;Account Name: Jerbel Mark Addeh"></textarea></div>
      <div class="cx-f"><label for="notes">Additional notes</label><textarea id="notes" rows="4" placeholder="Optional — shown on the invoice"></textarea>
        <label class="cx-check" title="Set automatically from the Tax (%) field"><input id="vatInclusive" type="checkbox" checked disabled> Note on invoice: <b>This invoice is VAT inclusive.</b> <span class="cx-hint">— automatic: on when Tax (%) is above 0, off at 0</span></label>
      </div>
    </div>
  </div>

  <!-- 5 · PAYMENT RECEIVED & RECEIPT (opened when you need it) -->
  <details class="card cx-card cx-collapsible" id="paymentReceivedCard">
    <summary class="cx-head"><h3><span class="cx-num">5</span>Payment received &amp; official receipt</h3><span class="cx-summary-meta">Balance <b id="paymentBalancePreview">GH₵0.00</b></span></summary>
    <div class="cx-grid3">
      <div class="cx-f"><label for="amountPaid">Amount paid (new payment)</label><input id="amountPaid" type="number" min="0" step="0.01" value="0" placeholder="0.00"></div>
      <div class="cx-f"><label for="paymentDate">Payment date</label><input id="paymentDate" type="date"></div>
      <div class="cx-f"><label for="paymentMethod">Payment method</label><select id="paymentMethod"><option>Cash</option><option selected>Mobile Money</option><option>Bank Transfer</option><option>Card</option><option>Cheque</option><option>Other</option></select></div>
      <div class="cx-f"><label for="transactionRef">Transaction reference</label><input id="transactionRef" placeholder="Bank / MoMo / card / payment reference"></div>
      <div class="cx-f"><label for="receivedBy">Received by</label><input id="receivedBy" placeholder="Accounts / Cashier"></div>
      <div class="cx-f"><label for="receiptNo">Receipt number</label><input id="receiptNo" readonly placeholder="Generated when payment is recorded"></div>
    </div>
    <div class="cx-receipt-bar">
      <small>For a part-payment, enter only the <b>new</b> amount and click <b>Record Payment &amp; Generate Receipt</b>. A new receipt number is created and previous receipts are kept.</small>
      <button class="btn primary" type="button" onclick="recordPayment()">🧾 Record Payment &amp; Generate Receipt</button>
    </div>
    <div id="paymentHistoryPanel" class="cx-history"></div>
  </details>

</div>

<!-- STICKY SUMMARY + ACTIONS -->
<aside class="cx-aside no-print" aria-label="Invoice summary and actions">
  <div class="cx-sum">
    <div class="cx-sum-top"><span id="cxSumNo">—</span><em id="cxSumStatus" class="cx-pill">Draft</em></div>
    <div class="cx-sum-client" id="cxSumClient">No client yet</div>
    <div class="cx-sum-rows">
      <div><span>Line items</span><b id="cxSumItems">0</b></div>
      <div><span>Category</span><b id="cxSumCat">—</b></div>
      <div><span>Balance due</span><b id="cxSumBal">—</b></div>
    </div>
    <div class="cx-sum-total"><span>Total</span><b id="cxSumTotal">0.00</b></div>
  </div>
  <div class="cx-actions">
    <button class="btn primary cx-big" type="button" onclick="save()">💾 Save<span class="cx-x"> Invoice</span></button>
    <div class="cx-actions-row">
      <button class="btn" type="button" onclick="preview()">👁<span class="cx-x"> Preview</span></button>
      <button class="btn" type="button" onclick="printInvoice()" title="Save as PDF to send to the client">📄<span class="cx-x"> Print /</span> PDF</button>
    </div>
  </div>
</aside>
</div>

<style id="fbi-create-v3">
/* Create Invoice v3 — layout only. Scoped to #view-create.cx so nothing else changes. */
html body #view-create.cx{--cx-top:84px}
/* the entrance animation must not keep holding a transform, or it traps the fixed action bar */
html body #view-create.cx.active{animation-fill-mode:none!important}
html body #view-create.cx .cx-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:20px;align-items:start}
html body #view-create.cx .cx-main{min-width:0}
html body #view-create.cx .card.cx-card{padding:20px 22px;margin-bottom:16px;scroll-margin-top:calc(var(--cx-top) + 64px)}
html body #view-create.cx .cx-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}
html body #view-create.cx .cx-head h3{margin:0!important;font-size:15px}
html body #view-create.cx .cx-head h3 small{font-size:12px;font-weight:500;color:var(--muted);margin-left:4px}
html body #view-create.cx .cx-num{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:7px;background:var(--u-ring,rgba(211,35,95,.2));color:var(--u-brand,#d3235f);font-size:12px;font-weight:800;flex:none}
html body #view-create.cx .cx-count{color:var(--muted);font-size:12px;margin:0!important}
html body #view-create.cx .cx-sub{font-size:11px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
html body #view-create.cx .cx-hint{font-weight:500;color:var(--muted);opacity:.8}
/* fields */
html body #view-create.cx .cx-f{min-width:0}
html body #view-create.cx .cx-f>label,html body #view-create.cx .cx-f label[for]{margin:0 0 6px!important;font-size:12.5px}
html body #view-create.cx .cx-grow{flex:1}
html body #view-create.cx .cx-split{display:grid;grid-template-columns:1fr 1fr;gap:22px}
html body #view-create.cx .cx-split>.cx-col+.cx-col{border-left:1px solid var(--border);padding-left:22px}
html body #view-create.cx .cx-grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px 14px}
html body #view-create.cx .cx-grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px 14px}
html body #view-create.cx .cx-inline{display:flex;gap:8px;align-items:flex-end;margin-bottom:12px}
html body #view-create.cx .cx-inline .btn{height:42px;white-space:nowrap}
html body #view-create.cx .cx-icon{width:42px;padding:0;font-size:18px}
html body #view-create.cx textarea#clientAddress{min-height:42px;resize:vertical}
html body #view-create.cx .cx-note{align-self:end;padding:10px 12px;border:1px dashed var(--border);border-radius:10px;color:var(--muted);font-size:12.5px;line-height:1.45;background:transparent!important}
html body #view-create.cx .cx-check{display:block!important;margin:12px 0 0!important;color:var(--text)!important;font-weight:500!important;line-height:1.5}
html body #view-create.cx .cx-check input{width:auto;vertical-align:-2px;margin:0 6px 0 0}
html body #view-create.cx .cx-check .cx-hint{display:block;font-size:12px;margin-top:2px}
/* collapsible bits */
html body #view-create.cx details.cx-more{margin-top:12px}
html body #view-create.cx details.cx-more>summary{cursor:pointer;color:var(--muted);font-size:12.5px;font-weight:600;list-style:none}
html body #view-create.cx details.cx-more>summary::-webkit-details-marker{display:none}
html body #view-create.cx details.cx-more>summary:before{content:"▸ ";}
html body #view-create.cx details.cx-more[open]>summary:before{content:"▾ ";}
html body #view-create.cx .template-picker{grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:10px}
html body #view-create.cx .template-card{padding:8px 9px}
html body #view-create.cx .template-card span{font-size:11px;line-height:1.3}
html body #view-create.cx details.cx-collapsible>summary{cursor:pointer;list-style:none;margin:0}
html body #view-create.cx details.cx-collapsible>summary::-webkit-details-marker{display:none}
html body #view-create.cx details.cx-collapsible[open]>summary{margin-bottom:14px}
html body #view-create.cx details.cx-collapsible>summary h3:after{content:"Show";margin-left:8px;font-size:11px;font-weight:600;color:var(--muted);border:1px solid var(--border);border-radius:999px;padding:1px 8px}
html body #view-create.cx details.cx-collapsible[open]>summary h3:after{content:"Hide"}
html body #view-create.cx .cx-summary-meta{color:var(--muted);font-size:12.5px;white-space:nowrap}
html body #view-create.cx .cx-summary-meta b{color:var(--text);font-size:14px;margin-left:4px}
html body #view-create.cx .cx-receipt-bar{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:14px;padding:12px 14px;border:1px solid var(--border);border-radius:12px;background:var(--u-row)}
html body #view-create.cx .cx-receipt-bar small{color:var(--muted);font-size:12px;line-height:1.5}
html body #view-create.cx .cx-receipt-bar .btn{white-space:nowrap;flex:none}
html body #view-create.cx .cx-history{margin-top:12px;padding:10px 12px;border:1px solid var(--border);border-radius:12px;background:var(--u-row)}
/* catalogue picker */
html body #view-create.cx .cx-catalog{padding:14px;border:1px solid var(--border);border-radius:12px;background:var(--u-row);margin:0 0 16px!important;box-shadow:none}
html body #view-create.cx .cx-catalog-filters{display:grid;grid-template-columns:1fr 1fr 1.2fr;gap:12px}
html body #view-create.cx .cx-catalog-pick{display:flex;gap:12px;align-items:stretch;margin-top:12px}
html body #view-create.cx #catalogItemSelect{width:100%;height:270px;min-height:0;padding:4px}
html body #view-create.cx #catalogItemSelect optgroup{font-weight:700;color:var(--muted);font-style:normal;padding-top:6px}
html body #view-create.cx #catalogItemSelect optgroup option{font-weight:500;color:var(--text);padding-left:10px}
html body #view-create.cx #addCategoryItemsBtn:disabled{opacity:.5}
html body #view-create.cx #catalogCustomBtn{white-space:normal;height:auto;min-height:42px;line-height:1.3;padding:8px 12px}
html body #view-create.cx #catalogItemSelect option{padding:5px 8px;border-radius:6px}
html body #view-create.cx .cx-catalog-actions{display:flex;flex-direction:column;gap:8px;justify-content:flex-end;width:200px;flex:none}
html body #view-create.cx .cx-catalog-actions .btn{width:100%;justify-content:center}
/* line items */
html body #view-create.cx .cx-lines .items-head{display:grid}
html body #view-create.cx #invoiceItemsCard .items-head,html body #view-create.cx #invoiceItemsCard .item{grid-template-columns:minmax(0,2.6fr) .9fr .6fr .6fr 1fr 38px}
html body #view-create.cx #invoiceItemsCard.no-days .items-head,html body #view-create.cx #invoiceItemsCard.no-days .item{grid-template-columns:minmax(0,2.6fr) .9fr .6fr 1fr 38px}
html body #view-create.cx #invoiceItemsCard .item{padding:8px;margin-bottom:6px;align-items:center}
html body #view-create.cx #invoiceItemsCard .item .rm{height:38px;width:38px}
html body #view-create.cx .cx-add{margin-top:4px}
html body #view-create.cx .cx-totals{display:grid;grid-template-columns:120px 140px minmax(200px,auto);justify-content:end;align-items:end;gap:12px;margin-top:16px;padding-top:16px;border-top:1px solid var(--border)}
html body #view-create.cx .cx-grand{display:flex;flex-direction:column;align-items:flex-end;padding:6px 4px}
html body #view-create.cx .cx-grand span{font-size:12px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.8px}
html body #view-create.cx .cx-grand b{font-size:24px;font-weight:800;letter-spacing:-.3px}
/* section stepper */
html body #view-create.cx .cx-steps{position:sticky;top:var(--cx-top);z-index:6;display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding:8px;margin:0 0 16px;border:1px solid var(--border);border-radius:14px;background:var(--panel);box-shadow:var(--u-shadow)}
html body #view-create.cx .cx-steps::-webkit-scrollbar{display:none}
html body #view-create.cx .cx-steps a{display:flex;align-items:center;gap:8px;white-space:nowrap;padding:7px 12px;border-radius:10px;color:var(--muted);font-size:13px;font-weight:600;text-decoration:none}
html body #view-create.cx .cx-steps a i{font-style:normal;display:inline-grid;place-items:center;width:20px;height:20px;border-radius:6px;border:1px solid var(--border);font-size:11px}
html body #view-create.cx .cx-steps a:hover{background:var(--u-row);color:var(--text)}
html body #view-create.cx .cx-steps a.on{background:var(--u-row);color:var(--text)}
html body #view-create.cx .cx-steps a.on i{background:var(--u-brand);border-color:var(--u-brand);color:#fff}
html body #view-create.cx .cx-steps a.cx-off{display:none}
/* summary aside */
html body #view-create.cx .cx-aside{position:sticky;top:calc(var(--cx-top) + 66px);display:flex;flex-direction:column;gap:12px}
html body #view-create.cx .cx-sum{background:var(--panel);border:1px solid var(--border);border-radius:var(--u-r,14px);padding:18px;box-shadow:var(--u-shadow)}
html body #view-create.cx .cx-sum-top{display:flex;justify-content:space-between;align-items:center;gap:8px;font-weight:700;font-size:13px;color:var(--muted)}
html body #view-create.cx .cx-pill{font-style:normal;font-size:11.5px;font-weight:700;padding:2px 9px;border-radius:999px;background:var(--u-neutral-bg);color:var(--u-neutral)}
html body #view-create.cx .cx-pill[data-s="Paid"]{background:var(--u-ok-bg);color:var(--u-ok)}
html body #view-create.cx .cx-pill[data-s="Sent"]{background:var(--u-info-bg);color:var(--u-info)}
html body #view-create.cx .cx-pill[data-s="Partially Paid"]{background:var(--u-warn-bg);color:var(--u-warn)}
html body #view-create.cx .cx-pill[data-s="Overdue"]{background:var(--u-bad-bg);color:var(--u-bad)}
html body #view-create.cx .cx-sum-client{margin:8px 0 12px;font-size:17px;font-weight:700;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
html body #view-create.cx .cx-sum-client.empty{color:var(--muted);font-weight:500;font-size:14px}
html body #view-create.cx .cx-sum-rows div{display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-top:1px solid var(--border);font-size:13px}
html body #view-create.cx .cx-sum-rows span{color:var(--muted)}
html body #view-create.cx .cx-sum-rows b{font-weight:600;text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:60%}
html body #view-create.cx .cx-sum-total{display:flex;justify-content:space-between;align-items:baseline;margin-top:6px;padding-top:12px;border-top:1px solid var(--border)}
html body #view-create.cx .cx-sum-total span{font-size:12px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--muted)}
html body #view-create.cx .cx-sum-total b{font-size:24px;font-weight:800;letter-spacing:-.4px;color:var(--text)}
html body #view-create.cx .cx-actions{display:flex;flex-direction:column;gap:8px}
html body #view-create.cx .cx-actions .btn{width:100%;justify-content:center;height:42px}
html body #view-create.cx .cx-actions .cx-big{height:48px;font-size:15px}
html body #view-create.cx .cx-actions-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
html body #view-create.cx .cx-ghost{background:transparent!important;color:var(--muted)!important}
/* medium screens: summary becomes a bottom action bar */
@media(max-width:1180px){
  html body #view-create.cx .cx-layout{grid-template-columns:1fr}
  html body #view-create.cx .cx-main{padding-bottom:84px}
  html body #view-create.cx .cx-aside{position:fixed;left:var(--cx-l,0);right:0;bottom:0;top:auto;z-index:30;flex-direction:row;align-items:center;gap:10px;padding:10px 16px calc(10px + env(safe-area-inset-bottom));background:color-mix(in srgb,var(--panel) 94%,transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-top:1px solid var(--border);box-shadow:0 -8px 24px -12px rgba(0,0,0,.35)}
  html body #view-create.cx .cx-sum{flex:1;min-width:0;padding:0;border:0;box-shadow:none;background:transparent;display:flex;align-items:center;gap:14px}
  html body #view-create.cx .cx-sum-top,html body #view-create.cx .cx-sum-rows{display:none}
  html body #view-create.cx .cx-sum-client{margin:0;font-size:14px;flex:1;min-width:0}
  html body #view-create.cx .cx-sum-total{margin:0;padding:0;border:0;gap:8px}
  html body #view-create.cx .cx-sum-total b{font-size:19px}
  html body #view-create.cx .cx-actions{flex-direction:row;gap:8px}
  html body #view-create.cx .cx-actions .btn{width:auto;height:42px;padding:0 14px}
  html body #view-create.cx .cx-actions .cx-big{height:42px;font-size:14px}
  html body #view-create.cx .cx-actions-row{display:flex}
  html body #view-create.cx .cx-ghost,html body #view-create.cx .cx-sum-client{display:none}
  html body #view-create.cx .cx-sum{justify-content:flex-start}
}
@media(max-width:820px){
  html body #view-create.cx .cx-steps{position:static}
  html body #view-create.cx .card.cx-card{scroll-margin-top:calc(var(--cx-top) + 8px)}
  html body #view-create.cx .cx-split,html body #view-create.cx .cx-catalog-filters{grid-template-columns:1fr}
  html body #view-create.cx .cx-split>.cx-col+.cx-col{border-left:0;padding-left:0;border-top:1px solid var(--border);padding-top:16px}
  html body #view-create.cx .cx-grid3{grid-template-columns:1fr 1fr}
  html body #view-create.cx .cx-catalog-pick{flex-direction:column}
  html body #view-create.cx .cx-catalog-actions{width:auto;flex-direction:row}
  html body #view-create.cx .template-picker{grid-template-columns:repeat(3,minmax(0,1fr))}
  html body #view-create.cx .cx-receipt-bar{flex-direction:column;align-items:stretch}
  html body #view-create.cx .cx-sum-client{display:none}
  html body #view-create.cx .cx-ghost{display:none}
}
@media(max-width:600px){
  html body #view-create.cx .card.cx-card{padding:16px}
  html body #view-create.cx .cx-grid2,html body #view-create.cx .cx-grid3{grid-template-columns:1fr}
  html body #view-create.cx .cx-lines .items-head{display:none}
  html body #view-create.cx #invoiceItemsCard .item,html body #view-create.cx #invoiceItemsCard.no-days .item{grid-template-columns:1fr 1fr}
  html body #view-create.cx #invoiceItemsCard .item>div:first-child{grid-column:1/-1}
  html body #view-create.cx .cx-totals{grid-template-columns:1fr 1fr}
  html body #view-create.cx .cx-grand{grid-column:1/-1;flex-direction:row;justify-content:space-between;align-items:baseline}
  html body #view-create.cx .cx-actions .cx-big{padding:0 14px}
  html body #view-create.cx .cx-aside{padding-left:12px;padding-right:12px;gap:8px}
  html body #view-create.cx .cx-sum-total span,html body #view-create.cx .cx-x{display:none}
  html body #view-create.cx .cx-sum-total b{font-size:17px;white-space:nowrap}
  html body #view-create.cx .cx-actions .btn{padding:0 12px}
}
/* Toasts never block taps: an invisible toast used to sit on top of the phone Save / PDF buttons. */
html body .toast{pointer-events:none!important}
@media(max-width:820px){html body .toast{left:12px!important;right:12px!important;bottom:calc(84px + env(safe-area-inset-bottom))!important;text-align:center}}
/* Keep the invoice's colours, black bars and logo when printing / saving as PDF (browsers drop backgrounds by default). */
@media print{.paper,.paper *,.receipt-paper,.receipt-paper *{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}}
@media print{html body #view-create.cx .cx-aside,html body #view-create.cx .cx-steps{display:none!important}}
</style>
<script id="fbi-create-v3-js">
/* UI helpers for the Create Invoice layout. Read-only mirrors + navigation; no data logic. */
(function(){
  var root=document.getElementById("view-create");if(!root)return;
  function $(id){return document.getElementById(id)}
  function txt(el,v){if(el&&el.textContent!==v)el.textContent=v}
  // Sticky offsets follow the real height of the app header.
  function measure(){
    var top=document.querySelector(".top");
    var h=top&&getComputedStyle(top).position.match(/sticky|fixed/)?top.getBoundingClientRect().height:0;
    root.style.setProperty("--cx-top",Math.round(h+12)+"px");
    var host=root.parentElement||root;root.style.setProperty("--cx-l",Math.max(0,Math.round(host.getBoundingClientRect().left))+"px");
  }
  // Summary panel mirrors what is already on the form.
  function refresh(){
    if(!root.classList.contains("active"))return;
    txt($("cxSumNo"),$("no")&&$("no").value||"New invoice");
    var qm=window.FBI_DOC_MODE==="quote";var st=qm?(($("qtStatus")&&$("qtStatus").value)||"Draft"):($("status")?$("status").value:"Draft"),pill=$("cxSumStatus");txt(pill,st);if(pill)pill.setAttribute("data-s",st);
    var c=($("client")&&$("client").value.trim())||"",cl=$("cxSumClient");txt(cl,c||"No client yet");if(cl)cl.classList.toggle("empty",!c);
    var n=0;root.querySelectorAll("#items .item").forEach(function(r){var d=r.querySelector(".desc"),p=r.querySelector(".rate");if((d&&d.value.trim())||(p&&+p.value>0))n++});
    txt($("cxSumItems"),String(n));
    var cat=$("serviceCategory");txt($("cxSumCat"),cat&&cat.value?cat.options[cat.selectedIndex].text:"—");
    txt($("cxSumTotal"),$("total")?$("total").textContent:"0.00");
    txt($("cxSumBal"),$("paymentBalancePreview")?$("paymentBalancePreview").textContent:"—");
    var ev=$("eventDateCard"),re=$("rentalDetailsCard"),step=$("cxJobStep");
    if(step)step.classList.toggle("cx-off",!((ev&&ev.style.display!=="none")||(re&&re.style.display!=="none")));
    var pr=$("paymentReceivedCard");
    if(pr&&!pr.dataset.cxTouched&&!qm){var paid=+($("amountPaid")&&$("amountPaid").value)||0,hist=$("paymentHistoryPanel");var hasHist=hist&&/receipt|RCT|paid/i.test(hist.textContent)&&!/No payments recorded/i.test(hist.textContent);var want=paid>0||hasHist||st==="Partially Paid"||st==="Paid";if(pr.open!==want){pr.open=want}}
  }
  var queued=false;function schedule(){if(queued)return;queued=true;requestAnimationFrame(function(){queued=false;refresh()})}
  root.addEventListener("input",schedule,true);root.addEventListener("change",schedule,true);root.addEventListener("click",function(){setTimeout(schedule,30)},true);
  try{new MutationObserver(schedule).observe(root,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:["style","class","value"]})}catch(e){}
  setInterval(schedule,1500); // catches programmatic value changes (loading a saved invoice)
  // Remember when the user opens/closes the receipt section themselves.
  var pr=$("paymentReceivedCard");
  if(pr){
    pr.querySelector("summary").addEventListener("click",function(){pr.dataset.cxTouched="1"});
    // Existing code scrolls to this card when taking a new payment — open it first.
    pr.scrollIntoView=function(o){pr.open=true;pr.dataset.cxTouched="1";HTMLElement.prototype.scrollIntoView.call(pr,o)};
  }
  // Double-click or Enter on the catalogue list adds the item.
  var list=$("catalogItemSelect"),add=$("addSelectedCatalogBtn");
  if(list&&add){list.addEventListener("dblclick",function(){if(list.value)add.click()});list.addEventListener("keydown",function(e){if(e.key==="Enter"&&list.value){e.preventDefault();add.click()}})}
  // Section stepper: smooth jump + highlight the section in view.
  var links=[].slice.call(root.querySelectorAll("[data-cx-step]"));
  links.forEach(function(a){a.addEventListener("click",function(e){e.preventDefault();var t=$(a.getAttribute("data-cx-step"));if(!t)return;if(t.id==="cxJob"){t=[$("eventDateCard"),$("rentalDetailsCard")].filter(function(x){return x&&x.style.display!=="none"})[0]||t}if(t.tagName==="DETAILS")t.open=true;t.scrollIntoView({behavior:"smooth",block:"start"})})});
  function spy(){
    if(!root.classList.contains("active"))return;
    var line=(parseFloat(getComputedStyle(root).getPropertyValue("--cx-top"))||80)+90,cur=links[0];
    links.forEach(function(a){if(a.classList.contains("cx-off"))return;var t=$(a.getAttribute("data-cx-step"));if(t&&t.getBoundingClientRect().top<=line)cur=a});
    if((window.innerHeight+window.scrollY)>=document.documentElement.scrollHeight-4){var vis=links.filter(function(a){return !a.classList.contains("cx-off")});cur=vis[vis.length-1]}
    links.forEach(function(a){a.classList.toggle("on",a===cur)});
  }
  window.addEventListener("scroll",spy,{passive:true});document.addEventListener("scroll",spy,{passive:true,capture:true});
  window.addEventListener("resize",function(){measure();spy()});
  function boot(){measure();refresh();spy()}
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot);else boot();
  setTimeout(boot,600);window.addEventListener("fbi-authenticated",function(){setTimeout(boot,300)});
  window.addEventListener("hashchange",function(){setTimeout(boot,50)});
  try{new MutationObserver(function(){if(root.classList.contains("active"))setTimeout(boot,30)}).observe(root,{attributes:true,attributeFilter:["class"]})}catch(e){}
})();
</script>
</section>

<section class="view" id="view-receipts"><div class="card"><div class="dashboard-section-head"><div><h3 style="margin-bottom:3px">Official Payment Receipts</h3><small>Print a professional receipt for every payment recorded against an invoice.</small></div><button class="btn" onclick="show('saved')">View Invoices →</button></div><div id="receiptList" class="receipt-list"></div></div></section>

<section class="view" id="view-clients">
  <div class="cl-layout">
    <div class="card cl-list-card">
      <div class="ov-panel-head"><h3>All clients</h3><small id="clientCount"></small></div>
      <div class="inv-search cl-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg><input id="clientSearch" type="search" placeholder="Search by name, phone, email or address" oninput="clientListLimit=60;renderClients()" autocomplete="off"></div>
      <div id="clientList"></div>
    </div>
    <div class="cl-side">
      <div class="card cl-form">
        <h3 id="clientFormTitle">Add Client</h3>
        <input id="clientId" type="hidden">
        <label for="dbClientName">Client or company name *</label><input id="dbClientName" placeholder="Client or company name">
        <div class="cl-two"><div><label for="dbClientPhone">Phone</label><input id="dbClientPhone" placeholder="0250000000"></div><div><label for="dbClientEmail">Email</label><input id="dbClientEmail" type="email" placeholder="client@example.com"></div></div>
        <label for="dbClientAddress">Address</label><textarea id="dbClientAddress" rows="2" placeholder="Client address"></textarea>
        <label for="dbClientNotes">Notes</label><textarea id="dbClientNotes" rows="2" placeholder="Additional client notes"></textarea>
        <div class="cl-btns"><button class="btn primary" type="button" onclick="saveClient()">Save client</button><button class="btn" type="button" onclick="clearClientForm()">Clear</button></div>
      </div>
      <details class="card cl-import">
        <summary><b>Import clients from a file</b><small>CSV or JSON. CSV columns: Name, Phone, Email, Address, Notes.</small></summary>
        <input id="clientImportFile" type="file" accept=".csv,.txt,.json" onchange="importClientsFile(event)">
        <div id="clientImportStatus" class="st-note"></div>
      </details>
    </div>
  </div>
</section>

<section class="view" id="view-saved"><div class="card inv-card">
<div class="inv-toolbar">
  <div class="inv-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg><input id="savedSearch" type="search" placeholder="Search by invoice number, client, phone or amount" autocomplete="off"></div>
  <select id="savedCurrency" aria-label="Currency"><option value="">All currencies</option><option>GHS</option><option>USD</option><option>EUR</option><option>GBP</option></select>
  <button class="btn primary" type="button" onclick="newInvoice()">＋ New invoice</button>
</div>
<div class="inv-chips" id="savedChips" role="tablist" aria-label="Filter by status"></div>
<select id="savedStatus" hidden><option value="">All</option><option value="open">Open</option><option>Draft</option><option>Sent</option><option>Partially Paid</option><option>Paid</option><option>Overdue</option></select>
<div class="inv-head" aria-hidden="true"><span>Invoice</span><span>Date</span><span class="num">Amount</span><span>Status</span><span>Job</span><span></span></div>
<div id="saved"></div><div id="savedEmpty" class="ui-empty" hidden><b>No invoices match</b><span>Try a different search or clear the filters.</span><button class="btn" type="button" onclick="openInvoicesFiltered('')">Clear filters</button></div>
<small id="savedCount" class="inv-count"></small>
</div>
<script>(function(){
  function el(id){return document.getElementById(id)}
  function statusOf(x){try{return invoiceStatusInfo(x).status||x.status||"Draft"}catch(e){return x.status||"Draft"}}
  function isOpen(x){const st=statusOf(x);return st!=="Paid"&&st!=="Draft"&&invoiceBalance(x)>0.005}
  const CHIPS=[["","All"],["open","Open"],["Overdue","Overdue"],["Partially Paid","Part paid"],["Paid","Paid"],["Draft","Drafts"]];
  function match(x,st){if(!st)return true;if(st==="open")return isOpen(x);return statusOf(x)===st}
  function chips(){
    const box=el("savedChips");if(!box||typeof data==="undefined")return;const cur=el("savedStatus").value;
    box.innerHTML=CHIPS.map(function(c){const n=data.filter(function(x){return match(x,c[0])}).length;return '<button type="button" role="tab" aria-selected="'+(cur===c[0])+'" data-chip="'+c[0]+'">'+c[1]+' <span>'+n+'</span></button>'}).join("");
  }
  function apply(){
    const box=el("saved");if(!box||typeof data==="undefined")return;
    const q=(el("savedSearch").value||"").trim().toLowerCase(),st=el("savedStatus").value,cu=el("savedCurrency").value;
    let shown=0,total=0;
    box.querySelectorAll("[data-invoice-row]").forEach(function(r){
      total++;
      const x=data.find(function(a){return String(a.id)===r.getAttribute("data-invoice-row")})||{};
      const hay=[x.no,x.client,x.clientPhone,x.clientEmail,x.total,x.date,x.category,x.eventDate].join(" ").toLowerCase();
      const ok=(!q||hay.indexOf(q)>=0)&&match(x,st)&&(!cu||String(x.cur||"GHS")===cu);
      r.style.display=ok?"":"none";if(ok)shown++;
    });
    el("savedEmpty").hidden=!(total&&!shown);
    el("savedCount").textContent=total?(shown===total?"Showing all "+total+" invoices":"Showing "+shown+" of "+total+" invoices"):"";
    chips();
  }
  window.openInvoicesFiltered=function(st){show("saved");el("savedStatus").value=st||"";if(!st){el("savedSearch").value="";el("savedCurrency").value=""}apply();window.scrollTo(0,0)};
  el("savedChips").addEventListener("click",function(e){const b=e.target.closest("[data-chip]");if(!b)return;el("savedStatus").value=b.getAttribute("data-chip");apply()});
  ["savedSearch","savedCurrency"].forEach(function(id){const n=el(id);n.addEventListener("input",apply);n.addEventListener("change",apply)});
  try{new MutationObserver(apply).observe(el("saved"),{childList:true})}catch(e){}
})();</script>
</section>
<section class="view" id="view-quotes"><div class="card inv-card">
<div class="inv-toolbar">
  <div class="inv-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg><input id="quoteSearch" type="search" placeholder="Search by quotation number, client or amount" autocomplete="off"></div>
  <span></span>
  <button class="btn primary" type="button" onclick="newQuote()">＋ New quotation</button>
</div>
<div class="inv-chips" id="quoteChips" role="tablist" aria-label="Filter quotations by status"></div>
<div class="inv-head qt-head" aria-hidden="true"><span>Quotation</span><span>Date</span><span class="num">Amount</span><span>Status</span><span>Valid until</span><span></span></div>
<div id="quoteList"></div>
<div id="quoteEmpty" class="ui-empty" hidden><b>No quotations yet</b><span>Send a client a quotation or pro-forma invoice, then turn it into an invoice with one click when they accept.</span><button class="btn primary" type="button" onclick="newQuote()">＋ New quotation</button></div>
</div></section>

<section class="view" id="view-completed">
  <div class="page-actions completed-jobs-head">
    <p>Every job is linked to its invoice. Payment and job progress are tracked separately.</p>
    <div><button class="btn" type="button" onclick="exportCompletedJobsCsv()">Export CSV</button><button class="btn primary" type="button" onclick="printCompletedJobsReport()">Print / save PDF</button></div>
  </div>
  <div class="stats dashboard-stats completed-job-stats">
    <div class="stat"><span>Total Jobs</span><b id="completedCount">0</b><small id="completedCountMeta">Linked to invoices</small></div>
    <div class="stat"><span>Completed</span><b id="completedValue">0</b><small id="completedValueMeta">Jobs finished</small></div>
    <div class="stat"><span>In Progress</span><b id="completedCollected">0</b><small id="completedCollectedMeta">Scheduled + active</small></div>
    <div class="stat"><span>Outstanding</span><b id="completedBalance">GH₵0.00</b><small id="completedBalanceMeta">Balance on jobs</small></div>
  </div>
  <div class="card">
    <div class="report-filters" style="margin-bottom:14px">
      <div><label>From Event Date</label><input id="completedFrom" type="date" onchange="renderCompletedJobs()"></div>
      <div><label>To Event Date</label><input id="completedTo" type="date" onchange="renderCompletedJobs()"></div>
      <div><label>Job Status</label><select id="completedJobStatus" onchange="renderCompletedJobs()"><option value="">All Job Statuses</option><option value="Not Started">Not Started</option><option value="Scheduled">Scheduled</option><option value="In Progress">In Progress</option><option value="Completed">Completed</option><option value="Cancelled">Cancelled</option></select></div>
      <div><label>Payment</label><select id="completedPayment" onchange="renderCompletedJobs()"><option value="">All Payments</option><option value="Paid">Fully Paid</option><option value="Partial">Partially Paid</option><option value="Outstanding">Outstanding</option></select></div>
      <div><label>Client</label><select id="completedClient" onchange="renderCompletedJobs()"><option value="">All Clients</option></select></div>
    </div>
    <div id="completedJobsTable"></div>
  </div>
</section>


<style id="cal2-style">
/* ===== Lively event calendar ===== */
.cal2{--cal-brand:var(--u-brand,#d3235f);padding:26px!important}
.cal2-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:18px}
.cal2-eyebrow{display:block;font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--cal-brand)}
html[data-theme] body .cal2 .calendar-month-title,.cal2 .calendar-month-title{font-size:clamp(28px,3.2vw,40px);font-weight:800;letter-spacing:-.02em;line-height:1.1;margin:6px 0 4px;color:var(--text)}
.cal2-titlebox small{font-size:13.5px;color:var(--muted)}
.cal2-nav{display:flex;align-items:center;gap:4px;padding:4px;border-radius:14px;border:1px solid var(--border);background:var(--panel2)}
.cal2-navbtn,.cal2-today{border:0;background:transparent;color:var(--text);cursor:pointer;font:inherit;border-radius:10px;min-height:40px}
.cal2-navbtn{width:42px;display:grid;place-items:center}
.cal2-today{padding:0 16px;font-weight:800;font-size:14px;background:var(--cal-brand);color:#fff}
.cal2-navbtn:hover{background:color-mix(in srgb,var(--cal-brand) 14%,transparent)}
.cal2-stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-bottom:16px}
.cal2-stat{padding:14px 16px;border-radius:14px;border:1px solid var(--border);background:var(--panel2);min-width:0}
.cal2-stat span{display:block;font-size:12.5px;font-weight:700;color:var(--muted)}
.cal2-stat b{display:block;font-size:clamp(17px,1.5vw,21px);font-weight:800;letter-spacing:-.01em;margin-top:4px;color:var(--text);line-height:1.2;overflow-wrap:anywhere}
.cal2-stat small{display:block;font-size:12px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cal2-stat.next{background:color-mix(in srgb,var(--cal-brand) 12%,var(--panel2));border-color:color-mix(in srgb,var(--cal-brand) 40%,var(--border))}
.cal2-stat.next b{color:var(--cal-brand)}
.cal2-legend{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;margin-bottom:14px;font-size:12.5px;color:var(--muted)}
.cal2-legend span{display:inline-flex;align-items:center;gap:6px;font-weight:700}
.cal2-legend span::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--jc)}
.cal2-legend em{font-style:normal;margin-left:auto}
html[data-theme] body .cal2-grid,.cal2-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px}
html[data-theme] body .cal2 .calendar-weekday{font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);text-align:left;padding:4px 10px}
html[data-theme] body .cal2 .calendar-weekday.wk{color:color-mix(in srgb,var(--cal-brand) 70%,var(--muted))}
html[data-theme] body .cal2 .calendar-day{position:relative;min-height:128px;padding:10px;border-radius:14px;border:1px solid var(--border);background:var(--panel);display:flex;flex-direction:column;gap:6px;transition:border-color .15s,transform .15s,box-shadow .15s}
html[data-theme] body .cal2 .calendar-day.weekend{background:color-mix(in srgb,var(--cal-brand) 3.5%,var(--panel))}
html[data-theme] body .cal2 .calendar-day:hover{border-color:color-mix(in srgb,var(--cal-brand) 45%,var(--border))}
html[data-theme] body .cal2 .calendar-day.other-month{opacity:.42}
html[data-theme] body .cal2 .calendar-day.past .calendar-day-number{opacity:.55}
html[data-theme] body .cal2 .calendar-day.has-events{background:color-mix(in srgb,var(--cal-brand) 5%,var(--panel))}
html[data-theme] body .cal2 .calendar-day-number{display:flex;align-items:center;justify-content:space-between;font-size:14px;font-weight:800;color:var(--text)}
html[data-theme] body .cal2 .calendar-day.today{border-color:var(--cal-brand);box-shadow:0 0 0 1px var(--cal-brand),0 10px 30px -10px color-mix(in srgb,var(--cal-brand) 70%,transparent)}
html[data-theme] body .cal2 .calendar-day.today .calendar-day-number span{display:inline-grid;place-items:center;min-width:28px;height:28px;border-radius:50%;background:var(--cal-brand);color:#fff}
.cal2-todaytag{font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--cal-brand)}
.cal2-add{position:absolute;left:8px;right:8px;bottom:8px;display:none;align-items:center;justify-content:center;gap:6px;min-height:34px;border-radius:10px;border:1px dashed color-mix(in srgb,var(--cal-brand) 60%,var(--border));background:color-mix(in srgb,var(--cal-brand) 8%,transparent);color:var(--cal-brand);font:inherit;font-size:12.5px;font-weight:800;cursor:pointer}
html[data-theme] body .cal2 .calendar-day:hover .cal2-add,.cal2-add:focus-visible{display:flex}
html[data-theme] body .cal2 .calendar-event.cal2-ev{position:relative;display:flex;flex-direction:column;gap:3px;width:100%;padding:9px 10px 8px;border-radius:11px;border:1px solid color-mix(in srgb,var(--jc) 40%,var(--border));background:color-mix(in srgb,var(--jc) 12%,var(--panel));color:var(--text);text-align:left;cursor:pointer;overflow:hidden;font:inherit;transition:transform .15s,box-shadow .15s}
html[data-theme] body .cal2 .calendar-event.cal2-ev::before{content:"";position:absolute;left:0;right:0;top:0;height:3px;background:var(--jc)}
html[data-theme] body .cal2 .calendar-event.cal2-ev:hover{transform:translateY(-2px);box-shadow:0 10px 24px -12px color-mix(in srgb,var(--jc) 80%,transparent)}
.cal2-ev-client{font-size:13px;font-weight:800;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cal2-ev-meta{font-size:12px;font-weight:700;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cal2-ev-foot{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:2px}
.cal2-ev-job{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:800;color:var(--jc)}
.cal2-ev-job::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--jc)}
.cal2-ev-pay{font-size:10.5px;font-weight:800;padding:2px 7px;border-radius:99px;background:color-mix(in srgb,var(--text) 8%,transparent);color:var(--muted)}
.cal2-ev-pay.paid{background:color-mix(in srgb,#3ccf8e 18%,transparent);color:#3ccf8e}
.cal2-ev-pay.overdue{background:color-mix(in srgb,#ff6b81 18%,transparent);color:#ff6b81}
.cal2-ev-pay.sent{background:color-mix(in srgb,#4aa8ff 18%,transparent);color:#4aa8ff}
.cal2-ev-pay.part{background:color-mix(in srgb,#f0b93a 18%,transparent);color:#f0b93a}
html[data-theme="light"] .cal2-ev-pay.sent{color:#1f6fb8}html[data-theme="light"] .cal2-ev-pay.part{color:#946a0b}
html[data-theme="light"] .cal2-ev-pay.paid{color:#127a52}html[data-theme="light"] .cal2-ev-pay.overdue{color:#b4233b}
html[data-theme="light"] .cal2-ev-job{filter:brightness(.8)}
.cal2-more{font-size:12px;font-weight:800;color:var(--cal-brand);padding:2px 4px}
.cal2-agenda-head{display:flex;align-items:baseline;gap:10px;margin:26px 0 12px}
.cal2-agenda-head h3{margin:0;font-size:20px;font-weight:800;color:var(--text)}
.cal2-agenda-head small{font-size:13px;color:var(--muted)}
.cal2-agenda{display:grid;grid-template-columns:repeat(auto-fill,minmax(440px,1fr));gap:12px}
.cal2-agenda .cal2-row{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:14px;align-items:center;padding:14px;border-radius:16px;border:1px solid var(--border);background:var(--panel);color:var(--text);text-align:left;cursor:pointer;font:inherit;width:100%;transition:border-color .15s,transform .15s}
.cal2-agenda .cal2-row:hover{border-color:color-mix(in srgb,var(--jc) 60%,var(--border));transform:translateY(-2px)}
.cal2-date{width:56px;height:60px;border-radius:13px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:color-mix(in srgb,var(--jc) 16%,var(--panel2));color:var(--text)}
.cal2-date b{font-size:22px;font-weight:800;line-height:1}
.cal2-date small{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--jc);margin-top:3px}
.cal2-row-main{min-width:0;display:flex;flex-direction:column;gap:4px}
.cal2-row-main b{font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cal2-row-main small{font-size:12.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cal2-row-right{text-align:right;display:flex;flex-direction:column;gap:3px}
.cal2-row-right b{font-size:15px;white-space:nowrap}
.cal2-row-right small{font-size:12px;color:var(--muted);white-space:nowrap}
.cal2-empty{grid-column:1/-1;padding:30px;text-align:center;border:1px dashed var(--border);border-radius:16px;color:var(--muted);font-size:14px}
@media(max-width:1100px){.cal2-stats{grid-template-columns:repeat(3,minmax(0,1fr))}.cal2-stat.next{grid-column:span 3}}
@media(max-width:760px){.cal2{padding:16px!important}.cal2-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.cal2-stat.next{grid-column:span 2}.cal2-legend em{display:none}html[data-theme] body .cal2-grid,.cal2-grid{gap:4px}html[data-theme] body .cal2 .calendar-day{min-height:70px;padding:6px;border-radius:10px}html[data-theme] body .cal2 .calendar-weekday{padding:2px;text-align:center;font-size:10.5px;letter-spacing:.04em}.cal2-ev-meta,.cal2-ev-foot,.cal2-todaytag{display:none}html[data-theme] body .cal2 .calendar-event.cal2-ev{padding:5px 5px 4px}.cal2-ev-client{font-size:10.5px}.cal2-add{display:none!important}.cal2-agenda{grid-template-columns:1fr}.cal2-agenda .cal2-ev-foot{display:flex}}
@media(prefers-reduced-motion:reduce){html[data-theme] body .cal2 .calendar-event.cal2-ev,.cal2-agenda .cal2-row{transition:none}html[data-theme] body .cal2 .calendar-event.cal2-ev:hover,.cal2-agenda .cal2-row:hover{transform:none}}
</style>
<section class="view" id="view-calendar">
  <div class="card calendar-main-card cal2">
    <div class="cal2-head">
      <div class="cal2-titlebox"><span class="cal2-eyebrow">Event calendar</span><h2 id="calendarMonthTitle" class="calendar-month-title">Event Calendar</h2><small>Media jobs by event date. IT invoices are not shown here.</small></div>
      <div class="cal2-nav" role="group" aria-label="Change month">
        <button type="button" class="cal2-navbtn" onclick="calendarPrevMonth()" aria-label="Previous month"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
        <button type="button" class="cal2-today" onclick="calendarToday()">Today</button>
        <button type="button" class="cal2-navbtn" onclick="calendarNextMonth()" aria-label="Next month"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
      </div>
    </div>
    <div id="calendarStats" class="cal2-stats"></div>
    <div class="cal2-legend" aria-label="Job status colours"><span style="--jc:#3ccf8e">Completed</span><span style="--jc:#4aa8ff">In progress</span><span style="--jc:#f0b93a">Scheduled</span><span style="--jc:#98a2b3">Not started</span><span style="--jc:#ff6b81">Cancelled</span><em>Tip: hover an empty day to add an invoice for that date</em></div>
    <div class="calendar-grid-wrap"><div id="calendarGrid" class="calendar-grid cal2-grid"></div></div>
    <div class="cal2-agenda-head"><h3>This month's events</h3><small id="calendarAgendaCount"></small></div>
    <div id="calendarEventList" class="calendar-event-list cal2-agenda"></div>
  </div>
  <div class="card">
    <h3>Calendar Information</h3>
    <div style="color:#858e9f;font-size:10px;line-height:1.6">Click any event to open the complete invoice record, including client details, service category, event date, brand/model, service item, line items, tax, discount, totals, payment details, notes and rental information where applicable.</div>
  </div>
</section>

<div id="calendarModal" class="calendar-modal" aria-hidden="true">
  <div class="calendar-dialog" role="dialog" aria-modal="true" aria-labelledby="calendarModalTitle">
    <div class="calendar-dialog-head">
      <div><h3 id="calendarModalTitle">Invoice Details</h3><small id="calendarModalSubtitle"></small></div>
      <button type="button" class="btn" onclick="closeCalendarModal()">✕</button>
    </div>
    <div id="calendarModalBody" class="calendar-dialog-body"></div>
    <div class="calendar-dialog-actions">
      <button type="button" class="btn" onclick="closeCalendarModal()">Close</button>
      <button type="button" class="btn" id="calendarEditBtn">Edit Invoice</button>
      <button type="button" class="btn primary" id="calendarPrintBtn">Print / PDF</button>
      <button type="button" class="btn primary" id="calendarReceiptBtn" style="display:none">View Receipt</button>
    </div>
  </div>
</div>

<section class="view" id="view-settings">
  <div class="card" id="dataBackupCard"><h3>Data Protection &amp; Backups</h3><div class="st-note">Your invoices, clients and settings are stored in the cloud PostgreSQL database. A full backup is taken automatically once a day (the last 30 are kept). Draft work is autosaved so a refresh does not erase what you were entering.</div><div class="st-row"><button class="btn primary" type="button" onclick="downloadServerBackup('current')">⬇ Download full backup now</button><button class="btn" type="button" onclick="exportStudioBackup()">Export from this device</button><label class="btn" style="display:inline-flex;align-items:center;gap:6px;cursor:pointer">Import Data Backup<input type="file" accept=".json,application/json" onchange="importStudioBackup(event)" style="display:none"></label></div><div id="backupList" class="st-list"></div><small id="storageStatus" style="display:block;color:var(--muted);margin-top:8px"></small></div>
  <div class="card" id="staffAccessCard"><div class="st-head"><div><h3 style="margin-bottom:2px">Staff Portal Access</h3><div class="st-note">Workers who create invoices and receipts use the Staff Portal. New sign-ups must be approved here before they can sign in. Disabling an account signs it out immediately.</div></div><a class="btn" id="staffPortalLink" href="#" target="_blank" rel="noopener">Open Staff Portal ↗</a></div>
    <div id="staffPending"></div>
    <div id="staffList" class="st-list"></div>
    <details class="st-add"><summary>＋ Add a worker account</summary>
      <div class="st-form"><div><label>Full name</label><input id="stName" placeholder="e.g. Kofi Mensah"></div><div><label>Username</label><input id="stUser" placeholder="e.g. kofi" autocomplete="off"></div><div><label>Temporary password</label><input id="stPass" type="text" placeholder="At least 8 characters" autocomplete="off"></div><button class="btn primary" type="button" onclick="createStaffUser()">Create account</button></div>
      <small class="st-note">Give the worker their username and password. The account works immediately.</small>
    </details>
  </div>
  <div class="grid2">
    <div class="card"><h3>Business Details</h3><label>Business Name</label><input id="biz" value="FILM BEYOND IMAGINATION (FBI)"><label>Owner / Contact Name</label><input id="owner" value="Jerbel Mark Addeh"><label>Address</label><input id="baddr" value="Dome, Accra"><label>Phone</label><input id="bphone" value="0257407350"><label>Email</label><input id="bemail" value="filmbfbi@gmail.com"><label>Business Number</label><input id="bnum" value="0257407350"></div>
    <div class="card"><h3>Logo & Default Payment</h3><label>Invoice Logo</label><div style="display:flex;align-items:center;gap:10px;margin:6px 0 10px"><div style="width:92px;height:52px;border-radius:6px;background:#08090c center/contain no-repeat url('/assets/fbi-logo.jpg');border:1px solid #303642"></div><small style="color:#858e9f">Your exact FBI gold logo is set as the default and is used on invoices and official receipts.</small></div><input id="logoFile" type="file" accept="image/*"><label>Default Payment Information</label><textarea id="defaultPay" rows="10">Bank Name: Cal Bank
Account Name: FILM BEYOND IMAGINATION (FBI)
Account Number: 1400010238562
Branch: Dansoman

MOMO Service
*203*0771134#
Name: (FBI) FILM BEYOND IMAGINATION</textarea><button class="btn primary" onclick="saveSettings()">Save Settings</button></div>
    
  </div>
<style id="fbi-settings-access">
.nav button[data-v="settings"][data-pending]:not([data-pending=""])::after{content:attr(data-pending);margin-left:auto;min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:var(--u-brand,#c71954);color:#fff;font-size:11px;font-weight:800;display:inline-grid;place-items:center}
#view-settings .st-note{font-size:12.5px;color:var(--muted);line-height:1.55}
#view-settings .st-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
#view-settings .st-row .btn{height:42px;display:inline-flex;align-items:center;margin:0}
#view-settings .st-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:12px}
#view-settings .st-head .btn{white-space:nowrap;text-decoration:none}
#view-settings .st-list{margin-top:12px;display:flex;flex-direction:column;gap:6px}
#view-settings .st-item{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 12px;border:1px solid var(--border);border-radius:10px;background:var(--u-row,transparent)}
#view-settings .st-item .grow{flex:1;min-width:160px}
#view-settings .st-item b{display:block;font-size:14px;color:var(--text)}
#view-settings .st-item small{display:block;color:var(--muted);font-size:12px}
#view-settings .st-item .btn{height:34px;padding:0 12px;font-size:13px}
#view-settings .st-tag{font-size:11.5px;font-weight:700;padding:2px 9px;border-radius:999px;background:var(--u-neutral-bg,#eee);color:var(--u-neutral,#555)}
#view-settings .st-tag.active{background:var(--u-ok-bg);color:var(--u-ok)}
#view-settings .st-tag.pending{background:var(--u-warn-bg);color:var(--u-warn)}
#view-settings .st-tag.disabled{background:var(--u-bad-bg);color:var(--u-bad)}
#view-settings #staffPending .st-alert{padding:12px 14px;border-radius:12px;border:1px solid var(--u-warn,#b80);background:var(--u-warn-bg,#fff3d6);color:var(--text);margin-bottom:10px}
#view-settings #staffPending .st-alert>b{display:block;margin-bottom:8px;color:var(--u-warn)}
#view-settings details.st-add{margin-top:14px}
#view-settings details.st-add>summary{cursor:pointer;font-weight:600;color:var(--text)}
#view-settings .st-form{display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:10px;align-items:end;margin:10px 0 6px}
#view-settings .st-form label{margin:0 0 6px!important}
#view-settings .st-form .btn{height:42px}
@media(max-width:820px){#view-settings .st-form{grid-template-columns:1fr}#view-settings .st-head{flex-direction:column}}
</style>
<script id="fbi-settings-access-js">
(function(){
  function el(id){return document.getElementById(id)}
  function e(v){return String(v==null?"":v).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
  function when(t){if(!t)return "—";try{return new Date(t).toLocaleString(undefined,{day:"numeric",month:"short",year:"numeric",hour:"2-digit",minute:"2-digit"})}catch(x){return "—"}}
  function note(m){if(typeof toast==="function")toast(m);else alert(m)}
  async function api(url,opt){opt=opt||{};opt.credentials="same-origin";opt.headers=Object.assign({"Content-Type":"application/json"},opt.headers||{});const r=await fetch(url,opt);let b={};try{b=await r.json()}catch(x){}if(!r.ok||b.ok===false)throw new Error(b.error||("Request failed ("+r.status+")"));return b}

  /* ---------- backups ---------- */
  window.downloadServerBackup=function(id){window.location.href="/api/backups/"+encodeURIComponent(id)+"/download"};
  async function loadBackups(){
    const box=el("backupList");if(!box)return;
    try{
      const d=await api("/api/backups");
      if(!d.backups.length){box.innerHTML='<div class="st-note">The first automatic backup will be taken with the next save.</div>';return}
      box.innerHTML='<div class="st-note" style="margin-bottom:2px">Automatic backups (newest first)</div>'+d.backups.slice(0,7).map(function(b){return '<div class="st-item"><div class="grow"><b>'+e(when(b.createdAt))+'</b><small>'+e(b.invoiceCount==null?"":b.invoiceCount+" invoices · ")+e(b.clientCount==null?"":b.clientCount+" clients · ")+Math.max(1,Math.round(b.bytes/1024))+' KB</small></div><button class="btn" type="button" onclick="downloadServerBackup(\''+e(b.id)+'\')">Download</button></div>'}).join("")+(d.backups.length>7?'<div class="st-note">'+(d.backups.length-7)+' older backups kept on the server.</div>':"");
    }catch(x){box.innerHTML='<div class="st-note">Backups could not be listed: '+e(x.message)+'</div>'}
  }

  /* ---------- staff portal accounts ---------- */
  function row(u){
    const btns=u.status==="pending"
      ?'<button class="btn primary" type="button" data-st="approve" data-id="'+e(u.id)+'">Approve</button><button class="btn" type="button" data-st="disable" data-id="'+e(u.id)+'">Decline</button>'
      :u.status==="active"
      ?'<button class="btn" type="button" data-st="password" data-id="'+e(u.id)+'" data-name="'+e(u.name)+'">Reset password</button><button class="btn" type="button" data-st="disable" data-id="'+e(u.id)+'">Disable</button>'
      :'<button class="btn" type="button" data-st="approve" data-id="'+e(u.id)+'">Enable</button>';
    const label={active:"Active",pending:"Waiting for approval",disabled:"Disabled"}[u.status]||u.status;
    const meta="@"+u.username+(u.createdAt?" · requested "+when(u.createdAt):"")+(u.lastLoginAt?" · last sign-in "+when(u.lastLoginAt):"");
    return '<div class="st-item"><div class="grow"><b>'+e(u.name)+'</b><small>'+e(meta)+'</small></div><span class="st-tag '+e(u.status)+'">'+e(label)+'</span>'+btns+'</div>';
  }
  async function loadStaff(){
    const list=el("staffList"),pend=el("staffPending");if(!list)return;
    try{
      const d=await api("/api/staff-portal/users");
      const link=el("staffPortalLink");if(link&&d.portalUrl)link.href=d.portalUrl;
      const p=d.users.filter(function(u){return u.status==="pending"}),rest=d.users.filter(function(u){return u.status!=="pending"});
      pend.innerHTML=p.length?'<div class="st-alert"><b>'+p.length+' worker'+(p.length>1?"s are":" is")+' waiting for approval</b><div class="st-list" style="margin:0">'+p.map(row).join("")+'</div></div>':"";
      list.innerHTML=rest.length?rest.map(row).join(""):'<div class="st-note">No staff accounts yet. Add one below, or ask workers to request an account on the Staff Portal.</div>';
      const badge=document.querySelector('.nav [data-v="settings"]');if(badge)badge.setAttribute("data-pending",p.length?String(p.length):"");
    }catch(x){list.innerHTML='<div class="st-note">Staff accounts could not be loaded: '+e(x.message)+'</div>'}
  }
  document.addEventListener("click",async function(ev){
    const b=ev.target.closest&&ev.target.closest("[data-st]");if(!b||!el("staffAccessCard")||!el("staffAccessCard").contains(b))return;
    const id=b.getAttribute("data-id"),act=b.getAttribute("data-st");let body;
    if(act==="disable"&&!confirm("Disable this staff account? They will be signed out and cannot sign in until you enable it again."))return;
    if(act==="password"){const pw=prompt("New password for "+(b.getAttribute("data-name")||"this worker")+" (at least 8 characters):");if(!pw)return;body=JSON.stringify({password:pw})}
    b.disabled=true;
    try{await api("/api/staff-portal/users/"+encodeURIComponent(id)+"/"+act,{method:"POST",body:body||"{}"});note(act==="approve"?"Staff account approved":act==="disable"?"Staff account disabled":"Password updated — the worker has been signed out");loadStaff()}
    catch(x){note(x.message);b.disabled=false}
  });
  window.createStaffUser=async function(){
    const name=el("stName").value.trim(),username=el("stUser").value.trim(),password=el("stPass").value;
    try{await api("/api/staff-portal/users",{method:"POST",body:JSON.stringify({name:name,username:username,password:password})});el("stName").value="";el("stUser").value="";el("stPass").value="";note("Worker account created for "+name);loadStaff()}
    catch(x){note(x.message)}
  };
  function refreshAll(){loadStaff();loadBackups()}
  const view=el("view-settings");
  if(view){try{new MutationObserver(function(){if(view.classList.contains("active"))refreshAll()}).observe(view,{attributes:true,attributeFilter:["class"]})}catch(x){}}
  window.addEventListener("fbi-authenticated",function(){setTimeout(loadStaff,800)});
})();
</script>
</section>



<section class="view" id="view-whatsapp">
  <div class="card">
    <h3>WhatsApp Invoice Alerts</h3>
    <div class="grid2">
      <div>
        <label>Enable automatic invoice notifications</label>
        <select id="waEnabled">
          <option value="yes">Enabled</option>
          <option value="no">Disabled</option>
        </select>
        <label>Notification number</label>
        <input id="waRecipient" value="233257407350" placeholder="233257407350">
        <small style="color:#777;display:block;margin-top:5px">Use international format without + or spaces.</small>
        <label>Backend API URL</label>
        <input id="waApiUrl" value="/api/whatsapp/invoice-created" readonly>
      </div>
      <div>
        <label>WhatsApp template name</label>
        <input id="waTemplate" value="hello_world" placeholder="hello_world">
        <label>Template language</label>
        <input id="waLanguage" value="en_US">
        <label>Notification events</label>
        <select id="waEvent">
          <option value="created">Invoice created</option>
          <option value="created_paid">Invoice created or marked paid</option>
        </select>
      </div>
    </div>
    <div style="margin-top:15px;padding:12px;border:1px solid #343a46;background:#0d1016;border-radius:8px;color:#aab1bd;font-size:11px;line-height:1.6">
      <b style="color:#fff">How it works:</b><br>
      When an invoice is saved, Invoice Studio sends the invoice details to your secure backend. The backend sends the WhatsApp message through the WhatsApp Business Cloud API. Your Meta access token stays on the server and is never stored in this HTML file.
    </div>
    <div class="no-print" style="display:flex;gap:7px;margin-top:12px;flex-wrap:wrap">
      <button class="btn primary" onclick="saveWhatsAppSettings()">Save WhatsApp Settings</button>
      <button class="btn" onclick="connectWhatsAppBusinessApp()">Connect WhatsApp Business App</button>
      <button class="btn" onclick="testWhatsApp()">📱 Send Test Alert</button> <button class="btn" onclick="window.open('http://127.0.0.1:3000/health','_blank')">🔎 Server Health</button>
    </div>
    <div id="waStatus" style="margin-top:10px;color:#777;font-size:11px;white-space:pre-wrap">WhatsApp Business App connection is managed through Meta Embedded Signup.</div>
    <div style="margin-top:12px;padding:12px;border:1px solid #343a46;background:#0b0e13;border-radius:8px">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:8px"><b style="color:#fff">WhatsApp Debug Log</b><button class="btn" onclick="refreshWhatsAppDebug()">↻ Refresh Log</button></div>
      <pre id="waDebug" style="max-height:260px;overflow:auto;white-space:pre-wrap;color:#aab1bd;font-size:10px;margin:10px 0 0">No log yet.</pre>
    </div>
  </div>

  <div class="card">
    <h3>Recommended Meta Setup</h3>
    <ol style="font-size:11px;color:#aab1bd;line-height:1.8">
      <li>Create/verify your Meta Business portfolio and WhatsApp Business Account.</li>
      <li>Add/register the WhatsApp Business phone number you want to use for sending.</li>
      <li>Create an approved WhatsApp utility template named <b>invoice_created</b>.</li>
      <li>Put your Meta access token and WhatsApp Phone Number ID in the backend server, not in this HTML.</li>
      <li>Run the backend and set its public URL above.</li>
    </ol>
  </div>
</section>

<section class="view print-view" id="view-preview">
  <div class="no-print" style="padding:12px 24px;background:#11141b;border-bottom:1px solid #2b303c;display:flex;gap:7px"><button class="btn" onclick="show('create')">← Edit</button><button class="btn primary" onclick="printInvoice()">🖨 Print / Save PDF</button><button class="btn" onclick="save()">💾 Save</button></div>
  <div class="preview-wrap"><div class="paper" id="paper"></div></div>
</section>

<section class="view print-view" id="view-receipt-preview"><div class="no-print" style="padding:12px 24px;background:#11141b;border-bottom:1px solid #2b303c;display:flex;gap:7px;flex-wrap:wrap"><button class="btn" onclick="show('receipts')">← Back to Receipts</button><button class="btn primary" onclick="printReceipt()">🖨 Print / Save Receipt PDF</button><button class="btn" onclick="show('create');if(current)loadInvoice(current.id)">✏️ Open Invoice</button></div><div class="preview-wrap"><div class="receipt-paper" id="receiptPaper"></div></div></section>
</main>
<div class="toast" id="toast"></div>

<script>
const KEY="invoice-studio-fbi-v2";let data=[],clients=[],settings={},current=null;
const $=id=>document.getElementById(id);
