      <label>Phone</label><input id="dbClientPhone" placeholder="0250000000">
      <label>Email</label><input id="dbClientEmail" type="email" placeholder="client@example.com">
      <label>Address</label><textarea id="dbClientAddress" rows="3" placeholder="Client address"></textarea>
      <label>Notes</label><textarea id="dbClientNotes" rows="3" placeholder="Additional client notes"></textarea>
      <div style="display:flex;gap:8px;margin-top:12px"><button class="btn primary" onclick="saveClient()">Save Client</button><button class="btn" onclick="clearClientForm()">Clear</button></div>
