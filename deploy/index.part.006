G Follow Focus","SMALLRIG Matte Box","SMALLRIG Baseplate","SMALLRIG Shoulder Rig","SMALLRIG Top Handle","SMALLRIG Magic Arm","SMALLRIG Monitor Mount","SMALLRIG V-Mount Plate","TILTA Nucleus-M","TILTA Nucleus Nano II","TILTA Mirage Matte Box","TILTA Camera Cage","TILTA Shoulder Rig","TILTA V-Mount Plate","TILTA Float Handheld Support","TILTA Float Full Size Support","WOODEN CAMERA Unified Baseplate","WOODEN CAMERA Elite 3 Baseplate","ZACUTO Recoil Rig","ZACUTO Gratical Eye","ZACUTO VCT Pro Baseplate","KESSLER Pocket Dolly","KESSLER Shuttle Dolly","EDELKRONE SliderPLUS","EDELKRONE JibONE","MANFROTTO 504X","MANFROTTO 509HD","SACHTLER Flowtech 75","SACHTLER Flowtech 100"],"Video Transmission":["OSEE GoStream Deck","TERADEK Bolt 4K LT","TERADEK Bolt 4K 750","TERADEK Bolt 6 LT","TERADEK Bolt 6 XT","TERADEK Bolt 6 750","TERADEK Bolt 6 1500","TERADEK Prism Flex","TERADEK Cube","HOLLYLAND Mars 300 Pro","HOLLYLAND Mars 400S Pro","HOLLYLAND Mars 4K","HOLLYLAND COSMO C1","HOLLYLAND COSMO C2","HOLLYLAND Pyro H","HOLLYLAND Pyro S","HOLLYLAND Pyro 7","ACCSOON CineView HE","ACCSOON CineView SE","ACCSOON CineView Quad","VAXIS Atom 500","VAXIS Storm 800","VAXIS Storm 1000","VAXIS AirOne","DECIMATOR 12G-CROSS","BLACKMAGIC ATEM Streaming Bridge"],"Lighting & Grip":["APUTURE LS 600D Pro","APUTURE LS 600X Pro","APUTURE LS 1200D Pro","APUTURE STORM 1200X","NANLITE Forza 300B II","NANLITE Forza 500B II","NANLITE Forza 500C","GODOX KNOWLED M600Bi","GODOX KNOWLED M600D","ASTERA TITAN Tube","ASTERA Helios Tube","ARRI SkyPanel S60-C","ARRI Orbiter","MANFROTTO 055","MANFROTTO 504X","AVENGER C-Stand","KUPO Master C-Stand"]}
  function bootCatalog(){
    const cat=document.getElementById('serviceCategory');
    const brand=document.getElementById('brandModelFilter');
    const search=document.getElementById('itemSearch');
    const items=document.getElementById('catalogItemSelect');
    const count=document.getElementById('catalogCount');
    if(!cat||!brand||!search||!items) return false;
    const current=cat.value;
    cat.innerHTML='<option value="">Select a service category...</option>'+CATEGORIES.map(x=>'<option value="'+String(x).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')+'">'+String(x).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')+'</option>').join('');
    if(current && CATEGORIES.indexOf(current)>=0) cat.value=current;
    function esc(v){return String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
    function buildBrands(){
      const c=cat.value; const arr=CATALOG[c]||[];
      const prefixes=['SONY','CANON','BLACKMAGIC','PANASONIC','FUJIFILM','NIKON','RED','ARRI','DJI','SIGMA','TAMRON','APUTURE','GODOX','ASTERA','NANLITE','SENNHEISER','SHURE','RODE','ZOOM','TASCAM','HOLLYLAND','ATOMOS','TERADEK','DATAVIDEO','EPSON','BENQ','OPTOMA','MANFROTTO','SACHTLER','MILLER','AVENGER','KUPO','ZHIYUN','GOOGLE MEET','TEAMS'];
      const groups=[];
      arr.forEach(v=>{const u=String(v).toUpperCase(); const p=prefixes.find(x=>u===x||u.startsWith(x+' ')||u.startsWith(x+'-')); if(p&&!groups.includes(p))groups.push(p)});
      brand.innerHTML='<option value="">All Brands / Models</option>'+groups.map(x=>'<option value="'+esc(x)+'">'+esc(x)+'</option>').join('');
    }
    function refresh(){
      const c=cat.value, b=brand.value, q=search.value.trim().toLowerCase();
      let arr=(CATALOG[c]||[]).slice();
      if(b){const bu=b.toLowerCase();arr=arr.filter(x=>String(x).toLowerCase().startsWith(bu+' ')||String(x).toLowerCase().startsWith(bu+'-')||String(x).toLowerCase()===bu)}
      if(q)arr=arr.filter(x=>String(x).toLowerCase().includes(q));
      items.innerHTML=arr.length?arr.map(x=>'<option value="'+esc(x)+'">'+esc(x)+'</option>').join(''):'<option value="">No matching items</option>';
      if(count)count.textContent=arr.length+' available items';
    }
    cat.onchange=function(){buildBrands();search.value='';refresh();};
    brand.onchange=function(){refresh();};
    search.oninput=function(){refresh();};
    if(!cat.value && CATEGORIES.length)cat.value=CATEGORIES[0];
    buildBrands(); refresh();
    const add=document.getElementById('addSelectedCatalogBtn');
    if(add) add.onclick=function(){const name=items.value;if(!name){alert('Please select an item first.');return;} if(typeof window.addItem==='function'){window.addItem(name,1,0); if(typeof window.toast==='function')window.toast('Item added: '+name);} };
    const add25=document.getElementById('addCategoryItemsBtn');
    if(add25) add25.onclick=function(){const c=cat.value,b=brand.value;let arr=(CATALOG[c]||[]).slice();if(b){const bu=b.toLowerCase();arr=arr.filter(x=>String(x).toLowerCase().startsWith(bu+' ')||String(x).toLowerCase().startsWith(bu+'-')||String(x).toLowerCase()===bu)}arr.slice(0,25).forEach(n=>{if(typeof window.addItem==='function')window.addItem(n,1,0)});if(typeof window.toast==='function')window.toast('Added '+Math.min(25,arr.length)+' items');};
    return true;
  }
  function tryBoot(){try{if(!bootCatalog())setTimeout(tryBoot,250);}catch(e){console.error('Standalone catalog boot failed',e);setTimeout(tryBoot,500);}}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',tryBoot);else tryBoot();
  window.addEventListener('load',tryBoot);
})();
</script>
<script>
(function(){
  let deferredInstallPrompt=null;
  function installButton(){return document.getElementById("installAppBtn")}
  function setInstallButtonVisible(visible){
    const b=installButton(); if(b) b.style.display=visible?"inline-flex":"none";
  }
  window.installFBIApp=async function(){
    if(deferredInstallPrompt){
      try{
        deferredInstallPrompt.prompt();
        const choice=await deferredInstallPrompt.userChoice;
        deferredInstallPrompt=null;
        setInstallButtonVisible(false);
        if(choice && choice.outcome==="accepted")toast("FBI Invoice Studio installed");
      }catch(e){console.warn("Install prompt failed",e)}
      return;
    }
    const standalone=window.matchMedia && window.matchMedia("(display-mode: standalone)").matches;
    const ios=/iphone|ipad|ipod/i.test(navigator.userAgent);
    if(standalone){
      toast("FBI Invoice Studio is already installed");
    }else if(ios){
      alert("Install FBI Invoice Studio:\n\n1. Open this site in Safari.\n2. Tap Share.\n3. Choose “Add to Home Screen”.\n4. Keep “Open as Web App” enabled.\n5. Tap Add.");
    }else{
      alert("Install FBI Invoice Studio from your browser menu:\n\nChrome / Edge on PC: choose the Install app icon in the address bar or open the browser menu and choose “Install FBI Invoice Studio”.\n\nAndroid: use the browser menu and choose “Install app” or “Add to Home screen”.");
    }
  };
  window.addEventListener("beforeinstallprompt",function(e){
    e.preventDefault();
    deferredInstallPrompt=e;
    setInstallButtonVisible(true);
  });
  window.addEventListener("appinstalled",function(){
    deferredInstallPrompt=null;
    setInstallButtonVisible(false);
    try{toast("FBI Invoice Studio installed successfully");}catch(e){}
  });
  function registerPWA(){
    if(!("serviceWorker" in navigator))return;
    navigator.serviceWorker.register("/sw.js",{scope:"/"})
      .then(function(reg){
        if(reg && reg.update)reg.update().catch(function(){});
      })
      .catch(function(err){console.warn("PWA service worker registration failed:",err)});
  }
  if(document.readyState==="loading"){
    document.addEventListener("DOMContentLoaded",registerPWA);
  }else{
    registerPWA();
  }
  window.addEventListener("load",function(){
    setTimeout(function(){
      const b=installButton();
      if(!b)return;
      const standalone=window.matchMedia && window.matchMedia("(display-mode: standalone)").matches;
      if(standalone)b.style.display="none";
      else if(!deferredInstallPrompt)b.style.display="inline-flex";
    },800);
  });
})();
</script>
</body>
</html>