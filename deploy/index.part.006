  const paidCount=infos.filter(o=>o.status==="Paid").length;
  const overdueCount=infos.filter(o=>o.status==="Overdue").length;
  const dueSoon=infos.filter(o=>o.status!=="Paid"&&o.status!=="Draft"&&o.dueDate&&daysFromToday(o.dueDate)>=0&&daysFromToday(o.dueDate)<=7);
  const dueSoonAmt=dueSoon.reduce((s,o)=>s+invoiceBalance(o.x),0);
  const collection=total?Math.min(100,(collected/total)*100):0;
  const rentals=data.filter(x=>x.category==="Equipment Rentals").length;
  const avg=data.length?total/data.length:0;
  $("sCount").textContent=data.length;$("sCountMeta").textContent=paidCount+" paid · "+drafts+" drafts";
  $("sInvoiced").textContent=fmtMoney(total,"GHS");$("sInvoicedMeta").textContent=data.length+" saved invoice"+(data.length===1?"":"s");
  $("sPaid").textContent=fmtMoney(collected,"GHS");$("sPaidMeta").textContent=paidCount+" fully paid · "+partial+" partial";
  $("sDue").textContent=fmtMoney(outstanding,"GHS");$("sDueMeta").textContent=(sent+partial+overdue)+" open invoice"+((sent+partial+overdue)===1?"":"s");
  $("sOverdue").textContent=fmtMoney(overdue,"GHS");$("sOverdueMeta").textContent=overdueCount+" overdue";
  $("sDueSoon").textContent=fmtMoney(dueSoonAmt,"GHS");$("sDueSoonMeta").textContent=dueSoon.length+" due within 7 days";
  $("sDraft").textContent=drafts;$("sDraftMeta").textContent="Not yet sent";
  $("sClients").textContent=clients.length;$("sClientsMeta").textContent="Client database";
  $("ovSent").textContent=sent;$("ovPartial").textContent=partial;$("ovPaid").textContent=paidCount;$("ovOverdue").textContent=overdueCount;$("ovDraft").textContent=drafts;$("ovCollection").textContent=collection.toFixed(1)+"%";$("ovAverage").textContent=fmtMoney(avg,"GHS");$("ovRentals").textContent=rentals;
  const attention=[];if(overdueCount)attention.push(`<div class="attention-item"><div class="attention-icon">⚠️</div><div class="grow"><b>${overdueCount} overdue invoice${overdueCount===1?"":"s"}</b><small>${fmtMoney(overdue,"GHS")} requires follow-up</small></div><button class="btn" onclick="show('saved')">Review</button></div>`);if(drafts)attention.push(`<div class="attention-item"><div class="attention-icon">📝</div><div class="grow"><b>${drafts} draft invoice${drafts===1?"":"s"}</b><small>Saved but not sent to clients</small></div><button class="btn" onclick="show('saved')">Review</button></div>`);if(dueSoon.length)attention.push(`<div class="attention-item"><div class="attention-icon">⏰</div><div class="grow"><b>${dueSoon.length} invoice${dueSoon.length===1?"":"s"} due soon</b><small>${fmtMoney(dueSoonAmt,"GHS")} due within 7 days</small></div></div>`);$("attentionList").innerHTML=attention.join("")||'<div style="color:#6f7888;font-size:10px;padding:14px 0">✓ Nothing requires immediate attention.</div>';
  $("recent").innerHTML=infos.slice(0,10).map(o=>{const x=o.x,b=invoiceBalance(x);return `<tr><td><b>${esc(x.no)}</b></td><td>${esc(x.client||"No client")}</td><td>${esc(x.date||"—")}</td><td>${esc(x.due||"On Receipt")}</td><td><span class="status-pill ${o.cls}">${esc(o.status)}</span></td><td>${fmtMoney(x.total,x.cur)}</td><td>${fmtMoney(b,x.cur)}</td><td><button class="btn" onclick="previewSaved('${x.id}')">View</button></td></tr>`}).join("")||'<tr><td colspan="8" style="text-align:center;color:#777;padding:22px">Create your first invoice to start your dashboard.</td></tr>';
  const dueRows=infos.filter(o=>o.status!=="Paid"&&o.status!=="Draft"&&o.dueDate).sort((a,b)=>a.dueDate-b.dueDate).slice(0,8);$("dueList").innerHTML=dueRows.length?dueRows.map(o=>{const d=daysFromToday(o.dueDate),label=d<0?Math.abs(d)+" day"+(Math.abs(d)===1?"":"s")+" overdue":d===0?"Due today": "Due in "+d+" day"+(d===1?"":"s");return `<div class="due-item"><div class="grow"><b>${esc(o.x.no)} · ${esc(o.x.client||"No client")}</b><small class="${d<0?"due-overdue":d<=7?"due-soon":"due-normal"}">${label} · ${fmtMoney(invoiceBalance(o.x),o.x.cur)}</small></div><button class="btn" onclick="previewSaved('${o.x.id}')">View</button></div>`}).join(""):'<div style="color:#6f7888;font-size:10px;padding:12px 0">No dated open invoices.</div>';
  $("sumClients").textContent=clients.length;$("sumClientInvoices").textContent=data.filter(x=>x.client).length;$("sumNoClient").textContent=data.filter(x=>!x.client).length;$("sumLatest").textContent=data[0]?data[0].no:"—";$("sumLatestClient").textContent=clients[0]?clients[0].name:"—";
}
function saveSettings(){settings.biz=$("biz").value;settings.owner=$("owner").value;settings.baddr=$("baddr").value;settings.bphone=$("bphone").value;settings.bemail=$("bemail").value;settings.bnum=$("bnum").value;settings.defaultPay=$("defaultPay").value;settings.template=Number($("template")?.value||settings.template||100)||100;persist();$("payment").value=settings.defaultPay;toast("Settings saved")}
$("logoFile").onchange=function(){let f=this.files[0];if(!f)return;let r=new FileReader();r.onload=e=>{settings.logo=e.target.result;persist();toast("Logo saved")};r.readAsDataURL(f)}

const LOCAL_RECOVERY_KEY="fbi-invoice-recovery-v1";
function generateRecoveryCode(){
  const bytes=new Uint8Array(8);
  if(window.crypto&&window.crypto.getRandomValues)window.crypto.getRandomValues(bytes);
  else for(let i=0;i<bytes.length;i++)bytes[i]=Math.floor(Math.random()*256);
  const hex=Array.from(bytes).map(b=>b.toString(16).padStart(2,"0")).join("").toUpperCase();
  return hex.match(/.{1,4}/g).join("-");
}
function getAuth(){
  try{
    const raw=window.localStorage.getItem(LOCAL_RECOVERY_KEY);
    const a=raw?JSON.parse(raw):null;
    if(a&&typeof a==="object")return a;
  }catch(e){}
  return null;
}
function setAuth(a){
  try{
    window.localStorage.setItem(LOCAL_RECOVERY_KEY,JSON.stringify(a));
    return true;
  }catch(e){
    console.warn("Recovery code could not be saved locally:",e);
    return false;
  }
}

function showRecoveryCode(){const a=getAuth();if(!a?.recoveryCode){toast("No recovery code available");return}$('recoveryDisplay').value=a.recoveryCode;toast("Recovery code displayed")}
function regenerateRecoveryCode(){if(!confirm("Generate a new recovery code? The old code will stop working."))return;const a=getAuth();if(!a)return;a.recoveryCode=generateRecoveryCode();a.recoveryIssuedAt=new Date().toISOString();setAuth(a);$('recoveryDisplay').value=a.recoveryCode;alert("NEW RECOVERY CODE:\n\n"+a.recoveryCode+"\n\nSave it in a safe place.");toast("Recovery code regenerated")}
function saveWhatsAppSettings(){
  settings.waEnabled=$("waEnabled").value;
  settings.waRecipient=$("waRecipient").value.replace(/\D/g,"");
  settings.waApiUrl=$("waApiUrl").value.trim();
  settings.waTemplate=$("waTemplate").value.trim();
  settings.waLanguage=$("waLanguage").value.trim()||"en_US";
  settings.waEvent=$("waEvent").value;
  persist();
  toast("WhatsApp settings saved");
}
function invoiceNotificationUrl(invoice){
  const base=(settings.waApiUrl||"/api/whatsapp/invoice-created").trim();
  const url=new URL(base, "http://127.0.0.1:3000");
  const q={recipient:settings.waRecipient||"233257407350",template:settings.waTemplate||"hello_world",language:settings.waLanguage||"en_US",number:invoice.no,client:invoice.client||"Client",total:Number(invoice.total||0).toFixed(2),currency:invoice.cur||"GHS",date:invoice.date||"",due:invoice.due||"",status:invoice.status||""};
  Object.entries(q).forEach(([k,v])=>url.searchParams.set(k,String(v)));
  return url.href;
}
function setWaStatus(text){const el=$("waStatus");if(el)el.textContent=text}
async function sendWhatsAppNotification(invoice){if(settings.waEnabled!=="yes")return {skipped:true};const payload={recipient:settings.waRecipient||"233257407350",template:settings.waTemplate||"hello_world",language:settings.waLanguage||"en_US",invoice:{number:invoice.no,client:invoice.client||"Client",total:Number(invoice.total||0),currency:invoice.cur||"GHS",date:invoice.date||"",due:invoice.due||"",status:invoice.status||""}};try{const res=await fetch("/api/whatsapp/invoice-created",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});const raw=await res.text();let body={};try{body=JSON.parse(raw)}catch(e){body={error:raw||"Empty server response"}};if(!res.ok||!body.ok)return {ok:false,error:body.error||("Server returned HTTP "+res.status),status:res.status,meta:body.meta};return {ok:true,messageId:body.messageId,status:res.status,meta:body.meta}}catch(e){return {ok:false,error:e.message||"Could not reach WhatsApp gateway"}}}
async function testWhatsApp(){saveWhatsAppSettings();setWaStatus("Testing Meta WhatsApp connection...");try{const res=await fetch("/api/whatsapp/test?recipient="+encodeURIComponent(settings.waRecipient||"233257407350"));const raw=await res.text();let body={};try{body=JSON.parse(raw)}catch(e){body={error:raw||"Empty server response"}}if(!res.ok||!body.ok){setWaStatus("❌ "+(body.error||("HTTP "+res.status))+"\nHTTP: "+res.status);return}setWaStatus("✅ WhatsApp API accepted the test.\nMessage ID: "+body.messageId+"\nHTTP: "+res.status);refreshWhatsAppDebug()}catch(e){setWaStatus("❌ Cannot reach local WhatsApp server. "+(e.message||""))}}
async function refreshWhatsAppDebug(){try{const r=await fetch("/api/whatsapp/debug-log");const b=await r.json();$("waDebug").textContent=b.log||"No WhatsApp server log yet."}catch(e){$("waDebug").textContent="Could not load debug log: "+e.message}}

function exportStudioBackup(){
  try{
    const payload={version:3,exportedAt:new Date().toISOString(),data,clients,settings};
    const blob=new Blob([JSON.stringify(payload,null,2)],{type:"application/json"});
    const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="FBI-Invoice-Studio-backup.json";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);
    toast("Backup exported");
  }catch(e){console.error(e);toast("Could not export backup: "+e.message)}
}
function importStudioBackup(evt){
  const f=evt.target.files&&evt.target.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=()=>{
    try{
      const obj=JSON.parse(r.result||"{}");
      if(!Array.isArray(obj.data)||!Array.isArray(obj.clients)||!obj.settings)throw new Error("Invalid Invoice Studio backup file");
      data=obj.data;clients=obj.clients;settings={...settings,...obj.settings};persist();populateClientSelect();renderClients();dashboard();renderSaved();renderReceipts();toast("Backup restored successfully");
    }catch(e){console.error(e);toast("Backup restore failed: "+e.message)}
    finally{evt.target.value=""}
  };
  r.readAsText(f);
}
function preview(){
  try{
    const invoice=get();
    if(!validateMediaEventDate(invoice))return;
    renderPaper();
    document.querySelectorAll(".view").forEach(v=>v.classList.remove("active","print-view"));
    $("view-preview").classList.add("active");
    $("side").classList.remove("open");
  }catch(e){console.error("Preview error",e);toast("Preview failed: "+e.message)}
}
function renderPaper(){
 let x=get(),s=settings,logo=s.logo?`<div class="logo" style="background-image:url('${s.logo}')"></div>`:`<div class="logo"></div>`;
 let rows=x.items.map(i=>{const days=Math.max(1,Number(i.days)||1),qty=Number(i.qty)||0,rate=Number(i.rate)||0;return `<tr><td>${esc(i.desc)}</td><td>${esc(money(rate))}</td><td>${days}</td><td>${qty}</td><td>${esc(money(rate*days*qty))}</td></tr>`}).join("");
 let vat=x.vatInclusive?`<div class="vat-note">This invoice is VAT inclusive.</div>`:"";
 let status=(x.status||"Draft").toLowerCase();
 let statusClass=status.includes("paid")&&!status.includes("partial")?"status-paid":status.includes("overdue")?"status-overdue":status.includes("partial")?"status-partial":status.includes("sent")?"status-sent":"status-draft";
 let rental=x.category==="Equipment Rentals"?`<div class="rental-box"><div class="rental-title">Equipment Rental Details</div><div class="rental-grid"><div>Period<b>${esc(x.rentalStart||"—")} → ${esc(x.rentalEnd||"—")}</b></div><div>Rate Unit<b>${esc(x.rentalUnit||"Per Day")}</b></div><div>Job Location<b>${esc(x.jobLocation||"—")}</b></div><div>Reference / Deposit<b>${esc(x.rentalRef||"—")}${x.deposit?" · "+esc(money(x.deposit))+" deposit":""}</b></div></div></div>`:"";
 let eventEnd=x.eventEndDate||x.eventDate;
 let eventLabel=x.eventDate?(x.eventEndDate&&x.eventEndDate!==x.eventDate?x.eventDate+" → "+x.eventEndDate:x.eventDate):"";
 let eventDetails=isMediaServiceCategory(x.category)&&x.eventDate?`<div class="rental-box"><div class="rental-title">Event Details</div><div class="rental-grid"><div>Service Category<b>${esc(x.category)}</b></div><div>Event Date / Period<b>${esc(eventLabel)}</b></div></div></div>`:"";
 $("paper").className="paper template-100";
 $("paper").innerHTML=`
 <div class="paper-top">
   <div class="business">${logo}<div class="biz"><h2>${esc(s.biz)}</h2><div>${esc(s.owner)}<br>${esc(s.bnum)} · ${esc(s.baddr)}<br>${esc(s.bphone)} · ${esc(s.bemail)}</div></div></div>
   <div class="invoice-meta"><b>INVOICE</b><div class="big">${esc(x.no)}</div><b>ISSUED</b><br>${esc(x.date)}<br><br><b>DUE</b><br>${esc(x.due)}<br><span class="status-pill ${statusClass}">${esc(x.status||"Draft")}</span></div>
 </div>
 <div class="bill"><div class="bill-grid">
   <div class="info-card"><div class="info-label">Bill To</div><div class="bill-name">${esc(x.client||"Client")}</div><div class="bill-info">${esc(x.clientAddress||"")}<br>${esc(x.clientPhone||"")}${x.clientEmail?esc(" · "+x.clientEmail):""}</div></div>
   <div class="info-card"><div class="info-label">Amount Due</div><div class="bill-name">${esc(money(x.total))}</div><div class="bill-info">Invoice total · ${esc(x.cur||"GHS")}<br>Payment status: ${esc(x.status||"Draft")}</div></div>
 </div></div>
 ${rental}
 ${eventDetails}
 <table class="invtable"><thead><tr><th>DESCRIPTION</th><th>RATE / DAY</th><th>DAYS</th><th>QTY</th><th>AMOUNT</th></tr></thead><tbody>${rows||`<tr><td>No items added</td><td>${esc(money(0))}</td><td>1</td><td>0</td><td>${esc(money(0))}</td></tr>`}</tbody></table>
 <div class="lower"><div class="pay"><h3>Payment Information</h3><h4>PAYMENT INSTRUCTIONS</h4><p>${esc(x.payment||s.defaultPay||"").replace(/\n/g,"<br>")}</p><h4>NOTES</h4><p>${esc(x.notes||"Thank you for your business.")}</p>${vat}</div><div class="totals"><div class="tl"><span>SUBTOTAL</span><b>${esc(money(x.sub))}</b></div><div class="tl"><span>DISCOUNT</span><b>${esc(money(x.dis||0))}</b></div><div class="tl"><span>TAX (${x.taxRate}%)</span><b>${esc(money(x.tax))}</b></div><div class="tl total"><span>TOTAL</span><b>${esc(money(x.total))}</b></div><div class="tl balance"><span>BALANCE DUE</span><b>${esc(money(x.total))}</b></div></div></div>
 <div class="paper-footer"><b>PAYMENT &amp; RECORD</b><div class="two"><div>${esc(s.biz)} · ${esc(s.bemail)} · ${esc(s.bphone)}</div><div style="text-align:right">Invoice ${esc(x.no)} · ${esc(x.status||"Draft")}<br>Thank you for your business.</div></div></div>
 <div class="watermark">${esc(s.biz)} · ${esc(x.no)}</div>`;
}
function printInvoice(){
  try{
    const invoice=get();
    if(!validateMediaEventDate(invoice))return;
    if(!invoice.no){toast("Invoice number is missing.");return}
    renderPaper();
    persist();
    openDocumentPrint($("paper"),"Invoice "+invoice.no,"size:A4 portrait;margin:0");
  }catch(err){console.error("Invoice print failed",err);toast("Could not prepare invoice PDF: "+err.message)}
}
async function savePdfToDrive(){
  try{
    const invoice=get();
    if(!invoice.no){toast("Invoice number is missing.");return}
    renderPaper();
    persist();
    openDocumentPrint($("paper"),"Invoice "+invoice.no,"size:A4 portrait;margin:0");
    toast("Use the print dialog and choose Save as PDF");
  }catch(err){console.error(err);toast("Could not prepare PDF: "+err.message)}
}
async function saveReceiptToDrive(){
  try{
    if(!current){toast("No receipt selected");return}
    renderReceipt(current);
    persist();
    openDocumentPrint($("receiptPaper"),"Receipt "+(current.receiptNo||nextReceiptNumber()),"size:A5 portrait;margin:0");
    toast("Use the print dialog and choose Save as PDF");
  }catch(err){console.error(err);toast("Could not prepare receipt PDF: "+err.message)}
}

function initServiceCatalog(){
  const cat=document.getElementById("serviceCategory");
  const brand=document.getElementById("brandModelFilter");
  const search=document.getElementById("itemSearch");
  const itemSelect=document.getElementById("catalogItemSelect");
  const addBtn=document.getElementById("addSelectedCatalogBtn");
  const add25Btn=document.getElementById("addCategoryItemsBtn");
  const count=document.getElementById("catalogCount");
  if(!cat||!brand||!search||!itemSelect)return false;

  // Build category list from the catalog, while preserving the service groups.
  if(typeof SERVICE_CATALOG === "undefined") return false;
  const categories=(typeof SERVICE_CATEGORIES!=="undefined"&&Array.isArray(SERVICE_CATEGORIES))?SERVICE_CATEGORIES.slice():Object.keys(SERVICE_CATALOG);
  cat.innerHTML='<option value="">Select a service category...</option>'+categories.map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join("");

  function buildBrands(){
    const c=cat.value;
    const items=SERVICE_CATALOG[c]||[];
    // For a selected category, derive recognizable manufacturer/model groups.
    const prefixes=["SONY","CANON","BLACKMAGIC","PANASONIC","FUJIFILM","NIKON","RED","ARRI","DJI","SIGMA","TAMRON","APUTURE","GODOX","ASTERA","NANLITE","SENNHEISER","SHURE","RODE","ZOOM","TASCAM","HOLLYLAND","ATOMOS","TERADEK","DATAVIDEO","EPSON","BENQ","OPTOMA","MANFROTTO","SACHTLER","MILLER","AVENGER","KUPO","ZHIYUN","OSEE","SYNCO","ROLAND","ROSS","NEWTEK","AVMATRIX","KILOVIEW","UBIQUITI","MIKROTIK","CISCO","TP-LINK","HIKVISION","DAHUA","UNIVIEW","AXIS","SMALLRIG","TILTA","ZACUTO","FEELWORLD","DESVIEW","LILLIPUT","MARSHALL","DEITY","SARAMONIC","COMICA","ACCSOON","VAXIS","PANASONIC","AJA","DECIMATOR","VIZRT"];
    const groups=[];
    const catalogGroups=Object.keys(SERVICE_CATALOG);
    if(catalogGroups.includes(c) && c!=="Equipment Rentals") groups.push(c);
    for(const item of items){
      const u=String(item).toUpperCase();
      const p=prefixes.find(x=>u.startsWith(x+" ")||u.startsWith(x+"-")||u===x);
      if(p && !groups.includes(p))groups.push(p);
    }
    brand.innerHTML='<option value="">All Brands / Models</option>'+groups.map(g=>`<option value="${esc(g)}">${esc(g)}</option>`).join("");
  }

  function currentItems(){
    const c=cat.value;
    const b=brand.value;
    let arr=[];
    if(b){
      const categoryItems=SERVICE_CATALOG[c]||[];
      const bu=b.toUpperCase();
      arr=categoryItems.filter(x=>String(x).toUpperCase().startsWith(bu+" ")||String(x).toUpperCase().startsWith(bu+"-")||String(x).toUpperCase()===bu);
      // If brand is actually a catalog group, use that group.
      if(!arr.length && SERVICE_CATALOG[b]) arr=SERVICE_CATALOG[b].slice();
      // Also search globally for a brand/model group when the selected category has no prefix match.
      if(!arr.length){
        for(const key of Object.keys(SERVICE_CATALOG)){
          if(key.toUpperCase().includes(bu)) { arr=SERVICE_CATALOG[key].slice(); break; }
        }
      }
    }else{
      arr=(SERVICE_CATALOG[c]||[]).slice();
    }
    const q=search.value.trim().toLowerCase();
    if(q)arr=arr.filter(x=>String(x).toLowerCase().includes(q));
    return arr;
  }

  function refresh(){
    const arr=currentItems();
    itemSelect.innerHTML=arr.length
      ? arr.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join("")
      : '<option value="">No matching items</option>';
    if(count)count.textContent=cat.value?`${arr.length} available items`:'Select a service category';
  }

  cat.onchange=function(){buildBrands();search.value="";refresh();toggleRentalDetails();toggleEventDate();};
  brand.onchange=function(){search.value="";refresh();toggleRentalDetails();};
  search.oninput=refresh;
  itemSelect.ondblclick=function(){addSelectedCatalogItem();};
  if(addBtn)addBtn.onclick=addSelectedCatalogItem;
  if(add25Btn)add25Btn.onclick=addCategoryItems;

  if(!cat.value && categories.length){cat.value=categories[0];}
  buildBrands();
  refresh();
  toggleRentalDetails();
  toggleEventDate();
  return true;
}

function addSelectedCatalogItem(){
  const name=document.getElementById("catalogItemSelect")?.value||"";
  if(!name){toast("Select an item first");return false;}
  addItem(name,1,0);
  toast("Item added: "+name);
  return true;
}

function addCategoryItems(){
  const arr=(function(){
    const c=document.getElementById("serviceCategory")?.value||"";
    const b=document.getElementById("brandModelFilter")?.value||"";
    if(b && SERVICE_CATALOG[b])return SERVICE_CATALOG[b].slice();
    const items=SERVICE_CATALOG[c]||[];
    if(b){const bu=b.toUpperCase();return items.filter(x=>String(x).toUpperCase().startsWith(bu+" ")||String(x).toUpperCase().startsWith(bu+"-"));}
    return items.slice();
  })();
  const names=arr.slice(0,25);
  names.forEach(n=>addItem(n,1,0));
  toast(`Added ${names.length} items. Use the search box for more.`);
}

function setCategory(c){
  if($("serviceCategory")){$("serviceCategory").value=c;$("itemSearch").value="";$("serviceCategory").dispatchEvent(new Event("change"));}
}

let authMode="login";
const AUTH_SESSION="invoice-studio-fbi-server-session";
let authAccountExists=false;
let authProfile=null;

async function authRequest(path, method="GET", body=null){
  const options={method,cache:"no-store",credentials:"same-origin",headers:{}};
  if(body!==null){options.headers["Content-Type"]="application/json";options.body=JSON.stringify(body)}
  const res=await fetch(path,options);
  const raw=await res.text();
  let data={};try{data=raw?JSON.parse(raw):{}}catch(e){data={error:raw||"Empty server response"}}
  if(!res.ok || data.ok===false) throw new Error(data.error||("HTTP "+res.status));
  return data;
}

async function refreshAuthSession(){
  try{
    const me=await authRequest("/api/auth/me");
    if(me && me.authenticated){
      authProfile={username:me.username||""};
      authAccountExists=true;
      return true;
    }
    return false;
  }catch(e){
    console.warn("Authentication session check failed",e);
    return false;
  }
}
async function refreshAuthStatus(){
  let lastError=null;
  for(let attempt=0;attempt<3;attempt++){
    try{
      const status=await authRequest("/api/auth/status");
      authAccountExists=!!status.accountExists;
      window.__fbiAuthStatusAvailable=true;
      return status;
    }catch(e){
      lastError=e;
      await new Promise(r=>setTimeout(r,250*(attempt+1)));
    }
  }
  console.error("Authentication server unavailable",lastError);
  window.__fbiAuthStatusAvailable=false;
  authAccountExists=true;
  return {ok:false,accountExists:true,error:lastError?.message||"Authentication server unavailable"};
}
function setAuthMessage(msg,ok=false){const el=$("authMsg");if(!el)return;el.textContent=msg;el.style.color=ok?"#75dfae":"#f0a4a4"}
async function configureAuthMode(){
  const status=await refreshAuthStatus();
  const exists=!!status.accountExists;
  authMode=exists?"login":"setup";
  $("authTitle").textContent=exists?"Welcome Back":"Create Your Account";
  $("authSub").textContent=exists?"Sign in to access your FBI Invoice Studio workspace.":"Create your administrator account to secure this invoice workspace.";
  $("authSubmit").textContent=exists?"Sign In":"Create Account";
  $("authConfirmWrap").style.display=exists?"none":"block";
  $("authPass").autocomplete=exists?"current-password":"new-password";
  $("authPass").placeholder=exists?"Enter your password":"Create a password (8+ characters)";
  $("authUser").value=authProfile?.username||"";
  $("createAccountLink").style.display=exists?"none":"inline-block";
  if(status.ok===false && window.__fbiAuthStatusAvailable===false){
    setAuthMessage("Cannot verify the administrator account. Check that the Invoice Studio server is running, then refresh the page.");
  }else{
    setAuthMessage("");
  }
}
async function switchToCreateAccount(){
  const status=await refreshAuthStatus();
  if(status.accountExists){
    authMode="login";
    $("authTitle").textContent="Welcome Back";
    $("authSub").textContent="Sign in to access your FBI Invoice Studio workspace.";
    $("authSubmit").textContent="Sign In";
    $("authConfirmWrap").style.display="none";
    $("createAccountLink").style.display="none";
    setAuthMessage("An administrator account already exists. Please sign in.");
    return;
  }
  authMode="setup";
  $("authTitle").textContent="Create Your Account";
  $("authSub").textContent="Create your administrator account to secure this invoice workspace.";
  $("authSubmit").textContent="Create Account";
  $("authConfirmWrap").style.display="block";
  $("authPass").value="";$("authPassConfirm").value="";
  setAuthMessage("");
}
function togglePasswordField(id,btn){
  const input=$(id);if(!input)return;
  const show=input.type==="password";input.type=show?"text":"password";
  if(btn){btn.setAttribute("aria-label",show?"Hide password":"Show password");btn.textContent="◉";}
}
async function showAuthScreen(){
  document.body.classList.add("auth-locked");$("authView").hidden=false;
  await configureAuthMode();
  setTimeout(()=>$("authUser")?.focus(),80);
}
function enterApp(){
  document.body.classList.remove("auth-locked");
  try{$("authView").hidden=true}catch(e){}
  try{sessionStorage.setItem(AUTH_SESSION,"1")}catch(e){}
  try{if(typeof refreshAppUI_==="function")refreshAppUI_()}catch(e){}
  const target=cloudDraftRestoredOnStartup?"create":"dashboard";
  try{location.hash=target==="create"?"#view-create":"#view-dashboard"}catch(e){}
  try{show(target)}catch(e){}
}
async function logoutApp(){
  try{await authRequest("/api/auth/logout","POST",{})}catch(e){console.warn("Logout request failed",e)}
  try{sessionStorage.removeItem(AUTH_SESSION)}catch(e){}
  authProfile=null;
  await showAuthScreen();
  toast("Signed out");
}
async function showForgotPassword(){
  $("loginPanel").style.display="none";$("forgotPanel").style.display="block";
  $("forgotUser").value=$("authUser").value.trim();$("forgotMsg").textContent="";$("forgotMsg").style.color="#f0a4a4";
  setTimeout(()=>$("forgotUser").focus(),50);
}
async function hideForgotPassword(){$("forgotPanel").style.display="none";$("loginPanel").style.display="block";await configureAuthMode()}
async function resetPasswordWithRecovery(){
  const username=$("forgotUser").value.trim(),code=$("forgotCode").value.trim(),np=$("forgotNew").value,cp=$("forgotNewConfirm").value;
  if(!username||!code||!np||!cp){$("forgotMsg").textContent="Complete all fields.";return}
  if(np.length<8){$("forgotMsg").textContent="Password must contain at least 8 characters.";return}
  if(np!==cp){$("forgotMsg").textContent="Passwords do not match.";return}
  try{
    const a=await authRequest("/api/auth/reset","POST",{username,recoveryCode:code,newPassword:np});
    authProfile={username};
    $("forgotMsg").style.color="#75dfae";
    $("forgotMsg").innerHTML="Password reset successfully.<div class=\"auth-recovery\">Your new recovery code:<code>"+a.recoveryCode+"</code></div>";
    $("forgotNew").value="";$("forgotNewConfirm").value="";$("forgotCode").value="";
    authAccountExists=true;
  }catch(e){$("forgotMsg").textContent=e.message||"Password reset failed. Please try again."}
}
async function handleAuth(e){
  e.preventDefault();
  const username=$("authUser").value.trim(),password=$("authPass").value;
  if(username.length<3){setAuthMessage("Username must contain at least 3 characters.");return false}
  if(password.length<8){setAuthMessage("Password must contain at least 8 characters.");return false}
  try{
    if(authMode==="setup"){
      const confirm=$("authPassConfirm").value;
      if(password!==confirm){setAuthMessage("Passwords do not match.");return false}
      const a=await authRequest("/api/auth/setup","POST",{username,password,confirmPassword:confirm});
      authProfile={username:a.username};authAccountExists=true;
      await hydrateCloudState();
      enterApp();
      setTimeout(()=>alert("ACCOUNT CREATED\n\nYour recovery code is:\n\n"+a.recoveryCode+"\n\nSave this code somewhere safe. You need it to reset your password."),100);
      return false;
    }
    const a=await authRequest("/api/auth/login","POST",{username,password});
    authProfile={username:a.username};authAccountExists=true;
    await hydrateCloudState();
    enterApp();
  }catch(err){
    console.error("Authentication request failed",err);
    setAuthMessage(err.message||"Authentication could not be completed. Please try again.");
  }
  return false;
}
function paintLoadedState_(){
  normalizePaymentSettings();
  ["biz","owner","baddr","bphone","bemail","bnum","defaultPay"].forEach(k=>{if($(k))$(k).value=settings[k]||""});
  if($("waEnabled"))$("waEnabled").value=settings.waEnabled||"yes";
  if($("waRecipient"))$("waRecipient").value=settings.waRecipient||"233257407350";
  if($("waApiUrl"))$("waApiUrl").value=settings.waApiUrl||"/api/whatsapp/invoice-created";
  if($("waTemplate"))$("waTemplate").value=settings.waTemplate||"hello_world";
  if($("waLanguage"))$("waLanguage").value=settings.waLanguage||"en_US";
  if($("waEvent"))$("waEvent").value=settings.waEvent||"created";
  populateClientSelect();renderClients();dashboard();renderSaved();renderReceipts();initServiceCatalog();
  const st=$("storageStatus");
  if(st && !serverDbOnline)st.textContent='Cloud database is not connected. Check your internet connection and server status.';
}
let cloudStateHydrated=false;
let cloudDraftRestoredOnStartup=false;
async function hydrateCloudState(){
  const stored=await readPersistentPayload();
  init(true,stored);
  initTemplates();
  initServiceCatalog();
  paintLoadedState_();
  const restoredLocal=restoreDraft();
  const restoredCloud=restoredLocal?false:await restoreCloudDraft();
  cloudDraftRestoredOnStartup=!!(restoredLocal||restoredCloud);
  if(!cloudDraftRestoredOnStartup && !data.length && !current) newInvoice();
  cloudStateHydrated=true;
  return stored;
}
async function startApp(){
  try{
    init(true);
    initTemplates();
    initServiceCatalog();

    // The production server explicitly reports loginRequired=false.
    // In that mode, open the workspace directly and load the cloud records.
    const authStatus=await refreshAuthStatus();
    if(authStatus && authStatus.loginRequired===false){
      await hydrateCloudState();
      enterApp();
      return;
    }

    const authenticated=await refreshAuthSession();
    if(authenticated){
      await hydrateCloudState();
      enterApp();
    }else{
      // Do not request private invoice data until authentication succeeds.
      paintLoadedState_();
      await showAuthScreen();
    }
  }catch(e){
    console.error("Invoice Studio startup error",e);
    try{init(true);initServiceCatalog()}catch(ignore){}
    try{
      const st=await refreshAuthStatus();
      if(st && st.loginRequired===false){
        await hydrateCloudState();
        enterApp();
        return;
      }
    }catch(ignore){}
    try{showAuthScreen()}catch(ignore){}
  }
}

// Autosave invoice work as a draft so a refresh does not wipe fields that have been entered.
document.addEventListener("input",function(e){
  const t=e.target;if(!t)return;
  if(t.closest("#view-create"))scheduleDraftSave();
});
document.addEventListener("change",function(e){
  const t=e.target;if(!t)return;
  if(t.closest("#view-create"))scheduleDraftSave();
});

window.addEventListener("DOMContentLoaded",function(){setTimeout(function(){startApp()},0)});
window.addEventListener("load",function(){setTimeout(function(){try{initServiceCatalog()}catch(e){console.error("Catalog boot guard",e)}},150)});

/* Standalone final interaction bridge */
window.addEventListener("load",function(){
  setTimeout(function(){
    try{
      const add=document.getElementById("addSelectedCatalogBtn"), add25=document.getElementById("addCategoryItemsBtn");
      if(add&&typeof addSelectedCatalogItem==="function")add.onclick=addSelectedCatalogItem;
      if(add25&&typeof addCategoryItems==="function")add25.onclick=addCategoryItems;
      initServiceCatalog();
      if($('no')&&!$('no').value&&!readDraft())newInvoice();
    }catch(e){console.error("Final interaction bridge",e)}
  },300);
});
<!-- FBI Invoice Studio — Default FBI Logo embedded from user-provided FBI artwork -->
</script>

