<style id="fbi-payroll-module-style">
#fbiPayrollView{display:none;padding-bottom:40px}
#fbiPayrollView.fbi-payroll-active{display:block}
.fbi-payroll-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:14px}
.fbi-payroll-stat{background:var(--card,#12161e);border:1px solid var(--line,#2b303b);border-radius:12px;padding:14px}
.fbi-payroll-stat span{display:block;color:var(--muted,#8992a2);font-size:9px;text-transform:uppercase;letter-spacing:1px;font-weight:800}
.fbi-payroll-stat b{display:block;color:var(--text,#f4f6fa);font-size:18px;margin-top:7px}
.fbi-payroll-toolbar{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
.fbi-payroll-tabs{display:flex;gap:7px;flex-wrap:wrap}
.fbi-payroll-tab{border:1px solid var(--line,#2b303b);background:var(--card,#12161e);color:var(--muted,#a7afbc);border-radius:8px;padding:8px 11px;font-size:10px;font-weight:800;cursor:pointer}
.fbi-payroll-tab.active{background:#20151c;border-color:#bd1b63;color:#fff}
.fbi-payroll-actions{display:flex;gap:7px;flex-wrap:wrap}
.fbi-payroll-panel{display:none}
.fbi-payroll-panel.active{display:block}
.fbi-payroll-form{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.fbi-payroll-field{display:flex;flex-direction:column;gap:5px}
.fbi-payroll-field.full{grid-column:1/-1}
.fbi-payroll-field.half{grid-column:span 2}
.fbi-payroll-field label{font-size:8px;color:#8e97a7;text-transform:uppercase;letter-spacing:.75px;font-weight:800}
.fbi-payroll-field input,.fbi-payroll-field select,.fbi-payroll-field textarea{width:100%;border:1px solid #303745;background:#0d1016;color:#edf0f5;border-radius:8px;padding:9px 10px;font:inherit;font-size:10px;box-sizing:border-box}
.fbi-payroll-field textarea{min-height:80px;resize:vertical}
.fbi-payroll-inline{display:flex;gap:8px;flex-wrap:wrap;align-items:end}
.fbi-payroll-table-wrap{overflow:auto;border:1px solid #2b303b;border-radius:10px}
.fbi-payroll-table{width:100%;min-width:920px;border-collapse:collapse}
.fbi-payroll-table th{padding:9px 10px;background:#10131a;color:#8992a2;font-size:8px;text-transform:uppercase;letter-spacing:.65px;text-align:left}
.fbi-payroll-table td{padding:10px;border-top:1px solid #252b34;color:#d9dee7;font-size:9px;vertical-align:top}
.fbi-payroll-table td.num,.fbi-payroll-table th.num{text-align:right}
.fbi-payroll-badge{display:inline-flex;align-items:center;padding:4px 7px;border-radius:999px;font-size:8px;font-weight:850;background:#eef1f5;color:#4d5663}
.fbi-payroll-badge.paid{background:#e7f7ee;color:#147a48}
.fbi-payroll-badge.partial{background:#fff4dc;color:#8b6500}
.fbi-payroll-badge.pending{background:#edf4ff;color:#235fa9}
.fbi-payroll-empty{padding:22px;text-align:center;color:#7f8897;font-size:10px;border:1px dashed #303745;border-radius:10px}
.fbi-payroll-section-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-bottom:12px;flex-wrap:wrap}
.fbi-payroll-section-head h3{margin:0}
.fbi-payroll-section-head p{margin:4px 0 0;color:#7f8897;font-size:9px}
.fbi-payroll-summary{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:9px;margin:12px 0}
.fbi-payroll-summary div{border:1px solid #2b303b;background:#0f1218;border-radius:9px;padding:10px}
.fbi-payroll-summary span{display:block;color:#7f8897;font-size:8px;text-transform:uppercase;letter-spacing:.7px}
.fbi-payroll-summary b{display:block;color:#f3f5f9;font-size:12px;margin-top:5px}
.fbi-payroll-pay-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.fbi-payroll-notice{padding:9px 11px;border-radius:8px;background:#151922;border:1px solid #303745;color:#9aa3b1;font-size:9px;margin-bottom:12px}
@media(max-width:980px){.fbi-payroll-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.fbi-payroll-form{grid-template-columns:repeat(2,minmax(0,1fr))}.fbi-payroll-summary{grid-template-columns:repeat(3,minmax(0,1fr))}.fbi-payroll-pay-grid{grid-template-columns:1fr}}
@media(max-width:620px){.fbi-payroll-grid,.fbi-payroll-form,.fbi-payroll-summary{grid-template-columns:1fr}.fbi-payroll-field.half{grid-column:1}.fbi-payroll-tabs{width:100%}.fbi-payroll-tab{flex:1}.fbi-payroll-actions{width:100%}}
@media print{body.fbi-payroll-printing .side,body.fbi-payroll-printing .top,body.fbi-payroll-printing .view{display:none!important}body.fbi-payroll-printing #fbiPayrollView{display:block!important;padding:0}.fbi-payroll-table{min-width:0}.fbi-payroll-table th,.fbi-payroll-table td{font-size:8px}}
</style>

<div class="view" id="fbiPayrollView">
  <div class="fbi-payroll-grid">
    <div class="fbi-payroll-stat"><span>Workers</span><b id="fbiPayrollWorkerCount">0</b></div>
    <div class="fbi-payroll-stat"><span>Payroll Records</span><b id="fbiPayrollRecordCount">0</b></div>
    <div class="fbi-payroll-stat"><span>Net Payroll</span><b id="fbiPayrollNetTotal">GHS₵0.00</b></div>
    <div class="fbi-payroll-stat"><span>Outstanding</span><b id="fbiPayrollBalanceTotal">GHS₵0.00</b></div>
  </div>

  <div class="card">
    <div class="fbi-payroll-toolbar">
      <div class="fbi-payroll-tabs" id="fbiPayrollTabs">
        <button type="button" class="fbi-payroll-tab active" data-payroll-tab="dashboard">Dashboard</button>
        <button type="button" class="fbi-payroll-tab" data-payroll-tab="workers">Staff / Workers</button>
        <button type="button" class="fbi-payroll-tab" data-payroll-tab="records">Payroll Records</button>
        <button type="button" class="fbi-payroll-tab" data-payroll-tab="reports">Reports</button>
      </div>
      <div class="fbi-payroll-actions">
        <button class="btn" type="button" id="fbiPayrollAddWorkerBtn">＋ Add Worker</button>
        <button class="btn primary" type="button" id="fbiPayrollAddRecordBtn">＋ New Payroll</button>
      </div>
    </div>

    <div class="fbi-payroll-panel active" data-payroll-panel="dashboard">
      <div class="fbi-payroll-notice">Payroll is isolated from Invoice Studio records. It does not modify invoices, clients, payments, settings, or the invoice database state.</div>
      <div class="fbi-payroll-section-head">
        <div><h3>Payroll Overview</h3><p>Recent payroll activity and worker payment status.</p></div>
        <button class="btn" type="button" id="fbiPayrollDashPrint">🖨 Print</button>
      </div>
      <div id="fbiPayrollDashboardBody"></div>
    </div>

    <div class="fbi-payroll-panel" data-payroll-panel="workers">
      <div class="fbi-payroll-section-head">
        <div><h3>Staff / Worker Directory</h3><p>Worker profiles and payment details are stored separately from invoice data.</p></div>
      </div>
      <div id="fbiPayrollWorkerFormWrap"></div>
      <div id="fbiPayrollWorkersTable"></div>
    </div>

    <div class="fbi-payroll-panel" data-payroll-panel="records">
      <div class="fbi-payroll-section-head">
        <div><h3>Payroll Records</h3><p>Track work, earnings, deductions, advances, partial payments, and balances.</p></div>
      </div>
      <div id="fbiPayrollRecordFormWrap"></div>
      <div id="fbiPayrollRecordsTable"></div>
    </div>

    <div class="fbi-payroll-panel" data-payroll-panel="reports">
      <div class="fbi-payroll-section-head">
        <div><h3>Payroll Reports</h3><p>Filter by date, worker, department, and payment status.</p></div>
        <div class="fbi-payroll-actions">
          <button class="btn" type="button" id="fbiPayrollCsvBtn">⬇ CSV</button>
          <button class="btn primary" type="button" id="fbiPayrollPrintBtn">🖨 Print / Save PDF</button>
        </div>
      </div>
      <div class="fbi-payroll-form" id="fbiPayrollReportFilters">
        <div class="fbi-payroll-field"><label>From Date</label><input id="fbiPayrollFilterFrom" type="date"></div>
        <div class="fbi-payroll-field"><label>To Date</label><input id="fbiPayrollFilterTo" type="date"></div>
        <div class="fbi-payroll-field"><label>Worker</label><select id="fbiPayrollFilterWorker"></select></div>
        <div class="fbi-payroll-field"><label>Department</label><select id="fbiPayrollFilterDept"><option value="">All Departments</option><option>Media Production</option><option>IT / Networking</option><option>CCTV / Security</option><option>Smart Home</option><option>Administration</option><option>Other</option></select></div>
        <div class="fbi-payroll-field"><label>Payment Status</label><select id="fbiPayrollFilterStatus"><option value="">All Statuses</option><option>Pending</option><option>Partially Paid</option><option>Paid</option></select></div>
        <div class="fbi-payroll-field"><label>&nbsp;</label><button type="button" class="btn" id="fbiPayrollResetFilters">Reset Filters</button></div>
      </div>
      <div class="fbi-payroll-summary" id="fbiPayrollReportSummary"></div>
      <div id="fbiPayrollReportTable"></div>
    </div>
  </div>
</div>

<script>
(function(){
  'use strict';

  var STORAGE_KEY = 'fbi-payroll-isolated-v1';
  var STATE = {workers:[], records:[]};

  function q(id){ return document.getElementById(id); }
  function esc(v){
    return String(v == null ? '' : v).replace(/[&<>"']/g,function(m){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];
    });
  }
  function money(v){
    return 'GHS₵' + Number(v || 0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});
  }
  function num(v){ var n=Number(v); return Number.isFinite(n)?n:0; }
  function id(prefix){
    if(window.crypto && crypto.randomUUID) return prefix + '-' + crypto.randomUUID();
    return prefix + '-' + Date.now() + '-' + Math.random().toString(36).slice(2,10);
  }
  function today(){
    var d=new Date();
    return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
  }
  function load(){
    try{
      var raw=localStorage.getItem(STORAGE_KEY);
      if(!raw){ STATE={workers:[],records:[]}; return; }
      var parsed=JSON.parse(raw);
      STATE={
        workers:Array.isArray(parsed.workers)?parsed.workers:[],
        records:Array.isArray(parsed.records)?parsed.records:[]
      };
    }catch(e){
      console.warn('Payroll isolated storage read failed',e);
      STATE={workers:[],records:[]};
    }
  }
  function save(){
    try{
      localStorage.setItem(STORAGE_KEY,JSON.stringify(STATE));
      return true;
    }catch(e){
      console.error('Payroll isolated storage save failed',e);
      alert('Payroll could not be saved on this device.');
      return false;
    }
  }
  function worker(idv){ return STATE.workers.find(function(w){return w.id===idv;}) || null; }
  function gross(r){ return Math.max(0,num(r.rate)*Math.max(1,num(r.qty)||1)+num(r.allowance)+num(r.bonus)); }
  function net(r){ return Math.max(0,gross(r)-num(r.deduction)-num(r.advance)); }
  function paid(r){ return Math.min(net(r),Math.max(0,num(r.paidAmount))); }
  function balance(r){ return Math.max(0,net(r)-paid(r)); }
  function status(r){
    var n=net(r),p=paid(r);
    if(p>=n-0.005 && n>0) return 'Paid';
    if(p>0.005) return 'Partially Paid';
    return 'Pending';
  }
  function badge(s){
    var cls=s==='Paid'?'paid':s==='Partially Paid'?'partial':'pending';
    return '<span class="fbi-payroll-badge '+cls+'">'+esc(s)+'</span>';
  }
  function workerOptions(selected){
    var html='<option value="">Select worker</option>';
    STATE.workers.slice().sort(function(a,b){return String(a.name||'').localeCompare(String(b.name||''));}).forEach(function(w){
      html+='<option value="'+esc(w.id)+'"'+(w.id===selected?' selected':'')+'>'+esc(w.name)+(w.role?' · '+esc(w.role):'')+'</option>';
    });
    return html;
  }
  function updateWorkerFilter(){
    var sel=q('fbiPayrollFilterWorker'); if(!sel)return;
    var val=sel.value;
    sel.innerHTML='<option value="">All Workers</option>'+STATE.workers.slice().sort(function(a,b){return String(a.name||'').localeCompare(String(b.name||''));}).map(function(w){
      return '<option value="'+esc(w.id)+'">'+esc(w.name)+'</option>';
    }).join('');
    if(STATE.workers.some(function(w){return w.id===val}))sel.value=val;
  }
  function reportRows(){
    var from=q('fbiPayrollFilterFrom')?.value||'';
    var to=q('fbiPayrollFilterTo')?.value||'';
    var wid=q('fbiPayrollFilterWorker')?.value||'';
    var dept=q('fbiPayrollFilterDept')?.value||'';
    var st=q('fbiPayrollFilterStatus')?.value||'';
    return STATE.records.filter(function(r){
      var w=worker(r.workerId);
      var d=String(r.workDate||'').slice(0,10);
      if(from&&(!d||d<from))return false;
      if(to&&(!d||d>to))return false;
      if(wid&&r.workerId!==wid)return false;
      if(dept&&String(w?.department||'')!==dept)return false;
      if(st&&status(r)!==st)return false;
      return true;
    }).sort(function(a,b){return String(b.workDate||'').localeCompare(String(a.workDate||''));});
  }
  function renderStats(){
    q('fbiPayrollWorkerCount').textContent=String(STATE.workers.length);
    q('fbiPayrollRecordCount').textContent=String(STATE.records.length);
    q('fbiPayrollNetTotal').textContent=money(STATE.records.reduce(function(s,r){return s+net(r);},0));
    q('fbiPayrollBalanceTotal').textContent=money(STATE.records.reduce(function(s,r){return s+balance(r);},0));
  }
  function switchTab(tab){
    document.querySelectorAll('[data-payroll-tab]').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-payroll-tab')===tab);});
    document.querySelectorAll('[data-payroll-panel]').forEach(function(p){p.classList.toggle('active',p.getAttribute('data-payroll-panel')===tab);});
    renderAll();
  }
  function showForm(kind,existing){
    if(kind==='worker'){
      switchTab('workers');
      var w=existing||{};
      q('fbiPayrollWorkerFormWrap').innerHTML=
        '<div class="card" style="margin-bottom:14px"><div class="fbi-payroll-section-head"><div><h3>'+(existing?'Edit Worker':'Add Worker')+'</h3><p>Worker profile and payment details.</p></div></div>'+
        '<div class="fbi-payroll-form">'+
        field('Worker ID','pwId',w.workerCode||'',false,'text','Optional internal ID')+
        field('Full Name','pwName',w.name||'',false,'text','Full name')+
        field('Phone','pwPhone',w.phone||'',false,'tel','Phone number')+
        field('Email','pwEmail',w.email||'',false,'email','Email address')+
        field('Address','pwAddress',w.address||'',true,'text','Address')+
        field('Role / Job Title','pwRole',w.role||'',false,'text','Role or job title')+
        selectField('Department','pwDept',['Media Production','IT / Networking','CCTV / Security','Smart Home','Administration','Other'],w.department||'Media Production')+
        selectField('Worker Type','pwType',['Employee','Freelancer','Casual','Contractor','Other'],w.workerType||'Freelancer')+
        selectField('Preferred Payment Method','pwPayMethod',['Mobile Money','Bank','Cash'],w.paymentMethod||'Mobile Money')+
        field('MoMo Number','pwMomo',w.momo||'',false,'text','')+
        field('Bank Name','pwBank',w.bank||'',false,'text','')+
        field('Account Name','pwAccountName',w.accountName||'',false,'text','')+
        field('Account Number','pwAccountNumber',w.accountNumber||'',false,'text','')+
        field('Ghana Card / ID Reference','pwIdRef',w.idRef||'',false,'text','')+
        field('Emergency / Contact Person','pwEmergency',w.emergency||'',false,'text','')+
        field('Emergency Phone','pwEmergencyPhone',w.emergencyPhone||'',false,'text','')+
        selectField('Status','pwStatus',['Active','Inactive'],w.status||'Active')+
        field('Notes','pwNotes',w.notes||'',true,'text','Additional worker notes')+
        '</div><div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">'+
        '<button type="button" class="btn primary" id="pwSaveBtn">Save Worker</button><button type="button" class="btn" id="pwCancelBtn">Cancel</button></div></div>';
      q('pwSaveBtn').onclick=function(){saveWorker(existing&&existing.id);};
      q('pwCancelBtn').onclick=function(){q('fbiPayrollWorkerFormWrap').innerHTML='';renderAll();};
      return;
    }
    switchTab('records');
    if(!STATE.workers.length){
      q('fbiPayrollRecordFormWrap').innerHTML='<div class="fbi-payroll-notice">Add at least one worker before creating a payroll record.</div>';
      return;
    }
    var r=existing||{};
    q('fbiPayrollRecordFormWrap').innerHTML=
      '<div class="card" style="margin-bottom:14px"><div class="fbi-payroll-section-head"><div><h3>'+(existing?'Edit Payroll Record':'New Payroll Record')+'</h3><p>Work, earnings, deductions, advances and payment details.</p></div></div>'+
      '<div class="fbi-payroll-form">'+
      selectField('Worker','prWorkerId',STATE.workers.slice().sort(function(a,b){return String(a.name||'').localeCompare(String(b.name||''));}).map(function(x){return {v:x.id,t:x.name+(x.role?' · '+x.role:'')};}),r.workerId||'',true)+
      field('Project / Event','prProject',r.project||'',false,'text','Project or event')+
      field('Work Date','prDate',r.workDate||today(),false,'date','')+
      selectField('Pay Basis','prBasis',['Per Event','Per Day','Per Installation','Other'],r.basis||'Per Event')+
      field('Role / Work Description','prRole',r.role||'',true,'text','Work performed')+
      field('Rate','prRate',r.rate||0,false,'number','0.00')+
      field('Quantity','prQty',r.qty||1,false,'number','')+
      field('Allowance','prAllowance',r.allowance||0,false,'number','0.00')+
      field('Bonus','prBonus',r.bonus||0,false,'number','0.00')+
      field('Deductions','prDeduction',r.deduction||0,false,'number','0.00')+
      field('Advance / Previous Payment','prAdvance',r.advance||0,false,'number','0.00')+
      field('Notes','prNotes',r.notes||'',true,'text','')+
      '</div>'+
      '<div class="fbi-payroll-summary">'+
        '<div><span>Gross Pay</span><b id="prGrossPreview">GHS₵0.00</b></div>'+
        '<div><span>Net Pay</span><b id="prNetPreview">GHS₵0.00</b></div>'+
        '<div><span>Paid</span><b id="prPaidPreview">GHS₵0.00</b></div>'+
        '<div><span>Balance</span><b id="prBalancePreview">GHS₵0.00</b></div>'+
        '<div><span>Status</span><b id="prStatusPreview">Pending</b></div>'+
      '</div>'+
      '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">'+
      '<button type="button" class="btn primary" id="prSaveBtn">Save Payroll Record</button><button type="button" class="btn" id="prCancelBtn">Cancel</button></div></div>';
      ['prRate','prQty','prAllowance','prBonus','prDeduction','prAdvance'].forEach(function(idv){q(idv).addEventListener('input',previewRecord);});
      q('prSaveBtn').onclick=function(){saveRecord(existing&&existing.id);};
      q('prCancelBtn').onclick=function(){q('fbiPayrollRecordFormWrap').innerHTML='';renderAll();};
      previewRecord();
  }
  function field(label,idv,value,full,type,placeholder){
    return '<div class="fbi-payroll-field'+(full?' full':'')+'"><label>'+esc(label)+'</label><input id="'+idv+'" type="'+(type||'text')+'" value="'+esc(value)+'" placeholder="'+esc(placeholder||'')+'"></div>';
  }
  function selectField(label,idv,options,selected,full){
    var arr=options||[];
    var html='<div class="fbi-payroll-field'+(full===true?' full':'')+'"><label>'+esc(label)+'</label><select id="'+idv+'">';
    html+=arr.map(function(o){
      var value,labelText;
      if(typeof o==='string'){value=o;labelText=o;}else{value=o.v;labelText=o.t;}
      return '<option value="'+esc(value)+'"'+(String(value)===String(selected)?' selected':'')+'>'+esc(labelText)+'</option>';
    }).join('');
    return html+'</select></div>';
  }
  function previewRecord(){
    var r={
      rate:num(q('prRate')?.value),
      qty:num(q('prQty')?.value)||1,
      allowance:num(q('prAllowance')?.value),
      bonus:num(q('prBonus')?.value),
      deduction:num(q('prDeduction')?.value),
      advance:num(q('prAdvance')?.value),
      paidAmount:0
    };
    if(q('prGrossPreview'))q('prGrossPreview').textContent=money(gross(r));
    if(q('prNetPreview'))q('prNetPreview').textContent=money(net(r));
    if(q('prPaidPreview'))q('prPaidPreview').textContent=money(0);
    if(q('prBalancePreview'))q('prBalancePreview').textContent=money(net(r));
    if(q('prStatusPreview'))q('prStatusPreview').textContent='Pending';
  }
  function saveWorker(existingId){
    var name=(q('pwName')?.value||'').trim();
    if(!name){alert('Worker name is required.');return;}
    var w=existingId?worker(existingId):{id:id('worker'),createdAt:new Date().toISOString()};
    w.workerCode=(q('pwId')?.value||'').trim();
    w.name=name;
    w.phone=(q('pwPhone')?.value||'').trim();
    w.email=(q('pwEmail')?.value||'').trim();
    w.address=(q('pwAddress')?.value||'').trim();
    w.role=(q('pwRole')?.value||'').trim();
    w.department=q('pwDept')?.value||'Other';
    w.workerType=q('pwType')?.value||'Freelancer';
    w.paymentMethod=q('pwPayMethod')?.value||'Mobile Money';
    w.momo=(q('pwMomo')?.value||'').trim();
    w.bank=(q('pwBank')?.value||'').trim();
    w.accountName=(q('pwAccountName')?.value||'').trim();
    w.accountNumber=(q('pwAccountNumber')?.value||'').trim();
    w.idRef=(q('pwIdRef')?.value||'').trim();
    w.emergency=(q('pwEmergency')?.value||'').trim();
    w.emergencyPhone=(q('pwEmergencyPhone')?.value||'').trim();
    w.status=q('pwStatus')?.value||'Active';
    w.notes=(q('pwNotes')?.value||'').trim();
    if(existingId){
      var idx=STATE.workers.findIndex(function(x){return x.id===existingId;});
      if(idx>=0)STATE.workers[idx]=w;
    }else STATE.workers.push(w);
    if(save()){q('fbiPayrollWorkerFormWrap').innerHTML='';renderAll();toastLocal(existingId?'Worker updated':'Worker saved');}
  }
  function saveRecord(existingId){
    var wid=q('prWorkerId')?.value||'';
    if(!wid){alert('Please select a worker.');return;}
    var r=existingId?(STATE.records.find(function(x){return x.id===existingId;})||null):{id:id('payroll'),createdAt:new Date().toISOString(),paidAmount:0};
    if(!r){alert('Payroll record not found.');return;}
    r.workerId=wid;
    r.project=(q('prProject')?.value||'').trim();
    r.workDate=q('prDate')?.value||today();
    r.basis=q('prBasis')?.value||'Per Event';
    r.role=(q('prRole')?.value||'').trim();
    r.rate=num(q('prRate')?.value);
    r.qty=Math.max(1,num(q('prQty')?.value)||1);
    r.allowance=num(q('prAllowance')?.value);
    r.bonus=num(q('prBonus')?.value);
    r.deduction=num(q('prDeduction')?.value);
    r.advance=num(q('prAdvance')?.value);
    r.notes=(q('prNotes')?.value||'').trim();
    if(existingId){
      var idx=STATE.records.findIndex(function(x){return x.id===existingId;});
      if(idx>=0)STATE.records[idx]=r;
    }else STATE.records.push(r);
    if(save()){q('fbiPayrollRecordFormWrap').innerHTML='';renderAll();toastLocal(existingId?'Payroll record updated':'Payroll record saved');}
  }
  function deleteWorker(idv){
    if(STATE.records.some(function(r){return r.workerId===idv;})){alert('This worker has payroll records and cannot be deleted. Set the worker to Inactive instead.');return;}
    if(!confirm('Delete this worker profile?'))return;
    STATE.workers=STATE.workers.filter(function(w){return w.id!==idv;});
    save();renderAll();
  }
  function deleteRecord(idv){
    if(!confirm('Delete this payroll record?'))return;
    STATE.records=STATE.records.filter(function(r){return r.id!==idv;});
    save();renderAll();
  }
  function recordPayment(idv){
    var r=STATE.records.find(function(x){return x.id===idv;}); if(!r)return;
    var bal=balance(r);
    if(bal<=0.005){alert('This payroll record is already fully paid.');return;}
    var amount=prompt('Payment amount (maximum '+money(bal)+')',String(bal.toFixed(2)));
    if(amount===null)return;
    var p=num(amount);
    if(p<=0||p>bal+0.005){alert('Enter a valid payment amount.');return;}
    var method=prompt('Payment method: Mobile Money / Bank / Cash',r.paymentMethod||worker(r.workerId)?.paymentMethod||'Mobile Money');
    if(method===null)return;
    var ref=prompt('Transaction / Payment reference',r.transactionRef||'');
    if(ref===null)return;
    var paidBy=prompt('Paid by',r.paidBy||'');
    if(paidBy===null)return;
    r.paidAmount=Math.min(net(r),paid(r)+p);
    r.paymentDate=today();
    r.paymentMethod=method;
    r.transactionRef=ref;
    r.paidBy=paidBy;
    save();renderAll();toastLocal('Payment recorded');
  }
  function renderWorkers(){
    updateWorkerFilter();
    var el=q('fbiPayrollWorkersTable'); if(!el)return;
    if(!STATE.workers.length){el.innerHTML='<div class="fbi-payroll-empty">No workers added yet.</div>';return;}
    el.innerHTML='<div class="fbi-payroll-table-wrap"><table class="fbi-payroll-table"><thead><tr><th>Name</th><th>Role / Department</th><th>Type</th><th>Payment Details</th><th>Status</th><th>Actions</th></tr></thead><tbody>'+
      STATE.workers.slice().sort(function(a,b){return String(a.name||'').localeCompare(String(b.name||''));}).map(function(w){
        var pay=w.paymentMethod==='Mobile Money'?(w.momo||''):(w.paymentMethod==='Bank'?((w.bank||'')+' '+(w.accountNumber||'')):'Cash');
        return '<tr><td><b>'+esc(w.name)+'</b><div style="color:#7f8897;margin-top:3px">'+esc(w.phone||w.email||w.workerCode||'')+'</div></td>'+
        '<td>'+esc(w.role||'')+'<div style="color:#7f8897;margin-top:3px">'+esc(w.department||'')+'</div></td>'+
        '<td>'+esc(w.workerType||'')+'</td><td>'+esc(w.paymentMethod||'')+'<div style="color:#7f8897;margin-top:3px">'+esc(pay)+'</div></td>'+
        '<td>'+badge(w.status||'Active')+'</td><td><div style="display:flex;gap:6px;flex-wrap:wrap">'+
        '<button class="btn" type="button" data-payroll-edit-worker="'+esc(w.id)+'">Edit</button><button class="btn" type="button" data-payroll-delete-worker="'+esc(w.id)+'">Delete</button></div></td></tr>';
      }).join('')+'</tbody></table></div>';
    el.querySelectorAll('[data-payroll-edit-worker]').forEach(function(b){b.onclick=function(){showForm('worker',worker(b.dataset.payrollEditWorker));};});
    el.querySelectorAll('[data-payroll-delete-worker]').forEach(function(b){b.onclick=function(){deleteWorker(b.dataset.payrollDeleteWorker);};});
  }
  function renderRecords(){
    var el=q('fbiPayrollRecordsTable'); if(!el)return;
    if(!STATE.records.length){el.innerHTML='<div class="fbi-payroll-empty">No payroll records added yet.</div>';return;}
    el.innerHTML='<div class="fbi-payroll-table-wrap"><table class="fbi-payroll-table"><thead><tr><th>Worker / Project</th><th>Work Date</th><th>Basis</th><th class="num">Gross</th><th class="num">Net</th><th class="num">Paid</th><th class="num">Balance</th><th>Status</th><th>Actions</th></tr></thead><tbody>'+
      STATE.records.slice().sort(function(a,b){return String(b.workDate||'').localeCompare(String(a.workDate||''));}).map(function(r){
        var w=worker(r.workerId),s=status(r);
        return '<tr><td><b>'+esc(w?.name||'Unknown worker')+'</b><div style="color:#7f8897;margin-top:3px">'+esc(r.project||r.role||'')+'</div></td>'+
        '<td>'+esc(r.workDate||'')+'</td><td>'+esc(r.basis||'')+'</td>'+
        '<td class="num">'+esc(money(gross(r)))+'</td><td class="num">'+esc(money(net(r)))+'</td><td class="num">'+esc(money(paid(r)))+'</td><td class="num">'+esc(money(balance(r)))+'</td><td>'+badge(s)+'</td>'+
        '<td><div style="display:flex;gap:6px;flex-wrap:wrap"><button class="btn" type="button" data-payroll-pay="'+esc(r.id)+'">Pay</button><button class="btn" type="button" data-payroll-slip="'+esc(r.id)+'">Payslip</button><button class="btn" type="button" data-payroll-edit-record="'+esc(r.id)+'">Edit</button><button class="btn" type="button" data-payroll-delete-record="'+esc(r.id)+'">Delete</button></div></td></tr>';
      }).join('')+'</tbody></table></div>';
    el.querySelectorAll('[data-payroll-pay]').forEach(function(b){b.onclick=function(){recordPayment(b.dataset.payrollPay);};});
    el.querySelectorAll('[data-payroll-slip]').forEach(function(b){b.onclick=function(){printPayslip(b.dataset.payrollSlip);};});
    el.querySelectorAll('[data-payroll-edit-record]').forEach(function(b){b.onclick=function(){showForm('record',STATE.records.find(function(r){return r.id===b.dataset.payrollEditRecord;}));};});
    el.querySelectorAll('[data-payroll-delete-record]').forEach(function(b){b.onclick=function(){deleteRecord(b.dataset.payrollDeleteRecord);};});
  }
  function renderDashboard(){
    var el=q('fbiPayrollDashboardBody'); if(!el)return;
    var recent=STATE.records.slice().sort(function(a,b){return String(b.workDate||'').localeCompare(String(a.workDate||''));}).slice(0,10);
    var total=STATE.records.reduce(function(s,r){return s+net(r);},0);
    var paidTotal=STATE.records.reduce(function(s,r){return s+paid(r);},0);
    var balTotal=STATE.records.reduce(function(s,r){return s+balance(r);},0);
    var html='<div class="fbi-payroll-summary"><div><span>Gross</span><b>'+esc(money(STATE.records.reduce(function(s,r){return s+gross(r);},0)))+'</b></div><div><span>Net</span><b>'+esc(money(total))+'</b></div><div><span>Paid</span><b>'+esc(money(paidTotal))+'</b></div><div><span>Balance</span><b>'+esc(money(balTotal))+'</b></div><div><span>Active Workers</span><b>'+esc(String(STATE.workers.filter(function(w){return (w.status||'Active')==='Active';}).length))+'</b></div></div>';
    if(!recent.length){el.innerHTML=html+'<div class="fbi-payroll-empty">No payroll activity yet.</div>';return;}
    html+='<div class="fbi-payroll-table-wrap"><table class="fbi-payroll-table"><thead><tr><th>Worker</th><th>Project / Event</th><th>Date</th><th class="num">Net</th><th class="num">Paid</th><th class="num">Balance</th><th>Status</th></tr></thead><tbody>';
    html+=recent.map(function(r){var w=worker(r.workerId);return '<tr><td>'+esc(w?.name||'Unknown')+'</td><td>'+esc(r.project||r.role||'')+'</td><td>'+esc(r.workDate||'')+'</td><td class="num">'+esc(money(net(r)))+'</td><td class="num">'+esc(money(paid(r)))+'</td><td class="num">'+esc(money(balance(r)))+'</td><td>'+badge(status(r))+'</td></tr>';}).join('');
    el.innerHTML=html+'</tbody></table></div>';
  }
  function renderReports(){
    var rows=reportRows();
    var totalNet=rows.reduce(function(s,r){return s+net(r);},0);
    var totalPaid=rows.reduce(function(s,r){return s+paid(r);},0);
    var totalBal=rows.reduce(function(s,r){return s+balance(r);},0);
    var totalGross=rows.reduce(function(s,r){return s+gross(r);},0);
    q('fbiPayrollReportSummary').innerHTML=
      '<div><span>Records</span><b>'+rows.length+'</b></div>'+
      '<div><span>Gross</span><b>'+esc(money(totalGross))+'</b></div>'+
      '<div><span>Net</span><b>'+esc(money(totalNet))+'</b></div>'+
      '<div><span>Paid</span><b>'+esc(money(totalPaid))+'</b></div>'+
      '<div><span>Balance</span><b>'+esc(money(totalBal))+'</b></div>';
    var el=q('fbiPayrollReportTable');
    if(!rows.length){el.innerHTML='<div class="fbi-payroll-empty">No payroll records match the selected filters.</div>';return;}
    el.innerHTML='<div class="fbi-payroll-table-wrap"><table class="fbi-payroll-table"><thead><tr><th>Worker</th><th>Department</th><th>Project / Event</th><th>Date</th><th>Basis</th><th class="num">Rate</th><th class="num">Qty</th><th class="num">Net</th><th class="num">Paid</th><th class="num">Balance</th><th>Status</th><th>Payment Date</th><th>Method</th><th>Reference</th></tr></thead><tbody>'+
      rows.map(function(r){var w=worker(r.workerId);return '<tr><td>'+esc(w?.name||'Unknown')+'</td><td>'+esc(w?.department||'')+'</td><td>'+esc(r.project||r.role||'')+'</td><td>'+esc(r.workDate||'')+'</td><td>'+esc(r.basis||'')+'</td><td class="num">'+esc(money(r.rate))+'</td><td class="num">'+esc(r.qty)+'</td><td class="num">'+esc(money(net(r)))+'</td><td class="num">'+esc(money(paid(r)))+'</td><td class="num">'+esc(money(balance(r)))+'</td><td>'+badge(status(r))+'</td><td>'+esc(r.paymentDate||'')+'</td><td>'+esc(r.paymentMethod||'')+'</td><td>'+esc(r.transactionRef||'')+'</td></tr>';}).join('')+'</tbody></table></div>';
  }
  function renderAll(){
    renderStats();renderDashboard();renderWorkers();renderRecords();renderReports();
  }
  function csvCell(v){return '"'+String(v==null?'':v).replace(/"/g,'""')+'"';}
  function exportCsv(){
    var rows=reportRows();
    var headers=['Worker','Department','Project/Event','Date','Basis','Rate','Quantity','Net Pay','Paid','Balance','Status','Payment Date','Payment Method','Transaction Reference'];
    var lines=[headers].concat(rows.map(function(r){var w=worker(r.workerId);return [w?.name||'',w?.department||'',r.project||r.role||'',r.workDate||'',r.basis||'',r.rate||0,r.qty||1,net(r),paid(r),balance(r),status(r),r.paymentDate||'',r.paymentMethod||'',r.transactionRef||''];}));
    var csv=lines.map(function(row){return row.map(csvCell).join(',');}).join('\\n');
    var blob=new Blob([csv],{type:'text/csv;charset=utf-8'});
    var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='FBI-Payroll-'+today()+'.csv';document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(a.href);a.remove();},1000);
  }
  function printHtml(title,body){
    var w=window.open('','_blank');
    if(!w){alert('Please allow pop-ups to print Payroll documents.');return;}
    w.document.write('<!doctype html><html><head><meta charset="utf-8"><title>'+esc(title)+'</title><style>body{font-family:Arial,sans-serif;color:#1b1f27;padding:28px}h1{font-size:22px;margin:0 0 6px}p{color:#6d7580;font-size:11px;margin:0 0 18px}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:16px 0}.card{border:1px solid #ddd;border-radius:8px;padding:10px}.card span{display:block;color:#777;font-size:9px;text-transform:uppercase}.card b{display:block;font-size:15px;margin-top:5px}table{width:100%;border-collapse:collapse}th,td{border:1px solid #ddd;padding:7px;font-size:9px;text-align:left}th{background:#111;color:#fff}td.num,th.num{text-align:right}.brand{margin-bottom:18px}@media print{body{padding:0}}<\/style></head><body>'+body+'<script>window.onload=function(){window.print()}<\\/script></body></html>');
    w.document.close();
  }
  function printReport(){
    var rows=reportRows();
    var grossTotal=rows.reduce(function(s,r){return s+gross(r);},0),netTotal=rows.reduce(function(s,r){return s+net(r);},0),paidTotal=rows.reduce(function(s,r){return s+paid(r);},0),balTotal=rows.reduce(function(s,r){return s+balance(r);},0);
    var html='<h1>FBI Payroll Report</h1><p>Generated '+esc(new Date().toLocaleString())+' · '+rows.length+' records</p><div class="cards"><div class="card"><span>Gross</span><b>'+esc(money(grossTotal))+'</b></div><div class="card"><span>Net</span><b>'+esc(money(netTotal))+'</b></div><div class="card"><span>Paid</span><b>'+esc(money(paidTotal))+'</b></div><div class="card"><span>Balance</span><b>'+esc(money(balTotal))+'</b></div></div><table><thead><tr><th>Worker</th><th>Department</th><th>Project/Event</th><th>Date</th><th>Basis</th><th class="num">Net</th><th class="num">Paid</th><th class="num">Balance</th><th>Status</th></tr></thead><tbody>';
    html+=rows.map(function(r){var w=worker(r.workerId);return '<tr><td>'+esc(w?.name||'Unknown')+'</td><td>'+esc(w?.department||'')+'</td><td>'+esc(r.project||r.role||'')+'</td><td>'+esc(r.workDate||'')+'</td><td>'+esc(r.basis||'')+'</td><td class="num">'+esc(money(net(r)))+'</td><td class="num">'+esc(money(paid(r)))+'</td><td class="num">'+esc(money(balance(r)))+'</td><td>'+esc(status(r))+'</td></tr>';}).join('');
    printHtml('FBI Payroll Report',html+'</tbody></table>');
  }
  function printPayslip(idv){
    var r=STATE.records.find(function(x){return x.id===idv;});if(!r)return;
    var w=worker(r.workerId)||{};
    var html='<h1>PAYSLIP</h1><p>Issued '+esc(new Date().toLocaleString())+'</p>'+
      '<div class="cards">'+
      '<div class="card"><span>Worker</span><b>'+esc(w.name||'')+'</b></div>'+
      '<div class="card"><span>Department</span><b>'+esc(w.department||'')+'</b></div>'+
      '<div class="card"><span>Work Date</span><b>'+esc(r.workDate||'')+'</b></div>'+
      '<div class="card"><span>Status</span><b>'+esc(status(r))+'</b></div></div>'+
      '<p><b>Project / Event:</b> '+esc(r.project||'')+' &nbsp; <b>Pay Basis:</b> '+esc(r.basis||'')+'</p>'+
      '<table><tbody>'+
      '<tr><th>Earnings</th><th class="num">Amount</th></tr>'+
      '<tr><td>Rate × Quantity</td><td class="num">'+esc(money(num(r.rate)*Math.max(1,num(r.qty)||1)))+'</td></tr>'+
      '<tr><td>Allowance</td><td class="num">'+esc(money(r.allowance))+'</td></tr>'+
      '<tr><td>Bonus</td><td class="num">'+esc(money(r.bonus))+'</td></tr>'+
      '<tr><td><b>Gross Pay</b></td><td class="num"><b>'+esc(money(gross(r)))+'</b></td></tr>'+
      '<tr><td>Deductions</td><td class="num">'+esc(money(r.deduction))+'</td></tr>'+
      '<tr><td>Advance / Previous Payment</td><td class="num">'+esc(money(r.advance))+'</td></tr>'+
      '<tr><td><b>Net Pay</b></td><td class="num"><b>'+esc(money(net(r)))+'</b></td></tr>'+
      '<tr><td>Amount Paid</td><td class="num">'+esc(money(paid(r)))+'</td></tr>'+
      '<tr><td><b>Balance</b></td><td class="num"><b>'+esc(money(balance(r)))+'</b></td></tr>'+
      '</tbody></table>'+
      '<p style="margin-top:18px"><b>Payment Method:</b> '+esc(r.paymentMethod||w.paymentMethod||'')+' &nbsp; <b>Payment Date:</b> '+esc(r.paymentDate||'')+' &nbsp; <b>Reference:</b> '+esc(r.transactionRef||'')+'</p>'+
      '<p><b>Worker Phone:</b> '+esc(w.phone||'')+' &nbsp; <b>Worker ID:</b> '+esc(w.workerCode||'')+'</p>'+
      (r.notes?'<p><b>Notes:</b> '+esc(r.notes)+'</p>':'');
    printHtml('Payslip - '+(w.name||'Worker'),html);
  }
  function printDashboard(){
    var rows=STATE.records.slice().sort(function(a,b){return String(b.workDate||'').localeCompare(String(a.workDate||''));});
    var html='<h1>FBI Payroll Overview</h1><p>Generated '+esc(new Date().toLocaleString())+'</p><div class="cards"><div class="card"><span>Workers</span><b>'+STATE.workers.length+'</b></div><div class="card"><span>Records</span><b>'+STATE.records.length+'</b></div><div class="card"><span>Net Payroll</span><b>'+esc(money(rows.reduce(function(s,r){return s+net(r);},0)))+'</b></div><div class="card"><span>Outstanding</span><b>'+esc(money(rows.reduce(function(s,r){return s+balance(r);},0)))+'</b></div></div>';
    printHtml('FBI Payroll Overview',html);
  }
  function toastLocal(msg){
    try{
      if(typeof window.toast==='function'){window.toast(msg);return;}
    }catch(e){}
  }

  function activatePayroll(){
    var root=q('fbiPayrollView');if(!root)return;
    document.querySelectorAll('.view').forEach(function(v){v.classList.remove('active','print-view');});
    root.classList.add('active','fbi-payroll-active');
    document.querySelectorAll('.nav button').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-v')==='payroll');});
    var t=q('title');if(t)t.textContent='Payroll';
    var s=q('subtitle');if(s)s.textContent='Staff, payroll records, payments and payslips';
    var side=q('side');if(side)side.classList.remove('open');
    renderAll();
  }

  function installNavigation(){
    var nav=document.querySelector('.nav');
    if(nav && !nav.querySelector('[data-v="payroll"]')){
      var b=document.createElement('button');
      b.type='button';b.className='nav-link';b.setAttribute('data-v','payroll');b.textContent='💰 Payroll';
      b.onclick=function(e){e.preventDefault();activatePayroll();};
      nav.insertBefore(b,nav.querySelector('[data-v="settings"]')||null);
    }
    var original=window.__FBI_NAV__;
    window.__FBI_PAYROLL_ORIGINAL_NAV__=original;
    window.__FBI_NAV__=function(v){
      if(v==='payroll'){activatePayroll();return false;}
      return typeof original==='function'?original(v):false;
    };
    window.__FBI_PAYROLL_OPEN__=activatePayroll;
    window.addEventListener('hashchange',function(){
      if(String(location.hash||'')==='#payroll')activatePayroll();
    });
  }

  function init(){
    load();
    installNavigation();
    document.querySelectorAll('[data-payroll-tab]').forEach(function(b){b.onclick=function(){switchTab(b.getAttribute('data-payroll-tab'));};});
    q('fbiPayrollAddWorkerBtn').onclick=function(){showForm('worker');};
    q('fbiPayrollAddRecordBtn').onclick=function(){showForm('record');};
    q('fbiPayrollCsvBtn').onclick=exportCsv;
    q('fbiPayrollPrintBtn').onclick=printReport;
    q('fbiPayrollDashPrint').onclick=printDashboard;
    q('fbiPayrollResetFilters').onclick=function(){
      q('fbiPayrollFilterFrom').value='';q('fbiPayrollFilterTo').value='';q('fbiPayrollFilterWorker').value='';q('fbiPayrollFilterDept').value='';q('fbiPayrollFilterStatus').value='';renderReports();
    };
    ['fbiPayrollFilterFrom','fbiPayrollFilterTo','fbiPayrollFilterWorker','fbiPayrollFilterDept','fbiPayrollFilterStatus'].forEach(function(idv){
      q(idv).addEventListener('change',renderReports);
    });
    renderAll();
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
  window.FBIPayrollModule={reload:function(){load();renderAll();},open:activatePayroll};
})();
</script>
