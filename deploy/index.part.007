<style id="fbi-payroll-module-style">
/* ===== FBI PAYROLL MODULE, ISOLATED FROM INVOICE ENGINE ===== */
#fbiPayrollView{display:none;width:100%;max-width:none;margin:0;padding:0 0 40px;position:relative}
#fbiPayrollView.fbi-payroll-active{display:block}
.top>div:last-child{display:flex;align-items:center;gap:7px;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}
.top>div:last-child .theme-switcher{order:999;flex:0 0 auto;margin-left:6px}
@media(max-width:700px){
  .top>div:last-child{width:auto;max-width:100%;justify-content:flex-end}
  .top>div:last-child .theme-switcher{margin-left:4px}
}
.fbi-payroll-shell{width:100%;max-width:1500px;margin:0 auto}
.fbi-payroll-hero{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;padding:20px 0 14px;flex-wrap:wrap}
.fbi-payroll-kicker{font-size:9px;text-transform:uppercase;letter-spacing:1.8px;color:#b48b2f;font-weight:900;margin-bottom:6px}
.fbi-payroll-hero h2{margin:0;font-size:22px;letter-spacing:-.35px}
.fbi-payroll-hero p{margin:6px 0 0;color:#7f8897;font-size:10px}
.fbi-payroll-actions{display:flex;gap:8px;flex-wrap:wrap}
.fbi-payroll-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:11px;margin-bottom:14px}
.fbi-payroll-stat{background:linear-gradient(180deg,#171b23,#13161d);border:1px solid #2b303c;border-radius:12px;padding:14px;min-height:88px}
.fbi-payroll-stat span{display:block;color:#858e9f;font-size:8px;text-transform:uppercase;letter-spacing:1px;font-weight:900}
.fbi-payroll-stat b{display:block;color:#f7f8fb;font-size:19px;margin-top:8px}
.fbi-payroll-stat small{display:block;color:#687180;font-size:8px;margin-top:4px}
.fbi-payroll-card{background:linear-gradient(180deg,#171b23,#13161d);border:1px solid #2b303c;border-radius:12px;padding:16px;margin-bottom:14px}
.fbi-payroll-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}
.fbi-payroll-tab{border:1px solid #343a48;background:#131720;color:#9aa3b1;border-radius:8px;padding:9px 12px;font-size:10px;font-weight:850;cursor:pointer}
.fbi-payroll-tab.active{background:#23151d;color:#fff;border-color:#bd1b63;box-shadow:inset 0 0 0 1px rgba(255,255,255,.05)}
.fbi-payroll-panel{display:none}.fbi-payroll-panel.active{display:block}
.fbi-payroll-section-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;margin-bottom:12px}
.fbi-payroll-section-head h3{margin:0;color:#e8ebf0;font-size:13px}
.fbi-payroll-section-head p{margin:4px 0 0;color:#7f8897;font-size:9px}
.fbi-payroll-form{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.fbi-payroll-field{min-width:0}.fbi-payroll-field.full{grid-column:1/-1}.fbi-payroll-field.half{grid-column:span 2}
.fbi-payroll-field label{display:block;margin:0 0 5px;color:#8f98a7;font-size:8px;text-transform:uppercase;letter-spacing:.7px;font-weight:850}
.fbi-payroll-field input,.fbi-payroll-field select,.fbi-payroll-field textarea{width:100%;box-sizing:border-box;border:1px solid #303744;background:#0d1016;color:#eef1f5;border-radius:8px;padding:9px 10px;font-size:10px;outline:none}
.fbi-payroll-field textarea{min-height:76px;resize:vertical}
.fbi-payroll-field input:focus,.fbi-payroll-field select:focus,.fbi-payroll-field textarea:focus{border-color:#b48b2f;box-shadow:0 0 0 3px rgba(180,139,47,.08)}
.fbi-payroll-info{padding:10px 12px;border:1px solid #303745;border-radius:9px;background:#0f1218;color:#8992a2;font-size:9px;line-height:1.5;margin-bottom:12px}
.fbi-payroll-summary{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin:13px 0}
.fbi-payroll-summary-item{border:1px solid #2b303b;background:#0f1218;border-radius:9px;padding:10px}
.fbi-payroll-summary-item span{display:block;color:#7f8897;font-size:7.5px;text-transform:uppercase;letter-spacing:.6px}
.fbi-payroll-summary-item b{display:block;color:#f4f6fa;font-size:12px;margin-top:5px}
.fbi-payroll-table-wrap{overflow:auto;border:1px solid #2b303c;border-radius:10px}
.fbi-payroll-table{width:100%;border-collapse:collapse;min-width:980px}
.fbi-payroll-table th{padding:9px 10px;background:#10131a;color:#858e9f;text-transform:uppercase;letter-spacing:.65px;font-size:7.5px;text-align:left}
.fbi-payroll-table td{padding:10px;border-top:1px solid #252b35;color:#dce1e9;font-size:9px;vertical-align:top}
.fbi-payroll-table .num{text-align:right}
.fbi-payroll-table .sub{display:block;color:#737d8d;font-size:8px;margin-top:3px}
.fbi-payroll-badge{display:inline-flex;align-items:center;padding:4px 8px;border-radius:999px;font-size:7.5px;font-weight:900;white-space:nowrap;background:#252b34;color:#c0c7d1}
.fbi-payroll-badge.paid{background:#163126;color:#66e7a6}.fbi-payroll-badge.partial{background:#382b13;color:#f2c15d}.fbi-payroll-badge.pending{background:#17283b;color:#72b8ff}
.fbi-payroll-badge.active{background:#172f28;color:#71dfab}.fbi-payroll-badge.inactive{background:#2a2e35;color:#959daa}
.fbi-payroll-empty{padding:30px;text-align:center;color:#778191;border:1px dashed #303745;border-radius:10px;font-size:10px}
.fbi-payroll-actions-cell{display:flex;gap:6px;flex-wrap:wrap}
.fbi-payroll-mini-btn{border:1px solid #353b49;background:#151921;color:#e7eaf0;border-radius:7px;padding:6px 8px;font-size:8px;font-weight:850;cursor:pointer}
.fbi-payroll-mini-btn.primary{background:#82103f;border-color:#ae1b5b}.fbi-payroll-mini-btn.danger{color:#ff9eaa;border-color:#512a35;background:#29161d}
.fbi-payroll-worker-layout{display:grid;grid-template-columns:minmax(300px,.85fr) minmax(0,1.5fr);gap:12px}
.fbi-payroll-profile{border:1px solid #2b303c;background:#0f1218;border-radius:10px;padding:14px}
.fbi-payroll-profile h4{margin:0 0 10px;font-size:11px}
.fbi-payroll-profile-row{display:grid;grid-template-columns:110px 1fr;gap:8px;padding:7px 0;border-bottom:1px solid #252b34;font-size:9px}
.fbi-payroll-profile-row span{color:#7f8897}.fbi-payroll-profile-row b{color:#e6eaf0;font-weight:750}
.fbi-payroll-modal{position:fixed;inset:0;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(0,0,0,.72);backdrop-filter:blur(5px);z-index:250}
.fbi-payroll-modal.show{display:flex}
.fbi-payroll-dialog{width:min(760px,96vw);max-height:92vh;overflow:auto;background:#11141b;border:1px solid #343a48;border-radius:14px;box-shadow:0 30px 90px #000b}
.fbi-payroll-dialog-head{position:sticky;top:0;z-index:2;padding:15px 17px;background:#11141bf7;border-bottom:1px solid #2b303c;display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.fbi-payroll-dialog-head h3{margin:0;font-size:13px;color:#fff}.fbi-payroll-dialog-head small{display:block;color:#7f8897;font-size:8px;margin-top:4px}
.fbi-payroll-dialog-body{padding:17px}
.fbi-payroll-pay-balance{padding:13px;background:#0e1218;border:1px solid #313846;border-radius:9px;margin-bottom:13px}
.fbi-payroll-pay-balance span{color:#7f8897;font-size:8px;text-transform:uppercase;letter-spacing:.7px}.fbi-payroll-pay-balance b{display:block;font-size:18px;margin-top:5px}
.fbi-payroll-report-summary{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin:12px 0}
.fbi-payroll-report-summary div{border:1px solid #2b303b;background:#0f1218;border-radius:9px;padding:10px}.fbi-payroll-report-summary span{display:block;color:#7f8897;font-size:7.5px;text-transform:uppercase}.fbi-payroll-report-summary b{display:block;font-size:12px;margin-top:4px}
.fbi-payroll-payslip-list{display:grid;gap:8px}
.fbi-payroll-payslip-row{display:flex;align-items:center;gap:10px;padding:11px;border:1px solid #2b303b;background:#0f1218;border-radius:9px}
.fbi-payroll-payslip-row .grow{flex:1;min-width:0}.fbi-payroll-payslip-row b{font-size:10px}.fbi-payroll-payslip-row small{display:block;color:#798291;font-size:8px;margin-top:3px}
@media(max-width:1180px){.fbi-payroll-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.fbi-payroll-worker-layout{grid-template-columns:1fr}.fbi-payroll-form{grid-template-columns:repeat(2,minmax(0,1fr))}.fbi-payroll-summary{grid-template-columns:repeat(3,minmax(0,1fr))}.fbi-payroll-report-summary{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:760px){.fbi-payroll-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.fbi-payroll-hero{padding-top:16px}.fbi-payroll-hero h2{font-size:19px}.fbi-payroll-form{grid-template-columns:1fr}.fbi-payroll-field.half{grid-column:1}.fbi-payroll-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.fbi-payroll-report-summary{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.fbi-payroll-grid,.fbi-payroll-summary,.fbi-payroll-report-summary{grid-template-columns:1fr}.fbi-payroll-card{padding:12px}.fbi-payroll-actions{width:100%}.fbi-payroll-actions .btn{flex:1}.fbi-payroll-dialog-body{padding:13px}}
@media print{
  body.fbi-payroll-printing{background:#fff!important;display:block!important;color:#111!important}
  body.fbi-payroll-printing .side,body.fbi-payroll-printing .top,body.fbi-payroll-printing .view:not(#fbiPayrollView){display:none!important}
  body.fbi-payroll-printing #fbiPayrollView{display:block!important;padding:0!important}
  body.fbi-payroll-printing .fbi-payroll-hero,body.fbi-payroll-printing .fbi-payroll-tabs,body.fbi-payroll-printing .fbi-payroll-actions{display:none!important}
  body.fbi-payroll-printing .fbi-payroll-card{background:#fff!important;border:0!important;padding:0!important}
  body.fbi-payroll-printing .fbi-payroll-table-wrap{border:0}.fbi-payroll-table{min-width:0}.fbi-payroll-table th,.fbi-payroll-table td{font-size:8px;padding:6px}
}

/* ===== PAYROLL UI POLISH V3 ===== */
/* Visual-only Payroll refresh. Invoice engine/state remain untouched. */
:root{
  --pay-bg:#0b0e13;--pay-surface:#11161e;--pay-surface-2:#151b24;--pay-border:#2a3340;--pay-text:#eef2f7;--pay-muted:#8792a3;--pay-gold:#d7b15a;--pay-pink:#bd1b63;--pay-shadow:0 16px 44px rgba(0,0,0,.20)
}
body.fbi-payroll-mode{background:radial-gradient(900px 460px at 78% -10%,rgba(215,177,90,.08),transparent 60%),radial-gradient(760px 500px at 2% 100%,rgba(189,27,99,.055),transparent 62%),var(--bg)}
body.fbi-payroll-mode .top{z-index:120;overflow:visible}
body.fbi-payroll-mode .top>div:first-child{min-width:0;flex:1 1 auto}
body.fbi-payroll-mode .top>div:last-child{
  flex:0 0 auto!important;display:flex!important;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:nowrap!important;margin-left:auto;width:auto!important;max-width:none!important;padding-right:150px
}
body.fbi-payroll-mode .top .theme-switcher{
  position:absolute!important;right:24px;top:50%;transform:translateY(-50%);z-index:140;margin:0!important;order:0!important;flex:0 0 auto!important
}
body.fbi-payroll-mode .top .theme-choice{white-space:nowrap}
body.fbi-payroll-mode #fbiPayrollView{padding:24px 28px 52px;max-width:none;margin:0;width:100%;position:relative;z-index:1}
body.fbi-payroll-mode .fbi-payroll-shell{width:100%;max-width:1600px;margin:0 auto}
body.fbi-payroll-mode .fbi-payroll-hero{
  position:relative;display:flex;justify-content:space-between;align-items:flex-end;gap:24px;padding:22px 24px 20px;margin:0 0 14px;
  background:linear-gradient(135deg,rgba(20,25,34,.98),rgba(13,18,26,.98));border:1px solid #293340;border-radius:16px;box-shadow:var(--pay-shadow);overflow:hidden
}
body.fbi-payroll-mode .fbi-payroll-hero:after{content:"";position:absolute;right:-80px;top:-95px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(215,177,90,.13),transparent 66%);pointer-events:none}
body.fbi-payroll-mode .fbi-payroll-kicker{color:var(--pay-gold);font-size:8px;letter-spacing:2.1px;margin-bottom:7px}
body.fbi-payroll-mode .fbi-payroll-hero h2{font-size:27px;line-height:1.05;letter-spacing:-.6px;color:#fff}
body.fbi-payroll-mode .fbi-payroll-hero p{font-size:10px;color:#98a3b3;margin-top:7px;max-width:660px;line-height:1.5}
body.fbi-payroll-mode .fbi-payroll-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
body.fbi-payroll-mode .fbi-payroll-hero>.fbi-payroll-actions{position:relative;z-index:2}
body.fbi-payroll-mode .fbi-payroll-hero .btn{min-height:38px;padding:9px 14px}
body.fbi-payroll-mode .fbi-payroll-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-bottom:14px}
body.fbi-payroll-mode .fbi-payroll-stat{min-height:96px;padding:13px 14px;background:linear-gradient(145deg,#141a22,#0f141b);border-color:#28313c;border-radius:13px;box-shadow:0 8px 24px rgba(0,0,0,.12)}
body.fbi-payroll-mode .fbi-payroll-stat:hover{transform:translateY(-2px);border-color:rgba(215,177,90,.30)}
body.fbi-payroll-mode .fbi-payroll-stat span{font-size:7.5px;letter-spacing:1.15px;color:#8792a2}
body.fbi-payroll-mode .fbi-payroll-stat b{font-size:20px;line-height:1.1;margin-top:9px;letter-spacing:-.3px}
body.fbi-payroll-mode .fbi-payroll-stat small{font-size:7.5px;margin-top:5px;color:#697587}
body.fbi-payroll-mode .fbi-payroll-grid .fbi-payroll-stat:nth-child(1){border-top:2px solid #d7b15a}
body.fbi-payroll-mode .fbi-payroll-grid .fbi-payroll-stat:nth-child(2){border-top:2px solid #bd1b63}
body.fbi-payroll-mode .fbi-payroll-grid .fbi-payroll-stat:nth-child(3){border-top:2px solid #48c98a}
body.fbi-payroll-mode .fbi-payroll-grid .fbi-payroll-stat:nth-child(4){border-top:2px solid #6fa7ff}
body.fbi-payroll-mode .fbi-payroll-grid .fbi-payroll-stat:nth-child(5){border-top:2px solid #efb95d}
body.fbi-payroll-mode .fbi-payroll-card{background:linear-gradient(160deg,rgba(18,23,31,.98),rgba(13,17,24,.98));border-color:#293340;border-radius:16px;padding:17px;box-shadow:var(--pay-shadow)}
body.fbi-payroll-mode .fbi-payroll-tabs{display:flex;align-items:center;gap:6px;padding:4px;margin:-1px 0 16px;border:1px solid #2a333f;border-radius:11px;background:#0c1117;overflow-x:auto;scrollbar-width:thin}
body.fbi-payroll-mode .fbi-payroll-tab{flex:0 0 auto;padding:9px 13px;border-radius:8px;border-color:transparent;background:transparent;color:#8490a1;font-size:9px}
body.fbi-payroll-mode .fbi-payroll-tab:hover{background:#171d26;color:#e8edf4}
body.fbi-payroll-mode .fbi-payroll-tab.active{background:linear-gradient(180deg,#2a1721,#21131b);border-color:#a61b58;color:#fff;box-shadow:inset 0 0 0 1px rgba(255,255,255,.035),0 5px 18px rgba(189,27,99,.10)}
body.fbi-payroll-mode .fbi-payroll-section-head{align-items:center;margin-bottom:14px}
body.fbi-payroll-mode .fbi-payroll-section-head h3{font-size:13px;letter-spacing:.05px;color:#f0f3f7}
body.fbi-payroll-mode .fbi-payroll-section-head p{font-size:8.5px;color:#788495}
body.fbi-payroll-mode .fbi-payroll-info{margin-bottom:13px;padding:10px 12px;border-color:#303947;background:rgba(215,177,90,.035);color:#8b96a6;border-radius:10px}
body.fbi-payroll-mode .fbi-payroll-summary{gap:9px;margin:13px 0 15px}
body.fbi-payroll-mode .fbi-payroll-summary-item{padding:11px 12px;border-color:#29323d;background:#0e1319;border-radius:10px}
body.fbi-payroll-mode .fbi-payroll-summary-item b{font-size:12.5px}
body.fbi-payroll-mode .fbi-payroll-table-wrap{border-color:#2b3440;border-radius:11px;background:#0c1117}
body.fbi-payroll-mode .fbi-payroll-table th{background:#0f141b;padding:10px;color:#7e899a;font-size:7px}
body.fbi-payroll-mode .fbi-payroll-table td{padding:10px;border-top-color:#222a34;font-size:8.5px}
body.fbi-payroll-mode .fbi-payroll-table tbody tr:hover{background:rgba(215,177,90,.025)}
body.fbi-payroll-mode .fbi-payroll-mini-btn{min-height:30px;padding:6px 9px;border-color:#343e4a;background:#151b23}
body.fbi-payroll-mode .fbi-payroll-profile{background:#0d1218;border-color:#2b3440;border-radius:11px}
body.fbi-payroll-mode .fbi-payroll-field input,body.fbi-payroll-mode .fbi-payroll-field select,body.fbi-payroll-mode .fbi-payroll-field textarea{background:#0b0f15;border-color:#2f3946;color:#eef2f7}
body.fbi-payroll-mode .fbi-payroll-modal{z-index:300}
[data-theme="light"] body.fbi-payroll-mode{background:radial-gradient(900px 460px at 78% -10%,rgba(184,144,50,.07),transparent 60%),#f4f6f9}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-hero{background:linear-gradient(135deg,#15202d,#202b3a);border-color:#2f3b4a}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-card{background:#fff;border-color:#dfe4eb;box-shadow:0 10px 30px rgba(15,23,42,.06)}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-tabs{background:#f4f6f9;border-color:#dfe4eb}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-tab{color:#667085}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-tab:hover{background:#fff;color:#17202d}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-tab.active{background:#17202d;border-color:#17202d;color:#fff}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-stat{background:linear-gradient(180deg,#fff,#f8fafc);border-color:#dfe4eb;color:#17202d}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-stat span{color:#667085}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-stat b{color:#17202d}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-stat small{color:#7b8797}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-info{background:#fbfaf5;border-color:#e4dcc7;color:#667085}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-summary-item{background:#f8fafc;border-color:#dfe4eb}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-table-wrap{background:#fff;border-color:#dfe4eb}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-table th{background:#f3f5f8;color:#687386}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-table td{border-top-color:#e7ebf0;color:#273244}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-profile{background:#f8fafc;border-color:#dfe4eb}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-field input, [data-theme="light"] body.fbi-payroll-mode .fbi-payroll-field select, [data-theme="light"] body.fbi-payroll-mode .fbi-payroll-field textarea{background:#fff;color:#17202d;border-color:#d1d8e3}
@media(max-width:1180px){
  body.fbi-payroll-mode .fbi-payroll-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media(max-width:900px){
  body.fbi-payroll-mode .top>div:last-child{padding-right:132px;flex-wrap:wrap!important}
  body.fbi-payroll-mode .top .theme-switcher{right:14px}
  body.fbi-payroll-mode #fbiPayrollView{padding:18px 16px 42px}
  body.fbi-payroll-mode .fbi-payroll-hero{align-items:flex-start;flex-direction:column}
}
@media(max-width:760px){
  body.fbi-payroll-mode .fbi-payroll-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  body.fbi-payroll-mode .top>div:last-child{padding-right:112px}
  body.fbi-payroll-mode .top .theme-switcher{right:10px}
}
@media(max-width:520px){
  body.fbi-payroll-mode .fbi-payroll-grid{grid-template-columns:1fr}
  body.fbi-payroll-mode .fbi-payroll-hero{padding:18px}
  body.fbi-payroll-mode .fbi-payroll-hero h2{font-size:23px}
  body.fbi-payroll-mode .top>div:last-child{padding-right:0}
  body.fbi-payroll-mode .top .theme-switcher{position:static!important;transform:none!important;margin-left:2px!important}
}

/* ===== PAYROLL DASHBOARD EXPERIENCE V4 ===== */
/* Reference-inspired finance dashboard layout for Payroll. Visual/module-only, engine untouched. */
.fbi-payroll-dashboard{display:grid;gap:14px}
.fbi-payroll-dashboard-hero{display:flex;justify-content:space-between;align-items:stretch;gap:16px;padding:20px 22px;border:1px solid #2a3441;border-radius:15px;background:linear-gradient(135deg,#111a24,#17232f 58%,#10261f);box-shadow:0 16px 42px rgba(0,0,0,.18);overflow:hidden;position:relative}
.fbi-payroll-dashboard-hero:before{content:"";position:absolute;width:330px;height:220px;right:-90px;top:-100px;border-radius:50%;background:radial-gradient(circle,rgba(93,220,132,.20),transparent 68%);pointer-events:none}
.fbi-payroll-dashboard-hero-main{position:relative;z-index:1;min-width:0}
.fbi-payroll-dashboard-eyebrow{font-size:8px;letter-spacing:1.7px;text-transform:uppercase;font-weight:900;color:#d8ba61;margin-bottom:6px}
.fbi-payroll-dashboard-title{margin:0;font-size:24px;letter-spacing:-.55px;color:#fff}
.fbi-payroll-dashboard-sub{margin:6px 0 0;color:#9aa6b6;font-size:9px;line-height:1.5;max-width:640px}
.fbi-payroll-dashboard-tools{display:flex;align-items:center;gap:8px;position:relative;z-index:1;align-self:center;flex-wrap:wrap;justify-content:flex-end}
.fbi-payroll-period{border:1px solid #364252;background:#0f151d;color:#e7edf4;border-radius:9px;padding:9px 11px;font-size:9px;min-height:36px}
.fbi-payroll-kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
.fbi-payroll-kpi{padding:14px;border:1px solid #dfe4eb;border-radius:12px;background:#fff;box-shadow:0 7px 20px rgba(15,23,42,.045);position:relative;overflow:hidden}
.fbi-payroll-kpi:after{content:"";position:absolute;right:-25px;top:-30px;width:75px;height:75px;border-radius:50%;background:rgba(180,144,50,.08)}
.fbi-payroll-kpi span{display:block;color:#7a8798;font-size:7.5px;letter-spacing:.9px;text-transform:uppercase;font-weight:850}
.fbi-payroll-kpi b{display:block;color:#17202d;font-size:20px;letter-spacing:-.35px;margin-top:8px}
.fbi-payroll-kpi small{display:block;color:#8791a0;font-size:7.5px;margin-top:4px}
.fbi-payroll-kpi.gold{border-top:2px solid #b89032}.fbi-payroll-kpi.green{border-top:2px solid #43b977}.fbi-payroll-kpi.blue{border-top:2px solid #5f94d9}.fbi-payroll-kpi.pink{border-top:2px solid #bd1b63}.fbi-payroll-kpi.orange{border-top:2px solid #d08a29}
.fbi-payroll-dashboard-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.85fr);gap:12px}
.fbi-payroll-widget{border:1px solid #dfe4eb;border-radius:13px;background:#fff;padding:15px;box-shadow:0 7px 22px rgba(15,23,42,.045);min-width:0}
.fbi-payroll-widget-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-bottom:12px}.fbi-payroll-widget-head h3{margin:0;color:#1f2937;font-size:12px}.fbi-payroll-widget-head small{display:block;color:#7b8796;font-size:8px;margin-top:3px}
.fbi-payroll-chart{display:grid;gap:8px}.fbi-payroll-chart-row{display:grid;grid-template-columns:50px minmax(0,1fr) 72px;gap:9px;align-items:center}.fbi-payroll-chart-label{font-size:8px;color:#7a8493}.fbi-payroll-bars{display:grid;gap:4px}.fbi-payroll-bar-track{height:8px;background:#edf1f4;border-radius:999px;overflow:hidden}.fbi-payroll-bar-fill{height:100%;border-radius:999px}.fbi-payroll-bar-fill.net{background:linear-gradient(90deg,#172d28,#43b977)}.fbi-payroll-bar-fill.paid{background:linear-gradient(90deg,#b89032,#dfbf63)}.fbi-payroll-chart-value{text-align:right;font-size:8px;color:#273244;font-weight:800}
.fbi-payroll-health{display:grid;grid-template-columns:108px 1fr;gap:15px;align-items:center}.fbi-payroll-donut{width:108px;height:108px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#42be79 0deg 250deg,#dfe7e4 250deg 360deg);position:relative}.fbi-payroll-donut:after{content:"";width:76px;height:76px;border-radius:50%;background:#fff;position:absolute}.fbi-payroll-donut b{position:relative;z-index:1;color:#17202d;font-size:20px}.fbi-payroll-health-copy b{display:block;color:#17202d;font-size:16px}.fbi-payroll-health-copy small{display:block;color:#7d8897;font-size:8px;line-height:1.45;margin-top:5px}.fbi-payroll-health-stats{display:grid;gap:7px;margin-top:9px}.fbi-payroll-health-stat{display:flex;justify-content:space-between;gap:10px;font-size:8px}.fbi-payroll-health-stat span{color:#7d8794}.fbi-payroll-health-stat b{color:#1d2734}
.fbi-payroll-lists{display:grid;grid-template-columns:1.35fr .8fr;gap:12px}.fbi-payroll-list{display:grid;gap:0}.fbi-payroll-list-row{display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid #edf0f4}.fbi-payroll-list-row:last-child{border-bottom:0}.fbi-payroll-avatar{width:31px;height:31px;border-radius:9px;display:grid;place-items:center;background:#f4ebef;color:#a80e4d;font-size:11px;font-weight:900;flex:0 0 auto}.fbi-payroll-list-row .grow{flex:1;min-width:0}.fbi-payroll-list-row b{display:block;color:#263141;font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.fbi-payroll-list-row small{display:block;color:#7e8897;font-size:7.5px;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.fbi-payroll-list-amount{text-align:right}.fbi-payroll-list-amount b{font-size:9px}.fbi-payroll-list-amount small{color:#768292}
.fbi-payroll-dept{display:grid;gap:8px}.fbi-payroll-dept-row{display:grid;grid-template-columns:1fr 76px;gap:8px;align-items:center}.fbi-payroll-dept-label{font-size:8px;color:#455163}.fbi-payroll-dept-bar{height:7px;background:#edf1f5;border-radius:999px;overflow:hidden;margin-top:4px}.fbi-payroll-dept-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,#bd1b63,#d7b15a)}
.fbi-payroll-quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.fbi-payroll-quick{display:flex;align-items:center;gap:8px;padding:11px;border:1px solid #e1e5eb;border-radius:10px;background:#fff;color:#263141;text-align:left;cursor:pointer}.fbi-payroll-quick:hover{border-color:#d0d8e1;box-shadow:0 7px 16px rgba(15,23,42,.05);transform:translateY(-1px)}.fbi-payroll-quick-icon{width:28px;height:28px;border-radius:8px;display:grid;place-items:center;background:#f4ebef;color:#a80e4d;font-size:13px;flex:0 0 auto}.fbi-payroll-quick b{font-size:8.5px}.fbi-payroll-quick small{display:block;color:#7a8796;font-size:7px;margin-top:2px}
.fbi-payroll-overview-table-wrap{margin-top:0}.fbi-payroll-dashboard .fbi-payroll-info{margin-top:0}
[data-theme="dark"] .fbi-payroll-widget,[data-theme="dark"] .fbi-payroll-kpi{background:linear-gradient(180deg,#141922,#10151b);border-color:#2b3440;box-shadow:0 10px 28px rgba(0,0,0,.16)}
[data-theme="dark"] .fbi-payroll-kpi span,[data-theme="dark"] .fbi-payroll-chart-label,[data-theme="dark"] .fbi-payroll-widget-head small,[data-theme="dark"] .fbi-payroll-list-row small,[data-theme="dark"] .fbi-payroll-dept-label,[data-theme="dark"] .fbi-payroll-health-copy small{color:#8792a2}
[data-theme="dark"] .fbi-payroll-kpi b,[data-theme="dark"] .fbi-payroll-widget-head h3,[data-theme="dark"] .fbi-payroll-chart-value,[data-theme="dark"] .fbi-payroll-health-copy b,[data-theme="dark"] .fbi-payroll-health-stat b,[data-theme="dark"] .fbi-payroll-list-row b{color:#eef2f7}
[data-theme="dark"] .fbi-payroll-bar-track,[data-theme="dark"] .fbi-payroll-dept-bar{background:#232a34}
[data-theme="dark"] .fbi-payroll-donut:after{background:#11161d}.fbi-payroll-dashboard .fbi-payroll-donut{background:conic-gradient(#43b977 0deg 250deg,#27332f 250deg 360deg)}
[data-theme="dark"] .fbi-payroll-quick{background:#11161d;border-color:#2b3440;color:#e9edf3}.fbi-payroll-quick-icon{background:rgba(189,27,99,.10)}
@media(max-width:1180px){.fbi-payroll-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.fbi-payroll-dashboard-grid{grid-template-columns:1fr}.fbi-payroll-lists{grid-template-columns:1fr}}
@media(max-width:780px){.fbi-payroll-dashboard-hero{flex-direction:column}.fbi-payroll-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.fbi-payroll-quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.fbi-payroll-kpis{grid-template-columns:1fr}.fbi-payroll-health{grid-template-columns:1fr}.fbi-payroll-donut{margin:auto}.fbi-payroll-quick-grid{grid-template-columns:1fr}.fbi-payroll-chart-row{grid-template-columns:42px minmax(0,1fr) 62px}}

/* ===== PAYROLL INNER-CONTENT INTERACTION V2 ===== */
/* Keep the outer Payroll navigation pill stable. Apply the tactile motion to the controls inside Payroll instead. */
.nav button[data-v="payroll"],.nav .nav-link[data-v="payroll"]{
  transform:none!important;
  box-shadow:none!important;
}
.fbi-payroll-tabs .fbi-payroll-tab{
  transform-origin:center center;
  transition:transform .28s cubic-bezier(.2,.75,.25,1),box-shadow .28s ease,background .28s ease,border-color .28s ease!important;
}
.fbi-payroll-tabs .fbi-payroll-tab:hover{
  transform:translateY(-1px) rotate(1.1deg) scale(1.012)!important;
  box-shadow:0 7px 20px rgba(0,0,0,.16),inset 0 0 18px rgba(215,177,90,.055)!important;
  border-color:rgba(215,177,90,.42)!important;
}
.fbi-payroll-tabs .fbi-payroll-tab.active{
  transform:rotate(.25deg) scale(1.005)!important;
  box-shadow:0 5px 18px rgba(189,27,99,.10),inset 0 0 20px rgba(189,27,99,.08)!important;
}
.fbi-payroll-tabs .fbi-payroll-tab:active{
  transform:translateY(0) rotate(.1deg) scale(.99)!important;
}
.fbi-payroll-quick,.fbi-payroll-mini-btn,.fbi-payroll-dashboard-tools .btn,.fbi-payroll-actions .btn{
  transition:transform .28s cubic-bezier(.2,.75,.25,1),box-shadow .28s ease,border-color .28s ease,background .28s ease!important;
}
.fbi-payroll-quick:hover,.fbi-payroll-mini-btn:hover,.fbi-payroll-dashboard-tools .btn:hover,.fbi-payroll-actions .btn:hover{
  transform:translateY(-1px) rotate(.7deg) scale(1.01)!important;
  box-shadow:0 7px 20px rgba(0,0,0,.14)!important;
}
@media(prefers-reduced-motion:reduce){
  .fbi-payroll-tabs .fbi-payroll-tab,.fbi-payroll-quick,.fbi-payroll-mini-btn,.fbi-payroll-dashboard-tools .btn,.fbi-payroll-actions .btn{transition:none!important}
  .fbi-payroll-tabs .fbi-payroll-tab:hover,.fbi-payroll-tabs .fbi-payroll-tab.active,.fbi-payroll-tabs .fbi-payroll-tab:active,
  .fbi-payroll-quick:hover,.fbi-payroll-mini-btn:hover,.fbi-payroll-dashboard-tools .btn:hover,.fbi-payroll-actions .btn:hover{transform:none!important}
}

/* ===== PAYROLL DEDICATED WORKSPACE V3 ===== */
/* Payroll gets a dedicated workspace. The invoice header tools are hidden while Payroll is open. */
body.fbi-payroll-mode .top{display:none!important}
body.fbi-payroll-mode .main{width:100%;min-width:0}
body.fbi-payroll-mode #fbiPayrollView{
  display:block;
  width:100%;
  max-width:none;
  margin:0;
  padding:20px 22px 44px;
  min-height:100vh;
}
body.fbi-payroll-mode .fbi-payroll-shell{width:min(1240px,100%);max-width:1240px;margin:0 auto}
body.fbi-payroll-mode .fbi-payroll-dashboard{width:100%}
body.fbi-payroll-mode .fbi-payroll-dashboard-hero{padding:18px 20px;border-radius:14px;min-height:116px}
body.fbi-payroll-mode .fbi-payroll-dashboard-title{font-size:23px}
body.fbi-payroll-mode .fbi-payroll-dashboard-sub{font-size:9px;max-width:590px}
body.fbi-payroll-mode .fbi-payroll-dashboard-tools{gap:6px}
body.fbi-payroll-mode .fbi-payroll-dashboard-tools .btn,
body.fbi-payroll-mode .fbi-payroll-dashboard-tools .fbi-payroll-period{min-height:34px;padding:8px 10px;font-size:8.5px}
body.fbi-payroll-mode .fbi-payroll-kpis{grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
body.fbi-payroll-mode .fbi-payroll-kpi{padding:12px;min-height:88px}
body.fbi-payroll-mode .fbi-payroll-kpi b{font-size:18px;margin-top:7px}
body.fbi-payroll-mode .fbi-payroll-dashboard-grid{grid-template-columns:minmax(0,1.45fr) minmax(285px,.8fr);gap:10px}
body.fbi-payroll-mode .fbi-payroll-lists{grid-template-columns:minmax(0,1.2fr) minmax(285px,.8fr);gap:10px}
body.fbi-payroll-mode .fbi-payroll-widget{padding:13px;border-radius:12px}
body.fbi-payroll-mode .fbi-payroll-widget-head{margin-bottom:9px}
body.fbi-payroll-mode .fbi-payroll-quick-grid{gap:7px}
body.fbi-payroll-mode .fbi-payroll-quick{padding:9px}
@media(max-width:1180px){
  body.fbi-payroll-mode #fbiPayrollView{padding:18px 16px 40px}
  body.fbi-payroll-mode .fbi-payroll-shell{width:100%;max-width:1180px}
}
@media(max-width:900px){
  body.fbi-payroll-mode .fbi-payroll-dashboard-hero{padding:16px;gap:14px}
  body.fbi-payroll-mode .fbi-payroll-dashboard-tools{width:100%;justify-content:flex-start}
}
@media(max-width:640px){
  body.fbi-payroll-mode #fbiPayrollView{padding:12px 10px 30px}
  body.fbi-payroll-mode .fbi-payroll-dashboard-title{font-size:20px}
  body.fbi-payroll-mode .fbi-payroll-dashboard-hero{border-radius:12px}
}
</style>

<section class="view" id="fbiPayrollView" aria-label="Payroll">
  <div class="fbi-payroll-shell">
    <div class="fbi-payroll-hero">
      <div>
        <div class="fbi-payroll-kicker">FBI People & Payments</div>
        <h2>Payroll</h2>
        <p>Staff, project earnings, payments, payslips and payroll reporting.</p>
      </div>
      <div class="fbi-payroll-actions">
        <button class="btn" type="button" id="fbiPayrollQuickWorker">＋ Add Worker</button>
        <button class="btn primary" type="button" id="fbiPayrollQuickRecord">＋ New Payroll</button>
      </div>
    </div>

    <div class="fbi-payroll-grid">
      <div class="fbi-payroll-stat"><span>Workers</span><b id="fbiPayrollWorkerCount">0</b><small id="fbiPayrollWorkerMeta">Active 0</small></div>
      <div class="fbi-payroll-stat"><span>Payroll Records</span><b id="fbiPayrollRecordCount">0</b><small id="fbiPayrollRecordMeta">All work records</small></div>
      <div class="fbi-payroll-stat"><span>Net Payroll</span><b id="fbiPayrollNetTotal">GHS₵0.00</b><small id="fbiPayrollNetMeta">All records</small></div>
      <div class="fbi-payroll-stat"><span>Paid</span><b id="fbiPayrollPaidTotal">GHS₵0.00</b><small id="fbiPayrollPaidMeta">Recorded payments</small></div>
      <div class="fbi-payroll-stat"><span>Outstanding</span><b id="fbiPayrollBalanceTotal">GHS₵0.00</b><small id="fbiPayrollBalanceMeta">Amount still due</small></div>
    </div>

    <div class="fbi-payroll-card">
      <div class="fbi-payroll-tabs">
        <button class="fbi-payroll-tab active" type="button" data-payroll-tab="overview">Overview</button>
        <button class="fbi-payroll-tab" type="button" data-payroll-tab="workers">Staff / Workers</button>
        <button class="fbi-payroll-tab" type="button" data-payroll-tab="records">Payroll Records</button>
        <button class="fbi-payroll-tab" type="button" data-payroll-tab="payslips">Payslips</button>
        <button class="fbi-payroll-tab" type="button" data-payroll-tab="reports">Reports</button>
      </div>

      <div class="fbi-payroll-panel active" data-payroll-panel="overview">
        <div class="fbi-payroll-dashboard">
          <div class="fbi-payroll-dashboard-hero">
            <div class="fbi-payroll-dashboard-hero-main">
              <div class="fbi-payroll-dashboard-eyebrow">FBI PEOPLE & PAYMENTS</div>
              <h2 class="fbi-payroll-dashboard-title">Payroll Command Center</h2>
              <p class="fbi-payroll-dashboard-sub">Manage worker earnings, payment progress, payroll exposure and payslips from one finance workspace.</p>
            </div>
            <div class="fbi-payroll-dashboard-tools">
              <select class="fbi-payroll-period" id="fbiPayrollOverviewPeriod" aria-label="Payroll period">
                <option value="all">All time</option>
                <option value="month">This month</option>
                <option value="quarter">This quarter</option>
              </select>
              <button class="btn" type="button" id="fbiPayrollOverviewPrint">🖨 Print</button>
              <button class="btn" type="button" id="fbiPayrollQuickWorkers">＋ Add Worker</button>
              <button class="btn primary" type="button" id="fbiPayrollQuickRecord">＋ New Payroll</button>
            </div>
          </div>

          <div class="fbi-payroll-kpis" id="fbiPayrollDashboardKpis"></div>

          <div class="fbi-payroll-dashboard-grid">
            <div class="fbi-payroll-widget">
              <div class="fbi-payroll-widget-head">
                <div><h3>Payroll Cashflow</h3><small>Net payroll against recorded payments</small></div>
                <small id="fbiPayrollChartRange">Last 6 months</small>
              </div>
              <div class="fbi-payroll-chart" id="fbiPayrollCashflowChart"></div>
            </div>

            <div class="fbi-payroll-widget">
              <div class="fbi-payroll-widget-head">
                <div><h3>Payroll Health</h3><small>How much current payroll has been settled</small></div>
              </div>
              <div id="fbiPayrollHealth"></div>
            </div>
          </div>

          <div class="fbi-payroll-lists">
            <div class="fbi-payroll-widget">
              <div class="fbi-payroll-widget-head">
                <div><h3>Recent Payroll Activity</h3><small>Latest work records and payment movement</small></div>
                <button class="fbi-payroll-mini-btn" type="button" id="fbiPayrollViewRecords">View Records</button>
              </div>
              <div class="fbi-payroll-list" id="fbiPayrollRecentActivity"></div>
            </div>
            <div class="fbi-payroll-widget">
              <div class="fbi-payroll-widget-head">
                <div><h3>Payroll by Department</h3><small>Net payroll exposure by team</small></div>
              </div>
              <div class="fbi-payroll-dept" id="fbiPayrollDepartments"></div>
            </div>
          </div>

          <div class="fbi-payroll-widget">
            <div class="fbi-payroll-widget-head">
              <div><h3>Quick Actions</h3><small>Jump directly into your daily payroll workflow</small></div>
            </div>
            <div class="fbi-payroll-quick-grid">
              <button class="fbi-payroll-quick" type="button" id="fbiPayrollQAWorker"><span class="fbi-payroll-quick-icon">👤</span><span><b>Add Worker</b><small>Create a new worker profile</small></span></button>
              <button class="fbi-payroll-quick" type="button" id="fbiPayrollQARecord"><span class="fbi-payroll-quick-icon">＋</span><span><b>New Payroll</b><small>Enter work and earnings</small></span></button>
              <button class="fbi-payroll-quick" type="button" id="fbiPayrollQAPayslip"><span class="fbi-payroll-quick-icon">🧾</span><span><b>Payslips</b><small>View and print payslips</small></span></button>
              <button class="fbi-payroll-quick" type="button" id="fbiPayrollQAReport"><span class="fbi-payroll-quick-icon">📊</span><span><b>Reports</b><small>Filter, print or export</small></span></button>
            </div>
          </div>

          <div class="fbi-payroll-widget">
            <div class="fbi-payroll-widget-head">
              <div><h3>Latest Payroll Records</h3><small>Full financial detail remains available under Payroll Records</small></div>
            </div>
            <div id="fbiPayrollOverviewTable" class="fbi-payroll-overview-table-wrap"></div>
          </div>
        </div>
      </div>

      <div class="fbi-payroll-panel" data-payroll-panel="workers">
        <div class="fbi-payroll-section-head">
          <div><h3>Staff / Worker Directory</h3><p>Profiles, worker categories and payment details.</p></div>
          <button class="btn primary" type="button" id="fbiPayrollWorkersAdd">＋ Add Worker</button>
        </div>
        <div id="fbiPayrollWorkerFormWrap"></div>
        <div class="fbi-payroll-worker-layout">
          <div id="fbiPayrollWorkerProfile"></div>
          <div id="fbiPayrollWorkersTable"></div>
        </div>
      </div>

      <div class="fbi-payroll-panel" data-payroll-panel="records">
        <div class="fbi-payroll-section-head">
          <div><h3>Payroll Records</h3><p>Pay people according to events, days, installations or another basis.</p></div>
          <button class="btn primary" type="button" id="fbiPayrollRecordsAdd">＋ New Payroll</button>
        </div>
        <div id="fbiPayrollRecordFormWrap"></div>
        <div id="fbiPayrollRecordsTable"></div>
      </div>

      <div class="fbi-payroll-panel" data-payroll-panel="payslips">
        <div class="fbi-payroll-section-head">
          <div><h3>Payslips</h3><p>Generated payslips and printable payment documents.</p></div>
        </div>
        <div id="fbiPayrollPayslipList"></div>
      </div>

      <div class="fbi-payroll-panel" data-payroll-panel="reports">
        <div class="fbi-payroll-section-head">
          <div><h3>Payroll Reports</h3><p>Filter by date, worker, department, project/job and payment status.</p></div>
          <div class="fbi-payroll-actions">
            <button class="btn" type="button" id="fbiPayrollReportCsv">⬇ CSV</button>
            <button class="btn primary" type="button" id="fbiPayrollReportPrint">🖨 Print / Save PDF</button>
          </div>
        </div>
        <div class="fbi-payroll-form" style="margin-bottom:12px">
          <div class="fbi-payroll-field"><label>From Date</label><input type="date" id="fbiPayrollReportFrom"></div>
          <div class="fbi-payroll-field"><label>To Date</label><input type="date" id="fbiPayrollReportTo"></div>
          <div class="fbi-payroll-field"><label>Worker</label><select id="fbiPayrollReportWorker"></select></div>
          <div class="fbi-payroll-field"><label>Department</label><select id="fbiPayrollReportDepartment"><option value="">All Departments</option><option>Media Production</option><option>IT / Networking</option><option>CCTV / Security</option><option>Smart Home</option><option>Administration</option><option>Other</option></select></div>
          <div class="fbi-payroll-field"><label>Project / Job</label><input type="text" id="fbiPayrollReportProject" placeholder="Search project or event"></div>
          <div class="fbi-payroll-field"><label>Payment Status</label><select id="fbiPayrollReportStatus"><option value="">All Statuses</option><option>Pending</option><option>Partially Paid</option><option>Paid</option></select></div>
          <div class="fbi-payroll-field"><label>&nbsp;</label><button class="btn" type="button" id="fbiPayrollReportReset">Reset Filters</button></div>
        </div>
        <div class="fbi-payroll-report-summary" id="fbiPayrollReportSummary"></div>
        <div id="fbiPayrollReportTable"></div>
      </div>
    </div>
  </div>

  <div class="fbi-payroll-modal" id="fbiPayrollPaymentModal" aria-hidden="true">
    <div class="fbi-payroll-dialog">
      <div class="fbi-payroll-dialog-head">
        <div><h3>Record Payroll Payment</h3><small>Partial payments are supported and stored in the Payroll module.</small></div>
        <button class="btn" type="button" id="fbiPayrollPaymentClose">Close</button>
      </div>
      <div class="fbi-payroll-dialog-body">
        <div class="fbi-payroll-pay-balance"><span>Outstanding Balance</span><b id="fbiPayrollPaymentBalance">GHS₵0.00</b></div>
        <div class="fbi-payroll-form">
          <div class="fbi-payroll-field"><label>Amount</label><input type="number" min="0" step="0.01" id="fbiPayrollPaymentAmount"></div>
          <div class="fbi-payroll-field"><label>Payment Date</label><input type="date" id="fbiPayrollPaymentDate"></div>
          <div class="fbi-payroll-field"><label>Payment Method</label><select id="fbiPayrollPaymentMethod"><option>Mobile Money</option><option>Bank</option><option>Cash</option></select></div>
          <div class="fbi-payroll-field"><label>Transaction / Reference</label><input type="text" id="fbiPayrollPaymentRef" placeholder="Reference number"></div>
          <div class="fbi-payroll-field"><label>Paid By</label><input type="text" id="fbiPayrollPaymentBy" placeholder="Person who made payment"></div>
          <div class="fbi-payroll-field"><label>Notes</label><input type="text" id="fbiPayrollPaymentNotes" placeholder="Optional payment notes"></div>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:13px">
          <button class="btn" type="button" id="fbiPayrollPaymentCancel">Cancel</button>
          <button class="btn primary" type="button" id="fbiPayrollPaymentSave">Save Payment</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  'use strict';

  var KEY='fbi-payroll-v2-isolated';
  var OLD_KEY='fbi-payroll-isolated-v1';
  var STATE={workers:[],records:[],payslips:[]};
  var selectedWorkerId='';
  var editingWorkerId='';
  var editingRecordId='';
  var paymentRecordId='';

  function q(id){return document.getElementById(id);}
  function num(v){var n=Number(v);return Number.isFinite(n)?n:0;}
  function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];});}
  function money(v){return 'GHS₵'+num(v).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});}
  function today(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
  function uid(prefix){if(window.crypto&&crypto.randomUUID)return prefix+'-'+crypto.randomUUID();return prefix+'-'+Date.now()+'-'+Math.random().toString(36).slice(2,9);}
  function toastLocal(msg){try{if(typeof window.toast==='function'){window.toast(msg);return}}catch(e){}}

  /* Payroll-only persistence. This never calls the invoice persist() function. */
  function saveState(){
    try{
      localStorage.setItem(KEY,JSON.stringify(STATE));
      return true;
    }catch(e){
      console.error('Payroll storage failed',e);
      alert('Payroll could not be saved on this device.');
      return false;
    }
  }
  function normalizeRecord(r){
    r=r||{};
    var payments=Array.isArray(r.payments)?r.payments.slice():[];
    if(!payments.length&&num(r.paidAmount)>0){
      payments.push({id:uid('payment'),date:r.paymentDate||today(),amount:num(r.paidAmount),method:r.paymentMethod||'',reference:r.transactionRef||'',paidBy:r.paidBy||'',notes:r.paymentNotes||''});
    }
    r.payments=payments;
    r.allowance=num(r.allowance);
    r.transport=num(r.transport);
    r.feeding=num(r.feeding);
    r.accommodation=num(r.accommodation);
    r.overtime=num(r.overtime);
    r.otherAllowance=num(r.otherAllowance);
    r.bonus=num(r.bonus);
    r.deduction=num(r.deduction);
    r.advance=num(r.advance);
    r.previousBalance=num(r.previousBalance);
    r.rate=num(r.rate);
    r.qty=Math.max(1,num(r.qty)||1);
    return r;
  }
  function loadState(){
    var parsed=null;
    try{parsed=JSON.parse(localStorage.getItem(KEY)||'null');}catch(e){}
    if(parsed&&typeof parsed==='object'){
      STATE={
        workers:Array.isArray(parsed.workers)?parsed.workers:[],
        records:Array.isArray(parsed.records)?parsed.records.map(normalizeRecord):[],
        payslips:Array.isArray(parsed.payslips)?parsed.payslips:[]
      };
      return;
    }
    /* One-time migration of the previous Payroll-only browser store, if it exists. */
    try{
      var old=JSON.parse(localStorage.getItem(OLD_KEY)||'null');
      if(old&&typeof old==='object'){
        STATE={
          workers:Array.isArray(old.workers)?old.workers:[],
          records:Array.isArray(old.records)?old.records.map(normalizeRecord):[],
          payslips:[]
        };
        saveState();
        return;
      }
    }catch(e){}
    STATE={workers:[],records:[],payslips:[]};
  }

  function getWorker(idv){return STATE.workers.find(function(w){return w.id===idv;})||null;}
  function basePay(r){return Math.max(0,num(r.rate)*Math.max(1,num(r.qty)||1));}
  function allowances(r){return num(r.allowance)+num(r.transport)+num(r.feeding)+num(r.accommodation)+num(r.overtime)+num(r.otherAllowance)+num(r.bonus);}
  function gross(r){return Math.max(0,basePay(r)+allowances(r));}
  function net(r){return Math.max(0,gross(r)-num(r.deduction)-num(r.advance)+num(r.previousBalance));}
  function paid(r){return Math.min(net(r),Math.max(0,(r.payments||[]).reduce(function(s,p){return s+num(p.amount);},0)));}
  function balance(r){return Math.max(0,net(r)-paid(r));}
  function status(r){var n=net(r),p=paid(r);if(n<=0)return 'Pending';if(p>=n-0.005)return 'Paid';if(p>0.005)return 'Partially Paid';return 'Pending';}
  function badge(s){var c=s==='Paid'?'paid':s==='Partially Paid'?'partial':'pending';return '<span class="fbi-payroll-badge '+c+'">'+esc(s)+'</span>';}

  /* Read-only bridge to existing invoice/job data. Nothing is written back. */
  function getInvoiceRecords(){
    try{
      if(typeof data!=='undefined'&&Array.isArray(data))return data.slice();
    }catch(e){}
    return [];
  }
  function invoiceOptions(selected){
    var invoices=getInvoiceRecords().slice().sort(function(a,b){return String(b.eventDate||b.date||'').localeCompare(String(a.eventDate||a.date||''));});
    var html='<option value="">No invoice / independent work</option>';
    invoices.forEach(function(x){
      var label=(x.no||'Invoice')+' · '+(x.client||'No client');
      if(x.eventDate)label+=' · '+x.eventDate;
      html+='<option value="'+esc(x.id||'')+'"'+((x.id||'')===selected?' selected':'')+'>'+esc(label)+'</option>';
    });
    return html;
  }
  function selectedInvoice(idv){
    return getInvoiceRecords().find(function(x){return x.id===idv;})||null;
  }

  function tabs(tab){
    document.querySelectorAll('[data-payroll-tab]').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-payroll-tab')===tab);});
    document.querySelectorAll('[data-payroll-panel]').forEach(function(p){p.classList.toggle('active',p.getAttribute('data-payroll-panel')===tab);});
    renderAll();
  }

  function workerSelectOptions(selected){
    var html='<option value="">Select worker</option>';
    STATE.workers.slice().sort(function(a,b){return String(a.name||'').localeCompare(String(b.name||''));}).forEach(function(w){
      html+='<option value="'+esc(w.id)+'"'+(w.id===selected?' selected':'')+'>'+esc(w.name)+(w.role?' · '+esc(w.role):'')+'</option>';
    });
    return html;
  }

  function showWorkerForm(existing){
    tabs('workers');
    editingWorkerId=existing?existing.id:'';
    var w=existing||{};
    q('fbiPayrollWorkerFormWrap').innerHTML=
      '<div class="fbi-payroll-card" style="margin-bottom:12px">'+
      '<div class="fbi-payroll-section-head"><div><h3>'+(existing?'Edit Worker':'Add Worker')+'</h3><p>Complete worker profile and payment details.</p></div></div>'+
      '<div class="fbi-payroll-form">'+
        field('Staff / Worker ID','pwCode',w.workerCode||'','text','e.g. FBI-WK-004')+
        field('Full Name','pwName',w.name||'','text','Full name')+
        field('Phone Number','pwPhone',w.phone||'','tel','Phone number')+
        field('Email','pwEmail',w.email||'','email','Email')+
        field('Address','pwAddress',w.address||'','text','Address',true)+
        field('Role / Job Title','pwRole',w.role||'','text','Role or job title')+
        selectField('Department','pwDepartment',['Media Production','IT / Networking','CCTV / Security','Smart Home','Administration','Other'],w.department||'Media Production')+
        selectField('Worker Type','pwType',['Staff','Media Worker','IT Technician','Network Technician','CCTV Installer','Other'],w.workerType||'Media Worker')+
        selectField('Preferred Payment Method','pwPaymentMethod',['Mobile Money','Bank','Cash'],w.paymentMethod||'Mobile Money')+
        field('MoMo Number','pwMomo',w.momo||'','text','')+
        field('Bank Name','pwBank',w.bank||'','text','')+
        field('Account Name','pwAccountName',w.accountName||'','text','')+
        field('Account Number','pwAccountNumber',w.accountNumber||'','text','')+
        field('Ghana Card / ID Reference','pwIdRef',w.idRef||'','text','')+
        field('Emergency / Contact Person','pwEmergency',w.emergency||'','text','')+
        field('Emergency Phone','pwEmergencyPhone',w.emergencyPhone||'','text','')+
        selectField('Status','pwStatus',['Active','Inactive'],w.status||'Active')+
        field('Notes','pwNotes',w.notes||'','text','Additional notes',true)+
      '</div>'+
      '<div style="display:flex;gap:8px;justify-content:flex-end;margin-top:12px"><button class="btn" type="button" id="pwCancel">Cancel</button><button class="btn primary" type="button" id="pwSave">Save Worker</button></div>'+
      '</div>';
    q('pwSave').onclick=saveWorker;
    q('pwCancel').onclick=function(){editingWorkerId='';q('fbiPayrollWorkerFormWrap').innerHTML='';renderAll();};
  }
  function field(label,idv,value,type,ph,full){
    return '<div class="fbi-payroll-field'+(full?' full':'')+'"><label>'+esc(label)+'</label><input id="'+idv+'" type="'+(type||'text')+'" value="'+esc(value)+'" placeholder="'+esc(ph||'')+'"></div>';
  }
  function selectField(label,idv,options,selected,full){
    return '<div class="fbi-payroll-field'+(full?' full':'')+'"><label>'+esc(label)+'</label><select id="'+idv+'">'+options.map(function(v){return '<option value="'+esc(v)+'"'+(String(v)===String(selected)?' selected':'')+'>'+esc(v)+'</option>';}).join('')+'</select></div>';
  }
  function saveWorker(){
    var name=(q('pwName')?.value||'').trim();
    if(!name){alert('Full name is required.');return;}
    var w=editingWorkerId?getWorker(editingWorkerId):{id:uid('worker'),createdAt:new Date().toISOString()};
    if(!w)return;
    w.workerCode=(q('pwCode')?.value||'').trim();
    w.name=name;
    w.phone=(q('pwPhone')?.value||'').trim();
    w.email=(q('pwEmail')?.value||'').trim();
    w.address=(q('pwAddress')?.value||'').trim();
    w.role=(q('pwRole')?.value||'').trim();
    w.department=q('pwDepartment')?.value||'Other';
    w.workerType=q('pwType')?.value||'Other';
    w.paymentMethod=q('pwPaymentMethod')?.value||'Mobile Money';
    w.momo=(q('pwMomo')?.value||'').trim();
    w.bank=(q('pwBank')?.value||'').trim();
    w.accountName=(q('pwAccountName')?.value||'').trim();
    w.accountNumber=(q('pwAccountNumber')?.value||'').trim();
    w.idRef=(q('pwIdRef')?.value||'').trim();
    w.emergency=(q('pwEmergency')?.value||'').trim();
    w.emergencyPhone=(q('pwEmergencyPhone')?.value||'').trim();
    w.status=q('pwStatus')?.value||'Active';
    w.notes=(q('pwNotes')?.value||'').trim();
    var idx=STATE.workers.findIndex(function(x){return x.id===w.id;});
    if(idx>=0)STATE.workers[idx]=w;else STATE.workers.push(w);
    if(saveState()){editingWorkerId='';q('fbiPayrollWorkerFormWrap').innerHTML='';selectedWorkerId=w.id;renderAll();toastLocal('Worker saved');}
  }

  function renderWorkerProfile(){
    var el=q('fbiPayrollWorkerProfile');if(!el)return;
    var w=getWorker(selectedWorkerId);
    if(!w){el.innerHTML='<div class="fbi-payroll-profile"><h4>Worker Profile</h4><div class="fbi-payroll-empty">Select a worker from the directory to view the profile.</div></div>';return;}
    var pay=w.paymentMethod==='Mobile Money'?(w.momo||'Not provided'):(w.paymentMethod==='Bank'?((w.bank||'')+' · '+(w.accountNumber||'Not provided')):'Cash');
    el.innerHTML='<div class="fbi-payroll-profile"><h4>'+esc(w.name)+'</h4>'+
      profileRow('Worker ID',w.workerCode||'Not set')+
      profileRow('Role',w.role||'Not set')+
      profileRow('Department',w.department||'Not set')+
      profileRow('Worker Type',w.workerType||'Not set')+
      profileRow('Phone',w.phone||'Not set')+
      profileRow('Email',w.email||'Not set')+
      profileRow('Address',w.address||'Not set')+
      profileRow('Payment',w.paymentMethod||'Not set')+
      profileRow('Payment Details',pay)+
      profileRow('ID Reference',w.idRef||'Not set')+
      profileRow('Emergency Contact',w.emergency||'Not set')+
      profileRow('Emergency Phone',w.emergencyPhone||'Not set')+
      profileRow('Status',w.status||'Active')+
      (w.notes?profileRow('Notes',w.notes):'')+
      '<div style="display:flex;gap:7px;margin-top:12px"><button class="fbi-payroll-mini-btn" type="button" id="fbiPayrollProfileEdit">Edit</button></div></div>';
    q('fbiPayrollProfileEdit').onclick=function(){showWorkerForm(w);};
  }
  function profileRow(k,v){return '<div class="fbi-payroll-profile-row"><span>'+esc(k)+'</span><b>'+esc(v)+'</b></div>';}

  function renderWorkers(){
    var el=q('fbiPayrollWorkersTable');if(!el)return;
    if(!STATE.workers.length){el.innerHTML='<div class="fbi-payroll-empty">No workers yet. Add your first worker to start Payroll.</div>';return;}
    el.innerHTML='<div class="fbi-payroll-table-wrap"><table class="fbi-payroll-table"><thead><tr><th>Name</th><th>Worker Type</th><th>Department</th><th>Role</th><th>Payment</th><th>Status</th><th>Actions</th></tr></thead><tbody>'+
      STATE.workers.slice().sort(function(a,b){return String(a.name||'').localeCompare(String(b.name||''));}).map(function(w){
        var count=STATE.records.filter(function(r){return r.workerId===w.id;}).length;
        var pay=w.paymentMethod==='Mobile Money'?(w.momo||''):(w.paymentMethod==='Bank'?((w.bank||'')+' '+(w.accountNumber||'')):'Cash');
        return '<tr'+(selectedWorkerId===w.id?' style="background:rgba(189,27,99,.06)"':'')+'><td><b>'+esc(w.name)+'</b><span class="sub">'+esc(w.workerCode||'')+'</span></td>'+
          '<td>'+esc(w.workerType||'')+'</td><td>'+esc(w.department||'')+'</td><td>'+esc(w.role||'')+'<span class="sub">'+count+' payroll record'+(count===1?'':'s')+'</span></td>'+
          '<td>'+esc(w.paymentMethod||'')+'<span class="sub">'+esc(pay)+'</span></td><td>'+activeBadge(w.status||'Active')+'</td>'+
          '<td><div class="fbi-payroll-actions-cell"><button class="fbi-payroll-mini-btn" type="button" data-w-view="'+esc(w.id)+'">View</button><button class="fbi-payroll-mini-btn" type="button" data-w-edit="'+esc(w.id)+'">Edit</button><button class="fbi-payroll-mini-btn danger" type="button" data-w-delete="'+esc(w.id)+'">Delete</button></div></td></tr>';
      }).join('')+'</tbody></table></div>';
    el.querySelectorAll('[data-w-view]').forEach(function(b){b.onclick=function(){selectedWorkerId=b.dataset.wView;renderAll();};});
    el.querySelectorAll('[data-w-edit]').forEach(function(b){b.onclick=function(){showWorkerForm(getWorker(b.dataset.wEdit));};});
    el.querySelectorAll('[data-w-delete]').forEach(function(b){b.onclick=function(){deleteWorker(b.dataset.wDelete);};});
  }
  function activeBadge(s){return '<span class="fbi-payroll-badge '+(s==='Active'?'active':'inactive')+'">'+esc(s)+'</span>';}
  function deleteWorker(idv){
    if(STATE.records.some(function(r){return r.workerId===idv;})){alert('This worker has payroll records. Set the worker to Inactive instead of deleting the profile.');return;}
    if(!confirm('Delete this worker profile?'))return;
    STATE.workers=STATE.workers.filter(function(w){return w.id!==idv;});
    if(selectedWorkerId===idv)selectedWorkerId='';
    saveState();renderAll();
  }

  function showRecordForm(existing){
    tabs('records');
    editingRecordId=existing?existing.id:'';
    var r=normalizeRecord(existing||{});
    var inv=selectedInvoice(r.invoiceId);
    var defaultProject=r.project|| (inv?((inv.no||'')+' · '+(inv.client||'')):'');
    var defaultDate=r.workDate|| (inv?(inv.eventDate||inv.date||today()):today());
    q('fbiPayrollRecordFormWrap').innerHTML=
      '<div class="fbi-payroll-card" style="margin-bottom:12px">'+
      '<div class="fbi-payroll-section-head"><div><h3>'+(existing?'Edit Payroll Record':'New Payroll Record')+'</h3><p>Individual worker earnings for an event, day, installation or other work.</p></div></div>'+
      '<div class="fbi-payroll-info">The Invoice / Job link below is read-only. Selecting an invoice only references it; Payroll never edits or saves anything into the invoice record.</div>'+
      '<div class="fbi-payroll-form">'+
        '<div class="fbi-payroll-field full"><label>Linked Invoice / Job</label><select id="prInvoice">'+invoiceOptions(r.invoiceId)+'</select></div>'+
        '<div class="fbi-payroll-field"><label>Worker</label><select id="prWorker">'+workerSelectOptions(r.workerId)+'</select></div>'+
        field('Project / Event','prProject',defaultProject,'text','Project or event')+
        field('Work Date','prDate',defaultDate,'date','')+
        selectField('Pay Basis','prBasis',['Per Event','Per Day','Per Installation','Other'],r.basis||'Per Event')+
        field('Role / Work Description','prRole',r.role||'','text','Work performed',true)+
        field('Rate','prRate',r.rate||0,'number','0.00')+
        field('Quantity','prQty',r.qty||1,'number','1')+
        field('Transport Allowance','prTransport',r.transport||0,'number','0.00')+
        field('Feeding Allowance','prFeeding',r.feeding||0,'number','0.00')+
        field('Accommodation','prAccommodation',r.accommodation||0,'number','0.00')+
        field('Overtime','prOvertime',r.overtime||0,'number','0.00')+
        field('Other Allowance','prOtherAllowance',r.otherAllowance||0,'number','0.00')+
        field('General Allowance','prAllowance',r.allowance||0,'number','0.00')+
        field('Bonus','prBonus',r.bonus||0,'number','0.00')+
        field('Deductions','prDeduction',r.deduction||0,'number','0.00')+
        field('Advance','prAdvance',r.advance||0,'number','0.00')+
        field('Previous Balance Owed','prPreviousBalance',r.previousBalance||0,'number','0.00')+
        field('Notes','prNotes',r.notes||'','text','Additional notes',true)+
      '</div>'+
      '<div class="fbi-payroll-summary">'+
        '<div class="fbi-payroll-summary-item"><span>Base Pay</span><b id="prBase">GHS₵0.00</b></div>'+
        '<div class="fbi-payroll-summary-item"><span>Allowances + Bonus</span><b id="prAllowances">GHS₵0.00</b></div>'+
        '<div class="fbi-payroll-summary-item"><span>Gross Pay</span><b id="prGross">GHS₵0.00</b></div>'+
        '<div class="fbi-payroll-summary-item"><span>Deductions</span><b id="prDeductions">GHS₵0.00</b></div>'+
        '<div class="fbi-payroll-summary-item"><span>Net Pay</span><b id="prNet">GHS₵0.00</b></div>'+
        '<div class="fbi-payroll-summary-item"><span>Status</span><b id="prStatus">Pending</b></div>'+
      '</div>'+
      '<div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px"><button class="btn" type="button" id="prCancel">Cancel</button><button class="btn primary" type="button" id="prSave">Save Payroll Record</button></div>'+
      '</div>';
    ['prRate','prQty','prTransport','prFeeding','prAccommodation','prOvertime','prOtherAllowance','prAllowance','prBonus','prDeduction','prAdvance','prPreviousBalance'].forEach(function(idv){q(idv).addEventListener('input',previewRecord);});
    q('prInvoice').addEventListener('change',function(){
      var ix=selectedInvoice(this.value);
      if(ix){
        if(!q('prProject').value)q('prProject').value=(ix.no||'Invoice')+' · '+(ix.client||'');
        if(q('prDate').value===today()&&ix.eventDate)q('prDate').value=ix.eventDate;
        if(!q('prRole').value&&ix.serviceCategory)q('prRole').value=ix.serviceCategory;
      }
    });
    q('prSave').onclick=saveRecord;
    q('prCancel').onclick=function(){editingRecordId='';q('fbiPayrollRecordFormWrap').innerHTML='';renderAll();};
    previewRecord();
  }
  function previewRecord(){
    var r=formRecord();
    q('prBase').textContent=money(basePay(r));
    q('prAllowances').textContent=money(allowances(r));
    q('prGross').textContent=money(gross(r));
    q('prDeductions').textContent=money(num(r.deduction)+num(r.advance)-num(r.previousBalance));
    q('prNet').textContent=money(net(r));
    q('prStatus').textContent='Pending';
  }
  function formRecord(){
    return normalizeRecord({
      rate:num(q('prRate')?.value),qty:num(q('prQty')?.value)||1,
      transport:num(q('prTransport')?.value),feeding:num(q('prFeeding')?.value),accommodation:num(q('prAccommodation')?.value),
      overtime:num(q('prOvertime')?.value),otherAllowance:num(q('prOtherAllowance')?.value),allowance:num(q('prAllowance')?.value),bonus:num(q('prBonus')?.value),
      deduction:num(q('prDeduction')?.value),advance:num(q('prAdvance')?.value),previousBalance:num(q('prPreviousBalance')?.value)
    });
  }
  function saveRecord(){
    var wid=q('prWorker')?.value||'';
    if(!wid){alert('Select a worker.');return;}
    var existing=editingRecordId?STATE.records.find(function(x){return x.id===editingRecordId;}):null;
    var r=existing||{id:uid('payroll'),createdAt:new Date().toISOString(),payments:[]};
    r.workerId=wid;
    r.invoiceId=q('prInvoice')?.value||'';
    r.project=(q('prProject')?.value||'').trim();
    r.workDate=q('prDate')?.value||today();
    r.basis=q('prBasis')?.value||'Per Event';
    r.role=(q('prRole')?.value||'').trim();
    r.rate=num(q('prRate')?.value);
    r.qty=Math.max(1,num(q('prQty')?.value)||1);
    r.transport=num(q('prTransport')?.value);
    r.feeding=num(q('prFeeding')?.value);
    r.accommodation=num(q('prAccommodation')?.value);
    r.overtime=num(q('prOvertime')?.value);
    r.otherAllowance=num(q('prOtherAllowance')?.value);
    r.allowance=num(q('prAllowance')?.value);
    r.bonus=num(q('prBonus')?.value);
    r.deduction=num(q('prDeduction')?.value);
    r.advance=num(q('prAdvance')?.value);
    r.previousBalance=num(q('prPreviousBalance')?.value);
    r.notes=(q('prNotes')?.value||'').trim();
    normalizeRecord(r);
    var idx=STATE.records.findIndex(function(x){return x.id===r.id;});
    if(idx>=0)STATE.records[idx]=r;else STATE.records.push(r);
    if(saveState()){editingRecordId='';q('fbiPayrollRecordFormWrap').innerHTML='';renderAll();toastLocal(existing?'Payroll record updated':'Payroll record saved');}
  }

  function renderRecords(){
    var el=q('fbiPayrollRecordsTable');if(!el)return;
    if(!STATE.records.length){el.innerHTML='<div class="fbi-payroll-empty">No payroll records yet. Create a payroll record for a worker or project.</div>';return;}
    el.innerHTML='<div class="fbi-payroll-table-wrap"><table class="fbi-payroll-table"><thead><tr><th>Worker / Job</th><th>Work Date</th><th>Basis</th><th class="num">Gross</th><th class="num">Net</th><th class="num">Paid</th><th class="num">Balance</th><th>Status</th><th>Actions</th></tr></thead><tbody>'+
      STATE.records.slice().sort(function(a,b){return String(b.workDate||'').localeCompare(String(a.workDate||''));}).map(function(r){
        var w=getWorker(r.workerId),s=status(r),ix=selectedInvoice(r.invoiceId);
        return '<tr><td><b>'+esc(w?.name||'Unknown worker')+'</b><span class="sub">'+esc(ix?(ix.no||'Invoice')+' · '+(ix.client||''):r.project||'Independent work')+'</span></td>'+
          '<td>'+esc(r.workDate||'')+'</td><td>'+esc(r.basis||'')+'<span class="sub">'+esc(r.role||'')+'</span></td>'+
          '<td class="num">'+esc(money(gross(r)))+'</td><td class="num">'+esc(money(net(r)))+'</td><td class="num">'+esc(money(paid(r)))+'</td><td class="num">'+esc(money(balance(r)))+'</td>'+
          '<td>'+badge(s)+'</td><td><div class="fbi-payroll-actions-cell">'+
            (balance(r)>0.005?'<button class="fbi-payroll-mini-btn primary" type="button" data-pay="'+esc(r.id)+'">Pay</button>':'')+
            '<button class="fbi-payroll-mini-btn" type="button" data-slip="'+esc(r.id)+'">Payslip</button>'+
            '<button class="fbi-payroll-mini-btn" type="button" data-edit-r="'+esc(r.id)+'">Edit</button>'+
            '<button class="fbi-payroll-mini-btn danger" type="button" data-delete-r="'+esc(r.id)+'">Delete</button>'+
          '</div></td></tr>';
      }).join('')+'</tbody></table></div>';
    el.querySelectorAll('[data-pay]').forEach(function(b){b.onclick=function(){openPayment(b.dataset.pay);};});
    el.querySelectorAll('[data-slip]').forEach(function(b){b.onclick=function(){generatePayslip(b.dataset.slip,true);};});
    el.querySelectorAll('[data-edit-r]').forEach(function(b){b.onclick=function(){showRecordForm(STATE.records.find(function(r){return r.id===b.dataset.editR;}));};});
    el.querySelectorAll('[data-delete-r]').forEach(function(b){b.onclick=function(){deleteRecord(b.dataset.deleteR);};});
  }
  function deleteRecord(idv){
    if(!confirm('Delete this Payroll record?'))return;
    STATE.records=STATE.records.filter(function(r){return r.id!==idv;});
    STATE.payslips=STATE.payslips.filter(function(p){return p.recordId!==idv;});
    saveState();renderAll();toastLocal('Payroll record deleted');
  }

  function openPayment(idv){
    var r=STATE.records.find(function(x){return x.id===idv;});if(!r)return;
    paymentRecordId=idv;
    q('fbiPayrollPaymentBalance').textContent=money(balance(r));
    q('fbiPayrollPaymentAmount').value=balance(r).toFixed(2);
    q('fbiPayrollPaymentDate').value=today();
    var w=getWorker(r.workerId);
    q('fbiPayrollPaymentMethod').value=r.paymentMethod||w?.paymentMethod||'Mobile Money';
    q('fbiPayrollPaymentRef').value='';
    q('fbiPayrollPaymentBy').value='';
    q('fbiPayrollPaymentNotes').value='';
    q('fbiPayrollPaymentModal').classList.add('show');
    q('fbiPayrollPaymentModal').setAttribute('aria-hidden','false');
  }
  function closePayment(){paymentRecordId='';q('fbiPayrollPaymentModal').classList.remove('show');q('fbiPayrollPaymentModal').setAttribute('aria-hidden','true');}
  function savePayment(){
    var r=STATE.records.find(function(x){return x.id===paymentRecordId;});if(!r)return;
    var amount=num(q('fbiPayrollPaymentAmount').value),bal=balance(r);
    if(amount<=0||amount>bal+0.005){alert('Enter a payment amount up to '+money(bal)+'.');return;}
    var method=q('fbiPayrollPaymentMethod').value||'';
    var ref=(q('fbiPayrollPaymentRef').value||'').trim();
    var by=(q('fbiPayrollPaymentBy').value||'').trim();
    var note=(q('fbiPayrollPaymentNotes').value||'').trim();
    if(!ref){alert('Enter the transaction / payment reference.');return;}
    if(!by){alert('Enter who made the payment.');return;}
    r.payments=r.payments||[];
    r.payments.push({id:uid('payment'),date:q('fbiPayrollPaymentDate').value||today(),amount:amount,method:method,reference:ref,paidBy:by,notes:note});
    r.lastPaymentDate=q('fbiPayrollPaymentDate').value||today();
    r.lastPaymentMethod=method;
    r.lastPaymentReference=ref;
    r.lastPaidBy=by;
    saveState();closePayment();renderAll();toastLocal(status(r)==='Paid'?'Payroll fully paid':'Partial payroll payment recorded');
  }

  function renderOverview(){
    var rows=STATE.records.slice().sort(function(a,b){return String(b.workDate||"").localeCompare(String(a.workDate||""));});
    var now=new Date();
    var period=q("fbiPayrollOverviewPeriod")?q("fbiPayrollOverviewPeriod").value:"all";
    function inPeriod(r){
      if(period==="all")return true;
      var d=new Date((r.workDate||today())+"T00:00:00");
      if(Number.isNaN(d.getTime()))return false;
      if(period==="month")return d.getMonth()===now.getMonth()&&d.getFullYear()===now.getFullYear();
      var qNow=Math.floor(now.getMonth()/3),qDay=Math.floor(d.getMonth()/3);
      return qNow===qDay&&d.getFullYear()===now.getFullYear();
    }
    var scoped=rows.filter(inPeriod);
    var grossTotal=scoped.reduce(function(s,r){return s+gross(r);},0);
    var netTotal=scoped.reduce(function(s,r){return s+net(r);},0);
    var paidTotal=scoped.reduce(function(s,r){return s+paid(r);},0);
    var balTotal=scoped.reduce(function(s,r){return s+balance(r);},0);
    var activeWorkers=STATE.workers.filter(function(w){return (w.status||"Active")==="Active";}).length;
    var paidPct=netTotal>0?Math.max(0,Math.min(100,paidTotal/netTotal*100)):0;
    var pending=scoped.filter(function(r){return status(r)!=="Paid";}).length;

    function kpi(label,value,meta,cls){
      return "<div class='fbi-payroll-kpi "+cls+"'><span>"+esc(label)+"</span><b>"+esc(value)+"</b><small>"+esc(meta)+"</small></div>";
    }
    if(q("fbiPayrollDashboardKpis")){
      q("fbiPayrollDashboardKpis").innerHTML=
        kpi("Net Payroll",money(netTotal),scoped.length+" records","gold")+
        kpi("Paid",money(paidTotal),Math.round(paidPct)+"% settled","green")+
        kpi("Outstanding",money(balTotal),pending+" records still due","orange")+
        kpi("Active Workers",String(activeWorkers),STATE.workers.length+" total workers","blue")+
        kpi("Payroll Records",String(scoped.length),"work records in period","pink");
    }
    if(q("fbiPayrollOverviewPeriod")&&!q("fbiPayrollOverviewPeriod").dataset.bound){
      q("fbiPayrollOverviewPeriod").dataset.bound="1";
      q("fbiPayrollOverviewPeriod").addEventListener("change",renderOverview);
    }

    var monthNames=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"],months=[];
    for(var i=5;i>=0;i--){
      var md=new Date(now.getFullYear(),now.getMonth()-i,1);
      months.push({key:md.getFullYear()+"-"+String(md.getMonth()+1).padStart(2,"0"),label:monthNames[md.getMonth()]});
    }
    var mvals=months.map(function(m){
      var list=scoped.filter(function(r){return String(r.workDate||"").slice(0,7)===m.key;});
      return {label:m.label,net:list.reduce(function(s,r){return s+net(r);},0),paid:list.reduce(function(s,r){return s+paid(r);},0)};
    });
    var mx=Math.max(1,Math.max.apply(Math,mvals.map(function(x){return x.net;})));
    if(q("fbiPayrollChartRange"))q("fbiPayrollChartRange").textContent=period==="all"?"Last 6 months":period==="month"?"This month":"This quarter";
    if(q("fbiPayrollCashflowChart")){
      q("fbiPayrollCashflowChart").innerHTML=mvals.map(function(x){
        var nw=x.net/mx*100,pw=x.paid/mx*100;
        return "<div class='fbi-payroll-chart-row'><div class='fbi-payroll-chart-label'>"+esc(x.label)+"</div><div class='fbi-payroll-bars'><div class='fbi-payroll-bar-track'><div class='fbi-payroll-bar-fill net' style='width:"+nw.toFixed(1)+"%'></div></div><div class='fbi-payroll-bar-track'><div class='fbi-payroll-bar-fill paid' style='width:"+pw.toFixed(1)+"%'></div></div></div><div class='fbi-payroll-chart-value'>"+esc(money(x.net))+"</div></div>";
      }).join("");
    }

    var pctDeg=Math.round(paidPct*3.6);
    if(q("fbiPayrollHealth")){
      q("fbiPayrollHealth").innerHTML=
        "<div class='fbi-payroll-health'>"+
          "<div class='fbi-payroll-donut' style='background:conic-gradient(#43b977 0deg "+pctDeg+"deg,#dfe7e4 "+pctDeg+"deg 360deg)'><b>"+Math.round(paidPct)+"%</b></div>"+
          "<div class='fbi-payroll-health-copy'><b>"+esc(paidPct>=100?"Fully settled":paidPct>=70?"Healthy payment position":paidPct>0?"Payments in progress":"No payments yet")+"</b>"+
          "<small>"+esc(money(paidTotal))+" paid from "+esc(money(netTotal))+" net payroll.</small>"+
          "<div class='fbi-payroll-health-stats'>"+
            "<div class='fbi-payroll-health-stat'><span>Gross</span><b>"+esc(money(grossTotal))+"</b></div>"+
            "<div class='fbi-payroll-health-stat'><span>Outstanding</span><b>"+esc(money(balTotal))+"</b></div>"+
            "<div class='fbi-payroll-health-stat'><span>Pending / Partial</span><b>"+pending+"</b></div>"+
          "</div></div>"+
        "</div>";
    }

    var activity=[];
    scoped.forEach(function(r){
      var w=getWorker(r.workerId)||{};
      var ps=Array.isArray(r.payments)?r.payments:[];
      if(ps.length){
        ps.forEach(function(p){activity.push({type:"payment",date:p.date||r.workDate||"",name:w.name||"Unknown worker",meta:(r.project||r.role||"Payroll payment")+" · "+(p.method||""),amount:num(p.amount),recordId:r.id});});
      }else{
        activity.push({type:"work",date:r.workDate||"",name:w.name||"Unknown worker",meta:(r.project||r.role||"Payroll work")+" · "+(r.basis||""),amount:net(r),recordId:r.id});
      }
    });
    activity.sort(function(a,b){return String(b.date||"").localeCompare(String(a.date||""));});
    activity=activity.slice(0,7);
    if(q("fbiPayrollRecentActivity")){
      q("fbiPayrollRecentActivity").innerHTML=activity.length?activity.map(function(item){
        var initials=String(item.name||"W").trim().split(/\\s+/).slice(0,2).map(function(s){return s.charAt(0);}).join("").toUpperCase();
        return "<div class='fbi-payroll-list-row'><div class='fbi-payroll-avatar'>"+esc(initials||"W")+"</div><div class='grow'><b>"+esc(item.name)+"</b><small>"+esc(item.meta)+" · "+esc(item.date)+"</small></div><div class='fbi-payroll-list-amount'><b>"+esc(money(item.amount))+"</b><small>"+esc(item.type==="payment"?"Paid":"Net")+"</small></div></div>";
      }).join(""):"<div class='fbi-payroll-empty'>No payroll activity yet.</div>";
    }

    var dept={};
    scoped.forEach(function(r){
      var w=getWorker(r.workerId)||{},key=w.department||"Unassigned";
      dept[key]=(dept[key]||0)+net(r);
    });
    var depts=Object.keys(dept).sort(function(a,b){return dept[b]-dept[a];}).slice(0,6);
    var dmax=depts.length?Math.max.apply(Math,depts.map(function(k){return dept[k];})):1;
    if(q("fbiPayrollDepartments")){
      q("fbiPayrollDepartments").innerHTML=depts.length?depts.map(function(k){
        return "<div class='fbi-payroll-dept-row'><div><div class='fbi-payroll-dept-label'>"+esc(k)+"</div><div class='fbi-payroll-dept-bar'><div class='fbi-payroll-dept-fill' style='width:"+((dept[k]/dmax)*100).toFixed(1)+"%'></div></div></div><div class='fbi-payroll-chart-value'>"+esc(money(dept[k]))+"</div></div>";
      }).join(""):"<div class='fbi-payroll-empty'>Department totals will appear when payroll records exist.</div>";
    }

    var recent=rows.slice(0,10);
    if(q("fbiPayrollOverviewTable")){
      q("fbiPayrollOverviewTable").innerHTML=recent.length?
        "<div class='fbi-payroll-table-wrap'><table class='fbi-payroll-table'><thead><tr><th>Worker</th><th>Project / Event</th><th>Date</th><th class='num'>Net</th><th class='num'>Paid</th><th class='num'>Balance</th><th>Status</th></tr></thead><tbody>"+
        recent.map(function(r){
          var w=getWorker(r.workerId);
          return "<tr><td><b>"+esc(w&&w.name?w.name:"Unknown")+"</b><span class='sub'>"+esc(w&&w.role?w.role:"")+"</span></td><td>"+esc(r.project||r.role||"")+"</td><td>"+esc(r.workDate||"")+"</td><td class='num'>"+esc(money(net(r)))+"</td><td class='num'>"+esc(money(paid(r)))+"</td><td class='num'>"+esc(money(balance(r)))+"</td><td>"+badge(status(r))+"</td></tr>";
        }).join("")+
        "</tbody></table></div>":
        "<div class='fbi-payroll-empty'>No payroll activity yet. Create a worker and payroll record to populate the dashboard.</div>";
    }
  }
  function summary(k,v){return '<div class="fbi-payroll-summary-item"><span>'+esc(k)+'</span><b>'+esc(v)+'</b></div>';}

  function renderPayslips(){
    var el=q('fbiPayrollPayslipList');if(!el)return;
    if(!STATE.payslips.length){el.innerHTML='<div class="fbi-payroll-empty">No payslips generated yet. Generate a payslip from a Payroll Record after recording work or payment.</div>';return;}
    el.innerHTML='<div class="fbi-payroll-payslip-list">'+STATE.payslips.slice().sort(function(a,b){return String(b.generatedAt||'').localeCompare(String(a.generatedAt||''));}).map(function(p){
      var r=STATE.records.find(function(x){return x.id===p.recordId;}),w=r?getWorker(r.workerId):null;
      return '<div class="fbi-payroll-payslip-row"><div class="grow"><b>'+esc(p.payslipNo||'Payslip')+' · '+esc(w?.name||'Worker')+'</b><small>'+esc(r?.project||r?.role||'')+' · '+esc(r?.workDate||'')+' · '+esc(r?status(r):'')+'</small></div><strong>'+esc(money(r?net(r):0))+'</strong><button class="fbi-payroll-mini-btn" type="button" data-ps="'+esc(p.recordId)+'">Print</button></div>';
    }).join('')+'</div>';
    el.querySelectorAll('[data-ps]').forEach(function(b){b.onclick=function(){generatePayslip(b.dataset.ps,true);};});
  }
  function generatePayslip(recordId,printNow){
    var r=STATE.records.find(function(x){return x.id===recordId;});if(!r)return;
    var w=getWorker(r.workerId)||{},ix=selectedInvoice(r.invoiceId);
    var p=STATE.payslips.find(function(x){return x.recordId===recordId;});
    if(!p){p={id:uid('payslip'),recordId:recordId,payslipNo:'PAY'+String(STATE.payslips.length+1).padStart(4,'0'),generatedAt:new Date().toISOString()};STATE.payslips.push(p);saveState();}
    var last=r.payments&&r.payments.length?r.payments[r.payments.length-1]:null;
    var doc='<div class="paydoc"><div class="paydoc-head"><div><div class="kicker">FILM BEYOND IMAGINATION (FBI)</div><h1>PAYSLIP</h1><p>Professional Payroll Statement</p></div><div class="meta"><b>'+esc(p.payslipNo)+'</b><span>'+esc(r.workDate||'')+'</span></div></div>'+
      '<div class="grid">'+cell('Employee',w.name||'')+cell('Worker ID',w.workerCode||'')+cell('Role',w.role||'')+cell('Department',w.department||'')+cell('Worker Type',w.workerType||'')+cell('Payment Basis',r.basis||'')+cell('Project / Event',r.project||'')+cell('Linked Invoice',ix?(ix.no||''):'Independent work')+'</div>'+
      '<table><thead><tr><th>Description</th><th class="r">Amount</th></tr></thead><tbody>'+
      row('Rate × Quantity',basePay(r))+row('Transport Allowance',r.transport)+row('Feeding Allowance',r.feeding)+row('Accommodation',r.accommodation)+row('Overtime',r.overtime)+row('Other Allowance',r.otherAllowance)+row('General Allowance',r.allowance)+row('Bonus',r.bonus)+
      '<tr class="strong"><td>Gross Pay</td><td class="r">'+money(gross(r))+'</td></tr>'+
      row('Deductions',-num(r.deduction))+row('Advance',-num(r.advance))+row('Previous Balance Owed',num(r.previousBalance))+
      '<tr class="net"><td>NET PAY</td><td class="r">'+money(net(r))+'</td></tr>'+
      '</tbody></table>'+
      '<div class="payment-box"><div><span>Amount Paid</span><b>'+money(paid(r))+'</b></div><div><span>Balance</span><b>'+money(balance(r))+'</b></div><div><span>Status</span><b>'+esc(status(r))+'</b></div></div>'+
      (last?'<div class="payment-detail"><b>Latest Payment</b><p>'+esc(last.date||'')+' · '+esc(last.method||'')+' · Ref '+esc(last.reference||'')+' · Paid by '+esc(last.paidBy||'')+'</p></div>':'')+
      '<div class="footer">Worker payment method: '+esc(w.paymentMethod||'')+(w.momo?' · MoMo '+esc(w.momo):'')+(w.bank?' · Bank '+esc(w.bank):'')+'<br>Generated '+esc(new Date().toLocaleString())+'</div></div>';
    var win=window.open('','_blank');
    if(!win){alert('Please allow pop-ups to print the payslip.');return;}
    win.document.write('<!doctype html><html><head><meta charset="utf-8"><title>'+esc(p.payslipNo)+' - Payslip</title><style>'+
      'body{font-family:Arial,sans-serif;background:#f4f5f7;color:#1c222b;padding:24px}.paydoc{width:min(760px,100%);margin:auto;background:#fff;padding:30px;border:1px solid #dde2e8;border-radius:12px}.paydoc-head{display:flex;justify-content:space-between;border-bottom:2px solid #222;padding-bottom:16px}.kicker{font-size:9px;letter-spacing:1.5px;font-weight:800;color:#8b6b2b}.paydoc h1{font-size:28px;margin:6px 0 2px}.paydoc p{margin:0;color:#6d7682;font-size:10px}.meta{text-align:right}.meta b{display:block;font-size:18px}.meta span{display:block;font-size:10px;color:#6d7682;margin-top:5px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:18px 0}.cell{border:1px solid #e0e4e9;background:#fafbfc;border-radius:8px;padding:9px}.cell span{display:block;font-size:7.5px;text-transform:uppercase;letter-spacing:.6px;color:#7f8792}.cell b{display:block;font-size:10px;margin-top:4px}.paydoc table{width:100%;border-collapse:collapse;margin-top:12px}.paydoc th{background:#151a21;color:#fff;padding:9px;text-align:left;font-size:8px;text-transform:uppercase}.paydoc td{border-bottom:1px solid #e6e9ed;padding:8px;font-size:9px}.r{text-align:right}.strong td{font-weight:800}.net td{background:#151a21;color:#fff;font-weight:900;font-size:12px}.payment-box{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:16px}.payment-box div{border:1px solid #e0e4e9;border-radius:8px;padding:10px}.payment-box span{display:block;font-size:7.5px;text-transform:uppercase;color:#7f8792}.payment-box b{display:block;font-size:13px;margin-top:4px}.payment-detail{margin-top:13px;padding:10px;border-left:3px solid #b48b2f;background:#fff9e7;font-size:9px}.footer{margin-top:22px;padding-top:11px;border-top:1px solid #e0e4e9;color:#707985;font-size:8px;line-height:1.5}@media print{body{background:#fff;padding:0}.paydoc{border:0;border-radius:0;width:100%;padding:0}}\n    </style></head><body>'+doc+'<script>window.onload=function(){window.print()}<\\/script></body></html>');
    win.document.close();
    tabs('payslips');
    toastLocal('Payslip '+p.payslipNo+' generated');
  }
  function cell(k,v){return '<div class="cell"><span>'+esc(k)+'</span><b>'+esc(v)+'</b></div>';}
  function row(k,v){return '<tr><td>'+esc(k)+'</td><td class="r">'+money(v)+'</td></tr>';}

  function reportRows(){
    var from=q('fbiPayrollReportFrom')?.value||'',to=q('fbiPayrollReportTo')?.value||'',wid=q('fbiPayrollReportWorker')?.value||'',dept=q('fbiPayrollReportDepartment')?.value||'',project=(q('fbiPayrollReportProject')?.value||'').trim().toLowerCase(),st=q('fbiPayrollReportStatus')?.value||'';
    return STATE.records.filter(function(r){
      var w=getWorker(r.workerId)||{},d=String(r.workDate||'').slice(0,10);
      if(from&&(!d||d<from))return false;if(to&&(!d||d>to))return false;if(wid&&r.workerId!==wid)return false;if(dept&&String(w.department||'')!==dept)return false;
      if(project&&!String(r.project||'').toLowerCase().includes(project))return false;if(st&&status(r)!==st)return false;return true;
    }).sort(function(a,b){return String(b.workDate||'').localeCompare(String(a.workDate||''));});
  }
  function fillReportWorker(){
    var s=q('fbiPayrollReportWorker');if(!s)return;var current=s.value;
    s.innerHTML='<option value="">All Workers</option>'+STATE.workers.slice().sort(function(a,b){return String(a.name||'').localeCompare(String(b.name||''));}).map(function(w){return '<option value="'+esc(w.id)+'">'+esc(w.name)+'</option>';}).join('');
    if(STATE.workers.some(function(w){return w.id===current}))s.value=current;
  }
  function renderReports(){
    fillReportWorker();
    var rows=reportRows(),netTotal=rows.reduce(function(s,r){return s+net(r);},0),paidTotal=rows.reduce(function(s,r){return s+paid(r);},0),balTotal=rows.reduce(function(s,r){return s+balance(r);},0),grossTotal=rows.reduce(function(s,r){return s+gross(r);},0);
    q('fbiPayrollReportSummary').innerHTML=summary('Records',rows.length)+summary('Gross',money(grossTotal))+summary('Net Pay',money(netTotal))+summary('Paid',money(paidTotal))+summary('Outstanding',money(balTotal));
    var el=q('fbiPayrollReportTable');if(!rows.length){el.innerHTML='<div class="fbi-payroll-empty">No payroll records match these filters.</div>';return;}
    el.innerHTML='<div class="fbi-payroll-table-wrap"><table class="fbi-payroll-table"><thead><tr><th>Worker</th><th>Department</th><th>Project / Event</th><th>Date</th><th>Basis</th><th class="num">Rate</th><th class="num">Qty</th><th class="num">Net</th><th class="num">Paid</th><th class="num">Balance</th><th>Status</th><th>Payment Ref</th></tr></thead><tbody>'+
      rows.map(function(r){var w=getWorker(r.workerId),last=r.payments&&r.payments.length?r.payments[r.payments.length-1]:null;return '<tr><td>'+esc(w?.name||'Unknown')+'</td><td>'+esc(w?.department||'')+'</td><td>'+esc(r.project||r.role||'')+'</td><td>'+esc(r.workDate||'')+'</td><td>'+esc(r.basis||'')+'</td><td class="num">'+esc(money(r.rate))+'</td><td class="num">'+esc(r.qty)+'</td><td class="num">'+esc(money(net(r)))+'</td><td class="num">'+esc(money(paid(r)))+'</td><td class="num">'+esc(money(balance(r)))+'</td><td>'+badge(status(r))+'</td><td>'+esc(last?.reference||'')+'</td></tr>';}).join('')+
      '</tbody></table></div>';
  }
  function exportCsv(){
    var rows=reportRows(),headers=['Worker','Worker ID','Department','Worker Type','Project/Event','Linked Invoice','Work Date','Pay Basis','Role','Rate','Quantity','Gross Pay','Net Pay','Paid','Balance','Status','Last Payment Date','Payment Method','Payment Reference','Paid By'];
    var lines=[headers].concat(rows.map(function(r){var w=getWorker(r.workerId)||{},ix=selectedInvoice(r.invoiceId),last=r.payments&&r.payments.length?r.payments[r.payments.length-1]:null;return [w.name||'',w.workerCode||'',w.department||'',w.workerType||'',r.project||'',ix?.no||'',r.workDate||'',r.basis||'',r.role||'',r.rate||0,r.qty||1,gross(r),net(r),paid(r),balance(r),status(r),last?.date||'',last?.method||'',last?.reference||'',last?.paidBy||''];}));
    var csv=lines.map(function(row){return row.map(function(v){return '"'+String(v==null?'':v).replace(/"/g,'""')+'"';}).join(',');}).join('\\n');
    var blob=new Blob([csv],{type:'text/csv;charset=utf-8'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='FBI-Payroll-'+today()+'.csv';document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(a.href);a.remove();},1000);
  }
  function printReport(){
    var rows=reportRows(),grossTotal=rows.reduce(function(s,r){return s+gross(r);},0),netTotal=rows.reduce(function(s,r){return s+net(r);},0),paidTotal=rows.reduce(function(s,r){return s+paid(r);},0),balTotal=rows.reduce(function(s,r){return s+balance(r);},0);
    var table=rows.map(function(r){var w=getWorker(r.workerId);return '<tr><td>'+esc(w?.name||'')+'</td><td>'+esc(w?.department||'')+'</td><td>'+esc(r.project||'')+'</td><td>'+esc(r.workDate||'')+'</td><td>'+esc(r.basis||'')+'</td><td class="r">'+esc(money(net(r)))+'</td><td class="r">'+esc(money(paid(r)))+'</td><td class="r">'+esc(money(balance(r)))+'</td><td>'+esc(status(r))+'</td></tr>';}).join('');
    var html='<h1>FBI Payroll Report</h1><p>Generated '+esc(new Date().toLocaleString())+' · '+rows.length+' records</p><div class="cards"><div><span>Gross</span><b>'+esc(money(grossTotal))+'</b></div><div><span>Net</span><b>'+esc(money(netTotal))+'</b></div><div><span>Paid</span><b>'+esc(money(paidTotal))+'</b></div><div><span>Outstanding</span><b>'+esc(money(balTotal))+'</b></div></div><table><thead><tr><th>Worker</th><th>Department</th><th>Project/Event</th><th>Date</th><th>Basis</th><th>Net</th><th>Paid</th><th>Balance</th><th>Status</th></tr></thead><tbody>'+table+'</tbody></table>';
    var win=window.open('','_blank');if(!win){alert('Please allow pop-ups to print the Payroll report.');return;}
    win.document.write('<!doctype html><html><head><meta charset="utf-8"><title>FBI Payroll Report</title><style>body{font-family:Arial,sans-serif;padding:28px;color:#1b1f27}h1{margin:0 0 5px}p{color:#69717d;font-size:10px}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0}.cards div{border:1px solid #ddd;border-radius:8px;padding:10px}.cards span{display:block;color:#777;font-size:8px;text-transform:uppercase}.cards b{display:block;font-size:15px;margin-top:5px}table{width:100%;border-collapse:collapse}th,td{border:1px solid #ddd;padding:7px;font-size:8px;text-align:left}th{background:#151a21;color:#fff}.r{text-align:right}@media print{body{padding:0}}</style></head><body>'+html+'<script>window.onload=function(){window.print()}<\\/script></body></html>');
    win.document.close();
  }

  function renderStats(){
    var active=STATE.workers.filter(function(w){return (w.status||'Active')==='Active';}).length;
    q('fbiPayrollWorkerCount').textContent=String(STATE.workers.length);q('fbiPayrollWorkerMeta').textContent='Active '+active;
    q('fbiPayrollRecordCount').textContent=String(STATE.records.length);q('fbiPayrollRecordMeta').textContent='All work records';
    var netTotal=STATE.records.reduce(function(s,r){return s+net(r);},0),paidTotal=STATE.records.reduce(function(s,r){return s+paid(r);},0),balTotal=STATE.records.reduce(function(s,r){return s+balance(r);},0);
    q('fbiPayrollNetTotal').textContent=money(netTotal);q('fbiPayrollPaidTotal').textContent=money(paidTotal);q('fbiPayrollBalanceTotal').textContent=money(balTotal);
    q('fbiPayrollNetMeta').textContent=STATE.records.filter(function(r){return status(r)==='Paid';}).length+' fully paid records';
    q('fbiPayrollPaidMeta').textContent=STATE.records.filter(function(r){return paid(r)>0;}).length+' records with payments';
    q('fbiPayrollBalanceMeta').textContent=STATE.records.filter(function(r){return balance(r)>0.005;}).length+' records still due';
  }

  function renderAll(){
    renderStats();
    renderOverview();
    renderWorkerProfile();
    renderWorkers();
    renderRecords();
    renderPayslips();
    renderReports();
  }

  function printOverview(){
    document.body.classList.add('fbi-payroll-printing');
    window.print();
    setTimeout(function(){document.body.classList.remove('fbi-payroll-printing');},500);
  }

  function deactivate(){
    var root=q('fbiPayrollView');
    if(root)root.classList.remove('active','fbi-payroll-active','print-view');
    document.body.classList.remove('fbi-payroll-mode');
  }
  function activate(){
    var root=q('fbiPayrollView');if(!root)return;
    document.body.classList.add('fbi-payroll-mode');
    var top=q('top');
    if(top&&top.parentNode&&root.parentNode!==top.parentNode)top.parentNode.insertBefore(root,top.nextSibling);
    document.querySelectorAll('.view').forEach(function(v){v.classList.remove('active','print-view');});
    root.classList.add('active','fbi-payroll-active');
    document.querySelectorAll('.nav button').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-v')==='payroll');});
    q('title').textContent='Payroll';q('subtitle').textContent='Staff, earnings, payments and payslips';
    if(q('side'))q('side').classList.remove('open');
    renderAll();
  }
  function installNav(){
    var nav=document.querySelector('.nav');
    if(nav&&!nav.querySelector('[data-v="payroll"]')){
      var b=document.createElement('button');b.type='button';b.className='nav-link';b.dataset.v='payroll';b.textContent='💰 Payroll';b.onclick=function(e){e.preventDefault();activate();};nav.insertBefore(b,nav.querySelector('[data-v="settings"]')||null);
    }
    var oldNav=window.__FBI_NAV__;
    window.__FBI_NAV__=function(v){if(v==='payroll'){activate();return false;}deactivate();return typeof oldNav==='function'?oldNav(v):false;};
    window.__FBI_PAYROLL_OPEN__=activate;
    window.addEventListener('hashchange',function(){if(location.hash==='#payroll')activate();else deactivate();});
  }
  function init(){
    loadState();installNav();
    document.querySelectorAll('[data-payroll-tab]').forEach(function(b){b.onclick=function(){tabs(b.getAttribute('data-payroll-tab'));};});
    q('fbiPayrollQuickWorker').onclick=function(){showWorkerForm();};
    q('fbiPayrollWorkersAdd').onclick=function(){showWorkerForm();};
    q('fbiPayrollQuickRecord').onclick=function(){showRecordForm();};
    q('fbiPayrollRecordsAdd').onclick=function(){showRecordForm();};
    q('fbiPayrollOverviewPrint').onclick=printOverview;
    q('fbiPayrollReportCsv').onclick=exportCsv;
    q('fbiPayrollReportPrint').onclick=printReport;
    q('fbiPayrollReportReset').onclick=function(){q('fbiPayrollReportFrom').value='';q('fbiPayrollReportTo').value='';q('fbiPayrollReportWorker').value='';q('fbiPayrollReportDepartment').value='';q('fbiPayrollReportProject').value='';q('fbiPayrollReportStatus').value='';renderReports();};
    ['fbiPayrollReportFrom','fbiPayrollReportTo','fbiPayrollReportWorker','fbiPayrollReportDepartment','fbiPayrollReportProject','fbiPayrollReportStatus'].forEach(function(idv){q(idv).addEventListener('input',renderReports);q(idv).addEventListener('change',renderReports);});
    q('fbiPayrollPaymentClose').onclick=closePayment;q('fbiPayrollPaymentCancel').onclick=closePayment;q('fbiPayrollPaymentSave').onclick=savePayment;
    q('fbiPayrollPaymentModal').addEventListener('click',function(e){if(e.target===this)closePayment();});
    renderAll();
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
  window.FBIPayrollModule={open:activate,close:deactivate,reload:function(){loadState();renderAll();}};
})();
</script>