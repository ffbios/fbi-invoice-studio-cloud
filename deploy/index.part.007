<style id="fbi-payroll-module-style">
/* ===== FBI PAYROLL MODULE, ISOLATED FROM INVOICE ENGINE ===== */
#fbiPayrollView{display:none;width:100%;max-width:none;margin:0;padding:0 0 40px;position:relative}
#fbiPayrollView.fbi-payroll-active{display:block}
.top>div:last-child{display:flex;align-items:center;gap:7px;flex-wrap:wrap;justify-content:flex-end;margin-left:auto}
.top>div:last-child .theme-switcher{order:999;flex:0 0 auto;margin-left:6px}
@media(max-width:700px){
  .top>div:last-child{width:auto;max-width:100%;justify-content:flex-end}
  .top>div:last-child .theme-switcher{margin-left:4px}
}
.fbi-payroll-shell{width:100%;max-width:1500px;margin:0 auto}
.fbi-payroll-hero{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;padding:20px 0 14px;flex-wrap:wrap}
.fbi-payroll-kicker{font-size:9px;text-transform:uppercase;letter-spacing:1.8px;color:#b48b2f;font-weight:900;margin-bottom:6px}
.fbi-payroll-hero h2{margin:0;font-size:22px;letter-spacing:-.35px}
.fbi-payroll-hero p{margin:6px 0 0;color:#7f8897;font-size:10px}
.fbi-payroll-actions{display:flex;gap:8px;flex-wrap:wrap}
.fbi-payroll-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:11px;margin-bottom:14px}
.fbi-payroll-stat{background:linear-gradient(180deg,#171b23,#13161d);border:1px solid #2b303c;border-radius:12px;padding:14px;min-height:88px}
.fbi-payroll-stat span{display:block;color:#858e9f;font-size:8px;text-transform:uppercase;letter-spacing:1px;font-weight:900}
.fbi-payroll-stat b{display:block;color:#f7f8fb;font-size:19px;margin-top:8px}
.fbi-payroll-stat small{display:block;color:#687180;font-size:8px;margin-top:4px}
.fbi-payroll-card{background:linear-gradient(180deg,#171b23,#13161d);border:1px solid #2b303c;border-radius:12px;padding:16px;margin-bottom:14px}
.fbi-payroll-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}
.fbi-payroll-tab{border:1px solid #343a48;background:#131720;color:#9aa3b1;border-radius:8px;padding:9px 12px;font-size:10px;font-weight:850;cursor:pointer}
.fbi-payroll-tab.active{background:#23151d;color:#fff;border-color:#bd1b63;box-shadow:inset 0 0 0 1px rgba(255,255,255,.05)}
.fbi-payroll-panel{display:none}.fbi-payroll-panel.active{display:block}
.fbi-payroll-section-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;margin-bottom:12px}
.fbi-payroll-section-head h3{margin:0;color:#e8ebf0;font-size:13px}
.fbi-payroll-section-head p{margin:4px 0 0;color:#7f8897;font-size:9px}
.fbi-payroll-form{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.fbi-payroll-field{min-width:0}.fbi-payroll-field.full{grid-column:1/-1}.fbi-payroll-field.half{grid-column:span 2}
.fbi-payroll-field label{display:block;margin:0 0 5px;color:#8f98a7;font-size:8px;text-transform:uppercase;letter-spacing:.7px;font-weight:850}
.fbi-payroll-field input,.fbi-payroll-field select,.fbi-payroll-field textarea{width:100%;box-sizing:border-box;border:1px solid #303744;background:#0d1016;color:#eef1f5;border-radius:8px;padding:9px 10px;font-size:10px;outline:none}
.fbi-payroll-field textarea{min-height:76px;resize:vertical}
.fbi-payroll-field input:focus,.fbi-payroll-field select:focus,.fbi-payroll-field textarea:focus{border-color:#b48b2f;box-shadow:0 0 0 3px rgba(180,139,47,.08)}
.fbi-payroll-info{padding:10px 12px;border:1px solid #303745;border-radius:9px;background:#0f1218;color:#8992a2;font-size:9px;line-height:1.5;margin-bottom:12px}
.fbi-payroll-summary{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin:13px 0}
.fbi-payroll-summary-item{border:1px solid #2b303b;background:#0f1218;border-radius:9px;padding:10px}
.fbi-payroll-summary-item span{display:block;color:#7f8897;font-size:7.5px;text-transform:uppercase;letter-spacing:.6px}
.fbi-payroll-summary-item b{display:block;color:#f4f6fa;font-size:12px;margin-top:5px}
.fbi-payroll-table-wrap{overflow:auto;border:1px solid #2b303c;border-radius:10px}
.fbi-payroll-table{width:100%;border-collapse:collapse;min-width:980px}
.fbi-payroll-table th{padding:9px 10px;background:#10131a;color:#858e9f;text-transform:uppercase;letter-spacing:.65px;font-size:7.5px;text-align:left}
.fbi-payroll-table td{padding:10px;border-top:1px solid #252b35;color:#dce1e9;font-size:9px;vertical-align:top}
.fbi-payroll-table .num{text-align:right}
.fbi-payroll-table .sub{display:block;color:#737d8d;font-size:8px;margin-top:3px}
.fbi-payroll-badge{display:inline-flex;align-items:center;padding:4px 8px;border-radius:999px;font-size:7.5px;font-weight:900;white-space:nowrap;background:#252b34;color:#c0c7d1}
.fbi-payroll-badge.paid{background:#163126;color:#66e7a6}.fbi-payroll-badge.partial{background:#382b13;color:#f2c15d}.fbi-payroll-badge.pending{background:#17283b;color:#72b8ff}
.fbi-payroll-badge.active{background:#172f28;color:#71dfab}.fbi-payroll-badge.inactive{background:#2a2e35;color:#959daa}
.fbi-payroll-empty{padding:30px;text-align:center;color:#778191;border:1px dashed #303745;border-radius:10px;font-size:10px}
.fbi-payroll-actions-cell{display:flex;gap:6px;flex-wrap:wrap}
.fbi-payroll-mini-btn{border:1px solid #353b49;background:#151921;color:#e7eaf0;border-radius:7px;padding:6px 8px;font-size:8px;font-weight:850;cursor:pointer}
.fbi-payroll-mini-btn.primary{background:#82103f;border-color:#ae1b5b}.fbi-payroll-mini-btn.danger{color:#ff9eaa;border-color:#512a35;background:#29161d}
.fbi-payroll-worker-layout{display:grid;grid-template-columns:minmax(300px,.85fr) minmax(0,1.5fr);gap:12px}
.fbi-payroll-profile{border:1px solid #2b303c;background:#0f1218;border-radius:10px;padding:14px}
.fbi-payroll-profile h4{margin:0 0 10px;font-size:11px}
.fbi-payroll-profile-row{display:grid;grid-template-columns:110px 1fr;gap:8px;padding:7px 0;border-bottom:1px solid #252b34;font-size:9px}
.fbi-payroll-profile-row span{color:#7f8897}.fbi-payroll-profile-row b{color:#e6eaf0;font-weight:750}
.fbi-payroll-modal{position:fixed;inset:0;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(0,0,0,.72);backdrop-filter:blur(5px);z-index:250}
.fbi-payroll-modal.show{display:flex}
.fbi-payroll-dialog{width:min(760px,96vw);max-height:92vh;overflow:auto;background:#11141b;border:1px solid #343a48;border-radius:14px;box-shadow:0 30px 90px #000b}
.fbi-payroll-dialog-head{position:sticky;top:0;z-index:2;padding:15px 17px;background:#11141bf7;border-bottom:1px solid #2b303c;display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.fbi-payroll-dialog-head h3{margin:0;font-size:13px;color:#fff}.fbi-payroll-dialog-head small{display:block;color:#7f8897;font-size:8px;margin-top:4px}
.fbi-payroll-dialog-body{padding:17px}
.fbi-payroll-pay-balance{padding:13px;background:#0e1218;border:1px solid #313846;border-radius:9px;margin-bottom:13px}
.fbi-payroll-pay-balance span{color:#7f8897;font-size:8px;text-transform:uppercase;letter-spacing:.7px}.fbi-payroll-pay-balance b{display:block;font-size:18px;margin-top:5px}
.fbi-payroll-report-summary{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin:12px 0}
.fbi-payroll-report-summary div{border:1px solid #2b303b;background:#0f1218;border-radius:9px;padding:10px}.fbi-payroll-report-summary span{display:block;color:#7f8897;font-size:7.5px;text-transform:uppercase}.fbi-payroll-report-summary b{display:block;font-size:12px;margin-top:4px}
.fbi-payroll-payslip-list{display:grid;gap:8px}
.fbi-payroll-payslip-row{display:flex;align-items:center;gap:10px;padding:11px;border:1px solid #2b303b;background:#0f1218;border-radius:9px}
.fbi-payroll-payslip-row .grow{flex:1;min-width:0}.fbi-payroll-payslip-row b{font-size:10px}.fbi-payroll-payslip-row small{display:block;color:#798291;font-size:8px;margin-top:3px}
@media(max-width:1180px){.fbi-payroll-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.fbi-payroll-worker-layout{grid-template-columns:1fr}.fbi-payroll-form{grid-template-columns:repeat(2,minmax(0,1fr))}.fbi-payroll-summary{grid-template-columns:repeat(3,minmax(0,1fr))}.fbi-payroll-report-summary{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:760px){.fbi-payroll-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.fbi-payroll-hero{padding-top:16px}.fbi-payroll-hero h2{font-size:19px}.fbi-payroll-form{grid-template-columns:1fr}.fbi-payroll-field.half{grid-column:1}.fbi-payroll-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.fbi-payroll-report-summary{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.fbi-payroll-grid,.fbi-payroll-summary,.fbi-payroll-report-summary{grid-template-columns:1fr}.fbi-payroll-card{padding:12px}.fbi-payroll-actions{width:100%}.fbi-payroll-actions .btn{flex:1}.fbi-payroll-dialog-body{padding:13px}}
@media print{
  body.fbi-payroll-printing{background:#fff!important;display:block!important;color:#111!important}
  body.fbi-payroll-printing .side,body.fbi-payroll-printing .top,body.fbi-payroll-printing .view:not(#fbiPayrollView){display:none!important}
  body.fbi-payroll-printing #fbiPayrollView{display:block!important;padding:0!important}
  body.fbi-payroll-printing .fbi-payroll-hero,body.fbi-payroll-printing .fbi-payroll-tabs,body.fbi-payroll-printing .fbi-payroll-actions{display:none!important}
  body.fbi-payroll-printing .fbi-payroll-card{background:#fff!important;border:0!important;padding:0!important}
  body.fbi-payroll-printing .fbi-payroll-table-wrap{border:0}.fbi-payroll-table{min-width:0}.fbi-payroll-table th,.fbi-payroll-table td{font-size:8px;padding:6px}
}

/* ===== PAYROLL UI POLISH V3 ===== */
/* Visual-only Payroll refresh. Invoice engine/state remain untouched. */
:root{
  --pay-bg:#0b0e13;--pay-surface:#11161e;--pay-surface-2:#151b24;--pay-border:#2a3340;--pay-text:#eef2f7;--pay-muted:#8792a3;--pay-gold:#d7b15a;--pay-pink:#bd1b63;--pay-shadow:0 16px 44px rgba(0,0,0,.20)
}
body.fbi-payroll-mode{background:radial-gradient(900px 460px at 78% -10%,rgba(215,177,90,.08),transparent 60%),radial-gradient(760px 500px at 2% 100%,rgba(189,27,99,.055),transparent 62%),var(--bg)}
body.fbi-payroll-mode .top{z-index:120;overflow:visible}
body.fbi-payroll-mode .top>div:first-child{min-width:0;flex:1 1 auto}
body.fbi-payroll-mode .top>div:last-child{
  flex:0 0 auto!important;display:flex!important;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:nowrap!important;margin-left:auto;width:auto!important;max-width:none!important;padding-right:150px
}
body.fbi-payroll-mode .top .theme-switcher{
  position:absolute!important;right:24px;top:50%;transform:translateY(-50%);z-index:140;margin:0!important;order:0!important;flex:0 0 auto!important
}
body.fbi-payroll-mode .top .theme-choice{white-space:nowrap}
body.fbi-payroll-mode #fbiPayrollView{padding:24px 28px 52px;max-width:none;margin:0;width:100%;position:relative;z-index:1}
body.fbi-payroll-mode .fbi-payroll-shell{width:100%;max-width:1600px;margin:0 auto}
body.fbi-payroll-mode .fbi-payroll-hero{
  position:relative;display:flex;justify-content:space-between;align-items:flex-end;gap:24px;padding:22px 24px 20px;margin:0 0 14px;
  background:linear-gradient(135deg,rgba(20,25,34,.98),rgba(13,18,26,.98));border:1px solid #293340;border-radius:16px;box-shadow:var(--pay-shadow);overflow:hidden
}
body.fbi-payroll-mode .fbi-payroll-hero:after{content:"";position:absolute;right:-80px;top:-95px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(215,177,90,.13),transparent 66%);pointer-events:none}
body.fbi-payroll-mode .fbi-payroll-kicker{color:var(--pay-gold);font-size:8px;letter-spacing:2.1px;margin-bottom:7px}
body.fbi-payroll-mode .fbi-payroll-hero h2{font-size:27px;line-height:1.05;letter-spacing:-.6px;color:#fff}
body.fbi-payroll-mode .fbi-payroll-hero p{font-size:10px;color:#98a3b3;margin-top:7px;max-width:660px;line-height:1.5}
body.fbi-payroll-mode .fbi-payroll-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
body.fbi-payroll-mode .fbi-payroll-hero>.fbi-payroll-actions{position:relative;z-index:2}
body.fbi-payroll-mode .fbi-payroll-hero .btn{min-height:38px;padding:9px 14px}
body.fbi-payroll-mode .fbi-payroll-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-bottom:14px}
body.fbi-payroll-mode .fbi-payroll-stat{min-height:96px;padding:13px 14px;background:linear-gradient(145deg,#141a22,#0f141b);border-color:#28313c;border-radius:13px;box-shadow:0 8px 24px rgba(0,0,0,.12)}
body.fbi-payroll-mode .fbi-payroll-stat:hover{transform:translateY(-2px);border-color:rgba(215,177,90,.30)}
body.fbi-payroll-mode .fbi-payroll-stat span{font-size:7.5px;letter-spacing:1.15px;color:#8792a2}
body.fbi-payroll-mode .fbi-payroll-stat b{font-size:20px;line-height:1.1;margin-top:9px;letter-spacing:-.3px}
body.fbi-payroll-mode .fbi-payroll-stat small{font-size:7.5px;margin-top:5px;color:#697587}
body.fbi-payroll-mode .fbi-payroll-grid .fbi-payroll-stat:nth-child(1){border-top:2px solid #d7b15a}
body.fbi-payroll-mode .fbi-payroll-grid .fbi-payroll-stat:nth-child(2){border-top:2px solid #bd1b63}
body.fbi-payroll-mode .fbi-payroll-grid .fbi-payroll-stat:nth-child(3){border-top:2px solid #48c98a}
body.fbi-payroll-mode .fbi-payroll-grid .fbi-payroll-stat:nth-child(4){border-top:2px solid #6fa7ff}
body.fbi-payroll-mode .fbi-payroll-grid .fbi-payroll-stat:nth-child(5){border-top:2px solid #efb95d}
body.fbi-payroll-mode .fbi-payroll-card{background:linear-gradient(160deg,rgba(18,23,31,.98),rgba(13,17,24,.98));border-color:#293340;border-radius:16px;padding:17px;box-shadow:var(--pay-shadow)}
body.fbi-payroll-mode .fbi-payroll-tabs{display:flex;align-items:center;gap:6px;padding:4px;margin:-1px 0 16px;border:1px solid #2a333f;border-radius:11px;background:#0c1117;overflow-x:auto;scrollbar-width:thin}
body.fbi-payroll-mode .fbi-payroll-tab{flex:0 0 auto;padding:9px 13px;border-radius:8px;border-color:transparent;background:transparent;color:#8490a1;font-size:9px}
body.fbi-payroll-mode .fbi-payroll-tab:hover{background:#171d26;color:#e8edf4}
body.fbi-payroll-mode .fbi-payroll-tab.active{background:linear-gradient(180deg,#2a1721,#21131b);border-color:#a61b58;color:#fff;box-shadow:inset 0 0 0 1px rgba(255,255,255,.035),0 5px 18px rgba(189,27,99,.10)}
body.fbi-payroll-mode .fbi-payroll-section-head{align-items:center;margin-bottom:14px}
body.fbi-payroll-mode .fbi-payroll-section-head h3{font-size:13px;letter-spacing:.05px;color:#f0f3f7}
body.fbi-payroll-mode .fbi-payroll-section-head p{font-size:8.5px;color:#788495}
body.fbi-payroll-mode .fbi-payroll-info{margin-bottom:13px;padding:10px 12px;border-color:#303947;background:rgba(215,177,90,.035);color:#8b96a6;border-radius:10px}
body.fbi-payroll-mode .fbi-payroll-summary{gap:9px;margin:13px 0 15px}
body.fbi-payroll-mode .fbi-payroll-summary-item{padding:11px 12px;border-color:#29323d;background:#0e1319;border-radius:10px}
body.fbi-payroll-mode .fbi-payroll-summary-item b{font-size:12.5px}
body.fbi-payroll-mode .fbi-payroll-table-wrap{border-color:#2b3440;border-radius:11px;background:#0c1117}
body.fbi-payroll-mode .fbi-payroll-table th{background:#0f141b;padding:10px;color:#7e899a;font-size:7px}
body.fbi-payroll-mode .fbi-payroll-table td{padding:10px;border-top-color:#222a34;font-size:8.5px}
body.fbi-payroll-mode .fbi-payroll-table tbody tr:hover{background:rgba(215,177,90,.025)}
body.fbi-payroll-mode .fbi-payroll-mini-btn{min-height:30px;padding:6px 9px;border-color:#343e4a;background:#151b23}
body.fbi-payroll-mode .fbi-payroll-profile{background:#0d1218;border-color:#2b3440;border-radius:11px}
body.fbi-payroll-mode .fbi-payroll-field input,body.fbi-payroll-mode .fbi-payroll-field select,body.fbi-payroll-mode .fbi-payroll-field textarea{background:#0b0f15;border-color:#2f3946;color:#eef2f7}
body.fbi-payroll-mode .fbi-payroll-modal{z-index:300}
[data-theme="light"] body.fbi-payroll-mode{background:radial-gradient(900px 460px at 78% -10%,rgba(184,144,50,.07),transparent 60%),#f4f6f9}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-hero{background:linear-gradient(135deg,#15202d,#202b3a);border-color:#2f3b4a}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-card{background:#fff;border-color:#dfe4eb;box-shadow:0 10px 30px rgba(15,23,42,.06)}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-tabs{background:#f4f6f9;border-color:#dfe4eb}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-tab{color:#667085}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-tab:hover{background:#fff;color:#17202d}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-tab.active{background:#17202d;border-color:#17202d;color:#fff}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-stat{background:linear-gradient(180deg,#fff,#f8fafc);border-color:#dfe4eb;color:#17202d}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-stat span{color:#667085}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-stat b{color:#17202d}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-stat small{color:#7b8797}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-info{background:#fbfaf5;border-color:#e4dcc7;color:#667085}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-summary-item{background:#f8fafc;border-color:#dfe4eb}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-table-wrap{background:#fff;border-color:#dfe4eb}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-table th{background:#f3f5f8;color:#687386}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-table td{border-top-color:#e7ebf0;color:#273244}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-profile{background:#f8fafc;border-color:#dfe4eb}
[data-theme="light"] body.fbi-payroll-mode .fbi-payroll-field input, [data-theme="light"] body.fbi-payroll-mode .fbi-payroll-field select, [data-theme="light"] body.fbi-payroll-mode .fbi-payroll-field textarea{background:#fff;color:#17202d;border-color:#d1d8e3}
@media(max-width:1180px){
  body.fbi-payroll-mode .fbi-payroll-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media(max-width:900px){
  body.fbi-payroll-mode .top>div:last-child{padding-right:132px;flex-wrap:wrap!important}
  body.fbi-payroll-mode .top .theme-switcher{right:14px}
  body.fbi-payroll-mode #fbiPayrollView{padding:18px 16px 42px}
  body.fbi-payroll-mode .fbi-payroll-hero{align-items:flex-start;flex-direction:column}
}
@media(max-width:760px){
  body.fbi-payroll-mode .fbi-payroll-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  body.fbi-payroll-mode .top>div:last-child{padding-right:112px}
  body.fbi-payroll-mode .top .theme-switcher{right:10px}
}
@media(max-width:520px){
  body.fbi-payroll-mode .fbi-payroll-grid{grid-template-columns:1fr}
  body.fbi-payroll-mode .fbi-payroll-hero{padding:18px}
  body.fbi-payroll-mode .fbi-payroll-hero h2{font-size:23px}
  body.fbi-payroll-mode .top>div:last-child{padding-right:0}
  body.fbi-payroll-mode .top .theme-switcher{position:static!important;transform:none!important;margin-left:2px!important}
}

/* ===== PAYROLL DASHBOARD EXPERIENCE V4 ===== */
/* Reference-inspired finance dashboard layout for Payroll. Visual/module-only, engine untouched. */
.fbi-payroll-dashboard{display:grid;gap:14px}
.fbi-payroll-dashboard-hero{display:flex;justify-content:space-between;align-items:stretch;gap:16px;padding:20px 22px;border:1px solid #2a3441;border-radius:15px;background:linear-gradient(135deg,#111a24,#17232f 58%,#10261f);box-shadow:0 16px 42px rgba(0,0,0,.18);overflow:hidden;position:relative}
.fbi-payroll-dashboard-hero:before{content:"";position:absolute;width:330px;height:220px;right:-90px;top:-100px;border-radius:50%;background:radial-gradient(circle,rgba(93,220,132,.20),transparent 68%);pointer-events:none}
.fbi-payroll-dashboard-hero-main{position:relative;z-index:1;min-width:0}
.fbi-payroll-dashboard-eyebrow{font-size:8px;letter-spacing:1.7px;text-transform:uppercase;font-weight:900;color:#d8ba61;margin-bottom:6px}
.fbi-payroll-dashboard-title{margin:0;font-size:24px;letter-spacing:-.55px;color:#fff}
.fbi-payroll-dashboard-sub{margin:6px 0 0;color:#9aa6b6;font-size:9px;line-height:1.5;max-width:640px}
.fbi-payroll-dashboard-tools{display:flex;align-items:center;gap:8px;position:relative;z-index:1;align-self:center;flex-wrap:wrap;justify-content:flex-end}
.fbi-payroll-period{border:1px solid #364252;background:#0f151d;color:#e7edf4;border-radius:9px;padding:9px 11px;font-size:9px;min-height:36px}
.fbi-payroll-kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
.fbi-payroll-kpi{padding:14px;border:1px solid #dfe4eb;border-radius:12px;background:#fff;box-shadow:0 7px 20px rgba(15,23,42,.045);position:relative;overflow:hidden}
.fbi-payroll-kpi:after{content:"";position:absolute;right:-25px;top:-30px;width:75px;height:75px;border-radius:50%;background:rgba(180,144,50,.08)}
.fbi-payroll-kpi span{display:block;color:#7a8798;font-size:7.5px;letter-spacing:.9px;text-transform:uppercase;font-weight:850}
.fbi-payroll-kpi b{display:block;color:#17202d;font-size:20px;letter-spacing:-.35px;margin-top:8px}
.fbi-payroll-kpi small{display:block;color:#8791a0;font-size:7.5px;margin-top:4px}
.fbi-payroll-kpi.gold{border-top:2px solid #b89032}.fbi-payroll-kpi.green{border-top:2px solid #43b977}.fbi-payroll-kpi.blue{border-top:2px solid #5f94d9}.fbi-payroll-kpi.pink{border-top:2px solid #bd1b63}.fbi-payroll-kpi.orange{border-top:2px solid #d08a29}
.fbi-payroll-dashboard-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.85fr);gap:12px}
.fbi-payroll-widget{border:1px solid #dfe4eb;border-radius:13px;background:#fff;padding:15px;box-shadow:0 7px 22px rgba(15,23,42,.045);min-width:0}
.fbi-payroll-widget-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-bottom:12px}.fbi-payroll-widget-head h3{margin:0;color:#1f2937;font-size:12px}.fbi-payroll-widget-head small{display:block;color:#7b8796;font-size:8px;margin-top:3px}
.fbi-payroll-chart{display:grid;gap:8px}.fbi-payroll-chart-row{display:grid;grid-template-columns:50px minmax(0,1fr) 72px;gap:9px;align-items:center}.fbi-payroll-chart-label{font-size:8px;color:#7a8493}.fbi-payroll-bars{display:grid;gap:4px}.fbi-payroll-bar-track{height:8px;background:#edf1f4;border-radius:999px;overflow:hidden}.fbi-payroll-bar-fill{height:100%;border-radius:999px}.fbi-payroll-bar-fill.net{background:linear-gradient(90deg,#172d28,#43b977)}.fbi-payroll-bar-fill.paid{background:linear-gradient(90deg,#b89032,#dfbf63)}.fbi-payroll-chart-value{text-align:right;font-size:8px;color:#273244;font-weight:800}
.fbi-payroll-health{display:grid;grid-template-columns:108px 1fr;gap:15px;align-items:center}.fbi-payroll-donut{width:108px;height:108px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#42be79 0deg 250deg,#dfe7e4 250deg 360deg);position:relative}.fbi-payroll-donut:after{content:"";width:76px;height:76px;border-radius:50%;background:#fff;position:absolute}.fbi-payroll-donut b{position:relative;z-index:1;color:#17202d;font-size:20px}.fbi-payroll-health-copy b{display:block;color:#17202d;font-size:16px}.fbi-payroll-health-copy small{display:block;color:#7d8897;font-size:8px;line-height:1.45;margin-top:5px}.fbi-payroll-health-stats{display:grid;gap:7px;margin-top:9px}.fbi-payroll-health-stat{display:flex;justify-content:space-between;gap:10px;font-size:8px}.fbi-payroll-health-stat span{color:#7d8794}.fbi-payroll-health-stat b{color:#1d2734}
.fbi-payroll-lists{display:grid;grid-template-columns:1.35fr .8fr;gap:12px}.fbi-payroll-list{display:grid;gap:0}.fbi-payroll-list-row{display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid #edf0f4}.fbi-payroll-list-row:last-child{border-bottom:0}.fbi-payroll-avatar{width:31px;height:31px;border-radius:9px;display:grid;place-items:center;background:#f4ebef;color:#a80e4d;font-size:11px;font-weight:900;flex:0 0 auto}.fbi-payroll-list-row .grow{flex:1;min-width:0}.fbi-payroll-list-row b{display:block;color:#263141;font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.fbi-payroll-list-row small{display:block;color:#7e8897;font-size:7.5px;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.fbi-payroll-list-amount{text-align:right}.fbi-payroll-list-amount b{font-size:9px}.fbi-payroll-list-amount small{color:#768292}
.fbi-payroll-dept{display:grid;gap:8px}.fbi-payroll-dept-row{display:grid;grid-template-columns:1fr 76px;gap:8px;align-items:center}.fbi-payroll-dept-label{font-size:8px;color:#455163}.fbi-payroll-dept-bar{height:7px;background:#edf1f5;border-radius:999px;overflow:hidden;margin-top:4px}.fbi-payroll-dept-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,#bd1b63,#d7b15a)}
.fbi-payroll-quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.fbi-payroll-quick{display:flex;align-items:center;gap:8px;padding:11px;border:1px solid #e1e5eb;border-radius:10px;background:#fff;color:#263141;text-align:left;cursor:pointer}.fbi-payroll-quick:hover{border-color:#d0d8e1;box-shadow:0 7px 16px rgba(15,23,42,.05);transform:translateY(-1px)}.fbi-payroll-quick-icon{width:28px;height:28px;border-radius:8px;display:grid;place-items:center;background:#f4ebef;color:#a80e4d;font-size:13px;flex:0 0 auto}.fbi-payroll-quick b{font-size:8.5px}.fbi-payroll-quick small{display:block;color:#7a8796;font-size:7px;margin-top:2px}
.fbi-payroll-overview-table-wrap{margin-top:0}.fbi-payroll-dashboard .fbi-payroll-info{margin-top:0}
[data-theme="dark"] .fbi-payroll-widget,[data-theme="dark"] .fbi-payroll-kpi{background:linear-gradient(180deg,#141922,#10151b);border-color:#2b3440;box-shadow:0 10px 28px rgba(0,0,0,.16)}
[data-theme="dark"] .fbi-payroll-kpi span,[data-theme="dark"] .fbi-payroll-chart-label,[data-theme="dark"] .fbi-payroll-widget-head small,[data-theme="dark"] .fbi-payroll-list-row small,[data-theme="dark"] .fbi-payroll-dept-label,[data-theme="dark"] .fbi-payroll-health-copy small{color:#8792a2}
[data-theme="dark"] .fbi-payroll-kpi b,[data-theme="dark"] .fbi-payroll-widget-head h3,[data-theme="dark"] .fbi-payroll-chart-value,[data-theme="dark"] .fbi-payroll-health-copy b,[data-theme="dark"] .fbi-payroll-health-stat b,[data-theme="dark"] .fbi-payroll-list-row b{color:#eef2f7}
[data-theme="dark"] .fbi-payroll-bar-track,[data-theme="dark"] .fbi-payroll-dept-bar{background:#232a34}
[data-theme="dark"] .fbi-payroll-donut:after{background:#11161d}.fbi-payroll-dashboard .fbi-payroll-donut{background:conic-gradient(#43b977 0deg 250deg,#27332f 250deg 360deg)}
[data-theme="dark"] .fbi-payroll-quick{background:#11161d;border-color:#2b3440;color:#e9edf3}.fbi-payroll-quick-icon{background:rgba(189,27,99,.10)}
@media(max-width:1180px){.fbi-payroll-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.fbi-payroll-dashboard-grid{grid-template-columns:1fr}.fbi-payroll-lists{grid-template-columns:1fr}}
@media(max-width:780px){.fbi-payroll-dashboard-hero{flex-direction:column}.fbi-payroll-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.fbi-payroll-quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.fbi-payroll-kpis{grid-template-columns:1fr}.fbi-payroll-health{grid-template-columns:1fr}.fbi-payroll-donut{margin:auto}.fbi-payroll-quick-grid{grid-template-columns:1fr}.fbi-payroll-chart-row{grid-template-columns:42px minmax(0,1fr) 62px}}

/* ===== PAYROLL INNER-CONTENT INTERACTION V2 ===== */
/* Keep the outer Payroll navigation pill stable. Apply the tactile motion to the controls inside Payroll instead. */
.nav button[data-v="payroll"],.nav .nav-link[data-v="payroll"]{
  transform:none!important;
  box-shadow:none!important;
}
.fbi-payroll-tabs .fbi-payroll-tab{
  transform-origin:center center;
  transition:transform .28s cubic-bezier(.2,.75,.25,1),box-shadow .28s ease,background .28s ease,border-color .28s ease!important;
}
.fbi-payroll-tabs .fbi-payroll-tab:hover{
  transform:translateY(-1px) rotate(1.1deg) scale(1.012)!important;
  box-shadow:0 7px 20px rgba(0,0,0,.16),inset 0 0 18px rgba(215,177,90,.055)!important;
  border-color:rgba(215,177,90,.42)!important;
}
.fbi-payroll-tabs .fbi-payroll-tab.active{
  transform:rotate(.25deg) scale(1.005)!important;
  box-shadow:0 5px 18px rgba(189,27,99,.10),inset 0 0 20px rgba(189,27,99,.08)!important;
}
.fbi-payroll-tabs .fbi-payroll-tab:active{
  transform:translateY(0) rotate(.1deg) scale(.99)!important;
}
.fbi-payroll-quick,.fbi-payroll-mini-btn,.fbi-payroll-dashboard-tools .btn,.fbi-payroll-actions .btn{
  transition:transform .28s cubic-bezier(.2,.75,.25,1),box-shadow .28s ease,border-color .28s ease,background .28s ease!important;
}
.fbi-payroll-quick:hover,.fbi-payroll-mini-btn:hover,.fbi-payroll-dashboard-tools .btn:hover,.fbi-payroll-actions .btn:hover{
  transform:translateY(-1px) rotate(.7deg) scale(1.01)!important;
  box-shadow:0 7px 20px rgba(0,0,0,.14)!important;
}
@media(prefers-reduced-motion:reduce){
  .fbi-payroll-tabs .fbi-payroll-tab,.fbi-payroll-quick,.fbi-payroll-mini-btn,.fbi-payroll-dashboard-tools .btn,.fbi-payroll-actions .btn{transition:none!important}
  .fbi-payroll-tabs .fbi-payroll-tab:hover,.fbi-payroll-tabs .fbi-payroll-tab.active,.fbi-payroll-tabs .fbi-payroll-tab:active,
  .fbi-payroll-quick:hover,.fbi-payroll-mini-btn:hover,.fbi-payroll-dashboard-tools .btn:hover,.fbi-payroll-actions .btn:hover{transform:none!important}
}

/* ===== PAYROLL DEDICATED WORKSPACE V3 ===== */
/* Payroll gets a dedicated workspace. The invoice header tools are hidden while Payroll is open. */
body.fbi-payroll-mode .top{display:none!important}
body.fbi-payroll-mode .main{width:100%;min-width:0}
body.fbi-payroll-mode #fbiPayrollView{
  display:block;
  width:100%;
  max-width:none;
  margin:0;
  padding:20px 22px 44px;
  min-height:100vh;
}
body.fbi-payroll-mode .fbi-payroll-shell{width:min(1240px,100%);max-width:1240px;margin:0 auto}
body.fbi-payroll-mode .fbi-payroll-dashboard{width:100%}
body.fbi-payroll-mode .fbi-payroll-dashboard-hero{padding:18px 20px;border-radius:14px;min-height:116px}
body.fbi-payroll-mode .fbi-payroll-dashboard-title{font-size:23px}
body.fbi-payroll-mode .fbi-payroll-dashboard-sub{font-size:9px;max-width:590px}
body.fbi-payroll-mode .fbi-payroll-dashboard-tools{gap:6px}
body.fbi-payroll-mode .fbi-payroll-dashboard-tools .btn,
body.fbi-payroll-mode .fbi-payroll-dashboard-tools .fbi-payroll-period{min-height:34px;padding:8px 10px;font-size:8.5px}
body.fbi-payroll-mode .fbi-payroll-kpis{grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
body.fbi-payroll-mode .fbi-payroll-kpi{padding:12px;min-height:88px}
body.fbi-payroll-mode .fbi-payroll-kpi b{font-size:18px;margin-top:7px}
body.fbi-payroll-mode .fbi-payroll-dashboard-grid{grid-template-columns:minmax(0,1.45fr) minmax(285px,.8fr);gap:10px}
body.fbi-payroll-mode .fbi-payroll-lists{grid-template-columns:minmax(0,1.2fr) minmax(285px,.8fr);gap:10px}
body.fbi-payroll-mode .fbi-payroll-widget{padding:13px;border-radius:12px}
body.fbi-payroll-mode .fbi-payroll-widget-head{margin-bottom:9px}
body.fbi-payroll-mode .fbi-payroll-quick-grid{gap:7px}
body.fbi-payroll-mode .fbi-payroll-quick{padding:9px}
@media(max-width:1180px){
  body.fbi-payroll-mode #fbiPayrollView{padding:18px 16px 40px}
  body.fbi-payroll-mode .fbi-payroll-shell{width:100%;max-width:1180px}
}
@media(max-width:900px){
  body.fbi-payroll-mode .fbi-payroll-dashboard-hero{padding:16px;gap:14px}
  body.fbi-payroll-mode .fbi-payroll-dashboard-tools{width:100%;justify-content:flex-start}
}
@media(max-width:640px){
  body.fbi-payroll-mode #fbiPayrollView{padding:12px 10px 30px}
  body.fbi-payroll-mode .fbi-payroll-dashboard-title{font-size:20px}
  body.fbi-payroll-mode .fbi-payroll-dashboard-hero{border-radius:12px}
}
</style>

<section class="view" id="fbiPayrollView" aria-label="Payroll">
  <div class="fbi-payroll-shell">
    <div class="fbi-payroll-hero">
      <div>
        <div class="fbi-payroll-kicker">FBI People & Payments</div>
        <h2>Payroll</h2>
        <p>Staff, project earnings, payments, payslips and payroll reporting.</p>
      </div>
      <div class="fbi-payroll-actions">
        <a class="btn" href="/payroll-staff-form.html" target="_blank" rel="noopener">📋 Staff Registration Form</a><a class="btn primary" href="/payroll-staff-portal.html" target="_blank" rel="noopener">👥 Payroll Staff Portal</a>
        <button class="btn" type="button" id="fbiPayrollImportForm">⬆ Import Completed Form</button>
        <button class="btn" type="button" id="fbiPayrollQuickWorker">＋ Add Worker</button>
        <button class="btn primary" type="button" id="fbiPayrollQuickRecord">＋ New Payroll</button>
        <input id="fbiPayrollImportFile" type="file" accept="application/json,.json,application/pdf,.pdf" style="display:none">
      </div>
    </div>

    <div class="fbi-payroll-grid">
      <div class="fbi-payroll-stat"><span>Workers</span><b id="fbiPayrollWorkerCount">0</b><small id="fbiPayrollWorkerMeta">Active 0</small></div>
      <div class="fbi-payroll-stat"><span>Payroll Records</span><b id="fbiPayrollRecordCount">0</b><small id="fbiPayrollRecordMeta">All work records</small></div>
      <div class="fbi-payroll-stat"><span>Net Payroll</span><b id="fbiPayrollNetTotal">GH₵0.00</b><small id="fbiPayrollNetMeta">All records</small></div>
      <div class="fbi-payroll-stat"><span>Paid</span><b id="fbiPayrollPaidTotal">GH₵0.00</b><small id="fbiPayrollPaidMeta">Recorded payments</small></div>
      <div class="fbi-payroll-stat"><span>Outstanding</span><b id="fbiPayrollBalanceTotal">GH₵0.00</b><small id="fbiPayrollBalanceMeta">Amount still due</small></div>
    </div>

    <div class="fbi-payroll-card">
      <div class="fbi-payroll-tabs">
        <button class="fbi-payroll-tab active" type="button" data-payroll-tab="overview">Overview</button>
        <button class="fbi-payroll-tab" type="button" data-payroll-tab="workers">Staff / Workers</button>
        <button class="fbi-payroll-tab" type="button" data-payroll-tab="registrations" id="fbiPayrollRegistrationTab">Staff Verification</button>
        <button class="fbi-payroll-tab" type="button" data-payroll-tab="records">Payroll Records</button>
        <button class="fbi-payroll-tab" type="button" data-payroll-tab="payslips">Payslips</button>
        <button class="fbi-payroll-tab" type="button" data-payroll-tab="reports">Reports</button>
      </div>

      <div class="fbi-payroll-panel active" data-payroll-panel="overview">
        <div class="fbi-payroll-dashboard">
          <div class="fbi-payroll-dashboard-hero">
            <div class="fbi-payroll-dashboard-hero-main">
              <div class="fbi-payroll-dashboard-eyebrow">FBI PEOPLE & PAYMENTS</div>
              <h2 class="fbi-payroll-dashboard-title">Payroll Command Center</h2>
              <p class="fbi-payroll-dashboard-sub">Manage worker earnings, payment progress, payroll exposure and payslips from one finance workspace.</p>
            </div>
            <div class="fbi-payroll-dashboard-tools">
              <select class="fbi-payroll-period" id="fbiPayrollOverviewPeriod" aria-label="Payroll period">
                <option value="all">All time</option>
                <option value="month">This month</option>
                <option value="quarter">This quarter</option>
              </select>
              <button class="btn" type="button" id="fbiPayrollOverviewPrint">🖨 Print</button>
              <button class="btn" type="button" id="fbiPayrollQuickWorkers">＋ Add Worker</button>
              <button class="btn primary" type="button" id="fbiPayrollQuickRecord">＋ New Payroll</button>
            </div>
          </div>

          <div class="fbi-payroll-kpis" id="fbiPayrollDashboardKpis"></div>
          <div class="fbi-payroll-widget" id="fbiPayrollRegistrationOverview" style="margin:0 0 12px 0">
            <div class="fbi-payroll-widget-head">
              <div><h3>Staff Registration Verification</h3><small>Review self-registrations before giving staff access to their payroll and payslips.</small></div>
              <div style="display:flex;gap:7px;align-items:center;flex-wrap:wrap">
                <span class="fbi-payroll-badge pending" id="fbiPayrollRegistrationOverviewCount">0 pending</span>
                <button class="fbi-payroll-mini-btn" type="button" id="fbiPayrollRegistrationOverviewOpen">Open Verification Queue</button>
              </div>
            </div>
            <div id="fbiPayrollRegistrationOverviewList"><div class="fbi-payroll-empty">Checking for new staff registrations...</div></div>
          </div>


          <div class="fbi-payroll-dashboard-grid">
            <div class="fbi-payroll-widget">
              <div class="fbi-payroll-widget-head">
                <div><h3>Payroll Cashflow</h3><small>Net payroll against recorded payments</small></div>
                <small id="fbiPayrollChartRange">Last 6 months</small>
              </div>
              <div class="fbi-payroll-chart" id="fbiPayrollCashflowChart"></div>
            </div>

            <div class="fbi-payroll-widget">
              <div class="fbi-payroll-widget-head">
                <div><h3>Payroll Health</h3><small>How much current payroll has been settled</small></div>
              </div>
              <div id="fbiPayrollHealth"></div>
            </div>
          </div>

          <div class="fbi-payroll-lists">
            <div class="fbi-payroll-widget">
              <div class="fbi-payroll-widget-head">
                <div><h3>Recent Payroll Activity</h3><small>Latest work records and payment movement</small></div>
                <button class="fbi-payroll-mini-btn" type="button" id="fbiPayrollViewRecords">View Records</button>
              </div>
              <div class="fbi-payroll-list" id="fbiPayrollRecentActivity"></div>
            </div>
            <div class="fbi-payroll-widget">
              <div class="fbi-payroll-widget-head">
                <div><h3>Payroll by Department</h3><small>Net payroll exposure by team</small></div>
              </div>
              <div class="fbi-payroll-dept" id="fbiPayrollDepartments"></div>
            </div>
          </div>

          <div class="fbi-payroll-widget">
            <div class="fbi-payroll-widget-head">
              <div><h3>Quick Actions</h3><small>Jump directly into your daily payroll workflow</small></div>
            </div>
            <div class="fbi-payroll-quick-grid">
              <button class="fbi-payroll-quick" type="button" id="fbiPayrollQAWorker"><span class="fbi-payroll-quick-icon">👤</span><span><b>Add Worker</b><small>Create a new worker profile</small></span></button>
              <button class="fbi-payroll-quick" type="button" id="fbiPayrollQARecord"><span class="fbi-payroll-quick-icon">＋</span><span><b>New Payroll</b><small>Enter work and earnings</small></span></button>
              <button class="fbi-payroll-quick" type="button" id="fbiPayrollQAPayslip"><span class="fbi-payroll-quick-icon">🧾</span><span><b>Payslips</b><small>View and print payslips</small></span></button>
              <button class="fbi-payroll-quick" type="button" id="fbiPayrollQAReport"><span class="fbi-payroll-quick-icon">📊</span><span><b>Reports</b><small>Filter, print or export</small></span></button>
            </div>
          </div>

          <div class="fbi-payroll-widget">
            <div class="fbi-payroll-widget-head">
              <div><h3>Latest Payroll Records</h3><small>Full financial detail remains available under Payroll Records</small></div>
            </div>
            <div id="fbiPayrollOverviewTable" class="fbi-payroll-overview-table-wrap"></div>
          </div>
        </div>
      </div>

      <div class="fbi-payroll-panel" data-payroll-panel="registrations">
        <div class="fbi-payroll-section-head">
          <div><h3>Staff Verification</h3><p>Review people who registered through the Payroll Staff Portal. Approve and add them to the Payroll Staff Directory, or reject the request.</p></div>
          <div style="display:flex;gap:7px;align-items:center;flex-wrap:wrap">
            <span class="fbi-payroll-badge pending" id="fbiPayrollRegistrationMainCount">0 pending</span>
            <a class="btn" href="/payroll-staff-portal.html" target="_blank" rel="noopener">Open Staff Portal</a>
            <button class="btn" type="button" id="fbiPayrollRegistrationMainRefresh">Refresh</button>
          </div>
        </div>
        <div class="fbi-payroll-widget" style="margin-bottom:12px">
          <div id="fbiPayrollRegistrationRequestsMain"><div class="fbi-payroll-empty">Loading registration requests...</div></div>
        </div>
      </div>

      <div class="fbi-payroll-panel" data-payroll-panel="workers">
        <div class="fbi-payroll-section-head">
          <div><h3>Staff / Worker Directory</h3><p>Profiles, worker categories and payment details.</p></div>
          <div style="display:flex;gap:7px;flex-wrap:wrap">
            <a class="btn" href="/payroll-staff-form.html" target="_blank" rel="noopener">📋 Staff Registration Form</a>
            <button class="btn" type="button" id="fbiPayrollImportForm2">⬆ Import Form</button>
            <button class="btn primary" type="button" id="fbiPayrollWorkersAdd">＋ Add Worker</button>
          </div>
        </div>
        <div class="fbi-payroll-widget" style="margin-bottom:12px" id="fbiPayrollRegistrationWidget">
  <div class="fbi-payroll-widget-head">
    <div><h3>Staff Registration Requests</h3><small>Self-registrations from the Payroll Staff Portal. Approve a request to add or link the worker in Payroll.</small></div>
    <div style="display:flex;gap:7px;align-items:center;flex-wrap:wrap"><span class="fbi-payroll-badge pending" id="fbiPayrollRegistrationCount">0 pending</span><a class="fbi-payroll-mini-btn" href="/payroll-staff-portal.html" target="_blank" rel="noopener">Open Staff Portal</a><button class="fbi-payroll-mini-btn" type="button" id="fbiPayrollRegistrationRefresh">Refresh</button></div>
  </div>
  <div id="fbiPayrollRegistrationRequests"><div class="fbi-payroll-empty">Loading registration requests...</div></div>
</div>
<div id="fbiPayrollWorkerFormWrap"></div>
        <div class="fbi-payroll-worker-layout">
          <div id="fbiPayrollWorkerProfile"></div>
          <div id="fbiPayrollWorkersTable"></div>
        </div>
      </div>

      <div class="fbi-payroll-panel" data-payroll-panel="records">
        <div class="fbi-payroll-section-head">
          <div><h3>Payroll Records</h3><p>Pay people according to events, days, installations or another basis.</p></div>
          <button class="btn primary" type="button" id="fbiPayrollRecordsAdd">＋ New Payroll</button>
        </div>
        <div id="fbiPayrollRecordFormWrap"></div>
        <div id="fbiPayrollRecordsTable"></div>
      </div>

      <div class="fbi-payroll-panel" data-payroll-panel="payslips">
        <div class="fbi-payroll-section-head">
          <div><h3>Payslips</h3><p>Generated payslips and printable payment documents.</p></div>
        </div>
        <div id="fbiPayrollPayslipList"></div>
      </div>

      <div class="fbi-payroll-panel" data-payroll-panel="reports">
        <div class="fbi-payroll-section-head">
          <div><h3>Payroll Reports</h3><p>Filter by date, worker, department, project/job and payment status.</p></div>
          <div class="fbi-payroll-actions">
            <button class="btn" type="button" id="fbiPayrollReportCsv">⬇ CSV</button>
            <button class="btn primary" type="button" id="fbiPayrollReportPrint">🖨 Print / Save PDF</button>
          </div>
        </div>
        <div class="fbi-payroll-form" style="margin-bottom:12px">
          <div class="fbi-payroll-field"><label>From Date</label><input type="date" id="fbiPayrollReportFrom"></div>
          <div class="fbi-payroll-field"><label>To Date</label><input type="date" id="fbiPayrollReportTo"></div>
          <div class="fbi-payroll-field"><label>Worker</label><select id="fbiPayrollReportWorker"></select></div>
          <div class="fbi-payroll-field"><label>Department</label><select id="fbiPayrollReportDepartment"><option value="">All Departments</option><option>Media Production</option><option>IT / Networking</option><option>CCTV / Security</option><option>Smart Home</option><option>Administration</option><option>Other</option></select></div>
          <div class="fbi-payroll-field"><label>Project / Job</label><input type="text" id="fbiPayrollReportProject" placeholder="Search project or event"></div>
          <div class="fbi-payroll-field"><label>Payment Status</label><select id="fbiPayrollReportStatus"><option value="">All Statuses</option><option>Pending</option><option>Partially Paid</option><option>Paid</option></select></div>
          <div class="fbi-payroll-field"><label>&nbsp;</label><button class="btn" type="button" id="fbiPayrollReportReset">Reset Filters</button></div>
        </div>
        <div class="fbi-payroll-report-summary" id="fbiPayrollReportSummary"></div>
        <div id="fbiPayrollReportTable"></div>
      </div>
    </div>
  </div>

  <div class="fbi-payroll-modal" id="fbiPayrollPaymentModal" aria-hidden="true">
    <div class="fbi-payroll-dialog">
      <div class="fbi-payroll-dialog-head">
        <div><h3>Record Payroll Payment</h3><small>Partial payments are supported and stored in the Payroll module.</small></div>
        <button class="btn" type="button" id="fbiPayrollPaymentClose">Close</button>
      </div>
      <div class="fbi-payroll-dialog-body">
        <div class="fbi-payroll-pay-balance"><span>Outstanding Balance</span><b id="fbiPayrollPaymentBalance">GH₵0.00</b></div>
        <div class="fbi-payroll-form">
          <div class="fbi-payroll-field"><label>Amount</label><input type="number" min="0" step="0.01" id="fbiPayrollPaymentAmount"></div>
          <div class="fbi-payroll-field"><label>Payment Date</label><input type="date" id="fbiPayrollPaymentDate"></div>
          <div class="fbi-payroll-field"><label>Payment Method</label><select id="fbiPayrollPaymentMethod"><option>Mobile Money</option><option>Bank</option><option>Cash</option></select></div>
          <div class="fbi-payroll-field"><label>Transaction / Reference</label><input type="text" id="fbiPayrollPaymentRef" placeholder="Reference number"></div>
          <div class="fbi-payroll-field"><label>Paid By</label><input type="text" id="fbiPayrollPaymentBy" placeholder="Person who made payment"></div>
          <div class="fbi-payroll-field"><label>Notes</label><input type="text" id="fbiPayrollPaymentNotes" placeholder="Optional payment notes"></div>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:13px">
          <button class="btn" type="button" id="fbiPayrollPaymentCancel">Cancel</button>
          <button class="btn primary" type="button" id="fbiPayrollPaymentSave">Save Payment</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  'use strict';

  var KEY='fbi-payroll-v2-isolated';
  var OLD_KEY='fbi-payroll-isolated-v1';
  var STATE={workers:[],records:[],payslips:[]};
  var selectedWorkerId='';
  var editingWorkerId='';
  var editingRecordId='';
  var paymentRecordId='';
  var payrollRegistrationRequests=[];
  var payrollRegistrationPoll=null;

  function q(id){return document.getElementById(id);}
  function num(v){var n=Number(v);return Number.isFinite(n)?n:0;}
  function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];});}
  function money(v){return 'GH₵'+num(v).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});}
  function today(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
  function uid(prefix){if(window.crypto&&crypto.randomUUID)return prefix+'-'+crypto.randomUUID();return prefix+'-'+Date.now()+'-'+Math.random().toString(36).slice(2,9);}
  function toastLocal(msg){try{if(typeof window.toast==='function'){window.toast(msg);return}}catch(e){}}

  /* Payroll persistence: local fallback plus isolated PostgreSQL storage. Invoice state is never touched. */
  var payrollCloudQueue=Promise.resolve();
  var payrollCloudOnline=false;
  var payrollPendingDeletes={workers:[],records:[],payslips:[]};

  function payrollSnapshotJson(){
    return JSON.stringify({
      version:1,
      savedAt:Date.now(),
      workers:STATE.workers,
      records:STATE.records,
      payslips:STATE.payslips,
      deletedWorkerIds:payrollPendingDeletes.workers.slice(),
      deletedRecordIds:payrollPendingDeletes.records.slice(),
      deletedPayslipIds:payrollPendingDeletes.payslips.slice()
    });
  }

  function queuePayrollCloudSave(){
    const json=payrollSnapshotJson();
    const sentDeletes={
      workers:payrollPendingDeletes.workers.slice(),
      records:payrollPendingDeletes.records.slice(),
      payslips:payrollPendingDeletes.payslips.slice()
    };
    payrollCloudQueue=payrollCloudQueue.then(async function(){
      try{
        const res=await fetch('/api/payroll-state',{method:'PUT',headers:{'Content-Type':'application/json'},body:json,cache:'no-store'});
        if(!res.ok)throw new Error('HTTP '+res.status);
        const body=await res.json().catch(function(){return{};});
        if(body.ok===false)throw new Error(body.error||'Payroll cloud save failed');
        payrollCloudOnline=true;
        sentDeletes.workers.forEach(function(id){payrollPendingDeletes.workers=payrollPendingDeletes.workers.filter(function(x){return x!==id;});});
        sentDeletes.records.forEach(function(id){payrollPendingDeletes.records=payrollPendingDeletes.records.filter(function(x){return x!==id;});});
        sentDeletes.payslips.forEach(function(id){payrollPendingDeletes.payslips=payrollPendingDeletes.payslips.filter(function(x){return x!==id;});});
        return true;
      }catch(e){
        payrollCloudOnline=false;
        console.warn('Payroll cloud save failed:',e);
        return false;
      }
    });
    return payrollCloudQueue;
  }

  function saveState(){
    try{
      localStorage.setItem(KEY,JSON.stringify(STATE));
    }catch(e){
      console.error('Payroll storage failed',e);
      alert('Payroll could not be saved on this device.');
      return false;
    }
    queuePayrollCloudSave();
    return true;
  }

  async function saveStateAndWait(){
    if(!saveState())return false;
    return await payrollCloudQueue;
  }

  function payrollArrayHasData(x){
    return !!(x&&((x.workers&&x.workers.length)||(x.records&&x.records.length)||(x.payslips&&x.payslips.length)));
  }

  function mergePayrollClientStates(remote,local){
    remote=remote||{workers:[],records:[],payslips:[]};
    local=local||{workers:[],records:[],payslips:[]};
    function stamp(v){var t=Date.parse(String(v||''));return Number.isFinite(t)?t:0;}
    function mergeWorker(a,b){
      var newer=stamp(b.updatedAt)>=stamp(a.updatedAt)?b:a, older=newer===b?a:b;
      return Object.assign({},older,newer,{id:a.id||b.id,updatedAt:stamp(a.updatedAt)||stamp(b.updatedAt)?new Date(Math.max(stamp(a.updatedAt),stamp(b.updatedAt))).toISOString():newer.updatedAt});
    }
    function mergeRecord(a,b){
      var newer=stamp(b.updatedAt)>=stamp(a.updatedAt)?b:a, older=newer===b?a:b;
      var out=Object.assign({},older,newer,{id:a.id||b.id});
      var map={};
      (Array.isArray(a.payments)?a.payments:[]).forEach(function(p){var k=String(p.id||p.reference||'').trim();if(k)map[k]=p;});
      (Array.isArray(b.payments)?b.payments:[]).forEach(function(p){var k=String(p.id||p.reference||'').trim();if(k){if(!map[k])map[k]=p;else map[k]=stamp(p.date)>=stamp(map[k].date)?Object.assign({},map[k],p):Object.assign({},p,map[k]);}});
      out.payments=Object.keys(map).map(function(k){return map[k];}).sort(function(x,y){return String(x.date||'').localeCompare(String(y.date||''))||String(x.id||'').localeCompare(String(y.id||''));});
      if(out.payments.length){
        var last=out.payments[out.payments.length-1];
        out.lastPaymentDate=last.date||out.lastPaymentDate||'';
        out.lastPaymentMethod=last.method||out.lastPaymentMethod||'';
        out.lastPaymentReference=last.reference||out.lastPaymentReference||'';
        out.lastPaidBy=last.paidBy||out.lastPaidBy||'';
      }
      var mt=Math.max(stamp(a.updatedAt),stamp(b.updatedAt));
      if(mt)out.updatedAt=new Date(mt).toISOString();
      return out;
    }
    function mergePayslip(a,b){
      var newer=stamp(b.generatedAt)>=stamp(a.generatedAt)?b:a, older=newer===b?a:b;
      return Object.assign({},older,newer,{id:a.id||b.id});
    }
    function mergeList(a,b,mergeOne){
      var map={};
      (Array.isArray(a)?a:[]).forEach(function(item){var k=String(item&&item.id||'').trim();if(k)map[k]=item;});
      (Array.isArray(b)?b:[]).forEach(function(item){var k=String(item&&item.id||'').trim();if(k){map[k]=map[k]?mergeOne(map[k],item):item;}});
      return Object.keys(map).map(function(k){return map[k];});
    }
    return {
      version:Math.max(Number(remote.version)||1,Number(local.version)||1),
      savedAt:Math.max(Number(remote.savedAt)||0,Number(local.savedAt)||0),
      workers:mergeList(remote.workers,local.workers,mergeWorker),
      records:mergeList(remote.records,local.records,mergeRecord),
      payslips:mergeList(remote.payslips,local.payslips,mergePayslip)
    };
  }

  async function hydratePayrollCloud(){
    var local={workers:STATE.workers.slice(),records:STATE.records.slice(),payslips:STATE.payslips.slice()};
    try{
      const res=await fetch('/api/payroll-state',{cache:'no-store'});
      if(!res.ok)throw new Error('HTTP '+res.status);
      const body=await res.json().catch(function(){return{};});
      if(body.ok===false)throw new Error(body.error||'Payroll cloud read failed');
      payrollCloudOnline=true;
      if(body.state&&typeof body.state==='object'){
        STATE=mergePayrollClientStates(body.state,local);
        try{localStorage.setItem(KEY,JSON.stringify(STATE));}catch(e){}
        await queuePayrollCloudSave();
      }else if(payrollArrayHasData(local)){
        await saveStateAndWait();
      }
    }catch(e){
      payrollCloudOnline=false;
      console.warn('Payroll cloud read failed; using local Payroll copy:',e);
    }
    renderAll();
  }
  function normalizeRecord(r){
    r=r||{};
    var payments=Array.isArray(r.payments)?r.payments.slice():[];
    if(!payments.length&&num(r.paidAmount)>0){
      payments.push({id:uid('payment'),date:r.paymentDate||today(),amount:num(r.paidAmount),method:r.paymentMethod||'',reference:r.transactionRef||'',paidBy:r.paidBy||'',notes:r.paymentNotes||''});
    }
    r.payments=payments;
    r.allowance=num(r.allowance);
    r.transport=num(r.transport);
    r.feeding=num(r.feeding);
    r.accommodation=num(r.accommodation);
    r.overtime=num(r.overtime);
    r.otherAllowance=num(r.otherAllowance);
    r.bonus=num(r.bonus);
    r.deduction=num(r.deduction);
    r.advance=num(r.advance);
    r.previousBalance=num(r.previousBalance);
    r.rate=num(r.rate);
    r.qty=Math.max(1,num(r.qty)||1);
    return r;
  }
  function loadState(){
    var parsed=null;
    try{parsed=JSON.parse(localStorage.getItem(KEY)||'null');}catch(e){}
    if(parsed&&typeof parsed==='object'){
      STATE={
        workers:Array.isArray(parsed.workers)?parsed.workers:[],
        records:Array.isArray(parsed.records)?parsed.records.map(normalizeRecord):[],
        payslips:Array.isArray(parsed.payslips)?parsed.payslips:[]
      };
      return;
    }
    /* One-time migration of the previous Payroll-only browser store, if it exists. */
    try{
      var old=JSON.parse(localStorage.getItem(OLD_KEY)||'null');
      if(old&&typeof old==='object'){
        STATE={
          workers:Array.isArray(old.workers)?old.workers:[],
          records:Array.isArray(old.records)?old.records.map(normalizeRecord):[],
          payslips:[]
        };
        saveState();
        return;
      }
    }catch(e){}
    STATE={workers:[],records:[],payslips:[]};
  }

  function getWorker(idv){return STATE.workers.find(function(w){return w.id===idv;})||null;}
  function basePay(r){return Math.max(0,num(r.rate)*Math.max(1,num(r.qty)||1));}
  function allowances(r){return num(r.allowance)+num(r.transport)+num(r.feeding)+num(r.accommodation)+num(r.overtime)+num(r.otherAllowance)+num(r.bonus);}
  function gross(r){return Math.max(0,basePay(r)+allowances(r));}
  function net(r){return Math.max(0,gross(r)-num(r.deduction)-num(r.advance)+num(r.previousBalance));}
  function paid(r){return Math.min(net(r),Math.max(0,(r.payments||[]).reduce(function(s,p){return s+num(p.amount);},0)));}
  function balance(r){return Math.max(0,net(r)-paid(r));}
  function status(r){var n=net(r),p=paid(r);if(n<=0)return 'Pending';if(p>=n-0.005)return 'Paid';if(p>0.005)return 'Partially Paid';return 'Pending';}
  function badge(s){var c=s==='Paid'?'paid':s==='Partially Paid'?'partial':'pending';return '<span class="fbi-payroll-badge '+c+'">'+esc(s)+'</span>';}

  /* Read-only bridge to existing invoice/job data. Nothing is written back. */
  function getInvoiceRecords(){
    try{
      if(typeof data!=='undefined'&&Array.isArray(data))return data.slice();
    }catch(e){}
    return [];
  }
  function invoiceOptions(selected){
    var invoices=getInvoiceRecords().slice().sort(function(a,b){return String(b.eventDate||b.date||'').localeCompare(String(a.eventDate||a.date||''));});
    var html='<option value="">No invoice / independent work</option>';
    invoices.forEach(function(x){
      var label=(x.no||'Invoice')+' · '+(x.client||'No client');
      if(x.eventDate)label+=' · '+x.eventDate;
      html+='<option value="'+esc(x.id||'')+'"'+((x.id||'')===selected?' selected':'')+'>'+esc(label)+'</option>';
    });
    return html;
  }
  function selectedInvoice(idv){
    return getInvoiceRecords().find(function(x){return x.id===idv;})||null;
  }

  function tabs(tab){
    document.querySelectorAll('[data-payroll-tab]').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-payroll-tab')===tab);});
    document.querySelectorAll('[data-payroll-panel]').forEach(function(p){p.classList.toggle('active',p.getAttribute('data-payroll-panel')===tab);});
    renderAll();
  }

  function workerSelectOptions(selected){
    var html='<option value="">Select worker</option>';
    STATE.workers.slice().sort(function(a,b){return String(a.name||'').localeCompare(String(b.name||''));}).forEach(function(w){
      html+='<option value="'+esc(w.id)+'"'+(w.id===selected?' selected':'')+'>'+esc(w.name)+(w.role?' · '+esc(w.role):'')+'</option>';
    });
    return html;
  }

  function showWorkerForm(existing){
    tabs('workers');
    editingWorkerId=existing?existing.id:'';
    var w=existing||{};
    q('fbiPayrollWorkerFormWrap').innerHTML=
      '<div class="fbi-payroll-card" style="margin-bottom:12px">'+
      '<div class="fbi-payroll-section-head"><div><h3>'+(existing?'Edit Worker':'Add Worker')+'</h3><p>Complete worker profile and payment details.</p></div></div>'+
      '<div class="fbi-payroll-form">'+
        field('Staff / Worker ID','pwCode',w.workerCode||'','text','e.g. FBI-WK-004')+
        field('Full Name','pwName',w.name||'','text','Full name')+
        field('Phone Number','pwPhone',w.phone||'','tel','Phone number')+
        field('Email','pwEmail',w.email||'','email','Email')+
        field('Address','pwAddress',w.address||'','text','Address',true)+
        field('Role / Job Title','pwRole',w.role||'','text','Role or job title')+
        selectField('Department','pwDepartment',['Media Production','IT / Networking','CCTV / Security','Smart Home','Administration','Other'],w.department||'Media Production')+
        selectField('Worker Type','pwType',['Staff','Media Worker','IT Technician','Network Technician','CCTV Installer','Other'],w.workerType||'Media Worker')+
        selectField('Preferred Payment Method','pwPaymentMethod',['Mobile Money','Bank','Cash'],w.paymentMethod||'Mobile Money')+
        field('MoMo Number','pwMomo',w.momo||'','text','')+
        field('Bank Name','pwBank',w.bank||'','text','')+
        field('Account Name','pwAccountName',w.accountName||'','text','')+
        field('Account Number','pwAccountNumber',w.accountNumber||'','text','')+
        field('Ghana Card / ID Reference','pwIdRef',w.idRef||'','text','')+
        field('Emergency / Contact Person','pwEmergency',w.emergency||'','text','')+
        field('Emergency Phone','pwEmergencyPhone',w.emergencyPhone||'','text','')+
        selectField('Status','pwStatus',['Active','Inactive'],w.status||'Active')+
        field('Notes','pwNotes',w.notes||'','text','Additional notes',true)+
      '</div>'+
      '<div style="display:flex;gap:8px;justify-content:flex-end;margin-top:12px"><button class="btn" type="button" id="pwCancel">Cancel</button><button class="btn primary" type="button" id="pwSave">Save Worker</button></div>'+
      '</div>';
    q('pwSave').onclick=saveWorker;
    q('pwCancel').onclick=function(){editingWorkerId='';q('fbiPayrollWorkerFormWrap').innerHTML='';renderAll();};
  }
  function field(label,idv,value,type,ph,full){
    return '<div class="fbi-payroll-field'+(full?' full':'')+'"><label>'+esc(label)+'</label><input id="'+idv+'" type="'+(type||'text')+'" value="'+esc(value)+'" placeholder="'+esc(ph||'')+'"></div>';
  }
  function selectField(label,idv,options,selected,full){
    return '<div class="fbi-payroll-field'+(full?' full':'')+'"><label>'+esc(label)+'</label><select id="'+idv+'">'+options.map(function(v){return '<option value="'+esc(v)+'"'+(String(v)===String(selected)?' selected':'')+'>'+esc(v)+'</option>';}).join('')+'</select></div>';
  }
  function saveWorker(){
    var name=(q('pwName')?.value||'').trim();
    if(!name){alert('Full name is required.');return;}
    var w=editingWorkerId?getWorker(editingWorkerId):{id:uid('worker'),createdAt:new Date().toISOString()};
    if(!w)return;
    w.workerCode=(q('pwCode')?.value||'').trim();
    w.name=name;
    w.phone=(q('pwPhone')?.value||'').trim();
    w.email=(q('pwEmail')?.value||'').trim();
    w.address=(q('pwAddress')?.value||'').trim();
    w.role=(q('pwRole')?.value||'').trim();
    w.department=q('pwDepartment')?.value||'Other';
    w.workerType=q('pwType')?.value||'Other';
    w.paymentMethod=q('pwPaymentMethod')?.value||'Mobile Money';
    w.momo=(q('pwMomo')?.value||'').trim();
    w.bank=(q('pwBank')?.value||'').trim();
    w.accountName=(q('pwAccountName')?.value||'').trim();
    w.accountNumber=(q('pwAccountNumber')?.value||'').trim();
    w.idRef=(q('pwIdRef')?.value||'').trim();
    w.emergency=(q('pwEmergency')?.value||'').trim();
    w.emergencyPhone=(q('pwEmergencyPhone')?.value||'').trim();
    w.status=q('pwStatus')?.value||'Active';
    w.notes=(q('pwNotes')?.value||'').trim();
    w.updatedAt=new Date().toISOString();
    var idx=STATE.workers.findIndex(function(x){return x.id===w.id;});
    if(idx>=0)STATE.workers[idx]=w;else STATE.workers.push(w);
    if(saveState()){editingWorkerId='';q('fbiPayrollWorkerFormWrap').innerHTML='';selectedWorkerId=w.id;renderAll();toastLocal('Worker saved');}
  }

  function renderWorkerProfile(){
    var el=q('fbiPayrollWorkerProfile');if(!el)return;
    var w=getWorker(selectedWorkerId);
    if(!w){el.innerHTML='<div class="fbi-payroll-profile"><h4>Worker Profile</h4><div class="fbi-payroll-empty">Select a worker from the directory to view the profile.</div></div>';return;}
    var pay=w.paymentMethod==='Mobile Money'?(w.momo||'Not provided'):(w.paymentMethod==='Bank'?((w.bank||'')+' · '+(w.accountNumber||'Not provided')):'Cash');
    el.innerHTML='<div class="fbi-payroll-profile"><h4>'+esc(w.name)+'</h4>'+
      profileRow('Worker ID',w.workerCode||'Not set')+
      profileRow('Role',w.role||'Not set')+
      profileRow('Department',w.department||'Not set')+
      profileRow('Worker Type',w.workerType||'Not set')+
      profileRow('Phone',w.phone||'Not set')+
      profileRow('Email',w.email||'Not set')+
      profileRow('Address',w.address||'Not set')+
      profileRow('Payment',w.paymentMethod||'Not set')+
      profileRow('Payment Details',pay)+
      profileRow('ID Reference',w.idRef||'Not set')+
      profileRow('Emergency Contact',w.emergency||'Not set')+
      profileRow('Emergency Phone',w.emergencyPhone||'Not set')+
      profileRow('Status',w.status||'Active')+
      (w.notes?profileRow('Notes',w.notes):'')+
      '<div style="display:flex;gap:7px;margin-top:12px"><button class="fbi-payroll-mini-btn" type="button" id="fbiPayrollProfileEdit">Edit</button></div></div>';
    q('fbiPayrollProfileEdit').onclick=function(){showWorkerForm(w);};
  }
  function profileRow(k,v){return '<div class="fbi-payroll-profile-row"><span>'+esc(k)+'</span><b>'+esc(v)+'</b></div>';}


  async function loadPayrollRegistrationRequests(){
    var el=q('fbiPayrollRegistrationRequests');if(!el)return;
    try{
      var res=await fetch('/api/payroll/registrations?status=pending',{cache:'no-store'});
      var body=await res.json().catch(function(){return{};});
      if(!res.ok||body.ok===false)throw new Error(body.error||'Registration requests could not be loaded.');
      payrollRegistrationRequests=Array.isArray(body.registrations)?body.registrations:[];
      renderPayrollRegistrationRequests();
      renderPayrollRegistrationOverview();
    }catch(err){
      console.warn('Payroll registration requests load failed:',err);
      el.innerHTML='<div class="fbi-payroll-empty">Could not load staff registration requests right now.</div>';
    }
  }
  function renderPayrollRegistrationOverview(){
    var el=q('fbiPayrollRegistrationOverviewList'),count=q('fbiPayrollRegistrationOverviewCount');
    if(!el)return;
    var rows=payrollRegistrationRequests||[];
    if(count)count.textContent=rows.length+' pending';
    if(!rows.length){
      el.innerHTML='<div class="fbi-payroll-empty">No new staff self-registrations are waiting for approval. The registration portal is ready for new staff applications.</div>';
      return;
    }
    el.innerHTML='<div class="fbi-payroll-table-wrap"><table class="fbi-payroll-table"><thead><tr><th>Staff Member</th><th>Email</th><th>Phone</th><th>Department</th><th>Submitted</th><th>Verification</th></tr></thead><tbody>'+
      rows.slice(0,8).map(function(r){
        var p=r.profile||{};
        var date=r.createdAt?new Date(r.createdAt).toLocaleString():'';
        return '<tr><td><b>'+esc(p.name||'')+'</b><span class="sub">'+esc(p.workerType||'')+' · '+esc(p.role||'Not provided')+'</span></td>'+
          '<td>'+esc(r.email||p.email||'')+'</td><td>'+esc(r.phone||p.phone||'')+'</td><td>'+esc(p.department||'')+'</td><td>'+esc(date)+'</td>'+
          '<td><div class="fbi-payroll-actions-cell"><button class="fbi-payroll-mini-btn primary" type="button" data-reg-approve-overview="'+esc(r.id)+'">Approve & Add</button><button class="fbi-payroll-mini-btn danger" type="button" data-reg-reject-overview="'+esc(r.id)+'">Reject</button></div></td></tr>';
      }).join('')+'</tbody></table></div>'+
      (rows.length>8?'<div style="margin-top:8px;color:#7f8997;font-size:9px">Showing the first 8 pending registrations. Open the verification queue to see all '+rows.length+'.</div>':'');
    el.querySelectorAll('[data-reg-approve-overview]').forEach(function(b){b.onclick=function(){approvePayrollRegistration(b.dataset.regApproveOverview);};});
    el.querySelectorAll('[data-reg-reject-overview]').forEach(function(b){b.onclick=function(){rejectPayrollRegistration(b.dataset.regRejectOverview);};});
  }

  function renderPayrollRegistrationRequests(){
    var targets=[q('fbiPayrollRegistrationRequests'),q('fbiPayrollRegistrationRequestsMain')].filter(function(x){return !!x;});
    if(!targets.length)return;
    var rows=payrollRegistrationRequests||[];
    var counts=[q('fbiPayrollRegistrationCount'),q('fbiPayrollRegistrationMainCount')].filter(function(x){return !!x;});
    counts.forEach(function(count){count.textContent=rows.length+' pending';});
    if(q('fbiPayrollRegistrationTab'))q('fbiPayrollRegistrationTab').textContent='Staff Verification'+(rows.length?' ('+rows.length+')':'');
    var html;
    if(!rows.length){html='<div class="fbi-payroll-empty">No new staff self-registrations are waiting for approval.</div>';}
    else {
      html='<div class="fbi-payroll-table-wrap"><table class="fbi-payroll-table"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Department</th><th>Submitted</th><th>Actions</th></tr></thead><tbody>'+
        rows.map(function(r){
          var p=r.profile||{};
          var date=r.createdAt?new Date(r.createdAt).toLocaleString():'';
          return '<tr><td><b>'+esc(p.name||'')+'</b><span class="sub">'+esc(p.workerType||'')+'</span></td>'+
            '<td>'+esc(r.email||p.email||'')+'</td><td>'+esc(r.phone||p.phone||'')+'</td><td>'+esc(p.role||'Not provided')+'</td>'+
            '<td>'+esc(p.department||'')+'</td><td>'+esc(date)+'</td><td><div class="fbi-payroll-actions-cell">'+
            '<button class="fbi-payroll-mini-btn primary" type="button" data-reg-approve="'+esc(r.id)+'">Approve & Add</button>'+ 
            '<button class="fbi-payroll-mini-btn danger" type="button" data-reg-reject="'+esc(r.id)+'">Reject</button>'+ 
            '</div></td></tr>';
        }).join('')+'</tbody></table></div>';
    }
    targets.forEach(function(el){
      el.innerHTML=html;
      el.querySelectorAll('[data-reg-approve]').forEach(function(b){b.onclick=function(){approvePayrollRegistration(b.dataset.regApprove);};});
      el.querySelectorAll('[data-reg-reject]').forEach(function(b){b.onclick=function(){rejectPayrollRegistration(b.dataset.regReject);};});
    });
  }

  async function approvePayrollRegistration(idv){
    var req=payrollRegistrationRequests.find(function(x){return String(x.id)===String(idv);});if(!req)return;
    var p=req.profile||{};
    if(!confirm('Approve '+(p.name||req.email)+' and add/link this person to the Payroll Staff Directory?'))return;
    try{
      var res=await fetch('/api/payroll/registrations/'+encodeURIComponent(idv)+'/approve',{method:'POST',headers:{'Content-Type':'application/json'},cache:'no-store'});
      var body=await res.json().catch(function(){return{};});
      if(!res.ok||body.ok===false)throw new Error(body.error||'Registration approval failed.');
      await hydratePayrollCloud();
      await loadPayrollRegistrationRequests();
      if(body.worker&&body.worker.id)selectedWorkerId=body.worker.id;
      renderAll();
      toastLocal((p.name||'Staff member')+' was added to Payroll.');
    }catch(err){alert(err.message||'Could not approve this registration.');}
  }
  async function rejectPayrollRegistration(idv){
    var req=payrollRegistrationRequests.find(function(x){return String(x.id)===String(idv);});if(!req)return;
    var p=req.profile||{};
    if(!confirm('Reject the staff registration for '+(p.name||req.email)+'?'))return;
    try{
      var res=await fetch('/api/payroll/registrations/'+encodeURIComponent(idv)+'/reject',{method:'POST',headers:{'Content-Type':'application/json'},cache:'no-store'});
      var body=await res.json().catch(function(){return{};});
      if(!res.ok||body.ok===false)throw new Error(body.error||'Registration rejection failed.');
      await loadPayrollRegistrationRequests();
      toastLocal('Staff registration rejected.');
    }catch(err){alert(err.message||'Could not reject this registration.');}
  }

  function renderWorkers(){
    var el=q('fbiPayrollWorkersTable');if(!el)return;
    if(!STATE.workers.length){el.innerHTML='<div class="fbi-payroll-empty">No workers yet. Add your first worker to start Payroll.</div>';return;}
    el.innerHTML='<div class="fbi-payroll-table-wrap"><table class="fbi-payroll-table"><thead><tr><th>Name</th><th>Worker Type</th><th>Department</th><th>Role</th><th>Payment</th><th>Status</th><th>Actions</th></tr></thead><tbody>'+
      STATE.workers.slice().sort(function(a,b){return String(a.name||'').localeCompare(String(b.name||''));}).map(function(w){
        var count=STATE.records.filter(function(r){return r.workerId===w.id;}).length;
        var pay=w.paymentMethod==='Mobile Money'?(w.momo||''):(w.paymentMethod==='Bank'?((w.bank||'')+' '+(w.accountNumber||'')):'Cash');
        return '<tr'+(selectedWorkerId===w.id?' style="background:rgba(189,27,99,.06)"':'')+'><td><b>'+esc(w.name)+'</b><span class="sub">'+esc(w.workerCode||'')+'</span></td>'+
          '<td>'+esc(w.workerType||'')+'</td><td>'+esc(w.department||'')+'</td><td>'+esc(w.role||'')+'<span class="sub">'+count+' payroll record'+(count===1?'':'s')+'</span></td>'+
          '<td>'+esc(w.paymentMethod||'')+'<span class="sub">'+esc(pay)+'</span></td><td>'+activeBadge(w.status||'Active')+'</td>'+
          '<td><div class="fbi-payroll-actions-cell"><button class="fbi-payroll-mini-btn" type="button" data-w-view="'+esc(w.id)+'">View</button><button class="fbi-payroll-mini-btn" type="button" data-w-edit="'+esc(w.id)+'">Edit</button><button class="fbi-payroll-mini-btn danger" type="button" data-w-delete="'+esc(w.id)+'">Delete</button></div></td></tr>';
      }).join('')+'</tbody></table></div>';
    el.querySelectorAll('[data-w-view]').forEach(function(b){b.onclick=function(){selectedWorkerId=b.dataset.wView;renderAll();};});
    el.querySelectorAll('[data-w-edit]').forEach(function(b){b.onclick=function(){showWorkerForm(getWorker(b.dataset.wEdit));};});
    el.querySelectorAll('[data-w-delete]').forEach(function(b){b.onclick=function(){deleteWorker(b.dataset.wDelete);};});
  }
  function activeBadge(s){return '<span class="fbi-payroll-badge '+(s==='Active'?'active':'inactive')+'">'+esc(s)+'</span>';}
  function deleteWorker(idv){
    if(STATE.records.some(function(r){return r.workerId===idv;})){alert('This worker has payroll records. Set the worker to Inactive instead of deleting the profile.');return;}
    if(!confirm('Delete this worker profile?'))return;
    STATE.workers=STATE.workers.filter(function(w){return w.id!==idv;});
    payrollPendingDeletes.workers.push(idv);
    if(selectedWorkerId===idv)selectedWorkerId='';
    saveState();renderAll();
  }

  function showRecordForm(existing){
    tabs('records');
    editingRecordId=existing?existing.id:'';
    var r=normalizeRecord(existing||{});
    var inv=selectedInvoice(r.invoiceId);
    var defaultProject=r.project|| (inv?((inv.no||'')+' · '+(inv.client||'')):'');
    var defaultDate=r.workDate|| (inv?(inv.eventDate||inv.date||today()):today());
    q('fbiPayrollRecordFormWrap').innerHTML=
      '<div class="fbi-payroll-card" style="margin-bottom:12px">'+
      '<div class="fbi-payroll-section-head"><div><h3>'+(existing?'Edit Payroll Record':'New Payroll Record')+'</h3><p>Individual worker earnings for an event, day, installation or other work.</p></div></div>'+
      '<div class="fbi-payroll-info">The Invoice / Job link below is read-only. Selecting an invoice only references it; Payroll never edits or saves anything into the invoice record.</div>'+
      '<div class="fbi-payroll-form">'+
        '<div class="fbi-payroll-field full"><label>Linked Invoice / Job</label><select id="prInvoice">'+invoiceOptions(r.invoiceId)+'</select></div>'+
        '<div class="fbi-payroll-field"><label>Worker</label><select id="prWorker">'+workerSelectOptions(r.workerId)+'</select></div>'+
        field('Project / Event','prProject',defaultProject,'text','Project or event')+
        field('Work Date','prDate',defaultDate,'date','')+
        selectField('Pay Basis','prBasis',['Per Event','Per Day','Per Installation','Other'],r.basis||'Per Event')+
        field('Role / Work Description','prRole',r.role||'','text','Work performed',true)+
        field('Rate','prRate',r.rate||0,'number','0.00')+
        field('Quantity','prQty',r.qty||1,'number','1')+
        field('Transport Allowance','prTransport',r.transport||0,'number','0.00')+
        field('Feeding Allowance','prFeeding',r.feeding||0,'number','0.00')+
        field('Accommodation','prAccommodation',r.accommodation||0,'number','0.00')+
        field('Overtime','prOvertime',r.overtime||0,'number','0.00')+
        field('Other Allowance','prOtherAllowance',r.otherAllowance||0,'number','0.00')+
        field('General Allowance','prAllowance',r.allowance||0,'number','0.00')+
        field('Bonus','prBonus',r.bonus||0,'number','0.00')+
        field('Deductions','prDeduction',r.deduction||0,'number','0.00')+
        field('Advance','prAdvance',r.advance||0,'number','0.00')+
        field('Previous Balance Owed','prPreviousBalance',r.previousBalance||0,'number','0.00')+
        field('Notes','prNotes',r.notes||'','text','Additional notes',true)+
      '</div>'+
      '<div class="fbi-payroll-summary">'+
        '<div class="fbi-payroll-summary-item"><span>Base Pay</span><b id="prBase">GH₵0.00</b></div>'+
        '<div class="fbi-payroll-summary-item"><span>Allowances + Bonus</span><b id="prAllowances">GH₵0.00</b></div>'+
        '<div class="fbi-payroll-summary-item"><span>Gross Pay</span><b id="prGross">GH₵0.00</b></div>'+
        '<div class="fbi-payroll-summary-item"><span>Deductions</span><b id="prDeductions">GH₵0.00</b></div>'+
        '<div class="fbi-payroll-summary-item"><span>Net Pay</span><b id="prNet">GH₵0.00</b></div>'+
        '<div class="fbi-payroll-summary-item"><span>Status</span><b id="prStatus">Pending</b></div>'+
      '</div>'+
      '<div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px"><button class="btn" type="button" id="prCancel">Cancel</button><button class="btn primary" type="button" id="prSave">Save Payroll Record</button></div>'+
      '</div>';
    ['prRate','prQty','prTransport','prFeeding','prAccommodation','prOvertime','prOtherAllowance','prAllowance','prBonus','prDeduction','prAdvance','prPreviousBalance'].forEach(function(idv){q(idv).addEventListener('input',previewRecord);});
    q('prInvoice').addEventListener('change',function(){
      var ix=selectedInvoice(this.value);
      if(ix){
        if(!q('prProject').value)q('prProject').value=(ix.no||'Invoice')+' · '+(ix.client||'');
        if(q('prDate').value===today()&&ix.eventDate)q('prDate').value=ix.eventDate;
        if(!q('prRole').value&&ix.serviceCategory)q('prRole').value=ix.serviceCategory;
      }
    });
    q('prSave').onclick=saveRecord;
    q('prCancel').onclick=function(){editingRecordId='';q('fbiPayrollRecordFormWrap').innerHTML='';renderAll();};
    previewRecord();
  }
  function previewRecord(){
    var r=formRecord();
    q('prBase').textContent=money(basePay(r));
    q('prAllowances').textContent=money(allowances(r));
    q('prGross').textContent=money(gross(r));
    q('prDeductions').textContent=money(num(r.deduction)+num(r.advance)-num(r.previousBalance));
    q('prNet').textContent=money(net(r));
    q('prStatus').textContent='Pending';
  }
  function formRecord(){
    return normalizeRecord({
      rate:num(q('prRate')?.value),qty:num(q('prQty')?.value)||1,
      transport:num(q('prTransport')?.value),feeding:num(q('prFeeding')?.value),accommodation:num(q('prAccommodation')?.value),
      overtime:num(q('prOvertime')?.value),otherAllowance:num(q('prOtherAllowance')?.value),allowance:num(q('prAllowance')?.value),bonus:num(q('prBonus')?.value),
      deduction:num(q('prDeduction')?.value),advance:num(q('prAdvance')?.value),previousBalance:num(q('prPreviousBalance')?.value)
    });
  }
  function saveRecord(){
    var wid=q('prWorker')?.value||'';
    if(!wid){alert('Select a worker.');return;}
    var existing=editingRecordId?STATE.records.find(function(x){return x.id===editingRecordId;}):null;
    var r=existing||{id:uid('payroll'),createdAt:new Date().toISOString(),payments:[]};
    r.workerId=wid;
    r.invoiceId=q('prInvoice')?.value||'';
    r.project=(q('prProject')?.value||'').trim();
    r.workDate=q('prDate')?.value||today();
    r.basis=q('prBasis')?.value||'Per Event';
    r.role=(q('prRole')?.value||'').trim();
    r.rate=num(q('prRate')?.value);
    r.qty=Math.max(1,num(q('prQty')?.value)||1);
    r.transport=num(q('prTransport')?.value);
    r.feeding=num(q('prFeeding')?.value);
    r.accommodation=num(q('prAccommodation')?.value);
    r.overtime=num(q('prOvertime')?.value);
    r.otherAllowance=num(q('prOtherAllowance')?.value);
    r.allowance=num(q('prAllowance')?.value);
    r.bonus=num(q('prBonus')?.value);
    r.deduction=num(q('prDeduction')?.value);
    r.advance=num(q('prAdvance')?.value);
    r.previousBalance=num(q('prPreviousBalance')?.value);
    r.notes=(q('prNotes')?.value||'').trim();
    normalizeRecord(r);
    r.updatedAt=new Date().toISOString();
    var idx=STATE.records.findIndex(function(x){return x.id===r.id;});
    if(idx>=0)STATE.records[idx]=r;else STATE.records.push(r);
    if(saveState()){editingRecordId='';q('fbiPayrollRecordFormWrap').innerHTML='';renderAll();toastLocal(existing?'Payroll record updated':'Payroll record saved');}
  }

  function renderRecords(){
    var el=q('fbiPayrollRecordsTable');if(!el)return;
    if(!STATE.records.length){el.innerHTML='<div class="fbi-payroll-empty">No payroll records yet. Create a payroll record for a worker or project.</div>';return;}
    el.innerHTML='<div class="fbi-payroll-table-wrap"><table class="fbi-payroll-table"><thead><tr><th>Worker / Job</th><th>Work Date</th><th>Basis</th><th class="num">Gross</th><th class="num">Net</th><th class="num">Paid</th><th class="num">Balance</th><th>Status</th><th>Actions</th></tr></thead><tbody>'+
      STATE.records.slice().sort(function(a,b){return String(b.workDate||'').localeCompare(String(a.workDate||''));}).map(function(r){
        var w=getWorker(r.workerId),s=status(r),ix=selectedInvoice(r.invoiceId);
        return '<tr><td><b>'+esc(w?.name||'Unknown worker')+'</b><span class="sub">'+esc(ix?(ix.no||'Invoice')+' · '+(ix.client||''):r.project||'Independent work')+'</span></td>'+
          '<td>'+esc(r.workDate||'')+'</td><td>'+esc(r.basis||'')+'<span class="sub">'+esc(r.role||'')+'</span></td>'+
          '<td class="num">'+esc(money(gross(r)))+'</td><td class="num">'+esc(money(net(r)))+'</td><td class="num">'+esc(money(paid(r)))+'</td><td class="num">'+esc(money(balance(r)))+'</td>'+
          '<td>'+badge(s)+'</td><td><div class="fbi-payroll-actions-cell">'+
            (balance(r)>0.005?'<button class="fbi-payroll-mini-btn primary" type="button" data-pay="'+esc(r.id)+'">Pay</button>':'')+
            '<button class="fbi-payroll-mini-btn" type="button" data-slip="'+esc(r.id)+'">Payslip</button>'+
            '<button class="fbi-payroll-mini-btn" type="button" data-edit-r="'+esc(r.id)+'">Edit</button>'+
            '<button class="fbi-payroll-mini-btn danger" type="button" data-delete-r="'+esc(r.id)+'">Delete</button>'+
          '</div></td></tr>';
      }).join('')+'</tbody></table></div>';
    el.querySelectorAll('[data-pay]').forEach(function(b){b.onclick=function(){openPayment(b.dataset.pay);};});
    el.querySelectorAll('[data-slip]').forEach(function(b){b.onclick=function(){generatePayslip(b.dataset.slip,true);};});
    el.querySelectorAll('[data-edit-r]').forEach(function(b){b.onclick=function(){showRecordForm(STATE.records.find(function(r){return r.id===b.dataset.editR;}));};});
    el.querySelectorAll('[data-delete-r]').forEach(function(b){b.onclick=function(){deleteRecord(b.dataset.deleteR);};});
  }
  function deleteRecord(idv){
    if(!confirm('Delete this Payroll record?'))return;
    STATE.records=STATE.records.filter(function(r){return r.id!==idv;});
    var removedPayslips=STATE.payslips.filter(function(p){return p.recordId===idv;});
    STATE.payslips=STATE.payslips.filter(function(p){return p.recordId!==idv;});
    payrollPendingDeletes.records.push(idv);
    removedPayslips.forEach(function(p){if(p.id)payrollPendingDeletes.payslips.push(p.id);});
    saveState();renderAll();toastLocal('Payroll record deleted');
  }

  function openPayment(idv){
    var r=STATE.records.find(function(x){return x.id===idv;});if(!r)return;
    paymentRecordId=idv;
    q('fbiPayrollPaymentBalance').textContent=money(balance(r));
    q('fbiPayrollPaymentAmount').value=balance(r).toFixed(2);
    q('fbiPayrollPaymentDate').value=today();
    var w=getWorker(r.workerId);
    q('fbiPayrollPaymentMethod').value=r.paymentMethod||w?.paymentMethod||'Mobile Money';
    q('fbiPayrollPaymentRef').value='';
    q('fbiPayrollPaymentBy').value='';
    q('fbiPayrollPaymentNotes').value='';
    q('fbiPayrollPaymentModal').classList.add('show');
    q('fbiPayrollPaymentModal').setAttribute('aria-hidden','false');
  }
  function closePayment(){paymentRecordId='';q('fbiPayrollPaymentModal').classList.remove('show');q('fbiPayrollPaymentModal').setAttribute('aria-hidden','true');}
  async function savePayment(){
    var r=STATE.records.find(function(x){return x.id===paymentRecordId;});if(!r)return;
    var amount=num(q('fbiPayrollPaymentAmount').value),bal=balance(r);
    if(amount<=0||amount>bal+0.005){alert('Enter a payment amount up to '+money(bal)+'.');return;}
    var method=q('fbiPayrollPaymentMethod').value||'';
    var ref=(q('fbiPayrollPaymentRef').value||'').trim();
    var by=(q('fbiPayrollPaymentBy').value||'').trim();
    var note=(q('fbiPayrollPaymentNotes').value||'').trim();
    if(!ref){alert('Enter the transaction / payment reference.');return;}
    if(!by){alert('Enter who made the payment.');return;}
    r.payments=r.payments||[];
    r.payments.push({id:uid('payment'),date:q('fbiPayrollPaymentDate').value||today(),amount:amount,method:method,reference:ref,paidBy:by,notes:note});
    r.lastPaymentDate=q('fbiPayrollPaymentDate').value||today();
    r.lastPaymentMethod=method;
    r.lastPaymentReference=ref;
    r.lastPaidBy=by;
    r.updatedAt=new Date().toISOString();
    const cloudSaved=await saveStateAndWait();
    closePayment();renderAll();
    toastLocal(cloudSaved?(status(r)==='Paid'?'Payroll fully paid':'Partial payroll payment recorded'):'Payment saved locally; cloud sync is retrying');
  }

  function renderOverview(){
    var rows=STATE.records.slice().sort(function(a,b){return String(b.workDate||"").localeCompare(String(a.workDate||""));});
    var now=new Date();
    var period=q("fbiPayrollOverviewPeriod")?q("fbiPayrollOverviewPeriod").value:"all";
    function inPeriod(r){
      if(period==="all")return true;
      var d=new Date((r.workDate||today())+"T00:00:00");
      if(Number.isNaN(d.getTime()))return false;
      if(period==="month")return d.getMonth()===now.getMonth()&&d.getFullYear()===now.getFullYear();
      var qNow=Math.floor(now.getMonth()/3),qDay=Math.floor(d.getMonth()/3);
      return qNow===qDay&&d.getFullYear()===now.getFullYear();
    }
    var scoped=rows.filter(inPeriod);
    var grossTotal=scoped.reduce(function(s,r){return s+gross(r);},0);
    var netTotal=scoped.reduce(function(s,r){return s+net(r);},0);
    var paidTotal=scoped.reduce(function(s,r){return s+paid(r);},0);
    var balTotal=scoped.reduce(function(s,r){return s+balance(r);},0);
    var activeWorkers=STATE.workers.filter(function(w){return (w.status||"Active")==="Active";}).length;
    var paidPct=netTotal>0?Math.max(0,Math.min(100,paidTotal/netTotal*100)):0;
    var pending=scoped.filter(function(r){return status(r)!=="Paid";}).length;

    function kpi(label,value,meta,cls){
      return "<div class='fbi-payroll-kpi "+cls+"'><span>"+esc(label)+"</span><b>"+esc(value)+"</b><small>"+esc(meta)+"</small></div>";
    }
    if(q("fbiPayrollDashboardKpis")){
      q("fbiPayrollDashboardKpis").innerHTML=
        kpi("Net Payroll",money(netTotal),scoped.length+" records","gold")+
        kpi("Paid",money(paidTotal),Math.round(paidPct)+"% settled","green")+
        kpi("Outstanding",money(balTotal),pending+" records still due","orange")+
        kpi("Active Workers",String(activeWorkers),STATE.workers.length+" total workers","blue")+
        kpi("Payroll Records",String(scoped.length),"work records in period","pink");
    }
    if(q("fbiPayrollOverviewPeriod")&&!q("fbiPayrollOverviewPeriod").dataset.bound){
      q("fbiPayrollOverviewPeriod").dataset.bound="1";
      q("fbiPayrollOverviewPeriod").addEventListener("change",renderOverview);
    }

    var monthNames=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"],months=[];
    for(var i=5;i>=0;i--){
      var md=new Date(now.getFullYear(),now.getMonth()-i,1);
      months.push({key:md.getFullYear()+"-"+String(md.getMonth()+1).padStart(2,"0"),label:monthNames[md.getMonth()]});
    }
    var mvals=months.map(function(m){
      var list=scoped.filter(function(r){return String(r.workDate||"").slice(0,7)===m.key;});
      return {label:m.label,net:list.reduce(function(s,r){return s+net(r);},0),paid:list.reduce(function(s,r){return s+paid(r);},0)};
    });
    var mx=Math.max(1,Math.max.apply(Math,mvals.map(function(x){return x.net;})));
    if(q("fbiPayrollChartRange"))q("fbiPayrollChartRange").textContent=period==="all"?"Last 6 months":period==="month"?"This month":"This quarter";
    if(q("fbiPayrollCashflowChart")){
      q("fbiPayrollCashflowChart").innerHTML=mvals.map(function(x){
        var nw=x.net/mx*100,pw=x.paid/mx*100;
        return "<div class='fbi-payroll-chart-row'><div class='fbi-payroll-chart-label'>"+esc(x.label)+"</div><div class='fbi-payroll-bars'><div class='fbi-payroll-bar-track'><div class='fbi-payroll-bar-fill net' style='width:"+nw.toFixed(1)+"%'></div></div><div class='fbi-payroll-bar-track'><div class='fbi-payroll-bar-fill paid' style='width:"+pw.toFixed(1)+"%'></div></div></div><div class='fbi-payroll-chart-value'>"+esc(money(x.net))+"</div></div>";
      }).join("");
    }

    var pctDeg=Math.round(paidPct*3.6);
    if(q("fbiPayrollHealth")){
      q("fbiPayrollHealth").innerHTML=
        "<div class='fbi-payroll-health'>"+
          "<div class='fbi-payroll-donut' style='background:conic-gradient(#43b977 0deg "+pctDeg+"deg,#dfe7e4 "+pctDeg+"deg 360deg)'><b>"+Math.round(paidPct)+"%</b></div>"+
          "<div class='fbi-payroll-health-copy'><b>"+esc(paidPct>=100?"Fully settled":paidPct>=70?"Healthy payment position":paidPct>0?"Payments in progress":"No payments yet")+"</b>"+
          "<small>"+esc(money(paidTotal))+" paid from "+esc(money(netTotal))+" net payroll.</small>"+
          "<div class='fbi-payroll-health-stats'>"+
            "<div class='fbi-payroll-health-stat'><span>Gross</span><b>"+esc(money(grossTotal))+"</b></div>"+
            "<div class='fbi-payroll-health-stat'><span>Outstanding</span><b>"+esc(money(balTotal))+"</b></div>"+
            "<div class='fbi-payroll-health-stat'><span>Pending / Partial</span><b>"+pending+"</b></div>"+
          "</div></div>"+
        "</div>";
    }

    var activity=[];
    scoped.forEach(function(r){
      var w=getWorker(r.workerId)||{};
      var ps=Array.isArray(r.payments)?r.payments:[];
      if(ps.length){
        ps.forEach(function(p){activity.push({type:"payment",date:p.date||r.workDate||"",name:w.name||"Unknown worker",meta:(r.project||r.role||"Payroll payment")+" · "+(p.method||""),amount:num(p.amount),recordId:r.id});});
      }else{
        activity.push({type:"work",date:r.workDate||"",name:w.name||"Unknown worker",meta:(r.project||r.role||"Payroll work")+" · "+(r.basis||""),amount:net(r),recordId:r.id});
      }
    });
    activity.sort(function(a,b){return String(b.date||"").localeCompare(String(a.date||""));});
    activity=activity.slice(0,7);
    if(q("fbiPayrollRecentActivity")){
      q("fbiPayrollRecentActivity").innerHTML=activity.length?activity.map(function(item){
        var initials=String(item.name||"W").trim().split(/\\s+/).slice(0,2).map(function(s){return s.charAt(0);}).join("").toUpperCase();
        return "<div class='fbi-payroll-list-row'><div class='fbi-payroll-avatar'>"+esc(initials||"W")+"</div><div class='grow'><b>"+esc(item.name)+"</b><small>"+esc(item.meta)+" · "+esc(item.date)+"</small></div><div class='fbi-payroll-list-amount'><b>"+esc(money(item.amount))+"</b><small>"+esc(item.type==="payment"?"Paid":"Net")+"</small></div></div>";
      }).join(""):"<div class='fbi-payroll-empty'>No payroll activity yet.</div>";
    }

    var dept={};
    scoped.forEach(function(r){
      var w=getWorker(r.workerId)||{},key=w.department||"Unassigned";
      dept[key]=(dept[key]||0)+net(r);
    });
    var depts=Object.keys(dept).sort(function(a,b){return dept[b]-dept[a];}).slice(0,6);
    var dmax=depts.length?Math.max.apply(Math,depts.map(function(k){return dept[k];})):1;
    if(q("fbiPayrollDepartments")){
      q("fbiPayrollDepartments").innerHTML=depts.length?depts.map(function(k){
        return "<div class='fbi-payroll-dept-row'><div><div class='fbi-payroll-dept-label'>"+esc(k)+"</div><div class='fbi-payroll-dept-bar'><div class='fbi-payroll-dept-fill' style='width:"+((dept[k]/dmax)*100).toFixed(1)+"%'></div></div></div><div class='fbi-payroll-chart-value'>"+esc(money(dept[k]))+"</div></div>";
      }).join(""):"<div class='fbi-payroll-empty'>Department totals will appear when payroll records exist.</div>";
    }

    var recent=rows.slice(0,10);
    if(q("fbiPayrollOverviewTable")){
      q("fbiPayrollOverviewTable").innerHTML=recent.length?
        "<div class='fbi-payroll-table-wrap'><table class='fbi-payroll-table'><thead><tr><th>Worker</th><th>Project / Event</th><th>Date</th><th class='num'>Net</th><th class='num'>Paid</th><th class='num'>Balance</th><th>Status</th></tr></thead><tbody>"+
        recent.map(function(r){
          var w=getWorker(r.workerId);
          return "<tr><td><b>"+esc(w&&w.name?w.name:"Unknown")+"</b><span class='sub'>"+esc(w&&w.role?w.role:"")+"</span></td><td>"+esc(r.project||r.role||"")+"</td><td>"+esc(r.workDate||"")+"</td><td class='num'>"+esc(money(net(r)))+"</td><td class='num'>"+esc(money(paid(r)))+"</td><td class='num'>"+esc(money(balance(r)))+"</td><td>"+badge(status(r))+"</td></tr>";
        }).join("")+
        "</tbody></table></div>":
        "<div class='fbi-payroll-empty'>No payroll activity yet. Create a worker and payroll record to populate the dashboard.</div>";
    }
  }
  function summary(k,v){return '<div class="fbi-payroll-summary-item"><span>'+esc(k)+'</span><b>'+esc(v)+'</b></div>';}

  function renderPayslips(){
    var el=q('fbiPayrollPayslipList');if(!el)return;
    if(!STATE.payslips.length){el.innerHTML='<div class="fbi-payroll-empty">No payslips generated yet. Generate a payslip from a Payroll Record after recording work or payment.</div>';return;}
    el.innerHTML='<div class="fbi-payroll-payslip-list">'+STATE.payslips.slice().sort(function(a,b){return String(b.generatedAt||'').localeCompare(String(a.generatedAt||''));}).map(function(p){
      var r=STATE.records.find(function(x){return x.id===p.recordId;}),w=r?getWorker(r.workerId):null;
      return '<div class="fbi-payroll-payslip-row"><div class="grow"><b>'+esc(p.payslipNo||'Payslip')+' · '+esc(w?.name||'Worker')+'</b><small>'+esc(r?.project||r?.role||'')+' · '+esc(r?.workDate||'')+' · '+esc(r?status(r):'')+'</small></div><strong>'+esc(money(r?net(r):0))+'</strong><button class="fbi-payroll-mini-btn" type="button" data-ps="'+esc(p.recordId)+'">Print</button></div>';
    }).join('')+'</div>';
    el.querySelectorAll('[data-ps]').forEach(function(b){b.onclick=function(){generatePayslip(b.dataset.ps,true);};});
  }
  function generatePayslip(recordId,printNow){
    var r=STATE.records.find(function(x){return x.id===recordId;});if(!r)return;
    var w=getWorker(r.workerId)||{},ix=selectedInvoice(r.invoiceId);
    var p=STATE.payslips.find(function(x){return x.recordId===recordId;});
    if(!p){p={id:uid('payslip'),recordId:recordId,payslipNo:'PAY'+String(STATE.payslips.length+1).padStart(4,'0'),generatedAt:new Date().toISOString()};STATE.payslips.push(p);saveState();}
    var last=r.payments&&r.payments.length?r.payments[r.payments.length-1]:null;
    var doc='<div class="paydoc"><div class="paydoc-head"><div><div class="kicker">FILM BEYOND IMAGINATION (FBI)</div><h1>PAYSLIP</h1><p>Professional Payroll Statement</p></div><div class="meta"><b>'+esc(p.payslipNo)+'</b><span>'+esc(r.workDate||'')+'</span></div></div>'+
      '<div class="grid">'+cell('Employee',w.name||'')+cell('Worker ID',w.workerCode||'')+cell('Role',w.role||'')+cell('Department',w.department||'')+cell('Worker Type',w.workerType||'')+cell('Payment Basis',r.basis||'')+cell('Project / Event',r.project||'')+cell('Linked Invoice',ix?(ix.no||''):'Independent work')+'</div>'+
      '<table><thead><tr><th>Description</th><th class="r">Amount</th></tr></thead><tbody>'+
      row('Rate × Quantity',basePay(r))+row('Transport Allowance',r.transport)+row('Feeding Allowance',r.feeding)+row('Accommodation',r.accommodation)+row('Overtime',r.overtime)+row('Other Allowance',r.otherAllowance)+row('General Allowance',r.allowance)+row('Bonus',r.bonus)+
      '<tr class="strong"><td>Gross Pay</td><td class="r">'+money(gross(r))+'</td></tr>'+
      row('Deductions',-num(r.deduction))+row('Advance',-num(r.advance))+row('Previous Balance Owed',num(r.previousBalance))+
      '<tr class="net"><td>NET PAY</td><td class="r">'+money(net(r))+'</td></tr>'+
      '</tbody></table>'+
      '<div class="payment-box"><div><span>Amount Paid</span><b>'+money(paid(r))+'</b></div><div><span>Balance</span><b>'+money(balance(r))+'</b></div><div><span>Status</span><b>'+esc(status(r))+'</b></div></div>'+
      (last?'<div class="payment-detail"><b>Latest Payment</b><p>'+esc(last.date||'')+' · '+esc(last.method||'')+' · Ref '+esc(last.reference||'')+' · Paid by '+esc(last.paidBy||'')+'</p></div>':'')+
      '<div class="footer">Worker payment method: '+esc(w.paymentMethod||'')+(w.momo?' · MoMo '+esc(w.momo):'')+(w.bank?' · Bank '+esc(w.bank):'')+'<br>Generated '+esc(new Date().toLocaleString())+'</div></div>';
    var win=window.open('','_blank');
    if(!win){alert('Please allow pop-ups to print the payslip.');return;}
    win.document.write('<!doctype html><html><head><meta charset="utf-8"><title>'+esc(p.payslipNo)+' - Payslip</title><style>'+
      'body{font-family:Arial,sans-serif;background:#f4f5f7;color:#1c222b;padding:24px}.paydoc{width:min(760px,100%);margin:auto;background:#fff;padding:30px;border:1px solid #dde2e8;border-radius:12px}.paydoc-head{display:flex;justify-content:space-between;border-bottom:2px solid #222;padding-bottom:16px}.kicker{font-size:9px;letter-spacing:1.5px;font-weight:800;color:#8b6b2b}.paydoc h1{font-size:28px;margin:6px 0 2px}.paydoc p{margin:0;color:#6d7682;font-size:10px}.meta{text-align:right}.meta b{display:block;font-size:18px}.meta span{display:block;font-size:10px;color:#6d7682;margin-top:5px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:18px 0}.cell{border:1px solid #e0e4e9;background:#fafbfc;border-radius:8px;padding:9px}.cell span{display:block;font-size:7.5px;text-transform:uppercase;letter-spacing:.6px;color:#7f8792}.cell b{display:block;font-size:10px;margin-top:4px}.paydoc table{width:100%;border-collapse:collapse;margin-top:12px}.paydoc th{background:#151a21;color:#fff;padding:9px;text-align:left;font-size:8px;text-transform:uppercase}.paydoc td{border-bottom:1px solid #e6e9ed;padding:8px;font-size:9px}.r{text-align:right}.strong td{font-weight:800}.net td{background:#151a21;color:#fff;font-weight:900;font-size:12px}.payment-box{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:16px}.payment-box div{border:1px solid #e0e4e9;border-radius:8px;padding:10px}.payment-box span{display:block;font-size:7.5px;text-transform:uppercase;color:#7f8792}.payment-box b{display:block;font-size:13px;margin-top:4px}.payment-detail{margin-top:13px;padding:10px;border-left:3px solid #b48b2f;background:#fff9e7;font-size:9px}.footer{margin-top:22px;padding-top:11px;border-top:1px solid #e0e4e9;color:#707985;font-size:8px;line-height:1.5}@media print{body{background:#fff;padding:0}.paydoc{border:0;border-radius:0;width:100%;padding:0}}\n    </style></head><body>'+doc+'<script>window.onload=function(){window.print()}<\\/script></body></html>');
    win.document.close();
    tabs('payslips');
    toastLocal('Payslip '+p.payslipNo+' generated');
  }
  function cell(k,v){return '<div class="cell"><span>'+esc(k)+'</span><b>'+esc(v)+'</b></div>';}
  function row(k,v){return '<tr><td>'+esc(k)+'</td><td class="r">'+money(v)+'</td></tr>';}

  function reportRows(){
    var from=q('fbiPayrollReportFrom')?.value||'',to=q('fbiPayrollReportTo')?.value||'',wid=q('fbiPayrollReportWorker')?.value||'',dept=q('fbiPayrollReportDepartment')?.value||'',project=(q('fbiPayrollReportProject')?.value||'').trim().toLowerCase(),st=q('fbiPayrollReportStatus')?.value||'';
    return STATE.records.filter(function(r){
      var w=getWorker(r.workerId)||{},d=String(r.workDate||'').slice(0,10);
      if(from&&(!d||d<from))return false;if(to&&(!d||d>to))return false;if(wid&&r.workerId!==wid)return false;if(dept&&String(w.department||'')!==dept)return false;
      if(project&&!String(r.project||'').toLowerCase().includes(project))return false;if(st&&status(r)!==st)return false;return true;
    }).sort(function(a,b){return String(b.workDate||'').localeCompare(String(a.workDate||''));});
  }
  function fillReportWorker(){
    var s=q('fbiPayrollReportWorker');if(!s)return;var current=s.value;
    s.innerHTML='<option value="">All Workers</option>'+STATE.workers.slice().sort(function(a,b){return String(a.name||'').localeCompare(String(b.name||''));}).map(function(w){return '<option value="'+esc(w.id)+'">'+esc(w.name)+'</option>';}).join('');
    if(STATE.workers.some(function(w){return w.id===current}))s.value=current;
  }
  function renderReports(){
    fillReportWorker();
    var rows=reportRows(),netTotal=rows.reduce(function(s,r){return s+net(r);},0),paidTotal=rows.reduce(function(s,r){return s+paid(r);},0),balTotal=rows.reduce(function(s,r){return s+balance(r);},0),grossTotal=rows.reduce(function(s,r){return s+gross(r);},0);
    q('fbiPayrollReportSummary').innerHTML=summary('Records',rows.length)+summary('Gross',money(grossTotal))+summary('Net Pay',money(netTotal))+summary('Paid',money(paidTotal))+summary('Outstanding',money(balTotal));
    var el=q('fbiPayrollReportTable');if(!rows.length){el.innerHTML='<div class="fbi-payroll-empty">No payroll records match these filters.</div>';return;}
    el.innerHTML='<div class="fbi-payroll-table-wrap"><table class="fbi-payroll-table"><thead><tr><th>Worker</th><th>Department</th><th>Project / Event</th><th>Date</th><th>Basis</th><th class="num">Rate</th><th class="num">Qty</th><th class="num">Net</th><th class="num">Paid</th><th class="num">Balance</th><th>Status</th><th>Payment Ref</th></tr></thead><tbody>'+
      rows.map(function(r){var w=getWorker(r.workerId),last=r.payments&&r.payments.length?r.payments[r.payments.length-1]:null;return '<tr><td>'+esc(w?.name||'Unknown')+'</td><td>'+esc(w?.department||'')+'</td><td>'+esc(r.project||r.role||'')+'</td><td>'+esc(r.workDate||'')+'</td><td>'+esc(r.basis||'')+'</td><td class="num">'+esc(money(r.rate))+'</td><td class="num">'+esc(r.qty)+'</td><td class="num">'+esc(money(net(r)))+'</td><td class="num">'+esc(money(paid(r)))+'</td><td class="num">'+esc(money(balance(r)))+'</td><td>'+badge(status(r))+'</td><td>'+esc(last?.reference||'')+'</td></tr>';}).join('')+
      '</tbody></table></div>';
  }
  function exportCsv(){
    var rows=reportRows(),headers=['Worker','Worker ID','Department','Worker Type','Project/Event','Linked Invoice','Work Date','Pay Basis','Role','Rate','Quantity','Gross Pay','Net Pay','Paid','Balance','Status','Last Payment Date','Payment Method','Payment Reference','Paid By'];
    var lines=[headers].concat(rows.map(function(r){var w=getWorker(r.workerId)||{},ix=selectedInvoice(r.invoiceId),last=r.payments&&r.payments.length?r.payments[r.payments.length-1]:null;return [w.name||'',w.workerCode||'',w.department||'',w.workerType||'',r.project||'',ix?.no||'',r.workDate||'',r.basis||'',r.role||'',r.rate||0,r.qty||1,gross(r),net(r),paid(r),balance(r),status(r),last?.date||'',last?.method||'',last?.reference||'',last?.paidBy||''];}));
    var csv=lines.map(function(row){return row.map(function(v){return '"'+String(v==null?'':v).replace(/"/g,'""')+'"';}).join(',');}).join('\\n');
    var blob=new Blob([csv],{type:'text/csv;charset=utf-8'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='FBI-Payroll-'+today()+'.csv';document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(a.href);a.remove();},1000);
  }
  function printReport(){
    var rows=reportRows(),grossTotal=rows.reduce(function(s,r){return s+gross(r);},0),netTotal=rows.reduce(function(s,r){return s+net(r);},0),paidTotal=rows.reduce(function(s,r){return s+paid(r);},0),balTotal=rows.reduce(function(s,r){return s+balance(r);},0);
    var table=rows.map(function(r){var w=getWorker(r.workerId);return '<tr><td>'+esc(w?.name||'')+'</td><td>'+esc(w?.department||'')+'</td><td>'+esc(r.project||'')+'</td><td>'+esc(r.workDate||'')+'</td><td>'+esc(r.basis||'')+'</td><td class="r">'+esc(money(net(r)))+'</td><td class="r">'+esc(money(paid(r)))+'</td><td class="r">'+esc(money(balance(r)))+'</td><td>'+esc(status(r))+'</td></tr>';}).join('');
    var html='<h1>FBI Payroll Report</h1><p>Generated '+esc(new Date().toLocaleString())+' · '+rows.length+' records</p><div class="cards"><div><span>Gross</span><b>'+esc(money(grossTotal))+'</b></div><div><span>Net</span><b>'+esc(money(netTotal))+'</b></div><div><span>Paid</span><b>'+esc(money(paidTotal))+'</b></div><div><span>Outstanding</span><b>'+esc(money(balTotal))+'</b></div></div><table><thead><tr><th>Worker</th><th>Department</th><th>Project/Event</th><th>Date</th><th>Basis</th><th>Net</th><th>Paid</th><th>Balance</th><th>Status</th></tr></thead><tbody>'+table+'</tbody></table>';
    var win=window.open('','_blank');if(!win){alert('Please allow pop-ups to print the Payroll report.');return;}
    win.document.write('<!doctype html><html><head><meta charset="utf-8"><title>FBI Payroll Report</title><style>body{font-family:Arial,sans-serif;padding:28px;color:#1b1f27}h1{margin:0 0 5px}p{color:#69717d;font-size:10px}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0}.cards div{border:1px solid #ddd;border-radius:8px;padding:10px}.cards span{display:block;color:#777;font-size:8px;text-transform:uppercase}.cards b{display:block;font-size:15px;margin-top:5px}table{width:100%;border-collapse:collapse}th,td{border:1px solid #ddd;padding:7px;font-size:8px;text-align:left}th{background:#151a21;color:#fff}.r{text-align:right}@media print{body{padding:0}}</style></head><body>'+html+'<script>window.onload=function(){window.print()}<\\/script></body></html>');
    win.document.close();
  }

  function renderStats(){
    var active=STATE.workers.filter(function(w){return (w.status||'Active')==='Active';}).length;
    q('fbiPayrollWorkerCount').textContent=String(STATE.workers.length);q('fbiPayrollWorkerMeta').textContent='Active '+active;
    q('fbiPayrollRecordCount').textContent=String(STATE.records.length);q('fbiPayrollRecordMeta').textContent='All work records';
    var netTotal=STATE.records.reduce(function(s,r){return s+net(r);},0),paidTotal=STATE.records.reduce(function(s,r){return s+paid(r);},0),balTotal=STATE.records.reduce(function(s,r){return s+balance(r);},0);
    q('fbiPayrollNetTotal').textContent=money(netTotal);q('fbiPayrollPaidTotal').textContent=money(paidTotal);q('fbiPayrollBalanceTotal').textContent=money(balTotal);
    q('fbiPayrollNetMeta').textContent=STATE.records.filter(function(r){return status(r)==='Paid';}).length+' fully paid records';
    q('fbiPayrollPaidMeta').textContent=STATE.records.filter(function(r){return paid(r)>0;}).length+' records with payments';
    q('fbiPayrollBalanceMeta').textContent=STATE.records.filter(function(r){return balance(r)>0.005;}).length+' records still due';
  }

  function renderAll(){
    renderStats();
    renderOverview();
    renderWorkerProfile();
    renderWorkers();
    renderRecords();
    renderPayslips();
    renderReports();
  }

  function openStaffRegistrationForm(){
    window.open('/payroll-staff-form.html','_blank','noopener');
  }

  function normalizeImportedWorker(raw){
    var w=raw&&raw.worker?raw.worker:raw||{};
    function s(v){return String(v==null?'':v).trim();}
    return {
      workerCode:s(w.workerCode),name:s(w.name),phone:s(w.phone),email:s(w.email),address:s(w.address),role:s(w.role),
      department:s(w.department)||'Other',workerType:s(w.workerType)||'Media Worker',paymentMethod:s(w.paymentMethod)||'Mobile Money',
      momo:s(w.momo),bank:s(w.bank),accountName:s(w.accountName),accountNumber:s(w.accountNumber),idRef:s(w.idRef),
      emergency:s(w.emergency),emergencyPhone:s(w.emergencyPhone),status:s(w.status)||'Active',notes:s(w.notes),
      dateOfBirth:s(w.dateOfBirth),gender:s(w.gender),maritalStatus:s(w.maritalStatus),dateJoined:s(w.dateJoined),
      tin:s(w.tin),ssnit:s(w.ssnit),nextOfKin:s(w.nextOfKin)
    };
  }

  function applyImportedWorker(imported,sourceLabel){
    imported=normalizeImportedWorker(imported);
    if(!imported.name)throw new Error('The '+(sourceLabel||'staff form')+' does not contain a full name.');
    var existing=null;
    if(imported.workerCode)existing=STATE.workers.find(function(w){return String(w.workerCode||'').trim().toLowerCase()===imported.workerCode.toLowerCase();})||null;
    if(!existing&&imported.email)existing=STATE.workers.find(function(w){return String(w.email||'').trim().toLowerCase()===imported.email.toLowerCase();})||null;
    var importedPhone=imported.phone.replace(/\D/g,'');
    if(!existing&&importedPhone)existing=STATE.workers.find(function(w){return String(w.phone||'').replace(/\D/g,'')===importedPhone;})||null;

    if(existing){
      var update=window.confirm('A worker with matching ID, email or phone already exists: '+existing.name+'.\n\nUpdate that existing worker with this completed '+(sourceLabel||'staff form')+'?');
      if(!update){toastLocal('Import cancelled');return;}
      var keepId=existing.id,keepCreated=existing.createdAt;
      Object.assign(existing,imported,{id:keepId,createdAt:keepCreated||new Date().toISOString(),updatedAt:new Date().toISOString()});
      selectedWorkerId=existing.id;
      if(saveState()){renderAll();toastLocal('Worker information updated from '+(sourceLabel||'staff form'));}
      return;
    }

    var worker=Object.assign({id:uid('worker'),createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()},imported);
    STATE.workers.push(worker);
    selectedWorkerId=worker.id;
    if(saveState()){
      renderAll();
      toastLocal(worker.name+' imported into Payroll');
    }
  }

  async function importPayrollPdf(file){
    var reader=new FileReader();
    reader.onload=async function(){
      try{
        var dataUrl=String(reader.result||'');
        var base64=dataUrl.split(',')[1]||'';
        const res=await fetch('/api/payroll/import-pdf',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({filename:file.name,data:base64}),cache:'no-store'});
        const body=await res.json().catch(function(){return{};});
        if(!res.ok||body.ok===false)throw new Error(body.error||'The PDF could not be imported.');
        applyImportedWorker(body.worker,'PDF form');
      }catch(err){
        console.error('Payroll PDF import failed',err);
        alert(err.message||'Could not import the PDF form.');
      }finally{
        q('fbiPayrollImportFile').value='';
      }
    };
    reader.readAsDataURL(file);
  }

  function importStaffFormFile(evt){
    var file=evt.target.files&&evt.target.files[0];if(!file)return;
    if(file.type==='application/pdf'||/\.pdf$/i.test(file.name)){importPayrollPdf(file);return;}
    var reader=new FileReader();
    reader.onload=function(){
      try{
        var obj=JSON.parse(String(reader.result||'{}'));
        if(obj.type!=='fbi-payroll-staff-form'||Number(obj.version)!==1)throw new Error('This is not a valid FBI Payroll Staff Registration Form.');
        applyImportedWorker(obj,'JSON form');
      }catch(err){
        console.error('Payroll staff form import failed',err);
        alert(err.message||'Could not import the completed staff form.');
      }finally{evt.target.value='';}
    };
    reader.readAsText(file);
  }

  window.__FBI_OPEN_PAYROLL_STAFF_FORM__=openStaffRegistrationForm;
  function printOverview(){
    document.body.classList.add('fbi-payroll-printing');
    window.print();
    setTimeout(function(){document.body.classList.remove('fbi-payroll-printing');},500);
  }

  function deactivate(){
    var root=q('fbiPayrollView');
    if(root)root.classList.remove('active','fbi-payroll-active','print-view');
    document.body.classList.remove('fbi-payroll-mode');
  }
  function activate(){
    var root=q('fbiPayrollView');if(!root)return;
    document.body.classList.add('fbi-payroll-mode');
    var top=q('top');
    if(top&&top.parentNode&&root.parentNode!==top.parentNode)top.parentNode.insertBefore(root,top.nextSibling);
    document.querySelectorAll('.view').forEach(function(v){v.classList.remove('active','print-view');});
    root.classList.add('active','fbi-payroll-active');
    document.querySelectorAll('.nav button').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-v')==='payroll');});
    q('title').textContent='Payroll';q('subtitle').textContent='Staff, earnings, payments and payslips';
    if(q('side'))q('side').classList.remove('open');
    renderAll();
    loadPayrollRegistrationRequests();
  }
  function installNav(){
    var nav=document.querySelector('.nav');
    if(nav&&!nav.querySelector('[data-v="payroll"]')){
      var b=document.createElement('button');b.type='button';b.className='nav-link';b.dataset.v='payroll';b.textContent='💰 Payroll';b.onclick=function(e){e.preventDefault();activate();};nav.insertBefore(b,nav.querySelector('[data-v="settings"]')||null);
    }
    var oldNav=window.__FBI_NAV__;
    window.__FBI_NAV__=function(v){if(v==='payroll'){activate();return false;}deactivate();return typeof oldNav==='function'?oldNav(v):false;};
    window.__FBI_PAYROLL_OPEN__=activate;
    window.addEventListener('hashchange',function(){if(location.hash==='#payroll')activate();else deactivate();});
  }
  function init(){
    loadState();installNav();
    document.querySelectorAll('[data-payroll-tab]').forEach(function(b){b.onclick=function(){tabs(b.getAttribute('data-payroll-tab'));};});
    q('fbiPayrollQuickWorker').onclick=function(){showWorkerForm();};
    q('fbiPayrollQAWorker').onclick=function(){showWorkerForm();};
    q('fbiPayrollQARecord').onclick=function(){showRecordForm();};
    q('fbiPayrollQAPayslip').onclick=function(){tabs('payslips');};
    q('fbiPayrollQAReport').onclick=function(){tabs('reports');};
    q('fbiPayrollViewRecords').onclick=function(){tabs('records');};
    q('fbiPayrollQuickWorkers').onclick=function(){showWorkerForm();};
    q('fbiPayrollImportForm').onclick=function(){q('fbiPayrollImportFile').click();};
    q('fbiPayrollImportForm2').onclick=function(){q('fbiPayrollImportFile').click();};
    q('fbiPayrollImportFile').addEventListener('change',importStaffFormFile);
    q('fbiPayrollWorkersAdd').onclick=function(){showWorkerForm();};
    q('fbiPayrollQuickRecord').onclick=function(){showRecordForm();};
    q('fbiPayrollRecordsAdd').onclick=function(){showRecordForm();};
    q('fbiPayrollOverviewPrint').onclick=printOverview;
    q('fbiPayrollReportCsv').onclick=exportCsv;
    q('fbiPayrollReportPrint').onclick=printReport;
    q('fbiPayrollReportReset').onclick=function(){q('fbiPayrollReportFrom').value='';q('fbiPayrollReportTo').value='';q('fbiPayrollReportWorker').value='';q('fbiPayrollReportDepartment').value='';q('fbiPayrollReportProject').value='';q('fbiPayrollReportStatus').value='';renderReports();};
    ['fbiPayrollReportFrom','fbiPayrollReportTo','fbiPayrollReportWorker','fbiPayrollReportDepartment','fbiPayrollReportProject','fbiPayrollReportStatus'].forEach(function(idv){q(idv).addEventListener('input',renderReports);q(idv).addEventListener('change',renderReports);});
    q('fbiPayrollPaymentClose').onclick=closePayment;q('fbiPayrollPaymentCancel').onclick=closePayment;q('fbiPayrollPaymentSave').onclick=savePayment;
    q('fbiPayrollPaymentModal').addEventListener('click',function(e){if(e.target===this)closePayment();});
    renderAll();
    hydratePayrollCloud();
    loadPayrollRegistrationRequests();
    if(q('fbiPayrollRegistrationRefresh')) q('fbiPayrollRegistrationRefresh').onclick=function(){loadPayrollRegistrationRequests();};
    if(q('fbiPayrollRegistrationOverviewOpen')) q('fbiPayrollRegistrationOverviewOpen').onclick=function(){tabs('workers');};
    if(!payrollRegistrationPoll) payrollRegistrationPoll=setInterval(function(){if(document.visibilityState!=='hidden')loadPayrollRegistrationRequests();},30000);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
  window.FBIPayrollModule={open:activate,close:deactivate,reload:function(){loadState();renderAll();hydratePayrollCloud();}};
})();
</script>
<!-- ===================== FBI Invoice Studio — UI v3 (look & feel layer) =====================
     Visual layer + small helpers only. It does not change how invoices are calculated,
     saved or stored: every button calls the same functions the app already had. -->
<style id="fbi-ui-v3">
/* ---------- tokens ---------- */
html[data-theme] body{
  --ui-font:"Instrument Sans",ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --r-lg:16px;--r-md:11px;--r-sm:8px;
}
html[data-theme="dark"] body{
  --bg:#0c0d11;--panel:#14161c;--panel2:#1a1d24;--raise:#20232b;--border:#252933;--line:#1f222a;
  --text:#f1f0ec;--muted:#959ba7;--faint:#6b717d;
  --brand:#d3235f;--brand-hi:#e8457b;--brand-soft:rgba(211,35,95,.14);--gold:#d9b25c;--gold-soft:rgba(217,178,92,.14);
  --u-row:#181a21;--u-input:#101217;--u-brand:#d3235f;
  --shadow-1:0 1px 0 rgba(255,255,255,.03) inset,0 10px 30px -18px rgba(0,0,0,.8);
}
html[data-theme="light"] body{
  --bg:#f3f4f6;--panel:#ffffff;--panel2:#f7f8fa;--raise:#ffffff;--border:#e2e4e9;--line:#eceef2;
  --text:#14161b;--muted:#5d6472;--faint:#8a909c;
  --brand:#b0124f;--brand-hi:#c8205f;--brand-soft:rgba(176,18,79,.08);--gold:#94701f;--gold-soft:rgba(148,112,31,.1);
  --u-row:#f8f9fb;--u-input:#ffffff;--u-brand:#b0124f;
  --shadow-1:0 1px 2px rgba(20,22,27,.04),0 8px 24px -16px rgba(20,22,27,.18);
}
html[data-theme] body,
html[data-theme] body :is(.side,.top,.main,.view,.report-modal,.calendar-modal,.toast,input,select,textarea,button){font-family:var(--ui-font)!important}
html[data-theme] body{background:var(--bg)!important;color:var(--text);font-variant-numeric:tabular-nums}
html[data-theme] body :focus-visible{outline:2px solid var(--brand)!important;outline-offset:2px}
@media (prefers-reduced-motion:reduce){html[data-theme] body *{transition:none!important;animation:none!important}}

/* ---------- sidebar (always the dark FBI surface) ---------- */
html[data-theme] body .side{width:236px;background:#0b0c10!important;border-right:1px solid #1b1d24;color:#a9afbb}
html[data-theme] body .brand{padding:20px 18px 16px;border-bottom:1px solid #1b1d24;gap:12px}
html[data-theme] body .brand>div{font-size:15px;font-weight:650;color:#fff;letter-spacing:0}
html[data-theme] body .brand small{color:#7b818d;font-size:12px;font-weight:450}
html[data-theme] body .nav{padding:10px 10px 16px;gap:14px}
html[data-theme] body .nav-group{display:flex;flex-direction:column;gap:1px}
html[data-theme] body .nav-heading{padding:8px 12px 6px;font-size:12px;font-weight:600;color:#666c78;letter-spacing:.1px}
html[data-theme] body .nav button,html[data-theme] body .nav .nav-link{padding:9px 12px;border-radius:9px;font-size:14px;font-weight:500;color:#aab0bc!important;background:transparent}
html[data-theme] body .nav button:hover{background:rgba(255,255,255,.05)!important;color:#fff!important}
html[data-theme] body .nav button.active{background:rgba(255,255,255,.08)!important;color:#fff!important}
html[data-theme] body .nav button.active:before{left:-10px;background:var(--gold,#d9b25c)}
html[data-theme] body .nav button.active svg{color:#d9b25c}
html[data-theme] body .sidefoot{display:flex;align-items:center;gap:8px;padding:14px 18px;border-top:1px solid #1b1d24;color:#7b818d;font-size:12px}
html[data-theme] body .sf-dot{width:7px;height:7px;border-radius:50%;background:#4fd49b;box-shadow:0 0 0 3px rgba(79,212,155,.15);flex:none}

/* ---------- top bar ---------- */
html[data-theme] body .top{position:sticky;top:0;z-index:20;padding:14px 28px;min-height:72px;background:color-mix(in srgb,var(--bg) 86%,transparent)!important;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line);box-shadow:none!important}
html[data-theme] body .top h1{font-size:21px;font-weight:650;letter-spacing:-.3px;color:var(--text);margin:0}
html[data-theme] body .top small#subtitle{font-size:13px;color:var(--muted)}
html[data-theme] body .top .btn{height:38px}
html[data-theme] body .ui-search-btn{display:inline-flex;align-items:center;gap:9px;min-width:300px;justify-content:flex-start;color:var(--muted)!important;background:var(--panel)!important;font-weight:450!important}
html[data-theme] body .ui-search-btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;flex:none}
html[data-theme] body .ui-search-btn span{flex:1;text-align:left}
html[data-theme] body .ui-search-btn kbd{font:600 11px var(--ui-font);padding:2px 6px;border-radius:6px;border:1px solid var(--border);color:var(--faint);background:var(--panel2)}
html[data-theme] body .theme-switcher{padding:3px;border-radius:10px;background:var(--panel)!important;border:1px solid var(--border)}
html[data-theme] body .theme-switcher button{padding:5px 8px!important;border-radius:7px;font-size:13px}
html[data-theme] body .theme-switcher button span{display:none!important}
html[data-theme] body .install-app-btn{font-size:13px!important}

/* ---------- buttons & fields ---------- */
html[data-theme] body .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:38px;padding:0 14px;border-radius:var(--r-md);border:1px solid var(--border);background:var(--panel)!important;color:var(--text)!important;font-size:13.5px;font-weight:600;letter-spacing:0;box-shadow:none;transition:background .15s,border-color .15s,transform .05s}
html[data-theme] body .btn:hover{border-color:color-mix(in srgb,var(--text) 22%,var(--border));background:var(--panel2)!important}
html[data-theme] body .btn:active{transform:translateY(1px)}
html[data-theme] body .btn.primary{background:var(--brand)!important;border-color:var(--brand)!important;color:#fff!important;box-shadow:0 6px 18px -10px var(--brand)}
html[data-theme] body .btn.primary:hover{background:var(--brand-hi)!important;border-color:var(--brand-hi)!important}
html[data-theme] body .btn.danger{color:var(--u-bad)!important}
html[data-theme] body .btn:disabled{opacity:.55;cursor:not-allowed}
html[data-theme] body .main :is(input:not([type=checkbox]):not([type=radio]):not([type=file]),select,textarea){border-radius:var(--r-md)!important;border:1px solid var(--border)!important;background:var(--u-input)!important;color:var(--text)!important;font-size:14px}
html[data-theme] body .main :is(input,select,textarea):focus{border-color:var(--brand)!important;box-shadow:0 0 0 3px var(--brand-soft)!important;outline:none}
html[data-theme] body .main label{color:var(--muted);font-weight:550}

/* ---------- surfaces ---------- */
html[data-theme] body .main{background:transparent}
html[data-theme] body .view{padding:24px 28px 40px}
html[data-theme] body .card{background:var(--panel)!important;border:1px solid var(--border)!important;border-radius:var(--r-lg)!important;box-shadow:var(--shadow-1)!important}
html[data-theme] body .card h3{font-size:15px;font-weight:650;letter-spacing:-.1px}
html[data-theme] body .ui-chip{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 10px;border-radius:999px;font-size:12px;font-weight:650;white-space:nowrap;background:var(--u-neutral-bg);color:var(--u-neutral)}
html[data-theme] body .ui-chip:before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.85}
html[data-theme] body .ui-chip.ok{background:var(--u-ok-bg);color:var(--u-ok)}
html[data-theme] body .ui-chip.bad{background:var(--u-bad-bg);color:var(--u-bad)}
html[data-theme] body .ui-chip.warn{background:var(--u-warn-bg);color:var(--u-warn)}
html[data-theme] body .ui-chip.info{background:var(--u-info-bg);color:var(--u-info)}
html[data-theme] body .ui-empty{display:flex;flex-direction:column;align-items:center;gap:6px;padding:36px 16px;text-align:center;color:var(--muted);border:1px dashed var(--border);border-radius:var(--r-lg)}
html[data-theme] body .ui-empty b{color:var(--text);font-size:15px}
html[data-theme] body .ui-empty .btn{margin-top:8px}
html[data-theme] body .ui-empty[hidden]{display:none!important}
html[data-theme] body .toast{border-radius:12px!important;background:#16181e!important;color:#f1f0ec!important;border:1px solid #2a2e38!important;box-shadow:0 18px 40px -16px rgba(0,0,0,.6)!important;font-weight:550}

/* ---------- overview ---------- */
html[data-theme] body #view-dashboard .ov-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:18px}
html[data-theme] body #view-dashboard .ov-greet{font-size:26px;font-weight:650;letter-spacing:-.5px;margin:0;color:var(--text)}
html[data-theme] body #view-dashboard .ov-date{margin:4px 0 0;color:var(--muted);font-size:14px}
html[data-theme] body #view-dashboard .ov-actions{display:flex;gap:8px;flex-wrap:wrap}
html[data-theme] body #view-dashboard .ov-money{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:16px;margin-bottom:16px}
html[data-theme] body #view-dashboard .ov-owed{padding:24px 26px!important;margin:0;position:relative;overflow:hidden}
html[data-theme] body #view-dashboard .ov-owed:after{content:"";position:absolute;inset:0 0 auto auto;width:220px;height:220px;background:radial-gradient(circle at 70% 30%,var(--brand-soft),transparent 65%);pointer-events:none}
html[data-theme] body #view-dashboard .ov-owed-top{display:flex;justify-content:space-between;align-items:center;font-size:14px;font-weight:600;color:var(--muted)}
html[data-theme] body #view-dashboard .ov-owed-amt{display:block;margin:10px 0 2px;font-size:44px;line-height:1.05;font-weight:650;letter-spacing:-1.4px;color:var(--text)!important}
html[data-theme] body #view-dashboard .ov-owed-meta{color:var(--muted);font-size:13.5px}
html[data-theme] body #view-dashboard .ov-reel{display:flex;gap:3px;height:12px;margin:22px 0 12px;border-radius:999px;overflow:hidden;background:var(--panel2)}
html[data-theme] body #view-dashboard .ov-reel i{display:block;height:100%;min-width:6px}
html[data-theme] body #view-dashboard .ov-reel-legend{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:6px 18px}
html[data-theme] body #view-dashboard .ov-reel-legend li{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);min-width:0}
html[data-theme] body #view-dashboard .ov-reel-legend li i{width:9px;height:9px;border-radius:3px;flex:none}
html[data-theme] body #view-dashboard .ov-reel-legend li span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text)}
html[data-theme] body #view-dashboard .ov-reel-legend li b{font-weight:600;color:var(--text)}
html[data-theme] body #view-dashboard .ov-reel-empty{color:var(--muted);font-size:13.5px;margin-top:18px}
html[data-theme] body #view-dashboard .ov-tiles{display:grid;grid-template-columns:1fr 1fr;gap:12px}
html[data-theme] body #view-dashboard .ov-tile{display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:18px 18px;border-radius:var(--r-lg);border:1px solid var(--border);background:var(--panel);color:var(--text);text-align:left;cursor:pointer;box-shadow:var(--shadow-1);transition:border-color .15s}
html[data-theme] body #view-dashboard .ov-tile:hover{border-color:color-mix(in srgb,var(--text) 25%,var(--border))}
html[data-theme] body #view-dashboard .ov-tile span{font-size:13.5px;font-weight:600;color:var(--muted)}
html[data-theme] body #view-dashboard .ov-tile b{font-size:23px;font-weight:650;letter-spacing:-.5px;color:var(--text)!important}
html[data-theme] body #view-dashboard .ov-tile small{font-size:12.5px;color:var(--faint)}
html[data-theme] body #view-dashboard .ov-tile-bad b{color:var(--u-bad)!important}
html[data-theme] body #view-dashboard .ov-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:16px}
html[data-theme] body #view-dashboard .ov-panel{padding:20px!important;margin:0!important;min-width:0}
html[data-theme] body :is(#view-dashboard,#view-saved) .ov-panel-head{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:12px}
html[data-theme] body :is(#view-dashboard,#view-saved) .ov-panel-head h3{margin:0!important}
html[data-theme] body :is(#view-dashboard,#view-saved) .ov-panel-head small{color:var(--muted);font-size:12.5px}
html[data-theme] body .ov-link{border:0;background:none;padding:0;color:var(--brand-hi);font:600 13px var(--ui-font);cursor:pointer}
html[data-theme="light"] body .ov-link{color:var(--brand)}
html[data-theme] body .ov-link:hover{text-decoration:underline}
html[data-theme] body #view-dashboard .ov-recent{padding:20px!important}
html[data-theme] body #view-dashboard .dashboard-table{width:100%;border-collapse:collapse;font-size:13.5px}
html[data-theme] body #view-dashboard .dashboard-table th{font-size:12.5px;font-weight:600;color:var(--muted);text-transform:none;letter-spacing:0;padding:8px 10px;border-bottom:1px solid var(--border);background:transparent;text-align:left}
html[data-theme] body #view-dashboard .dashboard-table td{padding:11px 10px;border-bottom:1px solid var(--line);color:var(--text)}
html[data-theme] body #view-dashboard .dashboard-table tr:last-child td{border-bottom:0}
html[data-theme] body #view-dashboard .dashboard-table :is(th.num,td:nth-child(6),td:nth-child(7)){text-align:right}
html[data-theme] body #view-dashboard :is(.attention-list,.due-list){display:flex;flex-direction:column;gap:6px}
html[data-theme] body #view-dashboard :is(.attention-item,.due-item,.due-row){border-radius:10px!important;border:1px solid var(--line)!important;background:var(--u-row)!important;padding:10px 12px!important}

/* ---------- invoices list ---------- */
html[data-theme] body #view-saved .inv-card{padding:20px!important}
html[data-theme] body #view-saved .inv-toolbar{display:grid;grid-template-columns:minmax(0,1fr) 170px auto;gap:10px;align-items:center}
html[data-theme] body .inv-search{position:relative}
html[data-theme] body .inv-search svg{position:absolute;left:12px;top:50%;width:17px;height:17px;transform:translateY(-50%);fill:none;stroke:var(--faint);stroke-width:1.8;stroke-linecap:round;pointer-events:none}
html[data-theme] body .inv-search input{width:100%;height:42px;padding-left:38px!important}
html[data-theme] body .inv-toolbar select,html[data-theme] body .inv-toolbar .btn{height:42px}
html[data-theme] body .inv-chips{display:flex;gap:6px;flex-wrap:wrap;margin:14px 0 16px}
html[data-theme] body .inv-chips button{height:32px;padding:0 12px;border-radius:999px;border:1px solid var(--border);background:transparent;color:var(--muted);font:600 13px var(--ui-font);cursor:pointer}
html[data-theme] body .inv-chips button span{margin-left:4px;color:var(--faint);font-weight:600}
html[data-theme] body .inv-chips button[aria-selected="true"]{background:var(--text);border-color:var(--text);color:var(--bg)}
html[data-theme] body .inv-toolbar{display:grid;grid-template-columns:minmax(0,1fr) 170px auto;gap:10px;align-items:center}
html[data-theme] body .inv-card{padding:20px!important}
html[data-theme] body #view-saved .inv-search{position:relative}
html[data-theme] body #view-saved .inv-search svg{position:absolute;left:12px;top:50%;width:17px;height:17px;transform:translateY(-50%);fill:none;stroke:var(--faint);stroke-width:1.8;stroke-linecap:round;pointer-events:none}
html[data-theme] body #view-saved .inv-search input{width:100%;height:42px;padding-left:38px!important}
html[data-theme] body #view-saved .inv-toolbar select{height:42px}
html[data-theme] body #view-saved .inv-chips{display:flex;gap:6px;flex-wrap:wrap;margin:14px 0 16px}
html[data-theme] body #view-saved .inv-chips button{height:32px;padding:0 12px;border-radius:999px;border:1px solid var(--border);background:transparent;color:var(--muted);font:600 13px var(--ui-font);cursor:pointer}
html[data-theme] body #view-saved .inv-chips button span{margin-left:4px;color:var(--faint);font-weight:600}
html[data-theme] body #view-saved .inv-chips button[aria-selected="true"]{background:var(--text);border-color:var(--text);color:var(--bg)}
html[data-theme] body #view-saved .inv-chips button[aria-selected="true"] span{color:inherit;opacity:.7}
html[data-theme] body #view-saved :is(.inv-head,.inv-row){display:grid;grid-template-columns:minmax(0,1.4fr) 124px 150px 128px 148px 268px;gap:14px;align-items:center}
html[data-theme] body #view-saved .inv-head{padding:0 14px 8px;font-size:12.5px;font-weight:600;color:var(--muted);border-bottom:1px solid var(--border)}
html[data-theme] body #view-saved .inv-head .num,html[data-theme] body :is(#view-saved,#view-quotes) .inv-amt{text-align:right}
html[data-theme] body #view-saved #saved{display:flex;flex-direction:column}
html[data-theme] body #view-saved .saved.inv-row{margin:0!important;padding:12px 14px!important;border:0!important;border-bottom:1px solid var(--line)!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;flex-wrap:nowrap}
html[data-theme] body #view-saved .saved.inv-row:hover{background:var(--u-row)!important}
html[data-theme] body :is(#view-saved,#view-quotes) .inv-main{display:flex;flex-direction:column;align-items:flex-start;gap:1px;min-width:0;border:0;background:none;padding:0;text-align:left;cursor:pointer;color:var(--text)}
html[data-theme] body :is(#view-saved,#view-quotes) .inv-no{font-size:14.5px;font-weight:650}
html[data-theme] body :is(#view-saved,#view-quotes) .inv-main:hover .inv-no{color:var(--brand-hi)}
html[data-theme] body :is(#view-saved,#view-quotes) .inv-client{max-width:100%;font-size:13.5px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
html[data-theme] body :is(#view-saved,#view-quotes) :is(.inv-date,.inv-amt){display:flex;flex-direction:column;font-size:13.5px;color:var(--text)}
html[data-theme] body :is(#view-saved,#view-quotes) .inv-amt b{font-weight:650;font-size:14.5px}
html[data-theme] body :is(#view-saved,#view-quotes) :is(.inv-date,.inv-amt) small{font-size:12.5px;color:var(--muted)}
html[data-theme] body #view-saved .inv-job{display:flex!important;align-items:center;gap:8px;margin:0!important}
html[data-theme] body #view-saved .inv-job span{display:none}
html[data-theme] body #view-saved .inv-job select{height:34px;padding:0 8px;font-size:13px;width:100%}
html[data-theme] body :is(#view-saved,#view-quotes) .inv-actions{display:flex;gap:6px;justify-content:flex-end;align-items:center}
html[data-theme] body :is(#view-saved,#view-quotes) .inv-actions .btn{min-height:34px;height:34px;padding:0 12px;font-size:13px;white-space:nowrap}
html[data-theme] body #view-saved .inv-row>.ui-chip{justify-self:start}
html[data-theme] body .inv-more{position:relative}
/* The open row sits above the rows below it, so its menu is never hidden */
html[data-theme] body #view-saved .saved.inv-row:has(details.inv-more[open]){position:relative;z-index:60}
html[data-theme] body #view-saved .saved.inv-row.menu-open{position:relative;z-index:60}
html[data-theme] body #view-saved .inv-card{overflow:visible!important}
html[data-theme] body .inv-more.up .inv-menu{top:auto;bottom:calc(100% + 6px)}
html[data-theme] body .inv-more>summary{list-style:none;cursor:pointer;min-height:34px;height:34px;padding:0 10px;letter-spacing:1px}
html[data-theme] body .inv-more>summary::-webkit-details-marker{display:none}
html[data-theme] body .inv-menu{position:absolute;right:0;top:calc(100% + 6px);z-index:30;min-width:240px;padding:6px;border-radius:12px;border:1px solid var(--border);background:var(--raise);box-shadow:0 20px 40px -18px rgba(0,0,0,.55)}
html[data-theme] body .inv-menu button{display:block;width:100%;padding:9px 12px;border:0;border-radius:8px;background:none;color:var(--text);font:500 13.5px var(--ui-font);text-align:left;cursor:pointer}
html[data-theme] body .inv-menu button:hover{background:var(--panel2)}
html[data-theme] body .inv-menu button.danger{color:var(--u-bad)}
html[data-theme] body #view-saved .inv-count{display:block;margin-top:12px;color:var(--faint);font-size:12.5px}

/* ---------- command palette ---------- */
.ui-palette{position:fixed;inset:0;z-index:1000;display:none;align-items:flex-start;justify-content:center;padding:12vh 16px 16px;background:rgba(6,7,10,.55);backdrop-filter:blur(3px)}
.ui-palette.open{display:flex}
.ui-palette-box{width:min(640px,100%);max-height:70vh;display:flex;flex-direction:column;border-radius:16px;border:1px solid var(--border);background:var(--raise,#1b1d24);box-shadow:0 40px 80px -30px rgba(0,0,0,.7);overflow:hidden;font-family:var(--ui-font)}
.ui-palette-input{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--border)}
.ui-palette-input svg{width:18px;height:18px;fill:none;stroke:var(--muted);stroke-width:1.8;stroke-linecap:round;flex:none}
.ui-palette-input input{flex:1;border:0!important;background:transparent!important;color:var(--text)!important;font:500 16px var(--ui-font)!important;outline:none;box-shadow:none!important;padding:0!important;min-height:0}
html[data-theme] body .ui-palette-input input:focus-visible,html[data-theme] body .ui-palette-input input:focus{outline:none!important;box-shadow:none!important;border:0!important}
.ui-palette-input kbd{font:600 11px var(--ui-font);padding:2px 6px;border-radius:6px;border:1px solid var(--border);color:var(--faint)}
.ui-palette-list{overflow:auto;padding:6px}
.ui-palette-group{padding:10px 10px 4px;font-size:12px;font-weight:600;color:var(--faint)}
.ui-palette-item{display:flex;align-items:center;gap:12px;width:100%;padding:10px 12px;border:0;border-radius:10px;background:none;color:var(--text);text-align:left;cursor:pointer;font:500 14px var(--ui-font)}
.ui-palette-item[aria-selected="true"]{background:var(--brand-soft)}
.ui-palette-item .pi-main{flex:1;min-width:0;display:flex;flex-direction:column}
.ui-palette-item .pi-main b{font-weight:600}
.ui-palette-item .pi-main small{color:var(--muted);font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ui-palette-item .pi-side{color:var(--muted);font-size:13px;white-space:nowrap}
.ui-palette-empty{padding:28px;text-align:center;color:var(--muted);font-size:14px}

/* ---------- responsive ---------- */
@media(max-width:1280px){
  html[data-theme] body #view-dashboard .ov-grid{grid-template-columns:1fr 1fr}
  html[data-theme] body #view-dashboard .ov-grid>.ov-panel:last-child{grid-column:1/-1}
  html[data-theme] body #view-saved :is(.inv-head,.inv-row){grid-template-columns:minmax(0,1.4fr) 150px 128px 140px 268px}
  html[data-theme] body #view-saved .inv-head span:nth-child(2),html[data-theme] body #view-saved .inv-date{display:none}
  html[data-theme] body .ui-search-btn{min-width:0}
  html[data-theme] body .ui-search-btn span,html[data-theme] body .ui-search-btn kbd{display:none}
}
@media(max-width:1024px){
  html[data-theme] body #view-dashboard .ov-money{grid-template-columns:1fr}
}
@media(max-width:950px){
  html[data-theme] body .top{padding:12px 16px}
  html[data-theme] body .view{padding:16px 14px 32px}
  html[data-theme] body #view-dashboard .ov-head{flex-direction:column;align-items:flex-start}
  html[data-theme] body #view-dashboard .ov-grid{grid-template-columns:1fr}
  html[data-theme] body #view-dashboard .ov-owed-amt{font-size:36px}
  html[data-theme] body #view-saved .inv-head{display:none}
  html[data-theme] body #view-saved .saved.inv-row{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"main amt" "chip job" "act act";row-gap:10px}
  html[data-theme] body :is(#view-saved,#view-quotes) .inv-main{grid-area:main}
  html[data-theme] body #view-saved .inv-amt{grid-area:amt}
  html[data-theme] body #view-saved .inv-row .ui-chip{grid-area:chip;justify-self:start}
  html[data-theme] body #view-saved .inv-job{grid-area:job}
  html[data-theme] body :is(#view-saved,#view-quotes) .inv-actions{grid-area:act;justify-content:flex-start;flex-wrap:wrap}
  html[data-theme] body #view-saved .inv-toolbar{grid-template-columns:1fr auto}
  html[data-theme] body #view-saved .inv-toolbar .inv-search{grid-column:1/-1}
  html[data-theme] body .inv-menu{right:auto;left:0}
}
@media(max-width:600px){
  html[data-theme] body .top .install-app-btn,html[data-theme] body .top .theme-switcher{display:none!important}
  html[data-theme] body #view-dashboard .ov-tiles{grid-template-columns:1fr 1fr}
  html[data-theme] body #view-dashboard .ov-tile b{font-size:19px}
  html[data-theme] body #view-dashboard .ov-actions{display:none}
  html[data-theme] body .top .ui-search-btn{display:inline-flex!important;min-width:38px;padding:0 10px}
  html[data-theme] body #view-dashboard .dashboard-table :is(th,td):nth-child(n+3):nth-child(-n+4){display:none}
}
@media print{.ui-palette{display:none!important}}
</style>

<div class="ui-palette no-print" id="uiPalette" role="dialog" aria-modal="true" aria-label="Search">
  <div class="ui-palette-box">
    <div class="ui-palette-input"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg><input id="uiPaletteInput" type="text" placeholder="Search invoices, clients or go to a page" autocomplete="off" aria-controls="uiPaletteList"><kbd>Esc</kbd></div>
    <div class="ui-palette-list" id="uiPaletteList" role="listbox"></div>
  </div>
</div>

<script id="fbi-ui-v3-js">
(function(){
  function $(id){return document.getElementById(id)}
  function e(v){return String(v==null?"":v).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
  function has(name){return typeof window[name]==="function"}
  function list(){return (typeof data!=="undefined"&&Array.isArray(data))?data:[]}
  function people(){return (typeof clients!=="undefined"&&Array.isArray(clients))?clients:[]}
  function money(n,c){try{return curSym(c||"GHS")+Number(n||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}catch(x){return "GH₵"+Number(n||0).toFixed(2)}}
  function statusOf(x){try{return invoiceStatusInfo(x).status||x.status||"Draft"}catch(err){return x.status||"Draft"}}
  function balanceOf(x){try{return invoiceBalance(x)}catch(err){return 0}}

  /* ---- Overview: greeting and "who owes FBI" reel ---- */
  function greet(){
    const h=new Date().getHours(),g=h<12?"Good morning":h<17?"Good afternoon":"Good evening";
    const owner=(typeof settings!=="undefined"&&settings&&settings.owner)?String(settings.owner).split(" ")[0]:"";
    if($("ovGreeting"))$("ovGreeting").textContent=g+(owner?", "+owner:"");
    if($("ovToday"))$("ovToday").textContent=new Date().toLocaleDateString(undefined,{weekday:"long",day:"numeric",month:"long",year:"numeric"});
  }
  const REEL=["var(--brand)","var(--gold)","#7d8cff","#43c59e","#9aa0ac"];
  function reel(){
    const bar=$("ovReel"),leg=$("ovReelLegend");if(!bar||!leg)return;
    const owed={};
    list().forEach(function(x){const st=statusOf(x);if(st==="Paid"||st==="Draft")return;if(String(x.cur||"GHS")!=="GHS")return;const b=balanceOf(x);if(b<=0.005)return;const k=(x.client||"No client").trim();owed[k]=(owed[k]||0)+b});
    const rows=Object.keys(owed).map(function(k){return [k,owed[k]]}).sort(function(a,b){return b[1]-a[1]});
    const total=rows.reduce(function(s,r){return s+r[1]},0);
    if(!total){bar.innerHTML="";bar.style.display="none";leg.innerHTML='<li class="ov-reel-empty">Nobody owes FBI anything right now.</li>';return}
    bar.style.display="";
    const top=rows.slice(0,4);const rest=rows.slice(4).reduce(function(s,r){return s+r[1]},0);if(rest>0)top.push(["Other clients ("+(rows.length-4)+")",rest]);
    bar.innerHTML=top.map(function(r,i){return '<i style="flex:'+r[1]+';background:'+REEL[i]+'" title="'+e(r[0])+': '+e(money(r[1]))+'"></i>'}).join("");
    leg.innerHTML=top.map(function(r,i){return '<li><i style="background:'+REEL[i]+'"></i><span>'+e(r[0])+'</span><b>'+e(money(r[1]))+'</b></li>'}).join("");
  }
  function overview(){greet();reel()}
  const due=$("sDue");if(due){try{new MutationObserver(function(){setTimeout(reel,0)}).observe(due,{childList:true,characterData:true,subtree:true})}catch(x){}}
  setTimeout(overview,400);setInterval(greet,60000);window.addEventListener("fbi-authenticated",function(){setTimeout(overview,900)});

  /* ---- Invoice quick actions ---- */
  window.duplicateInvoice=function(id){
    const src=list().find(function(x){return x.id===id});if(!src||!has("loadInvoice"))return;
    loadInvoice(id);
    setTimeout(function(){
      try{
        current=null;
        if(typeof invoiceNumberReserved!=="undefined")invoiceNumberReserved="";
        if($("no")&&has("nextInvoiceNumber"))$("no").value=nextInvoiceNumber();
        if($("date"))$("date").value=new Date().toISOString().slice(0,10);
        if($("status"))$("status").value="Draft";
        ["amountPaid"].forEach(function(k){if($(k))$(k).value=0});
        ["paymentDate","transactionRef","receiptNo","eventDate","eventEndDate"].forEach(function(k){if($(k))$(k).value=""});
        if($("paymentHistoryPanel"))$("paymentHistoryPanel").innerHTML="";
        if(has("calc"))calc();if(has("updatePaymentBalancePreview"))updatePaymentBalancePreview();
        if(has("toast"))toast("Copy of "+(src.no||"invoice")+" ready. Check the dates and details, then save.");
        window.scrollTo(0,0);
      }catch(err){console.warn("Duplicate failed",err)}
    },60);
  };
  function waPhone(p){let d=String(p||"").replace(/\D/g,"");if(!d)return "";if(d.indexOf("00")===0)d=d.slice(2);if(d.length===10&&d[0]==="0")d="233"+d.slice(1);if(d.length===9)d="233"+d;return d}
  window.shareInvoiceWhatsApp=function(id){
    const x=list().find(function(v){return v.id===id});if(!x)return;
    const biz=(typeof settings!=="undefined"&&settings&&settings.biz)||"FILM BEYOND IMAGINATION (FBI)";
    const bal=balanceOf(x),st=statusOf(x);
    const lines=["Hello "+(x.client||"there")+",","","Here are the details of invoice "+x.no+" from "+biz+":","Amount: "+money(x.total,x.cur)];
    if(st!=="Paid"&&bal>0.005&&Math.abs(bal-Number(x.total||0))>0.005)lines.push("Balance due: "+money(bal,x.cur));
    if(st==="Paid")lines.push("Status: fully paid — thank you!");else lines.push("Due: "+(x.due||"On receipt"));
    const pay=String(x.payment||"").trim();if(pay&&st!=="Paid")lines.push("","Payment details:",pay);
    lines.push("","Thank you for working with us.");
    const url="https://wa.me/"+waPhone(x.clientPhone)+"?text="+encodeURIComponent(lines.join("\n"));
    window.open(url,"_blank","noopener");
    if(!waPhone(x.clientPhone)&&has("toast"))toast("No phone number saved for this client — choose the contact in WhatsApp.");
  };

  /* ---- Command palette (Ctrl K) ---- */
  const pal=$("uiPalette"),inp=$("uiPaletteInput"),out=$("uiPaletteList");let items=[],sel=0,lastFocus=null;
  const PAGES=[["Overview","dashboard"],["Create invoice","create"],["Invoices","saved"],["Quotations","quotes"],["Receipts","receipts"],["Jobs","completed"],["Calendar","calendar"],["Clients","clients"],["Business settings","settings"],["WhatsApp alerts","whatsapp"]];
  function build(q){
    q=(q||"").trim().toLowerCase();const res=[];
    const inv=list().filter(function(x){return !q||[x.no,x.client,x.clientPhone,x.total,x.eventDate,x.date].join(" ").toLowerCase().indexOf(q)>=0}).slice(0,q?8:5);
    if(inv.length){res.push({g:"Invoices"});inv.forEach(function(x){res.push({t:x.no,s:(x.client||"No client")+" · "+statusOf(x),r:money(x.total,x.cur),run:function(){loadInvoice(x.id)}})})}
    if(q){const cl=people().filter(function(c){return [c.name,c.phone,c.email].join(" ").toLowerCase().indexOf(q)>=0}).slice(0,6);
      if(cl.length){res.push({g:"Clients"});cl.forEach(function(c){res.push({t:c.name,s:[c.phone,c.email].filter(Boolean).join(" · ")||"No contact details",r:"New invoice",run:function(){newInvoice();setTimeout(function(){const s=$("clientSelect");if(s){s.value=c.id;if(has("applySelectedClient"))applySelectedClient()}},80)}})})}}
    const acts=[{t:"New invoice",s:"Start a blank invoice",run:function(){newInvoice()}},{t:"New quotation",s:"Quote or pro-forma invoice for a client",run:function(){newQuote()}},{t:"Business report",s:"Filter and print a report",run:function(){openReportModal()}},{t:"Download a full backup",s:"Everything in one file",run:function(){location.href="/api/backups/current/download"}}]
      .concat(PAGES.map(function(p){return {t:"Go to "+p[0],s:"Page",run:function(){if(p[1]==="saved"&&window.openInvoicesFiltered)openInvoicesFiltered("");else show(p[1])}}}))
      .filter(function(a){return !q||a.t.toLowerCase().indexOf(q)>=0});
    if(acts.length){res.push({g:"Actions"});acts.slice(0,q?6:4).forEach(function(a){res.push(a)})}
    return res;
  }
  function draw(){
    items=build(inp.value);const pick=items.filter(function(i){return !i.g});if(sel>=pick.length)sel=Math.max(0,pick.length-1);
    if(!pick.length){out.innerHTML='<div class="ui-palette-empty">Nothing found for “'+e(inp.value)+'”.</div>';return}
    let n=-1;out.innerHTML=items.map(function(i){if(i.g)return '<div class="ui-palette-group">'+e(i.g)+'</div>';n++;return '<button type="button" role="option" class="ui-palette-item" data-i="'+n+'" aria-selected="'+(n===sel)+'"><span class="pi-main"><b>'+e(i.t)+'</b><small>'+e(i.s||"")+'</small></span>'+(i.r?'<span class="pi-side">'+e(i.r)+'</span>':"")+'</button>'}).join("");
    const on=out.querySelector('[aria-selected="true"]');if(on)on.scrollIntoView({block:"nearest"});
  }
  function run(i){const pick=items.filter(function(x){return !x.g})[i];if(!pick)return;close();try{pick.run()}catch(err){console.warn(err)}}
  function open(){if(!pal)return;lastFocus=document.activeElement;pal.classList.add("open");inp.value="";sel=0;draw();setTimeout(function(){inp.focus()},10)}
  function close(){if(!pal)return;pal.classList.remove("open");if(lastFocus&&lastFocus.focus)try{lastFocus.focus()}catch(x){}}
  window.openCommandPalette=open;
  if(pal){
    inp.addEventListener("input",function(){sel=0;draw()});
    inp.addEventListener("keydown",function(ev){const n=items.filter(function(i){return !i.g}).length;if(ev.key==="ArrowDown"){ev.preventDefault();sel=(sel+1)%Math.max(1,n);draw()}else if(ev.key==="ArrowUp"){ev.preventDefault();sel=(sel-1+n)%Math.max(1,n);draw()}else if(ev.key==="Enter"){ev.preventDefault();run(sel)}else if(ev.key==="Escape"){close()}});
    out.addEventListener("click",function(ev){const b=ev.target.closest("[data-i]");if(b)run(+b.getAttribute("data-i"))});
    pal.addEventListener("mousedown",function(ev){if(ev.target===pal)close()});
  }
  document.addEventListener("keydown",function(ev){
    const typing=/^(input|textarea|select)$/i.test((ev.target&&ev.target.tagName)||"")||(ev.target&&ev.target.isContentEditable);
    if((ev.ctrlKey||ev.metaKey)&&String(ev.key).toLowerCase()==="k"){ev.preventDefault();pal&&pal.classList.contains("open")?close():open();return}
    if(ev.key==="/"&&!typing&&!(pal&&pal.classList.contains("open"))){ev.preventDefault();open()}
  });
  /* close any open "more" menu when clicking elsewhere */
  document.addEventListener("click",function(ev){document.querySelectorAll("details.inv-more[open]").forEach(function(d){if(!d.contains(ev.target))d.open=false})});
  /* Lift the row with the open menu above its neighbours; open upwards near the bottom of the screen */
  document.addEventListener("toggle",function(ev){
    var d=ev.target;if(!d||!d.classList||!d.classList.contains("inv-more"))return;
    var row=d.closest(".inv-row");if(row)row.classList.toggle("menu-open",d.open);
    if(d.open){var r=d.getBoundingClientRect();d.classList.toggle("up",window.innerHeight-r.bottom<260&&r.top>260)}
  },true);
})();
</script>
<style id="fbi-ui-v3-pages">
/* ---------- shared page pieces ---------- */
html[data-theme] body .page-actions{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin:0 0 16px}
html[data-theme] body .page-actions p{margin:0;color:var(--muted);font-size:14px}
html[data-theme] body .page-actions>div{display:flex;gap:8px;flex-wrap:wrap}
html[data-theme] body .stats{gap:12px!important}
html[data-theme] body .stats .stat{background:var(--panel)!important;color:var(--text)!important;border:1px solid var(--border)!important;border-radius:var(--r-lg)!important;box-shadow:var(--shadow-1)!important;padding:16px 18px!important}
html[data-theme] body .stats .stat:before,html[data-theme] body .stats .stat:after{display:none!important}
html[data-theme] body .stats .stat span{font-size:13px!important;font-weight:600!important;color:var(--muted)!important;text-transform:none!important;letter-spacing:0!important}
html[data-theme] body .stats .stat b{font-size:22px!important;font-weight:650!important;letter-spacing:-.4px;color:var(--text)!important}
html[data-theme] body .stats .stat small{font-size:12.5px!important;color:var(--faint)!important}
html[data-theme] body .report-filters{display:grid!important;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px!important}
html[data-theme] body .report-filters label{margin:0 0 6px!important;font-size:12.5px}
html[data-theme] body :is(#completedJobsTable,.fbi-payroll-table-wrap) table{width:100%;border-collapse:collapse;font-size:13.5px}
html[data-theme] body :is(#completedJobsTable,.fbi-payroll-table-wrap) th{background:transparent!important;color:var(--muted)!important;font-size:12.5px!important;font-weight:600!important;text-transform:none!important;letter-spacing:0!important;padding:9px 10px!important;border:0!important;border-bottom:1px solid var(--border)!important;text-align:left}
html[data-theme] body :is(#completedJobsTable,.fbi-payroll-table-wrap) td{padding:10px!important;border:0!important;border-bottom:1px solid var(--line)!important;color:var(--text)!important;font-size:13.5px!important;background:transparent!important}
/* The report preview is a white printable page in every theme: keep its text dark and readable */
html[data-theme] body .report-preview table{width:100%;border-collapse:collapse;font-size:13.5px}
html[data-theme] body .report-preview :is(th,td){padding:9px 10px!important;text-align:left}
html[data-theme] body .report-preview{color:#15171c}
html[data-theme] body .report-preview :is(td,b,strong,h1,h2,h3,h4,p,span,div){color:#15171c!important}
html[data-theme] body .report-preview th{color:#4b5260!important;border-bottom:1px solid #d9dce2!important}
html[data-theme] body .report-preview td{border-bottom:1px solid #e8eaee!important}
html[data-theme] body .report-preview :is(small,.muted){color:#5d6472!important}
html[data-theme] body :is(#completedJobsTable,.fbi-payroll-table-wrap) tr:hover td{background:var(--u-row)!important}
html[data-theme] body :is(.status-pill,.status-badge,.fbi-payroll-badge){border-radius:999px!important;font-size:12px!important;font-weight:650!important;padding:3px 10px!important;text-transform:none!important;letter-spacing:0!important}
html[data-theme] body .status-paid{background:var(--u-ok-bg)!important;color:var(--u-ok)!important;border-color:transparent!important}
html[data-theme] body .status-partial{background:var(--u-warn-bg)!important;color:var(--u-warn)!important;border-color:transparent!important}
html[data-theme] body .status-overdue{background:var(--u-bad-bg)!important;color:var(--u-bad)!important;border-color:transparent!important}
html[data-theme] body :is(.status-sent,.status-draft){border-color:transparent!important}

/* ---------- clients ---------- */
html[data-theme] body #view-clients .cl-layout{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,1fr);gap:16px;align-items:start}
html[data-theme] body #view-clients .cl-list-card{padding:20px!important;margin:0!important}
html[data-theme] body #view-clients .cl-search{margin:0 0 10px}
html[data-theme] body #view-clients .cl-search{position:relative}
html[data-theme] body #view-clients .cl-search svg{position:absolute;left:12px;top:50%;width:17px;height:17px;transform:translateY(-50%);fill:none;stroke:var(--faint);stroke-width:1.8;stroke-linecap:round;pointer-events:none}
html[data-theme] body #view-clients .cl-search input{width:100%;height:42px;padding-left:38px!important}
html[data-theme] body #view-clients .saved.cl-row{display:grid;grid-template-columns:40px minmax(0,1fr) minmax(150px,auto) auto;gap:14px;align-items:center;margin:0!important;padding:12px 6px!important;border:0!important;border-bottom:1px solid var(--line)!important;border-radius:0!important;background:transparent!important;box-shadow:none!important}
html[data-theme] body #view-clients .saved.cl-row:hover{background:var(--u-row)!important}
html[data-theme] body #view-clients .cl-avatar{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:var(--brand-soft);color:var(--brand-hi);font-size:13px;font-weight:700;letter-spacing:.3px}
html[data-theme="light"] body #view-clients .cl-avatar{color:var(--brand)}
html[data-theme] body #view-clients .cl-main{display:flex;flex-direction:column;min-width:0}
html[data-theme] body #view-clients .cl-main b{font-size:14.5px;font-weight:650;color:var(--text)}
html[data-theme] body #view-clients .cl-main small{color:var(--muted);font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
html[data-theme] body #view-clients .cl-stats{display:flex;flex-direction:column;align-items:flex-end;font-size:12.5px;color:var(--muted);text-align:right}
html[data-theme] body #view-clients .cl-owed{color:var(--u-bad);font-weight:650;font-size:13.5px}
html[data-theme] body #view-clients .cl-clear{color:var(--u-ok);font-weight:600;font-size:12.5px}
html[data-theme] body #view-clients .cl-actions{display:flex;gap:6px}
html[data-theme] body #view-clients .cl-actions .btn{min-height:34px;height:34px;padding:0 12px;font-size:13px;white-space:nowrap}
html[data-theme] body #view-clients .cl-del{color:var(--muted)!important}
html[data-theme] body #view-clients .cl-del:hover{color:var(--u-bad)!important}
html[data-theme] body #view-clients .cl-more{width:100%;margin-top:12px}
html[data-theme] body #view-clients #clAddBtn{display:none}
html[data-theme] body #view-clients .cl-list-card .ov-panel-head{align-items:center}
html[data-theme] body #view-clients .cl-side{display:flex;flex-direction:column;gap:16px;position:sticky;top:96px}
html[data-theme] body #view-clients .cl-form{padding:20px!important;margin:0!important}
html[data-theme] body #view-clients .cl-form label{margin:12px 0 6px!important;font-size:12.5px}
html[data-theme] body #view-clients .cl-form h3{margin:0 0 4px!important}
html[data-theme] body #view-clients .cl-two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
html[data-theme] body #view-clients .cl-btns{display:flex;gap:8px;margin-top:14px}
html[data-theme] body #view-clients .cl-import{padding:16px 20px!important;margin:0!important}
html[data-theme] body #view-clients .cl-import summary{cursor:pointer;display:flex;flex-direction:column;gap:2px}
html[data-theme] body #view-clients .cl-import summary small{color:var(--muted);font-size:12.5px}
html[data-theme] body #view-clients .cl-import input{margin-top:12px}

/* ---------- receipts ---------- */
html[data-theme] body #view-receipts .card{padding:20px!important}
html[data-theme] body #view-receipts .receipt-list{display:flex;flex-direction:column}
html[data-theme] body #view-receipts .receipt-row{display:grid!important;grid-template-columns:minmax(0,1fr) 150px 140px auto auto;gap:14px;align-items:center;margin:0!important;padding:12px 6px!important;border:0!important;border-bottom:1px solid var(--line)!important;border-radius:0!important;background:transparent!important}
html[data-theme] body #view-receipts .receipt-row:hover{background:var(--u-row)!important}
html[data-theme] body #view-receipts .receipt-row .main{font-size:14.5px!important;font-weight:650!important;color:var(--text)!important}
html[data-theme] body #view-receipts .receipt-row .meta{font-size:12.5px!important;color:var(--muted)!important;margin-top:2px}
html[data-theme] body #view-receipts .receipt-row .amount{font-size:14.5px!important;font-weight:650!important;text-align:right;color:var(--text)!important}
html[data-theme] body #view-receipts .receipt-row .status-pill{justify-self:start}
html[data-theme] body #view-receipts .receipt-row .btn{min-height:34px;height:34px;padding:0 12px;font-size:13px}
html[data-theme] body #view-receipts .receipt-empty{padding:36px 16px;text-align:center;color:var(--muted);border:1px dashed var(--border);border-radius:var(--r-lg)}

/* ---------- jobs ---------- */
html[data-theme] body #view-completed>.card{padding:20px!important}

/* ---------- calendar ---------- */
html[data-theme] body #view-calendar [class*="eyebrow"],html[data-theme] body #view-calendar .cal2-kicker{text-transform:none!important;letter-spacing:0!important;font-size:13px!important;color:var(--muted)!important}
html[data-theme] body #view-calendar .cal2-stat{border-radius:var(--r-md)!important;border:1px solid var(--border)!important;background:var(--panel2)!important}
html[data-theme] body #view-calendar .cal2-navbtn{border-radius:var(--r-md)!important}

/* ---------- payroll (look only) ---------- */
html[data-theme] body :is(.fbi-payroll-card,.fbi-payroll-widget,.fbi-payroll-panel,.fbi-payroll-stat,.fbi-payroll-summary-item){border-radius:var(--r-lg)!important;border-color:var(--border)!important;box-shadow:var(--shadow-1)!important}
html[data-theme] body .fbi-payroll-stat{background:var(--panel)!important}
html[data-theme] body .fbi-payroll-tabs{gap:4px!important;border-radius:12px!important}
html[data-theme] body .fbi-payroll-tab{border-radius:9px!important;font-weight:600!important;text-transform:none!important;letter-spacing:0!important}
html[data-theme] body :is(.fbi-payroll-section-head,.fbi-payroll-widget-head) :is(small,span)[class*="kicker"],html[data-theme] body #fbiPayrollView [class*="eyebrow"]{text-transform:none!important;letter-spacing:0!important}

/* ---------- settings & WhatsApp ---------- */
html[data-theme] body :is(#view-settings,#view-whatsapp) .card{padding:20px 22px!important}
html[data-theme] body :is(#view-settings,#view-whatsapp) .grid2{gap:16px!important}

/* ---------- preview toolbars & report window ---------- */
html[data-theme] body :is(#view-preview,#view-receipt-preview)>.no-print:first-child{position:sticky;top:72px;z-index:5;display:flex;gap:8px;flex-wrap:wrap;padding:12px 28px!important;background:color-mix(in srgb,var(--bg) 90%,transparent)!important;backdrop-filter:blur(10px);border-bottom:1px solid var(--line)!important}
html[data-theme] body :is(#view-preview,#view-receipt-preview) .preview-wrap{background:transparent!important}
@media screen{html[data-theme] body :is(.paper,.receipt-paper){box-shadow:0 30px 60px -30px rgba(0,0,0,.6)!important;border-radius:4px}}
html[data-theme] body .report-dialog{border-radius:18px!important;border:1px solid var(--border)!important;background:var(--panel)!important;box-shadow:0 40px 80px -30px rgba(0,0,0,.7)!important}
html[data-theme] body .report-head{border-bottom:1px solid var(--line)!important}

@media(max-width:1100px){
  html[data-theme] body #view-clients .cl-layout{grid-template-columns:1fr}
  html[data-theme] body #view-clients .cl-side{position:static}
  html[data-theme] body #view-clients .cl-form{display:none}
  html[data-theme] body #view-clients #clAddBtn{display:inline-flex}
  html[data-theme] body #view-clients .cl-side.editing .cl-form{display:block}
}
@media(max-width:800px){
  html[data-theme] body #view-clients .saved.cl-row{grid-template-columns:40px minmax(0,1fr);grid-template-areas:"av main" "av stats" "act act"}
  html[data-theme] body #view-clients .cl-avatar{grid-area:av;align-self:start}
  html[data-theme] body #view-clients .cl-main{grid-area:main}
  html[data-theme] body #view-clients .cl-stats{grid-area:stats;align-items:flex-start;text-align:left}
  html[data-theme] body #view-clients .cl-actions{grid-area:act}
  html[data-theme] body #view-receipts .receipt-row{display:flex!important;flex-wrap:wrap;gap:8px 10px}
  html[data-theme] body #view-receipts .receipt-row .grow{flex:1 1 60%}
  html[data-theme] body #view-receipts .receipt-row .status-pill{margin-right:auto}
  html[data-theme] body #view-receipts .receipt-row .btn{width:auto!important;flex:none}
  html[data-theme] body :is(#view-preview,#view-receipt-preview)>.no-print:first-child{padding:10px 14px!important;top:60px}
}
</style>
<script id="fbi-ui-v3-pages-js">
/* Clients: on smaller screens the form opens only when adding or editing. */
(function(){
  var side=document.querySelector("#view-clients .cl-side");if(!side)return;
  var head=document.querySelector("#view-clients .cl-list-card .ov-panel-head");
  if(head&&!document.getElementById("clAddBtn")){var b=document.createElement("button");b.type="button";b.className="btn primary";b.id="clAddBtn";b.textContent="＋ Add client";b.onclick=function(){if(typeof clearClientForm==="function")clearClientForm();side.classList.add("editing");var n=document.getElementById("dbClientName");if(n){n.scrollIntoView({behavior:"smooth",block:"center"});setTimeout(function(){n.focus()},250)}};head.appendChild(b)}
  document.getElementById("clientList")&&document.getElementById("clientList").addEventListener("click",function(e){if(e.target.closest('[data-client-action="edit"]')){side.classList.add("editing");setTimeout(function(){var n=document.getElementById("dbClientName");n&&n.scrollIntoView({behavior:"smooth",block:"center"})},50)}},true);
})();
</script>

<!-- ===================== Quotations & pro-forma invoices =====================
     Quotes are stored in their own table (/api/quotes). They never change invoice
     numbers, totals or receipts. Converting one fills a new invoice that you save as usual. -->
<style id="fbi-quotes-style">
html[data-theme] body .qt-banner{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin:0 0 14px;padding:14px 18px;border-radius:var(--r-lg,16px);border:1px solid color-mix(in srgb,var(--gold) 45%,var(--border));background:linear-gradient(90deg,var(--gold-soft),transparent 70%),var(--panel)}
html[data-theme] body .qt-banner[hidden]{display:none}
html[data-theme] body .qt-banner-main{display:flex;flex-direction:column;min-width:200px;flex:1}
html[data-theme] body .qt-banner-main b{font-size:16px;color:var(--text)}
html[data-theme] body .qt-banner-main small{color:var(--muted);font-size:12.5px}
html[data-theme] body .qt-banner-fields{display:flex;gap:10px;flex-wrap:wrap}
html[data-theme] body .qt-banner-fields label{display:flex;flex-direction:column;gap:4px;margin:0!important;font-size:12px;color:var(--muted)}
html[data-theme] body .qt-banner-fields :is(select,input){height:38px;min-width:150px}
html[data-theme] body .qt-banner-actions{display:flex;gap:8px}
/* In quotation mode, invoice-only parts of the form are hidden */
html[data-theme] body #view-create.quote-mode :is(#paymentReceivedCard,[data-cx-step="paymentReceivedCard"]){display:none!important}
html[data-theme] body #view-create.quote-mode .cx-f:has(> #status),html[data-theme] body #view-create.quote-mode .cx-f:has(> #due){display:none}
html[data-theme] body #view-quotes :is(.qt-head,.qt-row){display:grid;grid-template-columns:minmax(0,1.4fr) 124px 140px 156px 120px 280px;gap:14px;align-items:center}
html[data-theme] body #view-quotes .qt-head{padding:0 14px 8px;font-size:12.5px;font-weight:600;color:var(--muted);border-bottom:1px solid var(--border)}
html[data-theme] body #view-quotes .qt-head .num{text-align:right}
html[data-theme] body #view-quotes .qt-row{padding:12px 14px;border-bottom:1px solid var(--line)}
html[data-theme] body #view-quotes .qt-row:hover{background:var(--u-row)}
html[data-theme] body #view-quotes .qt-row.menu-open{position:relative;z-index:60}
html[data-theme] body #view-quotes .qt-row>.ui-chip{justify-self:start}
html[data-theme] body #view-quotes .qt-valid{font-size:13.5px;color:var(--text)}
html[data-theme] body #view-quotes .qt-valid.late{color:var(--u-bad)}
html[data-theme] body #view-quotes .qt-valid small{display:block;color:var(--muted);font-size:12.5px}
html[data-theme] body #view-quotes .inv-toolbar{grid-template-columns:minmax(0,1fr) 0 auto}
@media(max-width:1280px){html[data-theme] body #view-quotes :is(.qt-head,.qt-row){grid-template-columns:minmax(0,1.4fr) 150px 128px 130px 280px}html[data-theme] body #view-quotes .qt-head span:nth-child(2),html[data-theme] body #view-quotes .qt-row .inv-date{display:none}}
@media(max-width:950px){
  html[data-theme] body #view-quotes .qt-head{display:none}
  html[data-theme] body #view-quotes .qt-row{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"main amt" "chip valid" "act act";row-gap:10px}
  html[data-theme] body #view-quotes .qt-row .inv-main{grid-area:main}
  html[data-theme] body #view-quotes .qt-row .inv-amt{grid-area:amt}
  html[data-theme] body #view-quotes .qt-row>.ui-chip{grid-area:chip}
  html[data-theme] body #view-quotes .qt-row .qt-valid{grid-area:valid;text-align:right}
  html[data-theme] body #view-quotes .qt-row .inv-actions{grid-area:act;justify-content:flex-start;flex-wrap:wrap}
  html[data-theme] body .qt-banner-fields{width:100%}
  html[data-theme] body .qt-banner-fields label{flex:1}
}
</style>
<script id="fbi-quotes-js">
(function(){
  var $=function(id){return document.getElementById(id)};
  function e(v){return String(v==null?"":v).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
  function note(m){if(typeof toast==="function")toast(m)}
  function sym(c){try{return curSym(c||"GHS")}catch(x){return "GH₵"}}
  function fmt(n,c){return sym(c)+Number(n||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}
  function hd(v){if(!v)return "—";var d=new Date(v);return isNaN(d)?String(v):d.toLocaleDateString(undefined,{day:"numeric",month:"short",year:"numeric"})}
  function today(){return new Date().toISOString().slice(0,10)}
  function plusDays(n){var d=new Date();d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)}
  async function api(url,opt){opt=opt||{};opt.credentials="same-origin";opt.headers=Object.assign({"Content-Type":"application/json"},opt.headers||{});var r=await fetch(url,opt);var b={};try{b=await r.json()}catch(x){}if(!r.ok||b.ok===false)throw new Error(b.error||("Request failed ("+r.status+")"));return b}

  window.FBI_DOC_MODE="invoice";
  window.FBI_QUOTES=[];
  var currentQuote=null,pendingConvert=null;

  function effectiveStatus(q){var st=q.quoteStatus||q.status||"Draft";if((st==="Draft"||st==="Sent")&&q.validUntil&&q.validUntil<today())return "Expired";return st}
  async function loadQuotes(){try{var d=await api("/api/quotes");window.FBI_QUOTES=d.quotes||[];renderQuotes()}catch(x){console.warn("Quotations not loaded",x)}}
  window.loadQuotes=loadQuotes;

  /* ---------- quotation mode on the Create page ---------- */
  function setMode(mode){
    window.FBI_DOC_MODE=mode;
    var v=$("view-create");if(v)v.classList.toggle("quote-mode",mode==="quote");
    var bn=$("quoteBanner");if(bn)bn.hidden=mode!=="quote";
    var save=document.querySelector('.cx-aside .cx-big');if(save)save.innerHTML=mode==="quote"?"💾 Save<span class=\"cx-x\"> quotation</span>":"💾 Save<span class=\"cx-x\"> Invoice</span>";
    var t=$("title");if(t&&v&&v.classList.contains("active"))t.textContent=mode==="quote"?"Quotation":"Create invoice";
  }
  function banner(){
    var q=currentQuote;
    $("qtBannerTitle").textContent=q?(q.docType==="PRO-FORMA INVOICE"?"Pro-forma invoice ":"Quotation ")+q.no:"New quotation";
    $("qtBannerMeta").textContent=q?("Created "+hd(q.createdAt)+(q.convertedInvoiceNo?" · Converted to "+q.convertedInvoiceNo:"")):"Not saved yet — it gets a quotation number when you save.";
  }
  window.exitQuoteMode=function(goToList){currentQuote=null;setMode("invoice");if(goToList)show("quotes");else if(typeof newInvoice==="function"&&goToList!==false)newInvoice()};
  window.newQuote=function(){
    pendingConvert=null;
    origNewInvoice();
    currentQuote=null;setMode("quote");
    $("no").value="New quotation";
    $("qtDocType").value="QUOTATION";$("qtStatus").value="Draft";$("qtValidUntil").value=plusDays(14);
    banner();show("create");if($("title"))$("title").textContent="Quotation";if($("subtitle"))$("subtitle").textContent="Quote or pro-forma invoice — not counted in your invoices";window.scrollTo(0,0);
  };
  function fillFormFrom(x){
    // Same steps the app uses to open an invoice, but the quotation is never added to the invoice list
    var map={no:"no",date:"date",due:"due",status:"status",cur:"cur",client:"client",clientAddress:"clientAddress",clientPhone:"clientPhone",clientEmail:"clientEmail",tax:"taxRate",discount:"discount",payment:"payment",notes:"notes"};
    Object.keys(map).forEach(function(k){if($(k))$(k).value=x[map[k]]!=null?x[map[k]]:""});
    if($("status"))$("status").value="Draft";
    $("template").value=String(Number(x.template)||100);
    $("amountPaid").value=0;["paymentDate","transactionRef","receiptNo"].forEach(function(k){if($(k))$(k).value=""});
    $("eventDate").value=x.eventDate||"";$("eventEndDate").value=x.eventEndDate||x.eventDate||"";$("rentalStart").value=x.rentalStart||"";$("rentalEnd").value=x.rentalEnd||"";$("jobLocation").value=x.jobLocation||"";$("rentalRef").value=x.rentalRef||"";$("rentalUnit").value=x.rentalUnit||"Per Day";$("deposit").value=x.deposit||0;
    if($("payment")&&!String(x.payment||"").trim())$("payment").value=(typeof settings!=="undefined"&&settings.defaultPay)||"";
    current=null;
    if(typeof invoiceNumberReserved!=="undefined")invoiceNumberReserved="";
    try{setTemplate($("template").value)}catch(err){}
    $("items").innerHTML="";(x.items||[]).forEach(function(a){addItem(a.desc,a.qty,a.rate,a.days)});
    try{initTemplates()}catch(err){}
    $("template").value=String(Number(x.template)||100);
    try{restoreServiceSelection(x)}catch(err){}
    try{populateClientSelect();if($("clientSelect"))$("clientSelect").value=(clients.find(function(c){return c.name===x.client})||{}).id||""}catch(err){}
    if($("paymentHistoryPanel"))$("paymentHistoryPanel").innerHTML="";
    try{calc();updatePaymentBalancePreview()}catch(err){}
  }
  window.openQuote=function(id){
    var q=window.FBI_QUOTES.find(function(x){return x.id===id});if(!q)return;
    pendingConvert=null;
    fillFormFrom(q);
    currentQuote=q;setMode("quote");
    $("no").value=q.no;$("date").value=q.date||today();
    $("qtDocType").value=q.docType||"QUOTATION";$("qtStatus").value=["Draft","Sent","Accepted","Declined","Expired"].indexOf(q.quoteStatus)>=0?q.quoteStatus:"Draft";$("qtValidUntil").value=q.validUntil||"";
    banner();show("create");if($("title"))$("title").textContent="Quotation";if($("subtitle"))$("subtitle").textContent="Quote or pro-forma invoice — not counted in your invoices";window.scrollTo(0,0);
  };
  function snapshot(){
    var x=get();
    ["id","no","status","amountPaid","payments","receiptNo","paymentDate","paymentMethod","transactionRef","receivedBy","jobStatus","jobCompletedDate"].forEach(function(k){delete x[k]});
    x.docType=$("qtDocType").value;x.validUntil=$("qtValidUntil").value;x.due=x.validUntil?("Valid until "+x.validUntil):"";
    return x;
  }
  async function saveQuote(){
    var d=snapshot();
    if(!String(d.client||"").trim()){note("Enter the client's name first");$("client").focus();return null}
    if(!(d.items||[]).length){note("Add at least one item to the quotation");return null}
    var status=$("qtStatus").value;
    try{
      var r=currentQuote?await api("/api/quotes/"+encodeURIComponent(currentQuote.id),{method:"PUT",body:JSON.stringify({status:status,data:d})}):await api("/api/quotes",{method:"POST",body:JSON.stringify({status:status,data:d})});
      currentQuote=r.quote;
      var i=window.FBI_QUOTES.findIndex(function(q){return q.id===currentQuote.id});if(i>=0)window.FBI_QUOTES[i]=currentQuote;else window.FBI_QUOTES.unshift(currentQuote);
      $("no").value=currentQuote.no;banner();renderQuotes();
      note((currentQuote.docType==="PRO-FORMA INVOICE"?"Pro-forma invoice ":"Quotation ")+currentQuote.no+" saved");
      return currentQuote;
    }catch(x){note("Quotation not saved: "+x.message);return null}
  }
  window.saveQuote=saveQuote;

  /* Make the printed page say Quotation / Pro-forma invoice instead of Invoice */
  function patchPaper(){
    var paper=$("paper");if(!paper||window.FBI_DOC_MODE!=="quote")return;
    var title=$("qtDocType").value||"QUOTATION",word=title==="QUOTATION"?"quotation":"pro-forma invoice",Word=title==="QUOTATION"?"Quotation":"Pro-forma invoice";
    var st=$("qtStatus").value||"Draft",valid=$("qtValidUntil").value;
    var walker=document.createTreeWalker(paper,NodeFilter.SHOW_TEXT),nodes=[];while(walker.nextNode())nodes.push(walker.currentNode);
    nodes.forEach(function(n){
      var t=n.nodeValue,s=t.trim();if(!s)return;
      if(s==="INVOICE"||s==="Invoice")n.nodeValue=t.replace(s,s==="INVOICE"?title:Word);
      else if(s==="ISSUED")n.nodeValue=t.replace(s,"DATE");
      else if(s==="DUE"||s==="DUE DATE")n.nodeValue=t.replace(s,"VALID UNTIL");
      else if(s==="Amount Due"||s==="AMOUNT DUE")n.nodeValue=t.replace(s,s==="Amount Due"?Word+" total":title+" TOTAL");
      else if(/^Valid until \d{4}-\d{2}-\d{2}$/.test(s))n.nodeValue=t.replace(s,valid?hd(valid):"—");
      else {
        var u=t.replace(/\bInvoice total\b/g,Word+" total").replace(/\bThis invoice\b/g,"This "+word).replace(/\bthis invoice\b/g,"this "+word).replace(/^Invoice (QT\d+)/,Word+" $1").replace(/Payment status: [A-Za-z ]+/,"Status: "+st);
        if(u!==t)n.nodeValue=u;
      }
    });
    paper.querySelectorAll(".tl.balance").forEach(function(el){el.style.display="none"});
    paper.querySelectorAll(".status-pill").forEach(function(el){el.textContent=st;el.className="status-pill status-draft"});
    if(!paper.querySelector(".qt-terms")){
      var box=document.createElement("div");box.className="qt-terms";box.style.cssText="margin:14px 0 0;padding:10px 12px;border:1px dashed #c9cdd4;border-radius:8px;font-size:11px;color:#3d4350;line-height:1.5";
      box.textContent="This "+word+" is valid"+(valid?" until "+hd(valid):" for 14 days")+". Prices may change after that date. "+(title==="QUOTATION"?"To accept, please confirm in writing or make the advance payment.":"Payment against this pro-forma invoice confirms the booking; a final invoice and receipt will follow.");
      var anchor=paper.querySelector(".paper-footer")||paper.lastElementChild;if(anchor&&anchor.parentNode)anchor.parentNode.insertBefore(box,anchor);else paper.appendChild(box);
    }
  }

  /* ---------- wrap the existing actions (invoice behaviour unchanged) ---------- */
  var origSave=window.save,origPreview=window.preview,origPrint=window.printInvoice,origPdf=window.savePdfToDrive,origRender=window.renderPaper,
      origNewInvoice=window.newInvoice,origLoadInvoice=window.loadInvoice,origDraft=window.scheduleDraftSave;
  window.renderPaper=function(){if(window.FBI_DOC_MODE==="quote"&&$("due")){var vu=$("qtValidUntil").value;$("due").value=vu?"Valid until "+vu:""}var r=origRender.apply(this,arguments);try{patchPaper()}catch(x){console.warn(x)}return r};
  window.save=async function(){
    if(window.FBI_DOC_MODE==="quote")return saveQuote();
    var x=await origSave.apply(this,arguments);
    if(x&&pendingConvert){var qid=pendingConvert;pendingConvert=null;
      try{var r=await api("/api/quotes/"+encodeURIComponent(qid),{method:"PUT",body:JSON.stringify({status:"Converted",convertedInvoiceNo:x.no})});var i=window.FBI_QUOTES.findIndex(function(q){return q.id===qid});if(i>=0)window.FBI_QUOTES[i]=r.quote;renderQuotes();note("Quotation marked as converted to "+x.no)}catch(err){console.warn(err)}}
    return x;
  };
  function quotePreview(){window.renderPaper();document.querySelectorAll(".view").forEach(function(v){v.classList.remove("active","print-view")});$("view-preview").classList.add("active");window.scrollTo(0,0)}
  window.preview=function(){if(window.FBI_DOC_MODE==="quote")return quotePreview();return origPreview.apply(this,arguments)};
  function quotePrint(){var label=($("qtDocType").value==="QUOTATION"?"Quotation ":"Pro-forma ")+($("no").value||"");window.renderPaper();openDocumentPrint($("paper"),label,"size:A4 portrait;margin:0")}
  window.printInvoice=function(){if(window.FBI_DOC_MODE==="quote")return quotePrint();return origPrint.apply(this,arguments)};
  window.savePdfToDrive=function(){if(window.FBI_DOC_MODE==="quote")return quotePrint();return origPdf.apply(this,arguments)};
  window.newInvoice=function(){if(window.FBI_DOC_MODE==="quote"){currentQuote=null;setMode("invoice")}pendingConvert=null;return origNewInvoice.apply(this,arguments)};
  window.loadInvoice=function(){if(window.FBI_DOC_MODE==="quote"){currentQuote=null;setMode("invoice")}pendingConvert=null;return origLoadInvoice.apply(this,arguments)};
  window.scheduleDraftSave=function(){if(window.FBI_DOC_MODE==="quote")return;return origDraft.apply(this,arguments)};
  ["qtDocType","qtStatus","qtValidUntil"].forEach(function(id){var n=$(id);if(n)n.addEventListener("change",function(){if(currentQuote)banner()})});

  /* ---------- convert ---------- */
  window.convertCurrentQuote=async function(){
    if(!currentQuote){var s=await saveQuote();if(!s)return}
    convertQuote(currentQuote.id);
  };
  function convertQuote(id){
    var q=window.FBI_QUOTES.find(function(x){return x.id===id});if(!q)return;
    if(q.convertedInvoiceNo&&!confirm("This quotation was already converted to "+q.convertedInvoiceNo+". Create another invoice from it?"))return;
    currentQuote=null;setMode("invoice");
    origNewInvoice();
    fillFormFrom(Object.assign({},q,{due:"On Receipt"}));
    $("no").value=nextInvoiceNumber();$("date").value=today();$("status").value="Sent";$("due").value="On Receipt";
    pendingConvert=q.id;
    show("create");window.scrollTo(0,0);
    note("Invoice ready from "+q.no+". Check the details and press Save to create it.");
  }
  window.convertQuote=convertQuote;

  /* ---------- quotations list ---------- */
  var CHIPS=[["","All"],["open","Waiting"],["Accepted","Accepted"],["Converted","Converted"],["Declined","Declined"],["Expired","Expired"],["Draft","Drafts"]];
  var filter="";
  function matchStatus(q,f){var st=effectiveStatus(q);if(!f)return true;if(f==="open")return st==="Sent";return st===f}
  function renderQuotes(){
    var box=$("quoteList");if(!box)return;
    var qs=(($("quoteSearch")||{}).value||"").trim().toLowerCase();
    var list=window.FBI_QUOTES.filter(function(q){return matchStatus(q,filter)&&(!qs||[q.no,q.client,q.clientPhone,q.total].join(" ").toLowerCase().indexOf(qs)>=0)});
    $("quoteChips").innerHTML=CHIPS.map(function(c){var n=window.FBI_QUOTES.filter(function(q){return matchStatus(q,c[0])}).length;return '<button type="button" role="tab" aria-selected="'+(filter===c[0])+'" data-qchip="'+c[0]+'">'+c[1]+' <span>'+n+'</span></button>'}).join("");
    $("quoteEmpty").hidden=!!window.FBI_QUOTES.length;
    box.innerHTML=list.map(function(q){
      var st=effectiveStatus(q),chip={Accepted:"ok",Converted:"ok",Declined:"bad",Expired:"bad",Sent:"info"}[st]||"neutral";
      var late=q.validUntil&&q.validUntil<today()&&(st==="Sent"||st==="Draft"||st==="Expired");
      return '<div class="qt-row" data-quote-row="'+e(q.id)+'">'+
        '<button type="button" class="inv-main" data-q="open" data-id="'+e(q.id)+'"><b class="inv-no">'+e(q.no)+'</b><span class="inv-client">'+e(q.client||"No client")+(q.docType==="PRO-FORMA INVOICE"?" · Pro-forma":"")+'</span></button>'+
        '<div class="inv-date">'+e(hd(q.date))+'<small>'+e(q.category||"")+'</small></div>'+
        '<div class="inv-amt"><b>'+e(fmt(q.total,q.cur))+'</b><small>'+e((q.items||[]).length+" item"+((q.items||[]).length===1?"":"s"))+'</small></div>'+
        '<span class="ui-chip '+chip+'">'+e(st==="Converted"&&q.convertedInvoiceNo?"Invoiced "+q.convertedInvoiceNo:st)+'</span>'+
        '<div class="qt-valid'+(late?" late":"")+'">'+e(q.validUntil?hd(q.validUntil):"—")+'<small>'+(late?"Expired":"")+'</small></div>'+
        '<div class="inv-actions"><button type="button" class="btn" data-q="open" data-id="'+e(q.id)+'">Open</button>'+
        (st!=="Converted"?'<button type="button" class="btn primary" data-q="convert" data-id="'+e(q.id)+'">Convert to invoice</button>':'')+
        '<details class="inv-more"><summary class="btn" aria-label="More actions for '+e(q.no)+'">•••</summary><div class="inv-menu">'+
          '<button type="button" data-q="print" data-id="'+e(q.id)+'">Preview / print</button>'+
          '<button type="button" data-q="share" data-id="'+e(q.id)+'">Send to client on WhatsApp</button>'+
          (st!=="Sent"&&st!=="Converted"?'<button type="button" data-q="mark-Sent" data-id="'+e(q.id)+'">Mark as sent</button>':'')+
          (st!=="Accepted"&&st!=="Converted"?'<button type="button" data-q="mark-Accepted" data-id="'+e(q.id)+'">Mark as accepted</button>':'')+
          (st!=="Declined"&&st!=="Converted"?'<button type="button" data-q="mark-Declined" data-id="'+e(q.id)+'">Mark as declined</button>':'')+
          '<button type="button" data-q="duplicate" data-id="'+e(q.id)+'">Duplicate as new quotation</button>'+
          '<button type="button" class="danger" data-q="delete" data-id="'+e(q.id)+'">Delete quotation</button>'+
        '</div></details></div></div>';
    }).join("")+(window.FBI_QUOTES.length&&!list.length?'<div class="ui-empty"><b>No quotations match</b><span>Try a different search or filter.</span></div>':"");
  }
  window.renderQuotes=renderQuotes;
  function share(q){
    var biz=(typeof settings!=="undefined"&&settings&&settings.biz)||"FILM BEYOND IMAGINATION (FBI)";
    var kind=q.docType==="PRO-FORMA INVOICE"?"pro-forma invoice":"quotation";
    var lines=["Hello "+(q.client||"there")+",","","Please find our "+kind+" "+q.no+" from "+biz+":"];
    (q.items||[]).slice(0,8).forEach(function(i){lines.push("• "+i.desc+(i.qty>1?" × "+i.qty:""))});
    if((q.items||[]).length>8)lines.push("• and "+((q.items||[]).length-8)+" more items");
    lines.push("","Total: "+fmt(q.total,q.cur));if(q.validUntil)lines.push("Valid until: "+hd(q.validUntil));
    lines.push("","Reply to this message to accept, or let us know if you'd like any changes. Thank you!");
    var p=String(q.clientPhone||"").replace(/\D/g,"");if(p.length===10&&p[0]==="0")p="233"+p.slice(1);
    window.open("https://wa.me/"+p+"?text="+encodeURIComponent(lines.join("\n")),"_blank","noopener");
  }
  async function setStatus(q,st){try{var r=await api("/api/quotes/"+encodeURIComponent(q.id),{method:"PUT",body:JSON.stringify({status:st})});var i=window.FBI_QUOTES.indexOf(q);if(i>=0)window.FBI_QUOTES[i]=r.quote;renderQuotes();note(q.no+" marked as "+st.toLowerCase())}catch(x){note(x.message)}}
  document.addEventListener("click",function(ev){
    var chip=ev.target.closest&&ev.target.closest("[data-qchip]");if(chip){filter=chip.getAttribute("data-qchip");renderQuotes();return}
    var b=ev.target.closest&&ev.target.closest("#view-quotes [data-q]");if(!b)return;
    var q=window.FBI_QUOTES.find(function(x){return x.id===b.getAttribute("data-id")});if(!q)return;
    var act=b.getAttribute("data-q"),more=b.closest("details");if(more)more.open=false;
    if(act==="open")openQuote(q.id);
    else if(act==="convert")convertQuote(q.id);
    else if(act==="print"){openQuote(q.id);setTimeout(quotePreview,80)}
    else if(act==="share")share(q);
    else if(act.indexOf("mark-")===0)setStatus(q,act.slice(5));
    else if(act==="duplicate"){openQuote(q.id);currentQuote=null;$("no").value="New quotation";$("qtStatus").value="Draft";$("qtValidUntil").value=plusDays(14);$("date").value=today();banner();note("Copy of "+q.no+" ready — save to give it a new number")}
    else if(act==="delete"){if(confirm("Delete quotation "+q.no+"? This cannot be undone from the app.")){api("/api/quotes/"+encodeURIComponent(q.id),{method:"DELETE"}).then(function(){window.FBI_QUOTES=window.FBI_QUOTES.filter(function(x){return x!==q});renderQuotes();note("Quotation deleted")}).catch(function(x){note(x.message)})}}
  });
  document.addEventListener("toggle",function(ev){var d=ev.target;if(!d||!d.classList||!d.classList.contains("inv-more"))return;var row=d.closest(".qt-row");if(row)row.classList.toggle("menu-open",d.open)},true);
  var qsIn=$("quoteSearch");if(qsIn)qsIn.addEventListener("input",renderQuotes);
  var qv=$("view-quotes");if(qv){try{new MutationObserver(function(){if(qv.classList.contains("active"))loadQuotes()}).observe(qv,{attributes:true,attributeFilter:["class"]})}catch(x){}}
  // Leaving the Create page while in quotation mode returns the form to invoice mode next time
  setTimeout(loadQuotes,1200);
})();
</script>
